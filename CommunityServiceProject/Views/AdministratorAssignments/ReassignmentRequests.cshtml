
@model List<CommunityServiceProject.Models.ReassignmentRequest>

@{
    ViewBag.Title = "Reassignment Requests";
}

<div class="admin-reassignment-page">

    <div class="admin-reassignment-card">

        <div class="admin-reassignment-header">
            <h2>Pending Reassignment Requests</h2>
            <p>Review technician requests for reassignment.</p>
        </div>

        @if (Model.Count == 0)
        {
            <div class="admin-reassignment-empty">
                <h4>No Pending Reassignment Requests</h4>
                <p>There are currently no reassignment requests waiting for review.</p>

                <a href="@Url.Action(
                    "Index",
                    "AdministratorRequests"
                )"
                   class="admin-back-button">
                    Back to Manage Requests
                </a>
            </div>
        }
        else
        {
            <div class="admin-reassignment-list">

                @foreach (var item in Model)
                {
                    <div class="admin-reassignment-item">

                        <div class="admin-reassignment-item-header">

                            <h4>
                                @(item.Assignment != null &&
                                  item.Assignment.Request != null
                                    ? item.Assignment.Request.Title
                                    : "Request")
                            </h4>

                            <span class="admin-reassignment-status">
                                @item.Status
                            </span>

                        </div>

                        <div class="admin-reassignment-details">

                            <div class="admin-reassignment-detail">
                                <span class="admin-reassignment-label">
                                    Technician
                                </span>

                                <span>
                                    @(item.Technician != null
                                        ? item.Technician.FirstName + " " +
                                          item.Technician.LastName
                                        : "Unknown")
                                </span>
                            </div>

                            <div class="admin-reassignment-detail">
                                <span class="admin-reassignment-label">
                                    Reason
                                </span>

                                <span>
                                    @item.Reason
                                </span>
                            </div>

                            <div class="admin-reassignment-detail">
                                <span class="admin-reassignment-label">
                                    Requested
                                </span>

                                <span>
                                    @item.RequestedDate.ToString(
                                        "dd MMM yyyy HH:mm")
                                </span>
                            </div>

                        </div>

                        <div class="admin-reassignment-actions">

                            <a href="@Url.Action(
                                "ReviewReassignment",
                                "AdministratorAssignments",
                                new { id = item.ReassignmentRequestID }
                            )"
                               class="admin-approve-button">
                                Review
                            </a>

                        </div>

                    </div>
                }

            </div>

            <div class="admin-reassignment-footer">

                <a href="@Url.Action(
                    "Index",
                    "AdministratorRequests"
                )"
                   class="admin-back-button">
                    Back to Manage Requests
                </a>

            </div>
        }

    </div>

</div>

