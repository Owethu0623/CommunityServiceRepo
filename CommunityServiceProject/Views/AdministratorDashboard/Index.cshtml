@{
    ViewBag.Title = "Administrator Dashboard";
}

<style>

    /* =========================================================
       PAGE
       ========================================================= */

    .admin-dashboard-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 36px 24px 40px;
        color: #1f2937;
    }


    /* =========================================================
       TOP HEADER
       ========================================================= */

    .admin-top-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 24px;
    }

    .admin-header-content {
        min-width: 0;
    }

    .admin-eyebrow {
        display: inline-block;
        margin-bottom: 7px;
        color: #0D5CC1;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.09em;
    }

    .admin-top-header h1 {
        margin: 0 0 7px;
        color: #16324f;
        font-size: 26px;
        line-height: 1.2;
        font-weight: 750;
        letter-spacing: -0.015em;
    }

    .admin-top-header p {
        margin: 0;
        max-width: 760px;
        color: #64748b;
        font-size: 14px;
        line-height: 1.6;
    }

    .admin-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 10px 14px;
        background: #ffffff;
        border: 1px solid #dce4ee;
        border-radius: 10px;
        color: #475569;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
        box-shadow: 0 3px 12px rgba(15, 23, 42, 0.04);
    }

    .admin-status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #18794e;
        box-shadow: 0 0 0 4px rgba(24, 121, 78, 0.09);
    }


    /* =========================================================
       MAIN LAYOUT
       ========================================================= */

    .admin-layout {
        display: grid;
        grid-template-columns: 250px minmax(0, 1fr);
        gap: 22px;
        align-items: start;
    }


    /* =========================================================
       SIDEBAR
       ========================================================= */

    .admin-sidebar {
        position: sticky;
        top: 20px;
        padding: 12px;
        background: #ffffff;
        border: 1px solid #dfe6ef;
        border-radius: 10px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.035);
    }

    .admin-sidebar-brand {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 8px 9px 15px;
        margin-bottom: 8px;
        border-bottom: 1px solid #edf1f5;
    }

    .admin-brand-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: linear-gradient(135deg, #0D5CC1, #094b9f);
        color: #ffffff;
        font-size: 16px;
        font-weight: 800;
        box-shadow: 0 5px 13px rgba(13, 92, 193, 0.18);
    }

    .admin-brand-text {
        min-width: 0;
    }

    .admin-brand-title {
        display: block;
        color: #16324f;
        font-size: 13px;
        font-weight: 800;
        line-height: 1.3;
    }

    .admin-brand-subtitle {
        display: block;
        margin-top: 2px;
        color: #94a3b8;
        font-size: 10px;
        font-weight: 650;
    }

    .admin-nav-section {
        margin-top: 13px;
    }

    .admin-nav-section-title {
        display: block;
        padding: 0 10px 7px;
        color: #94a3b8;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .admin-nav {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .admin-nav-link {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 42px;
        padding: 0 11px;
        border: 1px solid transparent;
        border-radius: 9px;
        color: #475569;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        transition:
            background 0.16s ease,
            border-color 0.16s ease,
            color 0.16s ease,
            transform 0.16s ease;
    }

    .admin-nav-link:hover {
        background: #f4f8fd;
        border-color: #d9e6f5;
        color: #0D5CC1;
        text-decoration: none;
        transform: translateX(1px);
    }

    .admin-nav-link.active {
        background: #eef5ff;
        border-color: #d5e4f7;
        color: #0D5CC1;
    }

    .admin-nav-icon {
        width: 25px;
        flex: 0 0 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }

    .admin-nav-divider {
        height: 1px;
        margin: 10px 5px;
        background: #edf1f5;
    }

    .admin-nav-link.logout {
        color: #b42318;
    }

    .admin-nav-link.logout:hover {
        background: #fff4f3;
        border-color: #f2d2cf;
        color: #b42318;
    }


    /* =========================================================
       MAIN CONTENT
       ========================================================= */

    .admin-main {
        min-width: 0;
    }


    /* =========================================================
       WELCOME BANNER
       ========================================================= */

    .admin-welcome {
        position: relative;
        overflow: hidden;
        margin-bottom: 18px;
        padding: 20px 22px;
        background: linear-gradient(135deg, rgba(13,92,193,0.96) 0%, rgba(10,83,173,0.9) 60%);
        border-radius: 10px;
        color: #ffffff;
        box-shadow: 0 8px 20px rgba(13, 92, 193, 0.12);
    }

    .admin-welcome::after {
        content: "";
        position: absolute;
        top: -90px;
        right: -70px;
        width: 240px;
        height: 240px;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 50%;
        box-shadow:
            0 0 0 28px rgba(255, 255, 255, 0.03),
            0 0 0 56px rgba(255, 255, 255, 0.025);
    }

    .admin-welcome-content {
        position: relative;
        z-index: 1;
        max-width: 760px;
    }

    .admin-welcome-label {
        display: block;
        margin-bottom: 6px;
        color: rgba(255, 255, 255, 0.76);
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.09em;
    }

    .admin-welcome h2 {
        margin: 0 0 7px;
        font-size: 23px;
        font-weight: 760;
        letter-spacing: -0.015em;
    }

    .admin-welcome p {
        margin: 0;
        color: rgba(255, 255, 255, 0.91);
        font-size: 13px;
        line-height: 1.65;
    }


    /* =========================================================
       SECTION
       ========================================================= */

    .admin-section {
        margin-bottom: 18px;
        padding: 16px;
        background: #ffffff;
        border: 1px solid #dfe6ef;
        border-radius: 10px;
        box-shadow: 0 6px 16px rgba(15, 23, 42, 0.035);
    }

    .admin-section-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 17px;
    }

    .admin-section-header-left {
        min-width: 0;
    }

    .admin-section-header h3 {
        margin: 0 0 5px;
        color: #16324f;
        font-size: 17px;
        font-weight: 760;
    }

    .admin-section-header p {
        margin: 0;
        color: #64748b;
        font-size: 12px;
        line-height: 1.55;
    }

    .admin-section-tag {
        flex-shrink: 0;
        padding: 6px 9px;
        background: #f5f8fc;
        border: 1px solid #e0e7ef;
        border-radius: 7px;
        color: #64748b;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }


    /* =========================================================
       FEATURE GRID
       ========================================================= */

    .admin-feature-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .admin-feature-card {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
        min-height: 72px;
        padding: 12px;
        background: #fbfcfe;
        border: 1px solid #e3e9f1;
        border-radius: 10px;
        color: inherit;
        text-decoration: none;
        transition:
            transform 0.14s ease,
            border-color 0.14s ease,
            background 0.14s ease,
            box-shadow 0.14s ease;
    }

    .admin-feature-card:hover {
        background: #ffffff;
        border-color: #c9dbf2;
        box-shadow: 0 9px 23px rgba(15, 23, 42, 0.07);
        transform: translateY(-2px);
        text-decoration: none;
    }

    .admin-feature-icon {
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #eef5ff;
        border: 1px solid #d7e5f7;
        color: #0D5CC1;
        font-size: 15px;
        font-weight: 800;
    }

    .admin-feature-text {
        min-width: 0;
    }

    .admin-feature-title {
        display: block;
        margin-bottom: 4px;
        color: #25384d;
        font-size: 13px;
        font-weight: 700;
    }

    .admin-feature-description {
        display: block;
        color: #7b8796;
        font-size: 11px;
        line-height: 1.45;
    }

    .admin-feature-arrow {
        margin-left: auto;
        padding-left: 7px;
        color: #9aa8b8;
        font-size: 16px;
        transition: transform 0.16s ease, color 0.16s ease;
    }

    .admin-feature-card:hover .admin-feature-arrow {
        color: #0D5CC1;
        transform: translateX(2px);
    }


    /* =========================================================
       QUICK ACTIONS
       ========================================================= */

    .admin-quick-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
    }

    .admin-quick-action {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 0 12px;
        border: 1px solid #d7e0eb;
        border-radius: 8px;
        background: #ffffff;
        color: #0D5CC1;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        transition:
            background 0.14s ease,
            border-color 0.14s ease,
            color 0.14s ease,
            transform 0.14s ease;
    }

    .admin-quick-action:hover {
        background: #eef5ff;
        border-color: #c5d9f2;
        color: #094b9f;
        text-decoration: none;
        transform: translateY(-1px);
    }


    /* =========================================================
       NOTIFICATION AREA
       ========================================================= */

    .notifications {
        margin-bottom: 18px;
        padding: 16px;
        background: #ffffff;
        border: 1px solid #dfe6ef;
        border-radius: 10px;
        box-shadow: 0 6px 16px rgba(15, 23, 42, 0.035);
    }

    .notifications h3 {
        margin: 0 0 15px;
        padding-bottom: 11px;
        border-bottom: 1px solid #e8edf3;
        color: #16324f;
        font-size: 17px;
        font-weight: 760;
    }

    .notification-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 8px;
        padding: 10px 12px;
        background: #f8fafc;
        border: 1px solid #e6ebf1;
        border-left: 4px solid #0D5CC1;
        border-radius: 8px;
        transition:
            background 0.14s ease,
            border-color 0.14s ease;
    }

    .notification-item:hover {
        background: #f2f7fd;
        border-color: #d3deec;
    }

    .notification-item:last-child {
        margin-bottom: 0;
    }

    .notification-icon {
        flex-shrink: 0;
        width: 24px;
        color: #0D5CC1;
        font-size: 16px;
        line-height: 1.4;
        text-align: center;
    }

    .notification-message {
        min-width: 0;
        color: #465466;
        font-size: 12px;
        line-height: 1.55;
    }

    .notifications > p {
        margin: 0;
        color: #7b8796;
        font-size: 12px;
        line-height: 1.55;
    }


    /* =========================================================
       FOOTER / LOGOUT
       ========================================================= */

    .admin-dashboard-footer {
        display: flex;
        justify-content: flex-end;
        margin-top: 3px;
    }

    .logout-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 0 14px;
        border: 1px solid #efc9c5;
        border-radius: 8px;
        background: #fff7f6;
        color: #b42318;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        transition:
            background 0.14s ease,
            border-color 0.14s ease,
            color 0.14s ease;
    }

    .logout-button:hover {
        background: #fff0ee;
        border-color: #eab7b1;
        color: #9f1f16;
        text-decoration: none;
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 1150px) {

        .admin-layout {
            grid-template-columns: 220px minmax(0, 1fr);
        }

        .admin-quick-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }


     @@media (max-width: 900px) {

        .admin-layout {
            grid-template-columns: 1fr;
        }

        .admin-sidebar {
            position: static;
        }

        .admin-nav {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .admin-nav-divider {
            display: none;
        }

        .admin-nav-section {
            margin-top: 8px;
        }

        .admin-top-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .admin-status-pill {
            align-self: flex-start;
        }
    }


    @@media (max-width: 680px) {

        .admin-dashboard-page {
            padding: 20px 12px 35px;
        }

        .admin-top-header h1 {
            font-size: 25px;
        }

        .admin-welcome {
            padding: 22px;
        }

        .admin-welcome h2 {
            font-size: 20px;
        }

        .admin-section,
        .notifications {
            padding: 18px;
        }

        .admin-feature-grid {
            grid-template-columns: 1fr;
        }

        .admin-quick-grid {
            grid-template-columns: 1fr 1fr;
        }
    }


    @@media (max-width: 500px) {

        .admin-nav {
            grid-template-columns: 1fr;
        }

        .admin-quick-grid {
            grid-template-columns: 1fr;
        }

        .admin-top-header h1 {
            font-size: 22px;
        }

        .admin-status-pill {
            width: 100%;
            box-sizing: border-box;
        }

        .admin-feature-card {
            min-height: 74px;
        }
    }

</style>


<div class="admin-dashboard-page">

    <!-- =====================================================
         TOP HEADER
         ===================================================== -->

    <div class="admin-top-header">

        <div class="admin-header-content">

            <span class="admin-eyebrow">
