@model CommunityServiceProject.ViewModels.AdministratorReportsViewModel

@using CommunityServiceProject.Models
@using System

@{
    ViewBag.Title = "Maintenance Reports";

    var selectedReport =
        Model.SelectedReportOption ??
        "ServiceResolutionPerformance";
}

<div class="admin-reports-page">

    <div class="admin-reports-card">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="admin-reports-header">

            <h2>Maintenance Reports</h2>

            <p>
                Generate detailed reports on community service requests
                and maintenance performance.
            </p>

        </div>


        <div class="admin-reports-content">

            <!-- =================================================
                 REPORT FILTERS
                 ================================================= -->

            <div class="admin-report-filter-section">

                <h3>Report Filters</h3>

                @using (Html.BeginForm(
                    "Index",
                    "AdministratorReports",
                    FormMethod.Get))
                {

                    <div class="admin-report-filters">

                        <!-- STATUS -->

                        <div class="admin-report-filter-group">

                            <label for="status">
                                Status
                            </label>

                            <select id="status"
                                    name="status"
                                    class="admin-report-select">

                                <option value="">
                                    All Statuses
                                </option>

                                @foreach (
                                    RequestStatus statusValue
                                    in Enum.GetValues(
                                        typeof(RequestStatus)))
                                {
                                    var statusValueText =
                                        statusValue.ToString();

                                    <option value="@statusValueText"
                                            @(Model.SelectedStatus == statusValueText ? "selected" : "")>
                                        @statusValueText
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- CATEGORY -->

                        <div class="admin-report-filter-group">

                            <label for="categoryId">
                                Category
                            </label>

                            <select id="categoryId"
                                    name="categoryId"
                                    class="admin-report-select">

                                <option value="">
                                    All Categories
                                </option>

                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.CategoryID"
                                            @(Model.SelectedCategoryId == category.CategoryID ? "selected" : "")>
                                        @category.CategoryName
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- WARD -->

                        <div class="admin-report-filter-group">

                            <label for="wardId">
                                Ward
                            </label>

                            <select id="wardId"
                                    name="wardId"
                                    class="admin-report-select">

                                <option value="">
                                    All Wards
                                </option>

                                @foreach (var ward in Model.Wards)
                                {
                                    <option value="@ward.WardID"
                                            @(Model.SelectedWardId == ward.WardID ? "selected" : "")>
                                        Ward @ward.WardNumber - @ward.WardName
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- PRIORITY -->

                        <div class="admin-report-filter-group">

                            <label for="priority">
                                Priority
                            </label>

                            <select id="priority"
                                    name="priority"
                                    class="admin-report-select">

                                <option value="">
                                    All Priorities
                                </option>

                                @foreach (
                                    Priority priorityValue
                                    in Enum.GetValues(
                                        typeof(Priority)))
                                {
                                    var priorityText =
                                        priorityValue.ToString();

                                    <option value="@priorityText"
                                            @(Model.SelectedPriority == priorityText ? "selected" : "")>
                                        @priorityText
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- TECHNICIAN -->

                        <div class="admin-report-filter-group">

                            <label for="technicianId">
                                Technician
                            </label>

                            <select id="technicianId"
                                    name="technicianId"
                                    class="admin-report-select">

                                <option value="">
                                    All Technicians
                                </option>

                                @foreach (var technician in Model.Technicians)
                                {
                                    <option value="@technician.TechnicianID"
                                            @(Model.SelectedTechnicianId == technician.TechnicianID ? "selected" : "")>
                                        @technician.FirstName
                                        @technician.LastName
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- DATE FROM -->

                        <div class="admin-report-filter-group">

                            <label for="dateFrom">
                                Date From
                            </label>

                            <input type="date"
                                   id="dateFrom"
                                   name="dateFrom"
                                   class="admin-report-input"
                                   value="@(Model.SelectedDateFrom.HasValue
                                       ? Model.SelectedDateFrom.Value.ToString("yyyy-MM-dd")
                                       : "")" />

                        </div>


                        <!-- DATE TO -->

                        <div class="admin-report-filter-group">

                            <label for="dateTo">
                                Date To
                            </label>

                            <input type="date"
                                   id="dateTo"
                                   name="dateTo"
                                   class="admin-report-input"
                                   value="@(Model.SelectedDateTo.HasValue
                                       ? Model.SelectedDateTo.Value.ToString("yyyy-MM-dd")
                                       : "")" />

                        </div>

                    </div>


                    <!-- =================================================
                         REPORT SELECTION
                         ================================================= -->

                    <div class="admin-report-selection">

                        <div class="admin-report-selection-header">

                            <h3>Report to Generate</h3>

                            <p>
                                Select the type of analysis you want to view.
                            </p>

                        </div>


                        <div class="admin-report-options">

                            <!-- CATEGORY -->

                            <label class="admin-report-option">

                                <input type="radio"
                                       name="reportOption"
                                       value="RequestsByCategory"
                                       class="admin-report-option-input"
                                       @(selectedReport == "RequestsByCategory" ? "checked" : "") />

                                <span class="admin-report-option-card">

                                    <span class="admin-report-option-content">

                                        <strong>
                                            Requests by Category
                                        </strong>

                                        <small>
                                            Analyse request distribution
                                            across service categories.
                                        </small>

                                    </span>

                                </span>

                            </label>


                            <!-- WARD -->

                            <label class="admin-report-option">

                                <input type="radio"
                                       name="reportOption"
                                       value="RequestsByWard"
                                       class="admin-report-option-input"
                                       @(selectedReport == "RequestsByWard" ? "checked" : "") />

                                <span class="admin-report-option-card">

                                    <span class="admin-report-option-content">

                                        <strong>
                                            Requests by Ward
                                        </strong>

                                        <small>
                                            Compare service requests
                                            across municipal wards.
                                        </small>

                                    </span>

                                </span>

                            </label>


                            <!-- STATUS -->

                            <label class="admin-report-option">

                                <input type="radio"
                                       name="reportOption"
                                       value="RequestsByStatus"
                                       class="admin-report-option-input"
                                       @(selectedReport == "RequestsByStatus" ? "checked" : "") />

                                <span class="admin-report-option-card">

                                    <span class="admin-report-option-content">

                                        <strong>
                                            Requests by Status
                                        </strong>

                                        <small>
                                            Review the current distribution
                                            of request statuses.
                                        </small>

                                    </span>

                                </span>

                            </label>


                            <!-- PRIORITY -->

                            <label class="admin-report-option">

                                <input type="radio"
                                       name="reportOption"
                                       value="RequestsByPriority"
                                       class="admin-report-option-input"
                                       @(selectedReport == "RequestsByPriority" ? "checked" : "") />

                                <span class="admin-report-option-card">

                                    <span class="admin-report-option-content">

                                        <strong>
                                            Requests by Priority
                                        </strong>

                                        <small>
                                            Analyse Low, Medium, High and
                                            Critical service requests.
                                        </small>

                                    </span>

                                </span>

                            </label>


                            <!-- TECHNICIAN -->

                            <label class="admin-report-option">

                                <input type="radio"
                                       name="reportOption"
                                       value="TechnicianPerformance"
                                       class="admin-report-option-input"
                                       @(selectedReport == "TechnicianPerformance" ? "checked" : "") />

                                <span class="admin-report-option-card">

                                    <span class="admin-report-option-content">

                                        <strong>
                                            Technician Performance
                                        </strong>

                                        <small>
                                            Compare completed and active
                                            work by technician.
                                        </small>

                                    </span>

                                </span>

                            </label>


                            <!-- SERVICE RESOLUTION -->

                            <label class="admin-report-option">

                                <input type="radio"
                                       name="reportOption"
                                       value="ServiceResolutionPerformance"
                                       class="admin-report-option-input"
                                       @(selectedReport == "ServiceResolutionPerformance" ? "checked" : "") />

                                <span class="admin-report-option-card">

                                    <span class="admin-report-option-content">

                                        <strong>
                                            Service Resolution Performance
                                        </strong>

                                        <small>
                                            Measure resolution time,
                                            completion and service efficiency.
                                        </small>

                                    </span>

                                </span>

                            </label>

                        </div>

                    </div>


                    <!-- =================================================
                         GENERATE BUTTON
                         ================================================= -->

                    <div class="admin-report-actions">

                        <button type="submit"
                                class="admin-report-generate-button">

                            Generate Report

                        </button>

                    </div>

                }

            </div>


            <!-- =================================================
                 REPORT SUMMARY
                 ================================================= -->

            <div class="admin-report-summary-section">

                <h3>Report Summary</h3>

                <div class="admin-report-summary-grid">

                    <div class="admin-report-summary-card">

                        <span class="admin-report-summary-label">
                            Requests in Report
                        </span>

                        <span class="admin-report-summary-number">
                            @Model.TotalRequests
                        </span>

                    </div>


                    <div class="admin-report-summary-card">

                        <span class="admin-report-summary-label">
                            Pending
                        </span>

                        <span class="admin-report-summary-number">
                            @Model.PendingRequests
                        </span>

                    </div>


                    <div class="admin-report-summary-card">

                        <span class="admin-report-summary-label">
                            Completed
                        </span>

                        <span class="admin-report-summary-number">
                            @Model.CompletedRequests
                        </span>

                    </div>


                    <div class="admin-report-summary-card">

                        <span class="admin-report-summary-label">
                            Rejected
                        </span>

                        <span class="admin-report-summary-number">
                            @Model.RejectedRequests
                        </span>

                    </div>


                    <div class="admin-report-summary-card">

                        <span class="admin-report-summary-label">
                            Categories
                        </span>

                        <span class="admin-report-summary-number">
                            @Model.CategoryCount
                        </span>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 GENERATED REPORT
                 ================================================= -->

            <div class="admin-report-results-section">


                <!-- =================================================
                     REQUESTS BY CATEGORY
                     ================================================= -->

                @if (selectedReport == "RequestsByCategory")
                {
                    <div class="admin-report-results-header">

                        <div>

                            <h3>
                                Requests by Category
                            </h3>

                            <p>
                                Distribution of service requests by category.
                            </p>

                        </div>

                    </div>


                    if (!Model.RequestsByCategory.Any())
                    {
                        <div class="admin-report-no-results">

                            <p>
                                No category data is available for the
                                selected filters.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="admin-report-table-wrapper">

                            <table class="admin-report-table">

                                <thead>

                                    <tr>
                                        <th>Category</th>
                                        <th>Requests</th>
                                        <th>Percentage</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (
                                        var item in Model.RequestsByCategory)
                                    {
                                        <tr>

                                            <td>
                                                @item.CategoryName
                                            </td>

                                            <td>
                                                @item.RequestCount
                                            </td>

                                            <td>
                                                @item.Percentage%
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                }


                <!-- =================================================
                     REQUESTS BY WARD
                     ================================================= -->

                @if (selectedReport == "RequestsByWard")
                {
                    <div class="admin-report-results-header">

                        <div>

                            <h3>
                                Requests by Ward
                            </h3>

                            <p>
                                Distribution of service requests across wards.
                            </p>

                        </div>

                    </div>


                    if (!Model.RequestsByWard.Any())
                    {
                        <div class="admin-report-no-results">

                            <p>
                                No ward data is available for the
                                selected filters.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="admin-report-table-wrapper">

                            <table class="admin-report-table">

                                <thead>

                                    <tr>
                                        <th>Ward</th>
                                        <th>Ward Name</th>
                                        <th>Requests</th>
                                        <th>Percentage</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (
                                        var item in Model.RequestsByWard)
                                    {
                                        <tr>

                                            <td>
                                                Ward @item.WardNumber
                                            </td>

                                            <td>
                                                @item.WardName
                                            </td>

                                            <td>
                                                @item.RequestCount
                                            </td>

                                            <td>
                                                @item.Percentage%
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                }


                <!-- =================================================
                     REQUESTS BY STATUS
                     ================================================= -->

                @if (selectedReport == "RequestsByStatus")
                {
                    <div class="admin-report-results-header">

                        <div>

                            <h3>
                                Requests by Status
                            </h3>

                            <p>
                                Current distribution of service request statuses.
                            </p>

                        </div>

                    </div>


                    if (!Model.RequestsByStatus.Any())
                    {
                        <div class="admin-report-no-results">

                            <p>
                                No status data is available for the
                                selected filters.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="admin-report-table-wrapper">

                            <table class="admin-report-table">

                                <thead>

                                    <tr>
                                        <th>Status</th>
                                        <th>Requests</th>
                                        <th>Percentage</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (
                                        var item in Model.RequestsByStatus)
                                    {
                                        <tr>

                                            <td>
                                                @item.Status
                                            </td>

                                            <td>
                                                @item.RequestCount
                                            </td>

                                            <td>
                                                @item.Percentage%
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                }


                <!-- =================================================
                     REQUESTS BY PRIORITY
                     ================================================= -->

                @if (selectedReport == "RequestsByPriority")
                {
                    <div class="admin-report-results-header">

                        <div>

                            <h3>
                                Requests by Priority
                            </h3>

                            <p>
                                Distribution of requests according to
                                service priority.
                            </p>

                        </div>

                    </div>


                    if (!Model.RequestsByPriority.Any())
                    {
                        <div class="admin-report-no-results">

                            <p>
                                No priority data is available for the
                                selected filters.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="admin-report-table-wrapper">

                            <table class="admin-report-table">

                                <thead>

                                    <tr>
                                        <th>Priority</th>
                                        <th>Requests</th>
                                        <th>Percentage</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (
                                        var item in Model.RequestsByPriority)
                                    {
                                        <tr>

                                            <td>
                                                @item.Priority
                                            </td>

                                            <td>
                                                @item.RequestCount
                                            </td>

                                            <td>
                                                @item.Percentage%
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                }


                <!-- =================================================
                     TECHNICIAN PERFORMANCE
                     ================================================= -->

                @if (selectedReport == "TechnicianPerformance")
                {
                    <div class="admin-report-results-header">

                        <div>

                            <h3>
                                Technician Performance
                            </h3>

                            <p>
                                Overview of technician workload and
                                completion performance.
                            </p>

                        </div>

                    </div>


                    if (!Model.TechnicianPerformance.Any())
                    {
                        <div class="admin-report-no-results">

                            <p>
                                No technician performance data is available
                                for the selected filters.
                            </p>

                        </div>
                    }
                    else
                    {
                        <div class="admin-report-table-wrapper">

                            <table class="admin-report-table">

                                <thead>

                                    <tr>
                                        <th>Technician</th>
                                        <th>Total Requests</th>
                                        <th>Completed</th>
                                        <th>Active</th>
                                        <th>Completion Rate</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (
                                        var item in Model.TechnicianPerformance)
                                    {
                                        <tr>

                                            <td>
                                                @item.TechnicianName
                                            </td>

                                            <td>
                                                @item.TotalRequests
                                            </td>

                                            <td>
                                                @item.CompletedRequests
                                            </td>

                                            <td>
                                                @item.ActiveRequests
                                            </td>

                                            <td>
                                                @item.CompletionRate%
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                }


                <!-- =================================================
                     SERVICE RESOLUTION PERFORMANCE
                     ================================================= -->

                @if (selectedReport == "ServiceResolutionPerformance")
                {
                    <div class="admin-report-results-header">

                        <div>

                            <h3>
                                Service Resolution Performance
                            </h3>

                            <p>
                                Measures how efficiently service requests
                                are resolved.
                            </p>

                        </div>

                    </div>


                    <!-- RESOLUTION METRICS -->

                    <div class="admin-resolution-metrics">

                        <div class="admin-resolution-metric">

                            <span class="admin-resolution-metric-label">
                                Average Resolution Time
                            </span>

                            <strong>
                                @Model.AverageResolutionDays days
                            </strong>

                        </div>


                        <div class="admin-resolution-metric">

                            <span class="admin-resolution-metric-label">
                                Resolved Requests
                            </span>

                            <strong>
                                @Model.ResolvedRequests
                            </strong>

                        </div>


                        <div class="admin-resolution-metric">

                            <span class="admin-resolution-metric-label">
                                Resolution Rate
                            </span>

                            <strong>
                                @Model.ResolutionRate%
                            </strong>

                        </div>


                        <div class="admin-resolution-metric">

                            <span class="admin-resolution-metric-label">
                                Open Over 7 Days
                            </span>

                            <strong>
                                @Model.OpenOverSevenDays
                            </strong>

                        </div>

                    </div>


                    <!-- CATEGORY RESOLUTION -->

                    <div class="admin-report-subsection">

                        <h4>
                            Resolution Performance by Category
                        </h4>

                        <p>
                            Average time taken to resolve completed
                            requests by category.
                        </p>


                        @if (!Model.CategoryResolutionPerformance.Any())
                        {
                            <div class="admin-report-no-results">

                                <p>
                                    No resolution performance data is
                                    available for the selected filters.
                                </p>

                            </div>
                        }
                        else
                        {
                            <div class="admin-report-table-wrapper">

                                <table class="admin-report-table">

                                    <thead>

                                        <tr>
                                            <th>Category</th>
                                            <th>Completed Requests</th>
                                            <th>Average Resolution</th>
                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (
                                            var item in Model.CategoryResolutionPerformance)
                                        {
                                            <tr>

                                                <td>
                                                    @item.CategoryName
                                                </td>

                                                <td>
                                                    @item.CompletedRequests
                                                </td>

                                                <td>
                                                    @item.AverageResolutionDays days
                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }

                    </div>

                }

            </div>


            <!-- =================================================
                 FOOTER
                 ================================================= -->

            <div class="admin-reports-footer">

                <a href="@Url.Action(
                    "Index",
                    "AdministratorDashboard")"
                   class="admin-back-button">

                    Back to Dashboard

                </a>

            </div>

        </div>

    </div>

</div>
