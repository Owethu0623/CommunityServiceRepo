@model IEnumerable<CommunityServiceProject.Models.Request>

@{
    ViewBag.Title = "Manage Requests";
}

<div class="admin-request-page">

    <div class="admin-request-card">

        <div class="admin-request-header">
            <h2>Manage Maintenance Requests</h2>
            <p>Review and manage submitted citizen requests.</p>
        </div>

        <!-- Request Filters -->
        <div class="admin-request-filters">

            @using (Html.BeginForm("Index", "AdministratorRequests", FormMethod.Get))
            {
                <div class="admin-filter-row">

                    <div class="admin-filter-group">
                        <label for="search">Search</label>

                        <input type="text"
                               id="search"
                               name="search"
                               value="@ViewBag.Search"
                               placeholder="Search request title..." />
                    </div>


                    <div class="admin-filter-group">
                        <label for="status">Status</label>

                        <select id="status" name="status">
                            <option value="">All Statuses</option>

                            @foreach (var item in Enum.GetValues(
                                typeof(CommunityServiceProject.Models.RequestStatus)))
                            {
                                <option value="@item"
                                        @(ViewBag.Status != null && ViewBag.Status.ToString() == item.ToString() ? "selected" : "")>
                                    @item
                                </option>
                            }

                        </select>
                    </div>


                    <div class="admin-filter-group">
                        <label for="categoryId">Category</label>

                        @Html.DropDownList(
                            "categoryId",
                            (SelectList)ViewBag.Categories,
                            "All Categories"
                        )
                    </div>


                    <div class="admin-filter-group">
                        <label for="sortOrder">Sort By</label>

                        <select id="sortOrder" name="sortOrder">

                            <option value=""
                                    @(ViewBag.SortOrder == null ? "selected" : "")>
                                Newest First
                            </option>

                            <option value="oldest"
                                    @(ViewBag.SortOrder == "oldest" ? "selected" : "")>
                                Oldest First
                            </option>

                        </select>
                    </div>

                </div>


                <div class="admin-filter-actions">

                    <button type="submit"
                            class="admin-filter-button">
                        Apply Filters
                    </button>

                    <a href="@Url.Action("Index", "AdministratorRequests")"
                       class="admin-clear-filter-button">
                        Clear Filters
                    </a>

                </div>
            }

        </div>


        @if (!Model.Any())
        {
            <div class="admin-no-requests">
                <p>No maintenance requests match your search or filters.</p>
            </div>
        }
        else
        {
            <div class="admin-request-table-wrapper">

                <table class="admin-request-table">

                    <thead>
                        <tr>
                            <th>Reference</th>
                            <th>Title</th>
                            <th>Citizen Information</th>
                            <th>Category</th>
                            <th>Date Submitted</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var request in Model)
                        {
                            <tr>

                                <td>
                                    #@request.RequestID
                                </td>

                                <td>
                                    @request.Title
                                </td>

                                <td>
                                    @request.Citizen.FirstName
                                    @request.Citizen.LastName
                                </td>

                                <td>
                                    @request.Category.CategoryName
                                </td>

                                <td>
                                    @request.DateSubmitted.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @request.Status
                                </td>

                                <td>
                                    <a href="@Url.Action(
                                        "Details",
                                        "AdministratorRequests",
                                        new { id = request.RequestID }
                                    )"
                                       class="admin-view-button">
                                        Review
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }


        <div class="admin-request-footer">

            <a href="@Url.Action(
                "Index",
                "AdministratorDashboard"
            )"
               class="admin-back-button">
                Back to Dashboard
            </a>

        </div>

    </div>

</div>