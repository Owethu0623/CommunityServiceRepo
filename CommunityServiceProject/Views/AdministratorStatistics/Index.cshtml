@{
    ViewBag.Title = "Statistics";
}

<div class="admin-statistics-page">

    <div class="admin-statistics-card">

        <!-- Header -->
        <div class="admin-statistics-header">

            <h2>
                Statistics
            </h2>

            <p>
                Overview of community service requests and citizen activity.
            </p>

        </div>


        <div class="admin-statistics-content">

            <!-- =====================================================
                 REQUEST STATISTICS
                 ===================================================== -->

            <div class="admin-statistics-section">

                <h3>
                    Request Statistics
                </h3>


                <div class="admin-statistics-summary-grid">

                    <!-- Total Requests -->
                    <div class="admin-statistics-summary-card">

                        <span class="admin-statistics-summary-label">
                            Total Requests
                        </span>

                        <span class="admin-statistics-summary-number">
                            @ViewBag.TotalRequests
                        </span>

                    </div>


                    <!-- Pending -->
                    <div class="admin-statistics-summary-card">

                        <span class="admin-statistics-summary-label">
                            Pending
                        </span>

                        <span class="admin-statistics-summary-number">
                            @ViewBag.PendingRequests
                        </span>

                    </div>


                    <!-- Under Review -->
                    <div class="admin-statistics-summary-card">

                        <span class="admin-statistics-summary-label">
                            Under Review
                        </span>

                        <span class="admin-statistics-summary-number">
                            @ViewBag.UnderReviewRequests
                        </span>

                    </div>


                    <!-- Approved -->
                    <div class="admin-statistics-summary-card">

                        <span class="admin-statistics-summary-label">
                            Approved
                        </span>

                        <span class="admin-statistics-summary-number">
                            @ViewBag.ApprovedRequests
                        </span>

                    </div>


                    <!-- Assigned -->
                    <div class="admin-statistics-summary-card">

                        <span class="admin-statistics-summary-label">
                            Assigned
                        </span>

                        <span class="admin-statistics-summary-number">
                            @ViewBag.AssignedRequests
                        </span>

                    </div>


                    <!-- In Progress -->
                    <div class="admin-statistics-summary-card">

                        <span class="admin-statistics-summary-label">
                            In Progress
                        </span>

                        <span class="admin-statistics-summary-number">
                            @ViewBag.InProgressRequests
                        </span>

                    </div>


                    <!-- Completed -->
                    <div class="admin-statistics-summary-card">

                        <span class="admin-statistics-summary-label">
                            Completed
                        </span>

                        <span class="admin-statistics-summary-number">
                            @ViewBag.CompletedRequests
                        </span>

                    </div>


                    <!-- Rejected -->
                    <div class="admin-statistics-summary-card">

                        <span class="admin-statistics-summary-label">
                            Rejected
                        </span>

                        <span class="admin-statistics-summary-number">
                            @ViewBag.RejectedRequests
                        </span>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 REQUESTS BY CATEGORY
                 ===================================================== -->

            <div class="admin-statistics-section">

                <h3>
                    Requests by Category
                </h3>


                <div class="admin-statistics-category-list">

                    @foreach (var category in ViewBag.CategoryStatistics)
                    {
                        <div class="admin-statistics-category-row">

                            <span class="admin-statistics-category-name">
                                @category["CategoryName"]
                            </span>

                            <span class="admin-statistics-category-count">
                                @category["RequestCount"]
                            </span>

                        </div>
                    }

                </div>

            </div>


            <!-- =====================================================
                 CITIZEN OVERVIEW
                 ===================================================== -->

            <div class="admin-statistics-section">

                <h3>
                    Citizen Overview
                </h3>


                <div class="admin-statistics-citizen-grid">

                    <!-- Total Citizens -->
                    <div class="admin-statistics-citizen-card">

                        <span class="admin-statistics-summary-label">
                            Total Citizens
                        </span>

                        <span class="admin-statistics-summary-number">
                            @ViewBag.TotalCitizens
                        </span>

                    </div>


                    <!-- Active Citizens -->
                    <div class="admin-statistics-citizen-card">

                        <span class="admin-statistics-summary-label">
                            Active Citizens
                        </span>

                        <span class="admin-statistics-summary-number">
                            @ViewBag.ActiveCitizens
                        </span>

                    </div>


                    <!-- Citizens With Requests -->
                    <div class="admin-statistics-citizen-card">

                        <span class="admin-statistics-summary-label">
                            Citizens With Requests
                        </span>

                        <span class="admin-statistics-summary-number">
                            @ViewBag.CitizensWithRequests
                        </span>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 FOOTER
                 ===================================================== -->

            <div class="admin-statistics-footer">

                <a href="@Url.Action("Index", "AdministratorDashboard")"
                   class="admin-back-button">

                    Back to Dashboard

                </a>

            </div>

        </div>

    </div>

</div>