
@model CommunityServiceProject.Models.Appeal

@{
    ViewBag.Title = "Review Appeal";

    var daysOpen = ViewBag.DaysOpen ?? 0;
}

<div class="appeal-review-page">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="appeal-review-header">

        <div>
            <h2>APPEAL REVIEW</h2>

            <p>
                Review the citizen's account appeal and determine
                the appropriate outcome.
            </p>
        </div>

        <div class="appeal-reference">
            @Model.ReferenceNumber
        </div>

    </div>


    <!-- =====================================================
         MAIN CONTENT
         ===================================================== -->

    <div class="appeal-review-grid">


        <!-- =================================================
             LEFT COLUMN
             ================================================= -->

        <div>


            <!-- =============================================
                 CITIZEN / ACCOUNT INFORMATION
                 ============================================= -->

            <div class="review-card">

                <div class="review-card-title">
                    Citizen & Account Information
                </div>

                <div class="review-row">

                    <span class="review-label">
                        Citizen
                    </span>

                    <span class="review-value">
                        @(Model.Citizen != null
                            ? Model.Citizen.FirstName + " " +
                              Model.Citizen.LastName
                            : "Unknown Citizen")
                    </span>

                </div>

                <div class="review-row">

                    <span class="review-label">
                        Account Status
                    </span>

                    <span class="review-value status-warning">
                        @(Model.Citizen != null
                            ? Model.Citizen.AccountStatus.ToString()
                            : "Unknown")
                    </span>

                </div>

                <div class="review-row">

                    <span class="review-label">
                        Appeal Status
                    </span>

                    <span class="review-value">

                        <span class="status-badge status-under-review">
                            @Model.Status
                        </span>

                    </span>

                </div>

            </div>


            <!-- =============================================
                 RESTRICTION INFORMATION
                 ============================================= -->

            <div class="review-card">

                <div class="review-card-title">
                    Account Restriction
                </div>

                <div class="review-row">

                    <span class="review-label">
                        Restriction Type
                    </span>

                    <span class="review-value">
                        @(Model.Restriction != null
                            ? Model.Restriction.RestrictionType
                            : "Not available")
                    </span>

                </div>

                <div class="review-row">

                    <span class="review-label">
                        Restriction Date
                    </span>

                    <span class="review-value">
                        @(Model.Restriction != null
                            ? Model.Restriction.DateStarted
                                .ToString("dd MMM yyyy")
                            : "-")
                    </span>

                </div>

                <div class="review-row">

                    <span class="review-label">
                        Restriction Reason
                    </span>

                    <span class="review-value review-long-value">
                        @(Model.Restriction != null
                            ? Model.Restriction.Reason
                            : "Not available")
                    </span>

                </div>

            </div>


            <!-- =============================================
                 APPEAL INFORMATION
                 ============================================= -->

            <div class="review-card">

                <div class="review-card-title">
                    Appeal Information
                </div>

                <div class="review-row">

                    <span class="review-label">
                        Submitted
                    </span>

                    <span class="review-value">
                        @Model.DateSubmitted.ToString(
                            "dd MMM yyyy, HH:mm")
                    </span>

                </div>

                <div class="review-row">

                    <span class="review-label">
                        Days Open
                    </span>

                    <span class="review-value">
                        @daysOpen
                    </span>

                </div>

                @if (Model.DateReviewed.HasValue)
                {
                    <div class="review-row">

                        <span class="review-label">
                            Review Started
                        </span>

                        <span class="review-value">
                            @Model.DateReviewed.Value.ToString(
                                "dd MMM yyyy, HH:mm")
                        </span>

                    </div>
                }

            </div>

        </div>


        <!-- =================================================
             RIGHT COLUMN
             ================================================= -->

        <div>


            <!-- =============================================
         APPEAL REASON
         ============================================= -->

            <div class="review-card">

                <div class="review-card-title">
                    Appeal Reason
                </div>

                <div class="reason-box">
                    @Model.Reason
                </div>

            </div>


            <!-- =============================================
         SUPPORTING DOCUMENT
         ============================================= -->

            <div class="review-card">

                <div class="review-card-title">
                    Supporting Document
                </div>

                @if (!string.IsNullOrWhiteSpace(
                    Model.SupportingDocumentPath))
                {
                    <a href="@Url.Content(
                        Model.SupportingDocumentPath)"
                       target="_blank"
                       class="document-button">

                        <span class="glyphicon glyphicon-file"></span>

                        View Supporting Document

                    </a>
                }
                else
                {
                    <div class="no-document">
                        No supporting document was provided.
                    </div>
                }

            </div>

            
            <!-- =============================================
         ADMINISTRATOR DECISION
         ============================================= -->

            <div class="review-card decision-card">

                <div class="review-card-title">
                    Administrator Decision
                </div>

                <p class="decision-description">
                    Select the appropriate outcome for this appeal
                    and provide the reason for your decision.
                </p>


                @using (Html.BeginForm(
                    "Review",
                    "Appeals",
                    FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    @Html.HiddenFor(
                        m => m.AppealID
                    )


                    <!-- =============================================
                 APPROVE
                 ============================================= -->

                    <label class="decision-option">

                        <input type="radio"
                               name="decision"
                               value="Approved"
                               required />

                        <span class="decision-option-content">

                            <span class="decision-option-title">
                                Approve Appeal
                            </span>

                            <span class="decision-option-description">
                                Remove the account restriction and
                                restore the citizen account to Active.
                            </span>

                        </span>

                    </label>


                    <!-- =============================================
                 REJECT
                 ============================================= -->

                    <label class="decision-option">

                        <input type="radio"
                               name="decision"
                               value="Rejected" />

                        <span class="decision-option-content">

                            <span class="decision-option-title">
                                Reject Appeal
                            </span>

                            <span class="decision-option-description">
                                Keep the existing account restriction
                                active.
                            </span>

                        </span>

                    </label>


                    <!-- =============================================
                 DECISION REASON
                 ============================================= -->

                    <div class="decision-reason-group">

                        <label for="decisionReason">
                            Decision Reason <span class="required">*</span>
                        </label>

                        <textarea id="decisionReason"
                                  name="decisionReason"
                                  class="decision-reason-input"
                                  maxlength="2000"
                                  required
                                  placeholder="Enter the reason for your decision..."></textarea>

                        <div class="decision-help">
                            Provide a clear reason explaining the administrator's decision.
                        </div>

                        @Html.ValidationMessage(
                            "decisionReason",
                            "",
                            new { @class = "field-validation-error" }
                        )

                    </div>


                    <!-- =============================================
                 SUBMIT
                 ============================================= -->

                    <button type="submit"
                            class="decision-submit-button">

                        <span class="glyphicon glyphicon-ok"></span>

                        Submit Decision

                    </button>

                }

            </div>
            



        </div>

    </div>


    <!-- =====================================================
         NAVIGATION
         ===================================================== -->

    <div class="review-navigation">

        <a href="@Url.Action(
            "AdminIndex",
            "Appeals")"
           class="navigation-button secondary">

            <span class="glyphicon glyphicon-arrow-left"></span>

            Back to Account Appeals

        </a>

    </div>

</div>


<style>

    /* =========================================================
       PAGE
       ========================================================= */

    .appeal-review-page {
        max-width: 1250px;
        margin: 0 auto;
        padding: 30px 25px 45px;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .appeal-review-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .appeal-review-header h2 {
        margin: 0 0 6px;
        font-size: 26px;
        font-weight: 700;
    }

    .appeal-review-header p {
        margin: 0;
        color: #6b7280;
        font-size: 13px;
    }

    .appeal-reference {
        padding: 10px 15px;
        background: #f3f6ff;
        border: 1px solid #d8e0f7;
        border-radius: 8px;
        color: #2f5bea;
        font-size: 14px;
        font-weight: 700;
    }


    /* =========================================================
       GRID
       ========================================================= */

    .appeal-review-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }


    /* =========================================================
       CARDS
       ========================================================= */

    .review-card {
        background: #ffffff;
        border: 1px solid #e2e7ee;
        border-radius: 11px;
        padding: 21px;
        margin-bottom: 20px;
        box-shadow: 0 5px 16px rgba(15, 23, 42, 0.05);
    }

    .review-card-title {
        margin-bottom: 17px;
        font-size: 14px;
        font-weight: 700;
        color: #1f2937;
    }


    /* =========================================================
       ROWS
       ========================================================= */

    .review-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 10px 0;
        border-bottom: 1px solid #edf0f4;
        font-size: 13px;
    }

    .review-row:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .review-label {
        color: #6b7280;
        min-width: 130px;
    }

    .review-value {
        text-align: right;
        font-weight: 600;
        color: #374151;
    }

    .review-long-value {
        max-width: 65%;
        line-height: 1.5;
    }

    .status-warning {
        color: #a15c00;
    }


    /* =========================================================
       STATUS
       ========================================================= */

    .status-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .status-under-review {
        background: #eaf2ff;
        color: #2451b2;
    }


    /* =========================================================
       APPEAL REASON
       ========================================================= */

    .reason-box {
        padding: 16px;
        min-height: 170px;
        background: #f8fafc;
        border: 1px solid #e7ebf1;
        border-radius: 9px;
        color: #374151;
        font-size: 13px;
        line-height: 1.7;
        white-space: pre-line;
    }


    /* =========================================================
       SUPPORTING DOCUMENT
       ========================================================= */

    .document-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        min-height: 45px;
        border-radius: 8px;
        background: #f3f6ff;
        border: 1px solid #d8e0f7;
        color: #2f5bea;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .document-button:hover,
    .document-button:focus {
        background: #eaf0ff;
        color: #2449c7;
        text-decoration: none;
    }

    .no-document {
        padding: 14px;
        border-radius: 8px;
        background: #f8fafc;
        color: #8b93a1;
        font-size: 12px;
        text-align: center;
    }


    /* =========================================================
       DECISION PLACEHOLDER
       ========================================================= */

    .decision-card {
        margin-bottom: 0;
    }

    .decision-description {
        margin-bottom: 15px;
        color: #6b7280;
        font-size: 12px;
        line-height: 1.6;
    }

    .decision-placeholder {
        padding: 15px;
        background: #f8fafc;
        border: 1px solid #e7ebf1;
        border-radius: 9px;
    }

    .decision-placeholder > div {
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .decision-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #eaf2ff;
        color: #2f5bea;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .decision-placeholder strong {
        display: block;
        margin-bottom: 4px;
        color: #374151;
        font-size: 12px;
    }

    .decision-placeholder p {
        margin: 0;
        color: #6b7280;
        font-size: 11px;
        line-height: 1.5;
    }


    /* =========================================================
       NAVIGATION
       ========================================================= */

    .review-navigation {
        display: flex;
        gap: 10px;
        margin-top: 5px;
    }

    .navigation-button {
        min-height: 43px;
        padding: 10px 16px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none !important;
        transition: all 0.2s ease;
    }

    .navigation-button.secondary {
        background: #ffffff;
        border: 1px solid #d8dde5;
        color: #4b5563;
    }

    .navigation-button.secondary:hover,
    .navigation-button.secondary:focus {
        background: #f8fafc;
        color: #1f2937;
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 800px) {

        .appeal-review-page {
            padding: 22px 15px 35px;
        }

        .appeal-review-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .appeal-review-grid {
            grid-template-columns: 1fr;
        }

    }

    @@media (max-width: 576px) {

        .appeal-review-header h2 {
            font-size: 22px;
        }

        .review-row {
            flex-direction: column;
            gap: 4px;
        }

        .review-value {
            text-align: left;
        }

        .review-long-value {
            max-width: 100%;
        }

        .review-navigation {
            flex-direction: column;
        }

        .navigation-button {
            width: 100%;
        }

    }
    /* =========================================================
   DECISION FORM
   ========================================================= */
    .decision-option {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 14px;
        margin-bottom: 10px;
        border: 1px solid #e1e6ed;
        border-radius: 9px;
        background: #ffffff;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .decision-option:hover {
        background: #f8fafc;
        border-color: #cbd5e1;
    }

    .decision-option input[type="radio"] {
        margin-top: 3px;
        flex-shrink: 0;
    }

    .decision-option-content {
        display: block;
    }

    .decision-option-title {
        display: block;
        margin-bottom: 3px;
        color: #374151;
        font-size: 13px;
        font-weight: 700;
    }

    .decision-option-description {
        display: block;
        color: #6b7280;
        font-size: 11px;
        line-height: 1.5;
    }

    .decision-reason-group {
        margin-top: 20px;
    }

        .decision-reason-group label {
            display: block;
            margin-bottom: 8px;
            color: #374151;
            font-size: 12px;
            font-weight: 700;
        }

        .decision-reason-group .required {
            color: #b42318;
        }

    .decision-reason-input {
        width: 100%;
        min-height: 120px;
        padding: 12px;
        border: 1px solid #d7dce5;
        border-radius: 8px;
        resize: vertical;
        font-size: 13px;
        line-height: 1.6;
        box-shadow: none;
    }

        .decision-reason-input:focus {
            outline: none;
            border-color: #2f5bea;
            box-shadow: 0 0 0 3px rgba(47, 91, 234, 0.10);
        }

    .decision-help {
        margin-top: 6px;
        color: #8b93a1;
        font-size: 10px;
    }

    .decision-submit-button {
        width: 100%;
        min-height: 45px;
        margin-top: 18px;
        border: none;
        border-radius: 8px;
        background: #2f5bea;
        color: #ffffff;
        font-size: 13px;
        font-weight: 700;
        transition: all 0.2s ease;
    }

        .decision-submit-button:hover,
        .decision-submit-button:focus {
            background: #2449c7;
            color: #ffffff;
            transform: translateY(-1px);
        }


</style>
