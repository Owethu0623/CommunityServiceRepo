@model CommunityServiceProject.Models.Citizen

@{
    ViewBag.Title = "Citizen Dashboard";
}

<div class="citizen-dashboard">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="dashboard-header">

        <h2>
            COMMUNITY SERVICE PLATFORM
        </h2>

        <p>
            Citizen Dashboard
        </p>

    </div>


    <!-- =====================================================
         WELCOME
         ===================================================== -->

    <div class="dashboard-welcome">

        <h2>
            Welcome back, @Session["CitizenName"]
        </h2>

        <p>
            Manage your service requests and account information.
        </p>

    </div>


    <!-- =====================================================
         REQUEST STATISTICS
         ===================================================== -->

    <div class="dashboard-stats">

        <!-- Total Requests -->

        <div class="dashboard-stat-card">

            <h3>
                Total Requests
            </h3>

            <p class="dashboard-stat-value">
                @ViewBag.TotalRequests
            </p>

        </div>


        <!-- Assigned Requests -->

        <div class="dashboard-stat-card">

            <h3>
                Assigned Requests
            </h3>

            <p class="dashboard-stat-value">
                @ViewBag.AssignedRequests
            </p>

        </div>


        <!-- Completed Requests -->

        <div class="dashboard-stat-card">

            <h3>
                Completed Requests
            </h3>

            <p class="dashboard-stat-value">
                @ViewBag.CompletedRequests
            </p>

        </div>

    </div>


    <!-- =====================================================
         DASHBOARD CONTENT
         ===================================================== -->

    <div class="dashboard-content">


        <!-- =================================================
             NOTIFICATIONS
             ================================================= -->

        <div class="notifications">

            <h3>
                Latest Notifications
            </h3>

            @if (ViewBag.Notifications != null &&
                 ViewBag.Notifications.Count > 0)
            {
                foreach (string notification in ViewBag.Notifications)
                {
                    <div class="notification-item">

                        <span class="notification-icon">
                            🔔
                        </span>

                        <span class="notification-message">
                            @notification
                        </span>

                    </div>
                }
            }
            else
            {
                <p>
                    You have no notifications at the moment.
                </p>
            }

        </div>


        <!-- =================================================
             SUBMIT REQUEST
             ================================================= -->

        <div class="submit-request-section">

            <h3>
                Submit a Maintenance Request
            </h3>

            <a href="@Url.Action("Create", "Requests")"
               class="dashboard-button">

                Submit New Request

            </a>

        </div>


        <!-- =================================================
             QUICK ACCESS
             ================================================= -->

        <div class="quick-access">

            <h3>
                Quick Access
            </h3>


            <!-- Dashboard -->

            <div class="dashboard-menu">

                <a href="@Url.Action("Index", "CitizenDashboard")"
                   class="dashboard-button active">

                    Dashboard

                </a>


                <!-- My Requests -->

                <a href="@Url.Action("Index", "Requests")"
                   class="dashboard-button">

                    View My Requests

                </a>


                <!-- Track Request -->

                <a href="@Url.Action("Index", "Requests")"
                   class="dashboard-button">

                    Track Request Status

                </a>


                <!-- Update Profile -->

                <a href="@Url.Action("UpdateProfile", "Citizens")"
                   class="dashboard-button">

                    Update Profile

                </a>


                <!-- Account Compliance -->

                <a href="@Url.Action("Index", "CitizenCompliance")"
                   class="dashboard-button compliance">

                    Account Compliance

                </a>

            </div>

        </div>


        <!-- =================================================
             ACCOUNT STATUS
             ================================================= -->

        <div class="account-status">

            <h3>
                Account Status
            </h3>

            <p>
                @Model.AccountStatus
            </p>

        </div>


        <!-- =================================================
             LOGOUT
             ================================================= -->

        <div class="dashboard-menu">

            <a href="@Url.Action("Logout", "Login")"
               class="dashboard-button logout">

                Logout

            </a>

        </div>

    </div>

</div>