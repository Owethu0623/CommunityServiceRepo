
@model CommunityServiceProject.Models.Citizen

@{
    ViewBag.Title = "Citizen Dashboard";
}

<style>

    /* =========================================================
       PAGE
       ========================================================= */

    .citizen-dashboard-page {
        max-width: 1420px;
        margin: 0 auto;
        padding: 28px 24px 50px;
        color: #1f2937;
    }


    /* =========================================================
       TOP HEADER
       ========================================================= */

    .citizen-top-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 24px;
    }

    .citizen-header-content {
        min-width: 0;
    }

    .citizen-eyebrow {
        display: inline-block;
        margin-bottom: 7px;
        color: #0D5CC1;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.09em;
    }

    .citizen-top-header h1 {
        margin: 0 0 7px;
        color: #16324f;
        font-size: 30px;
        line-height: 1.2;
        font-weight: 760;
        letter-spacing: -0.025em;
    }

    .citizen-top-header p {
        margin: 0;
        max-width: 760px;
        color: #64748b;
        font-size: 14px;
        line-height: 1.6;
    }

    .citizen-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 10px 14px;
        background: #ffffff;
        border: 1px solid #dce4ee;
        border-radius: 10px;
        color: #475569;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
        box-shadow: 0 3px 12px rgba(15, 23, 42, 0.04);
    }

    .citizen-status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #18794e;
        box-shadow: 0 0 0 4px rgba(24, 121, 78, 0.09);
    }


    /* =========================================================
       MAIN LAYOUT
       ========================================================= */

    .citizen-layout {
        display: grid;
        grid-template-columns: 250px minmax(0, 1fr);
        gap: 22px;
        align-items: start;
    }


    /* =========================================================
       CITIZEN SIDEBAR
       ========================================================= */

    .citizen-sidebar {
        position: sticky;
        top: 20px;
        padding: 14px;
        background: #ffffff;
        border: 1px solid #dfe6ef;
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
    }

    .citizen-sidebar-brand {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 8px 9px 15px;
        margin-bottom: 8px;
        border-bottom: 1px solid #edf1f5;
    }

    .citizen-brand-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: linear-gradient(135deg, #0D5CC1, #094b9f);
        color: #ffffff;
        font-size: 16px;
        font-weight: 800;
        box-shadow: 0 5px 13px rgba(13, 92, 193, 0.18);
    }

    .citizen-brand-text {
        min-width: 0;
    }

    .citizen-brand-title {
        display: block;
        color: #16324f;
        font-size: 13px;
        font-weight: 800;
        line-height: 1.3;
    }

    .citizen-brand-subtitle {
        display: block;
        margin-top: 2px;
        color: #94a3b8;
        font-size: 10px;
        font-weight: 650;
    }


    /* =========================================================
       NAVIGATION SECTIONS
       ========================================================= */

    .citizen-nav-section {
        margin-top: 13px;
    }

    .citizen-nav-section-title {
        display: block;
        padding: 0 10px 7px;
        color: #94a3b8;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .citizen-nav {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .citizen-nav-link {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 42px;
        padding: 0 11px;
        border: 1px solid transparent;
        border-radius: 9px;
        color: #475569;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: background 0.16s ease, border-color 0.16s ease, color 0.16s ease, transform 0.16s ease;
    }

        .citizen-nav-link:hover {
            background: #f4f8fd;
            border-color: #d9e6f5;
            color: #0D5CC1;
            text-decoration: none;
            transform: translateX(1px);
        }

        .citizen-nav-link.active {
            background: #eef5ff;
            border-color: #d5e4f7;
            color: #0D5CC1;
        }

    .citizen-nav-icon {
        width: 25px;
        flex: 0 0 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }

    .citizen-nav-divider {
        height: 1px;
        margin: 10px 5px;
        background: #edf1f5;
    }


    /* =========================================================
       LOGOUT
       ========================================================= */

    .citizen-nav-link.logout {
        color: #b42318;
    }

        .citizen-nav-link.logout:hover {
            background: #fff4f3;
            border-color: #f2d2cf;
            color: #b42318;
        }


    /* =========================================================
       MAIN CONTENT
       ========================================================= */

    .citizen-main {
        min-width: 0;
    }


    /* =========================================================
       WELCOME BANNER
       ========================================================= */

    .citizen-welcome {
        position: relative;
        overflow: hidden;
        margin-bottom: 20px;
        padding: 26px 28px;
        background: linear-gradient( 135deg, #0D5CC1 0%, #0a53ad 55%, #094b9f 100% );
        border-radius: 14px;
        color: #ffffff;
        box-shadow: 0 11px 28px rgba(13, 92, 193, 0.17);
    }

        .citizen-welcome::after {
            content: "";
            position: absolute;
            top: -90px;
            right: -70px;
            width: 240px;
            height: 240px;
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 50%;
            box-shadow: 0 0 0 28px rgba(255, 255, 255, 0.03), 0 0 0 56px rgba(255, 255, 255, 0.025);
        }

    .citizen-welcome-content {
        position: relative;
        z-index: 1;
        max-width: 760px;
    }

    .citizen-welcome-label {
        display: block;
        margin-bottom: 6px;
        color: rgba(255, 255, 255, 0.76);
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.09em;
    }

    .citizen-welcome h2 {
        margin: 0 0 7px;
        font-size: 23px;
        font-weight: 760;
        letter-spacing: -0.015em;
    }

    .citizen-welcome p {
        margin: 0;
        color: rgba(255, 255, 255, 0.91);
        font-size: 13px;
        line-height: 1.65;
    }


    /* =========================================================
       STATISTICS
       ========================================================= */

    .citizen-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 20px;
    }

    .citizen-stat-card {
        padding: 18px;
        background: #ffffff;
        border: 1px solid #dfe6ef;
        border-radius: 14px;
        box-shadow: 0 6px 19px rgba(15, 23, 42, 0.04);
    }

    .citizen-stat-label {
        margin-bottom: 8px;
        color: #64748b;
        font-size: 11px;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .citizen-stat-value {
        margin: 0;
        color: #16324f;
        font-size: 27px;
        line-height: 1;
        font-weight: 800;
    }

    .citizen-stat-description {
        margin-top: 8px;
        color: #94a3b8;
        font-size: 11px;
    }


    /* =========================================================
       SECTION
       ========================================================= */

    .citizen-section {
        margin-bottom: 20px;
        padding: 22px;
        background: #ffffff;
        border: 1px solid #dfe6ef;
        border-radius: 14px;
        box-shadow: 0 6px 19px rgba(15, 23, 42, 0.04);
    }

    .citizen-section-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 17px;
    }

    .citizen-section-header-left {
        min-width: 0;
    }

    .citizen-section-header h3 {
        margin: 0 0 5px;
        color: #16324f;
        font-size: 17px;
        font-weight: 760;
    }

    .citizen-section-header p {
        margin: 0;
        color: #64748b;
        font-size: 12px;
        line-height: 1.55;
    }

    .citizen-section-tag {
        flex-shrink: 0;
        padding: 6px 9px;
        background: #f5f8fc;
        border: 1px solid #e0e7ef;
        border-radius: 7px;
        color: #64748b;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }


    /* =========================================================
       FEATURE GRID
       ========================================================= */

    .citizen-feature-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .citizen-feature-card {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
        min-height: 80px;
        padding: 14px;
        background: #fbfcfe;
        border: 1px solid #e3e9f1;
        border-radius: 11px;
        color: inherit;
        text-decoration: none;
        transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
    }

        .citizen-feature-card:hover {
            background: #ffffff;
            border-color: #c9dbf2;
            box-shadow: 0 9px 23px rgba(15, 23, 42, 0.07);
            transform: translateY(-2px);
            text-decoration: none;
        }

    .citizen-feature-icon {
        width: 43px;
        height: 43px;
        flex: 0 0 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #eef5ff;
        border: 1px solid #d7e5f7;
        color: #0D5CC1;
        font-size: 16px;
        font-weight: 800;
    }

    .citizen-feature-text {
        min-width: 0;
    }

    .citizen-feature-title {
        display: block;
        margin-bottom: 4px;
        color: #25384d;
        font-size: 13px;
        font-weight: 760;
    }

    .citizen-feature-description {
        display: block;
        color: #7b8796;
        font-size: 11px;
        line-height: 1.45;
    }

    .citizen-feature-arrow {
        margin-left: auto;
        padding-left: 7px;
        color: #9aa8b8;
        font-size: 16px;
        transition: transform 0.16s ease, color 0.16s ease;
    }

    .citizen-feature-card:hover .citizen-feature-arrow {
        color: #0D5CC1;
        transform: translateX(2px);
    }


    /* =========================================================
       NOTIFICATIONS
       ========================================================= */

    .citizen-notifications {
        margin-bottom: 20px;
        padding: 20px;
        background: #ffffff;
        border: 1px solid #dfe6ef;
        border-radius: 14px;
        box-shadow: 0 6px 19px rgba(15, 23, 42, 0.04);
    }

        .citizen-notifications h3 {
            margin: 0 0 15px;
            padding-bottom: 11px;
            border-bottom: 1px solid #e8edf3;
            color: #16324f;
            font-size: 17px;
            font-weight: 760;
        }

    .citizen-notification-item {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        margin-bottom: 9px;
        padding: 12px 13px;
        background: #f8fafc;
        border: 1px solid #e6ebf1;
        border-left: 4px solid #0D5CC1;
        border-radius: 8px;
        transition: background 0.16s ease, border-color 0.16s ease;
    }

        .citizen-notification-item:hover {
            background: #f2f7fd;
            border-color: #d3deec;
        }

        .citizen-notification-item:last-child {
            margin-bottom: 0;
        }

    .citizen-notification-icon {
        flex-shrink: 0;
        width: 24px;
        color: #0D5CC1;
        font-size: 16px;
        line-height: 1.4;
        text-align: center;
    }

    .citizen-notification-message {
        min-width: 0;
        color: #465466;
        font-size: 12px;
        line-height: 1.55;
    }

    .citizen-notifications-empty {
        margin: 0;
        color: #7b8796;
        font-size: 12px;
        line-height: 1.55;
    }


    /* =========================================================
       QUICK ACCESS
       ========================================================= */

    .citizen-quick-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
    }

    .citizen-quick-action {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0 12px;
        border: 1px solid #d7e0eb;
        border-radius: 9px;
        background: #ffffff;
        color: #0D5CC1;
        font-size: 12px;
        font-weight: 750;
        text-decoration: none;
        transition: background 0.16s ease, border-color 0.16s ease, color 0.16s ease, transform 0.16s ease;
    }

        .citizen-quick-action:hover {
            background: #eef5ff;
            border-color: #c5d9f2;
            color: #094b9f;
            text-decoration: none;
            transform: translateY(-1px);
        }


    /* =========================================================
       ACCOUNT STATUS
       ========================================================= */

    .citizen-account-status {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 20px;
        padding: 18px 20px;
        background: #ffffff;
        border: 1px solid #dfe6ef;
        border-radius: 14px;
        box-shadow: 0 6px 19px rgba(15, 23, 42, 0.04);
    }

    .citizen-account-status-label {
        color: #64748b;
        font-size: 11px;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .citizen-account-status-value {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        background: #eef9f3;
        border: 1px solid #cce9d9;
        border-radius: 8px;
        color: #18794e;
        font-size: 11px;
        font-weight: 800;
    }

        .citizen-account-status-value::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #18794e;
        }


    /* =========================================================
       FOOTER / LOGOUT
       ========================================================= */

    .citizen-dashboard-footer {
        display: flex;
        justify-content: flex-end;
        margin-top: 3px;
    }

    .citizen-logout-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 18px;
        border: 1px solid #efc9c5;
        border-radius: 9px;
        background: #fff7f6;
        color: #b42318;
        font-size: 12px;
        font-weight: 750;
        text-decoration: none;
        transition: background 0.16s ease, border-color 0.16s ease, color 0.16s ease;
    }

        .citizen-logout-button:hover {
            background: #fff0ee;
            border-color: #eab7b1;
            color: #9f1f16;
            text-decoration: none;
        }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 1150px) {

        .citizen-layout {
            grid-template-columns: 220px minmax(0, 1fr);
        }

        .citizen-quick-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }


    @@media (max-width: 900px) {

        .citizen-layout {
            grid-template-columns: 1fr;
        }

        .citizen-sidebar {
            position: static;
        }

        .citizen-nav {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .citizen-nav-divider {
            display: none;
        }

        .citizen-nav-section {
            margin-top: 8px;
        }

        .citizen-top-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .citizen-status-pill {
            align-self: flex-start;
        }

        .citizen-stats {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }


    @@media (max-width: 680px) {

        .citizen-dashboard-page {
            padding: 20px 12px 35px;
        }

        .citizen-top-header h1 {
            font-size: 25px;
        }

        .citizen-welcome {
            padding: 22px;
        }

            .citizen-welcome h2 {
                font-size: 20px;
            }

        .citizen-section,
        .citizen-notifications {
            padding: 18px;
        }

        .citizen-feature-grid {
            grid-template-columns: 1fr;
        }

        .citizen-stats {
            grid-template-columns: 1fr;
        }

        .citizen-quick-grid {
            grid-template-columns: 1fr 1fr;
        }
    }


    @@media (max-width: 500px) {

        .citizen-nav {
            grid-template-columns: 1fr;
        }

        .citizen-quick-grid {
            grid-template-columns: 1fr;
        }

        .citizen-top-header h1 {
            font-size: 22px;
        }

        .citizen-status-pill {
            width: 100%;
            box-sizing: border-box;
        }

        .citizen-feature-card {
            min-height: 74px;
        }

        .citizen-account-status {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>


<div class="citizen-dashboard-page">


    <!-- =====================================================
         TOP HEADER
         ===================================================== -->

    <div class="citizen-top-header">

        <div class="citizen-header-content">

            <span class="citizen-eyebrow">
                Community Service Platform
            </span>

            <h1>
                Citizen Dashboard
            </h1>

            <p>
                Access municipal services, submit maintenance requests,
                track service progress and manage your citizen account.
            </p>

        </div>

        <div class="citizen-status-pill">

            <span class="citizen-status-dot"></span>

            Citizen Access

        </div>

    </div>


    <!-- =====================================================
         MAIN LAYOUT
         ===================================================== -->

    <div class="citizen-layout">


        <!-- =================================================
             SIDEBAR
             ================================================= -->

        <aside class="citizen-sidebar">


            <!-- BRAND -->

            <div class="citizen-sidebar-brand">

                <div class="citizen-brand-icon">
                    C
                </div>

                <div class="citizen-brand-text">

                    <span class="citizen-brand-title">
                        Citizen Portal
                    </span>

                    <span class="citizen-brand-subtitle">
                        Municipal Services
                    </span>

                </div>

            </div>


            <!-- =================================================
                 SERVICE ACCESS
                 ================================================= -->

            <div class="citizen-nav-section">

                <span class="citizen-nav-section-title">
                    Service Access
                </span>

                <nav class="citizen-nav">

                    <a href="@Url.Action("Index", "CitizenDashboard")"
                       class="citizen-nav-link active">

                        <span class="citizen-nav-icon">
                            ⌂
                        </span>

                        Dashboard

                    </a>


                    <a href="@Url.Action("Create", "Requests")"
                       class="citizen-nav-link">

                        <span class="citizen-nav-icon">
                            +
                        </span>

                        Submit Request

                    </a>


                    <a href="@Url.Action("Index", "Requests")"
                       class="citizen-nav-link">

                        <span class="citizen-nav-icon">
                            ▣
                        </span>

                        My Requests

                    </a>


                    <a href="@Url.Action("Index", "MunicipalServices")"
                       class="citizen-nav-link">

                        <span class="citizen-nav-icon">
                            □
                        </span>

                        Municipal Services

                    </a>

                </nav>

            </div>


            <!-- =================================================
                 ACCOUNT
                 ================================================= -->

            <div class="citizen-nav-section">

                <span class="citizen-nav-section-title">
                    My Account
                </span>

                <nav class="citizen-nav">

                    <a href="@Url.Action("UpdateProfile", "Citizens")"
                       class="citizen-nav-link">

                        <span class="citizen-nav-icon">
                            ♙
                        </span>

                        My Profile

                    </a>


                    <a href="@Url.Action("Index", "CitizenNotification")"
                       class="citizen-nav-link">

                        <span class="citizen-nav-icon">
                            🔔
                        </span>

                        Notifications

                    </a>


                    <a href="@Url.Action("Index", "CitizenCompliance")"
                       class="citizen-nav-link">

                        <span class="citizen-nav-icon">
                            ✓
                        </span>

                        Account Compliance

                    </a>

                </nav>

            </div>


            <!-- =================================================
                 OPPORTUNITIES
                 ================================================= -->

            <div class="citizen-nav-section">

                <span class="citizen-nav-section-title">
                    Opportunities
                </span>

                <nav class="citizen-nav">

                    <a href="@Url.Action("Index", "TechnicianOpportunity")"
                       class="citizen-nav-link">

                        <span class="citizen-nav-icon">
                            ⚒
                        </span>

                        Technician Opportunities

                    </a>

                </nav>

            </div>


            <div class="citizen-nav-divider"></div>


            <!-- =================================================
                 LOGOUT
                 ================================================= -->

            <a href="@Url.Action("Index", "Home")"
               class="citizen-nav-link logout">

                <span class="citizen-nav-icon">
                    ⇥
                </span>

                Logout

            </a>

        </aside>


        <!-- =================================================
             MAIN CONTENT
             ================================================= -->

        <main class="citizen-main">


            <!-- =================================================
                 WELCOME
                 ================================================= -->

            <section class="citizen-welcome">

                <div class="citizen-welcome-content">

                    <span class="citizen-welcome-label">
                        Citizen Service Workspace
                    </span>

                    <h2>
                        Welcome back, @Session["CitizenName"]
                    </h2>

                    <p>
                        Manage your municipal service requests, track progress,
                        access available services and keep your account information up to date.
                    </p>

                </div>

            </section>


            <!-- =================================================
                 REQUEST STATISTICS
                 ================================================= -->

            <div class="citizen-stats">


                <div class="citizen-stat-card">

                    <div class="citizen-stat-label">
                        Total Requests
                    </div>

                    <p class="citizen-stat-value">
                        @ViewBag.TotalRequests
                    </p>

                    <div class="citizen-stat-description">
                        Requests submitted
                    </div>

                </div>


                <div class="citizen-stat-card">

                    <div class="citizen-stat-label">
                        Assigned Requests
                    </div>

                    <p class="citizen-stat-value">
                        @ViewBag.AssignedRequests
                    </p>

                    <div class="citizen-stat-description">
                        Requests assigned for service
                    </div>

                </div>


                <div class="citizen-stat-card">

                    <div class="citizen-stat-label">
                        Completed Requests
                    </div>

                    <p class="citizen-stat-value">
                        @ViewBag.CompletedRequests
                    </p>

                    <div class="citizen-stat-description">
                        Requests completed
                    </div>

                </div>

            </div>


            <!-- =================================================
                 SERVICE OPERATIONS
                 ================================================= -->

            <section class="citizen-section">

                <div class="citizen-section-header">

                    <div class="citizen-section-header-left">

                        <h3>
                            Service Operations
                        </h3>

                        <p>
                            Submit new requests and access municipal services.
                        </p>

                    </div>

                    <span class="citizen-section-tag">
                        Services
                    </span>

                </div>


                <div class="citizen-feature-grid">


                    <a href="@Url.Action("Create", "Requests")"
                       class="citizen-feature-card">

                        <span class="citizen-feature-icon">
                            +
                        </span>

                        <span class="citizen-feature-text">

                            <span class="citizen-feature-title">
                                Submit Maintenance Request
                            </span>

                            <span class="citizen-feature-description">
                                Report potholes, water leaks, broken streetlights,
                                illegal dumping and other municipal issues.
                            </span>

                        </span>

                        <span class="citizen-feature-arrow">
                            →
                        </span>

                    </a>


                    <a href="@Url.Action("Index", "Requests")"
                       class="citizen-feature-card">

                        <span class="citizen-feature-icon">
                            ▣
                        </span>

                        <span class="citizen-feature-text">

                            <span class="citizen-feature-title">
                                My Requests
                            </span>

                            <span class="citizen-feature-description">
                                View your submitted requests and monitor their progress.
                            </span>

                        </span>

                        <span class="citizen-feature-arrow">
                            →
                        </span>

                    </a>


                    <a href="@Url.Action("Index", "MunicipalServices")"
                       class="citizen-feature-card">

                        <span class="citizen-feature-icon">
                            □
                        </span>

                        <span class="citizen-feature-text">

                            <span class="citizen-feature-title">
                                Municipal Services
                            </span>

                            <span class="citizen-feature-description">
                                Browse available municipal services and service information.
                            </span>

                        </span>

                        <span class="citizen-feature-arrow">
                            →
                        </span>

                    </a>


                    <a href="@Url.Action("Index", "CitizenCompliance")"
                       class="citizen-feature-card">

                        <span class="citizen-feature-icon">
                            ✓
                        </span>

                        <span class="citizen-feature-text">

                            <span class="citizen-feature-title">
                                Account Compliance
                            </span>

                            <span class="citizen-feature-description">
                                Review your account compliance and required information.
                            </span>

                        </span>

                        <span class="citizen-feature-arrow">
                            →
                        </span>

                    </a>

                </div>

            </section>


            <!-- =================================================
                 NOTIFICATIONS
                 ================================================= -->

            <section class="citizen-notifications">

                <h3>
                    Latest Notifications
                </h3>


                @if (ViewBag.Notifications != null &&
                     ViewBag.Notifications.Count > 0)
                {
                    foreach (string notification in ViewBag.Notifications)
                    {
                        <div class="citizen-notification-item">

                            <span class="citizen-notification-icon">
                                🔔
                            </span>

                            <span class="citizen-notification-message">
                                @notification
                            </span>

                        </div>
                    }
                }
                else
                {
                    <p class="citizen-notifications-empty">
                        You have no notifications at the moment.
                    </p>
                }


            </section>


            <!-- =================================================
                 QUICK ACCESS
                 ================================================= -->

            <section class="citizen-section">

                <div class="citizen-section-header">

                    <div class="citizen-section-header-left">

                        <h3>
                            Quick Access
                        </h3>

                        <p>
                            Frequently used citizen services.
                        </p>

                    </div>

                </div>


                <div class="citizen-quick-grid">

                    <a href="@Url.Action("Create", "Requests")"
                       class="citizen-quick-action">

                        Submit Request

                    </a>


                    <a href="@Url.Action("Index", "Requests")"
                       class="citizen-quick-action">

                        My Requests

                    </a>


                    <a href="@Url.Action("Index", "CitizenNotification")"
                       class="citizen-quick-action">

                        Notifications

                    </a>


                    <a href="@Url.Action("UpdateProfile", "Citizens")"
                       class="citizen-quick-action">

                        My Profile

                    </a>

                </div>

            </section>


            <!-- =================================================
                 ACCOUNT STATUS
                 ================================================= -->

            <div class="citizen-account-status">

                <span class="citizen-account-status-label">
                    Account Status
                </span>

                <span class="citizen-account-status-value">
                    @Model.AccountStatus
                </span>

            </div>


            <!-- =================================================
                 LOGOUT
                 ================================================= -->

            <div class="citizen-dashboard-footer">

                <a href="@Url.Action("Index", "Home")"
                   class="citizen-logout-button">

                    Logout

                </a>

            </div>

        </main>

    </div>

</div>

