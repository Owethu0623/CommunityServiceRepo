@model CommunityServiceProject.ViewModels.PaymentReceiptViewModel

@{
    ViewBag.Title = "Payment Receipt";
}

<style>

    .citizen-receipt-page {
        max-width: 900px;
        margin: 35px auto 55px;
        padding: 0 20px;
    }

    .receipt-card {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e1e7ef;
        border-radius: 14px;
        box-shadow: 0 8px 28px rgba(15, 23, 42, 0.07);
    }

    .receipt-header {
        padding: 30px 32px;
        background: linear-gradient(135deg, #0D5CC1, #094b9f);
        color: white;
    }

    .receipt-header-label {
        margin-bottom: 7px;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
        opacity: .82;
    }

    .receipt-header h1 {
        margin: 0 0 7px;
        font-size: 27px;
        font-weight: 800;
    }

    .receipt-header p {
        margin: 0;
        font-size: 13px;
        line-height: 1.6;
        opacity: .91;
    }

    .receipt-status {
        display: inline-flex;
        margin-top: 17px;
        padding: 7px 11px;
        border: 1px solid rgba(255,255,255,.3);
        border-radius: 7px;
        background: rgba(255,255,255,.12);
        font-size: 11px;
        font-weight: 800;
    }

    .receipt-amount {
        padding: 27px 32px;
        text-align: center;
        background: #f8fafc;
        border-bottom: 1px solid #e8edf3;
    }

    .receipt-amount-label {
        margin-bottom: 7px;
        color: #64748b;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .7px;
        text-transform: uppercase;
    }

    .receipt-amount-value {
        color: #16324f;
        font-size: 37px;
        font-weight: 850;
    }

    .receipt-section {
        padding: 24px 32px;
        border-bottom: 1px solid #edf0f4;
    }

    .receipt-section:last-child {
        border-bottom: none;
    }

    .receipt-section h2 {
        margin: 0 0 16px;
        color: #16324f;
        font-size: 16px;
        font-weight: 800;
    }

    .receipt-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
    }

    .receipt-detail {
        padding: 14px 16px;
        background: #f8fafc;
        border: 1px solid #e5eaf0;
        border-radius: 9px;
    }

    .receipt-label {
        display: block;
        margin-bottom: 5px;
        color: #718096;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .receipt-value {
        color: #172033;
        font-size: 13px;
        font-weight: 700;
        word-break: break-word;
    }

    .success-banner {
        margin: 24px 32px 0;
        padding: 15px 17px;
        border: 1px solid #bfe4cc;
        border-radius: 9px;
        background: #eaf7ef;
        color: #17663f;
        font-size: 13px;
        line-height: 1.55;
    }

    .receipt-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 20px;
    }

    .receipt-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 41px;
        padding: 0 17px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
    }

    .receipt-primary {
        background: #0D5CC1;
        border: 1px solid #0D5CC1;
        color: white;
    }

    .receipt-primary:hover {
        background: #094b9f;
        border-color: #094b9f;
        color: white;
        text-decoration: none;
    }

    .receipt-secondary {
        background: white;
        border: 1px solid #d0d5dd;
        color: #344054;
    }

    .receipt-secondary:hover {
        background: #f8fafc;
        color: #172033;
        text-decoration: none;
    }

    @@media print {

        .receipt-actions {
            display: none;
        }

        .citizen-receipt-page {
            margin: 0;
            padding: 0;
            max-width: none;
        }

        .receipt-card {
            box-shadow: none;
        }

    }

    @@media (max-width: 650px) {

        .citizen-receipt-page {
            padding: 0 12px 35px;
        }

        .receipt-header,
        .receipt-section {
            padding: 22px 20px;
        }

        .receipt-amount {
            padding: 24px 20px;
        }

        .receipt-grid {
            grid-template-columns: 1fr;
        }

        .success-banner {
            margin: 20px 20px 0;
        }

        .receipt-actions {
            flex-direction: column;
        }

        .receipt-button {
            width: 100%;
        }

    }

</style>


<div class="citizen-receipt-page">

    <div class="receipt-card">

        <div class="receipt-header">

            <div class="receipt-header-label">
                Municipal Payment Document
            </div>

            <h1>
                Payment Receipt
            </h1>

            <p>
                Official confirmation of your successful municipal payment.
            </p>

            <span class="receipt-status">
                Payment Successful
            </span>

        </div>


        <div class="receipt-amount">

            <div class="receipt-amount-label">
                Amount Paid
            </div>

            <div class="receipt-amount-value">
                R @Model.AmountPaid.ToString("N2")
            </div>

        </div>


        <div class="success-banner">

            Your payment has been successfully verified and recorded.
            Please retain this receipt for your records.

        </div>


        <div class="receipt-section">

            <h2>
                Receipt Information
            </h2>

            <div class="receipt-grid">

                <div class="receipt-detail">

                    <span class="receipt-label">
                        Receipt Number
                    </span>

                    <span class="receipt-value">
                        @Model.ReceiptNumber
                    </span>

                </div>

                <div class="receipt-detail">

                    <span class="receipt-label">
                        Issue Date
                    </span>

                    <span class="receipt-value">
                        @Model.IssueDate.ToString("dd MMM yyyy")
                    </span>

                </div>

                <div class="receipt-detail">

                    <span class="receipt-label">
                        Transaction Reference
                    </span>

                    <span class="receipt-value">
                        @Model.TransactionReference
                    </span>

                </div>

                <div class="receipt-detail">

                    <span class="receipt-label">
                        Payment Date
                    </span>

                    <span class="receipt-value">
                        @Model.PaymentDate.ToString("dd MMM yyyy, HH:mm")
                    </span>

                </div>

            </div>

        </div>


        <div class="receipt-section">

            <h2>
                Municipal Service
            </h2>

            <div class="receipt-grid">

                <div class="receipt-detail">

                    <span class="receipt-label">
                        Service
                    </span>

                    <span class="receipt-value">
                        @Model.ServiceName
                    </span>

                </div>

                <div class="receipt-detail">

                    <span class="receipt-label">
                        Request Reference
                    </span>

                    <span class="receipt-value">
                        @Model.RequestReference
                    </span>

                </div>

                <div class="receipt-detail">

                    <span class="receipt-label">
                        Invoice Number
                    </span>

                    <span class="receipt-value">
                        @Model.InvoiceNumber
                    </span>

                </div>

                <div class="receipt-detail">

                    <span class="receipt-label">
                        Payment Method
                    </span>

                    <span class="receipt-value">
                        @Model.PaymentMethod
                    </span>

                </div>

            </div>

        </div>


        <div class="receipt-section">

            <h2>
                Account Summary
            </h2>

            <div class="receipt-grid">

                <div class="receipt-detail">

                    <span class="receipt-label">
                        Invoice Amount
                    </span>

                    <span class="receipt-value">
                        R @Model.InvoiceAmount.ToString("N2")
                    </span>

                </div>

                <div class="receipt-detail">

                    <span class="receipt-label">
                        Remaining Balance
                    </span>

                    <span class="receipt-value">
                        R @Model.RemainingBalance.ToString("N2")
                    </span>

                </div>

                <div class="receipt-detail">

                    <span class="receipt-label">
                        Invoice Status
                    </span>

                    <span class="receipt-value">
                        @Model.InvoiceStatus
                    </span>

                </div>

                <div class="receipt-detail">

                    <span class="receipt-label">
                        Payment Status
                    </span>

                    <span class="receipt-value">
                        @Model.PaymentStatus
                    </span>

                </div>

            </div>

        </div>

    </div>


    <div class="receipt-actions">

        <button type="button"
                class="receipt-button receipt-primary"
                onclick="window.print();">
            Print Receipt
        </button>

        <a href="@Url.Action("FinancialStatement", "CitizenFinancial")"
           class="receipt-button receipt-secondary">
            View Financial Statement
        </a>

        <a href="@Url.Action("Index", "MunicipalServices")"
           class="receipt-button receipt-secondary">
            Back to Municipal Services
        </a>

    </div>

</div>