@model CommunityServiceProject.Models.Violation

@{
    ViewBag.Title = "Issue Warning";
}

<div class="admin-citizen-details-page">

    <div class="admin-citizen-details-card">

        <div class="admin-citizen-details-header">
            <h2>Issue Warning</h2>
            <p>Issue a warning for this confirmed violation.</p>
        </div>

        <div class="admin-citizen-details-content">

            <!-- VIOLATION INFORMATION -->
            <div class="admin-citizen-details-section">

                <h3>Violation Information</h3>

                <div class="admin-citizen-details-row">
                    <div class="admin-citizen-details-label">
                        Violation ID
                    </div>

                    <div>
                        @Model.ViolationID
                    </div>
                </div>

                <div class="admin-citizen-details-row">
                    <div class="admin-citizen-details-label">
                        Violation Type
                    </div>

                    <div>
                        @Model.ViolationType
                    </div>
                </div>

                <div class="admin-citizen-details-row">
                    <div class="admin-citizen-details-label">
                        Description
                    </div>

                    <div>
                        @Model.Description
                    </div>
                </div>

                <div class="admin-citizen-details-row">
                    <div class="admin-citizen-details-label">
                        Date Confirmed
                    </div>

                    <div>
                        @Model.DateConfirmed.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>

                <div class="admin-citizen-details-row">
                    <div class="admin-citizen-details-label">
                        Status
                    </div>

                    <div class="admin-citizen-status">
                        @Model.Status
                    </div>
                </div>

            </div>

            <!-- WARNING FORM -->
            <div class="admin-citizen-details-section">

                <h3>Warning Information</h3>

                @using (Html.BeginForm(
                    "IssueWarning",
                    "CitizenManagement",
                    FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="violationID"
                           value="@Model.ViolationID" />

                    <div class="admin-citizen-details-row">

                        <div class="admin-citizen-details-label">
                            Warning Reason
                        </div>

                        <div style="width: 100%;">

                            <textarea name="warningReason"
                                      rows="6"
                                      maxlength="2000"
                                      style="width: 100%;"
                                      required></textarea>

                        </div>

                    </div>

                    <div class="admin-citizen-management-actions">

                        <button type="submit"
                                class="admin-citizen-action-button">
                            Issue Warning
                        </button>

                        <a href="@Url.Action(
                            "Compliance",
                            "CitizenManagement",
                            new { id = Model.ComplianceRecord.CitizenID }
                        )"
                           class="admin-back-button">
                            Cancel
                        </a>

                    </div>
                }

            </div>

        </div>

    </div>

</div>