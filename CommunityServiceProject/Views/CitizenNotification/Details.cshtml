
@model CommunityServiceProject.ViewModels.CitizenNotificationViewModel

@{
    ViewBag.Title = Model != null
        ? Model.Title
        : "Notification";
}

<style>
    .notification-details-page {
        max-width: 850px;
        margin: 0 auto;
        padding: 30px 20px 50px;
        color: #1f2937;
    }

    .notification-details-card {
        background: white;
        border: 1px solid #e1e7ef;
        border-radius: 13px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
        overflow: hidden;
    }

    .details-header {
        background: linear-gradient(135deg, #0D5CC1, #094b9f);
        color: white;
        padding: 28px 30px;
    }

    .details-back {
        display: inline-block;
        color: rgba(255,255,255,0.88);
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        margin-bottom: 20px;
    }

        .details-back:hover {
            color: white;
        }

    .details-category {
        display: inline-block;
        background: rgba(255,255,255,0.14);
        border: 1px solid rgba(255,255,255,0.22);
        border-radius: 6px;
        padding: 5px 8px;
        font-size: 10px;
        font-weight: 650;
        margin-bottom: 11px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .details-header h1 {
        margin: 0 0 8px;
        font-size: 24px;
        line-height: 1.3;
        font-weight: 700;
    }

    .details-date {
        font-size: 12px;
        opacity: 0.86;
    }

    .details-body {
        padding: 28px 30px;
    }

    .details-context {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 25px;
    }

    .context-item {
        border: 1px solid #e3e8ef;
        background: #f8fafc;
        border-radius: 9px;
        padding: 13px 14px;
    }

    .context-label {
        display: block;
        color: #64748b;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 5px;
    }

    .context-value {
        color: #1f2937;
        font-size: 13px;
        font-weight: 650;
        word-break: break-word;
    }

    .message-section {
        margin-top: 5px;
    }

        .message-section h2 {
            margin: 0 0 10px;
            color: #16324f;
            font-size: 16px;
        }

    .notification-message {
        background: #f8fafc;
        border: 1px solid #e3e8ef;
        border-radius: 9px;
        padding: 18px;
        color: #374151;
        font-size: 13px;
        line-height: 1.7;
        white-space: pre-line;
    }

    .details-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border-top: 1px solid #e8edf3;
        margin-top: 27px;
        padding-top: 20px;
    }

    .details-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 0 15px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 650;
        text-decoration: none;
        box-sizing: border-box;
    }

        .details-button.secondary {
            border: 1px solid #cfd7e3;
            background: white;
            color: #374151;
        }

            .details-button.secondary:hover {
                background: #f5f7fa;
            }

        .details-button.primary {
            border: 1px solid #0D5CC1;
            background: #0D5CC1;
            color: white;
        }

            .details-button.primary:hover {
                background: #094b9f;
            }

    .read-status {
        color: #64748b;
        font-size: 11px;
    }

    @@media (max-width: 650px) {
        .notification-details-page {
            padding: 20px 12px 35px;
        }

        .details-header {
            padding: 23px;
        }

            .details-header h1 {
                font-size: 21px;
            }

        .details-body {
            padding: 22px;
        }

        .details-context {
            grid-template-columns: 1fr;
        }

        .details-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .details-button {
            width: 100%;
        }

        .read-status {
            text-align: center;
        }
    }
</style>

<div class="notification-details-page">

    <div class="notification-details-card">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="details-header">

            <a href="@Url.Action(
                    "Index",
                    "CitizenNotification")"
               class="details-back">
                ← Back to Notifications
            </a>

            <div class="details-category">
                @Model.Category
            </div>

            <h1>
                @Model.Title
            </h1>

            <div class="details-date">
                @Model.DateCreated.ToString("dd MMMM yyyy · HH:mm")
            </div>

        </div>

        <!-- =====================================================
             BODY
             ===================================================== -->

        <div class="details-body">

            <div class="details-context">

                @if (Model.NotificationSource == "Applications")
                {
                    if (!string.IsNullOrWhiteSpace(Model.ApplicationReference))
                    {
                        <div class="context-item">

                            <span class="context-label">
                                Application
                            </span>

                            <div class="context-value">
                                @Model.ApplicationReference
                            </div>

                        </div>
                    }

                    if (!string.IsNullOrWhiteSpace(Model.OpportunityTitle))
                    {
                        <div class="context-item">

                            <span class="context-label">
                                Position
                            </span>

                            <div class="context-value">
                                @Model.OpportunityTitle
                            </div>

                        </div>
                    }
                }
                else if (Model.NotificationSource == "Maintenance")
                {
                    if (!string.IsNullOrWhiteSpace(Model.RequestReference))
                    {
                        <div class="context-item">

                            <span class="context-label">
                                Service Request
                            </span>

                            <div class="context-value">
                                @Model.RequestReference
                            </div>

                        </div>
                    }
                }

                <div class="context-item">

                    <span class="context-label">
                        Notification Type
                    </span>

                    <div class="context-value">
                        @Model.Category
                    </div>

                </div>

                <div class="context-item">

                    <span class="context-label">
                        Date Received
                    </span>

                    <div class="context-value">
                        @Model.DateCreated.ToString("dd MMM yyyy HH:mm")
                    </div>

                </div>

            </div>

            <!-- =================================================
                 MESSAGE
                 ================================================= -->

            <div class="message-section">

                <h2>Message</h2>

                <div class="notification-message">
                    @Model.Message
                </div>

            </div>

            <!-- =================================================
                 ACTIONS
                 ================================================= -->

            <div class="details-actions">

                <a href="@Url.Action(
                        "Index",
                        "CitizenNotification")"
                   class="details-button secondary">
                    ← Back to Notifications
                </a>

                <div class="read-status">
                    Notification marked as read.
                </div>

            </div>

        </div>

    </div>

</div>
