
@model CommunityServiceProject.ViewModels.FeeScheduleManagementViewModel

@{
    ViewBag.Title = "Manage Service Fees";
}

<style>

    /* =========================================================
       PAGE
       ========================================================= */

    .fee-page {
        max-width: 1350px;
        margin: 0 auto;
        padding: 30px 20px 50px;
        color: #1f2937;
    }

    /* =========================================================
       HEADER
       ========================================================= */

    .fee-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 24px;
        padding: 24px 26px;

        background: #ffffff;
        border: 1px solid #e1e7ef;
        border-radius: 12px;

        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    }

    .fee-page-header > div:first-child {
        min-width: 0;
    }

    .fee-page-header h1 {
        margin: 0 0 6px;
        color: #16324f;
        font-size: 24px;
        font-weight: 700;
        line-height: 1.25;
    }

    .fee-page-header p {
        margin: 0;
        color: #64748b;
        font-size: 13px;
        line-height: 1.5;
    }

    .fee-page-header-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        flex-shrink: 0;
    }

    /* =========================================================
       BACK BUTTON
       ========================================================= */

    .back-dashboard-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;

        min-height: 42px;
        padding: 0 16px;

        box-sizing: border-box;

        border: 1px solid #cfd7e3;
        border-radius: 8px;

        background: #ffffff;
        color: #475569;

        font-size: 13px;
        font-weight: 650;
        line-height: 1;

        text-decoration: none;
        white-space: nowrap;

        transition:
            background 0.15s ease,
            border-color 0.15s ease,
            color 0.15s ease,
            box-shadow 0.15s ease,
            transform 0.15s ease;
    }

    .back-dashboard-button:hover {
        background: #f8fafc;
        border-color: #aeb9c8;
        color: #1f2937;
        text-decoration: none;
        box-shadow: 0 2px 7px rgba(15, 23, 42, 0.07);
        transform: translateY(-1px);
    }

    .back-dashboard-icon {
        font-size: 17px;
        line-height: 1;
    }

    /* =========================================================
       ADD BUTTON
       ========================================================= */

    .add-fee-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;

        min-height: 42px;
        padding: 0 17px;

        border: 1px solid #0D5CC1;
        border-radius: 8px;

        background: #0D5CC1;
        color: #ffffff;

        font-size: 13px;
        font-weight: 650;
        line-height: 1;

        cursor: pointer;
        white-space: nowrap;

        transition:
            background 0.15s ease,
            border-color 0.15s ease,
            box-shadow 0.15s ease,
            transform 0.15s ease;
    }

    .add-fee-button:hover {
        background: #094b9f;
        border-color: #094b9f;
        color: #ffffff;
        box-shadow: 0 4px 10px rgba(13, 92, 193, 0.18);
        transform: translateY(-1px);
    }

    /* =========================================================
       ALERTS
       ========================================================= */

    .alert {
        border-radius: 9px;
        padding: 13px 16px;
        margin-bottom: 20px;
        font-size: 13px;
        line-height: 1.5;
    }

    .alert-success {
        background: #eaf7ef;
        border: 1px solid #bfe4cc;
        color: #176b43;
    }

    .alert-error {
        background: #fff1f0;
        border: 1px solid #efc0bc;
        color: #9b1c1c;
    }

    /* =========================================================
       SUMMARY CARDS
       ========================================================= */

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .summary-card {
        background: #ffffff;
        border: 1px solid #e1e7ef;
        border-radius: 11px;
        padding: 19px;
        box-shadow: 0 3px 12px rgba(15, 23, 42, 0.04);
    }

    .summary-label {
        display: block;
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 8px;
    }

    .summary-value {
        display: block;
        color: #16324f;
        font-size: 25px;
        font-weight: 750;
        line-height: 1;
    }

    .summary-description {
        margin-top: 8px;
        color: #94a3b8;
        font-size: 11px;
    }

    .summary-card.active .summary-value {
        color: #18794e;
    }

    .summary-card.inactive .summary-value {
        color: #64748b;
    }

    .summary-card.service .summary-value {
        color: #0D5CC1;
    }

    /* =========================================================
       FILTER CARD
       ========================================================= */

    .filter-card {
        background: #ffffff;
        border: 1px solid #e1e7ef;
        border-radius: 11px;
        padding: 19px;
        margin-bottom: 20px;
        box-shadow: 0 3px 12px rgba(15, 23, 42, 0.04);
    }

    .filter-title {
        margin: 0 0 14px;
        color: #16324f;
        font-size: 15px;
        font-weight: 700;
    }

    .filter-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(180px, 1fr) minmax(180px, 1fr) auto;
        gap: 11px;
        align-items: end;
    }

    .filter-group label {
        display: block;
        margin-bottom: 6px;
        color: #475569;
        font-size: 11px;
        font-weight: 700;
    }

    .filter-control {
        width: 100%;
        height: 40px;
        box-sizing: border-box;

        border: 1px solid #cfd7e3;
        border-radius: 7px;

        background: #ffffff;
        color: #1f2937;

        padding: 0 11px;
        font-size: 13px;
    }

    .filter-control:focus {
        outline: none;
        border-color: #0D5CC1;
        box-shadow: 0 0 0 3px rgba(13, 92, 193, 0.10);
    }

    .filter-button {
        height: 40px;
        padding: 0 16px;

        border: 1px solid #0D5CC1;
        border-radius: 7px;

        background: #0D5CC1;
        color: #ffffff;

        font-size: 12px;
        font-weight: 650;

        cursor: pointer;
    }

    .filter-button:hover {
        background: #094b9f;
        border-color: #094b9f;
    }

    .clear-filter {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        height: 40px;
        margin-left: 6px;

        color: #64748b;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
    }

    .clear-filter:hover {
        color: #0D5CC1;
        text-decoration: none;
    }

    /* =========================================================
       TABLE CARD
       ========================================================= */

    .table-card {
        background: #ffffff;
        border: 1px solid #e1e7ef;
        border-radius: 11px;
        overflow: hidden;
        box-shadow: 0 3px 12px rgba(15, 23, 42, 0.04);
    }

    .table-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;

        padding: 18px 20px;

        border-bottom: 1px solid #e8edf3;
    }

    .table-card-header h2 {
        margin: 0 0 4px;
        color: #16324f;
        font-size: 17px;
    }

    .table-card-header p {
        margin: 0;
        color: #64748b;
        font-size: 12px;
    }

    .record-count {
        padding: 6px 10px;
        border-radius: 20px;
        background: #f0f6ff;
        border: 1px solid #c9ddf8;
        color: #0D5CC1;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .fee-table {
        width: 100%;
        min-width: 950px;
        border-collapse: collapse;
    }

    .fee-table th {
        padding: 12px 18px;
        background: #f8fafc;

        border-bottom: 1px solid #e5eaf0;

        color: #64748b;
        font-size: 10px;
        font-weight: 750;
        text-align: left;

        text-transform: uppercase;
        letter-spacing: 0.035em;
        white-space: nowrap;
    }

    .fee-table td {
        padding: 14px 18px;

        border-bottom: 1px solid #edf0f4;

        color: #374151;
        font-size: 13px;
        vertical-align: middle;
    }

    .fee-table tbody tr:last-child td {
        border-bottom: none;
    }

    .fee-table tbody tr:hover {
        background: #fbfcfe;
    }

    .service-code {
        display: inline-block;
        padding: 4px 7px;
        border-radius: 5px;
        background: #f1f5f9;
        color: #475569;
        font-family: Consolas, monospace;
        font-size: 11px;
        font-weight: 700;
    }

    .service-name {
        color: #1f2937;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .fee-type {
        color: #64748b;
        font-size: 12px;
    }

    .fee-amount {
        color: #16324f;
        font-size: 14px;
        font-weight: 750;
        white-space: nowrap;
    }

    .date-value {
        color: #475569;
        font-size: 12px;
        white-space: nowrap;
    }

    .date-open {
        color: #18794e;
        font-weight: 650;
    }

    /* =========================================================
       STATUS
       ========================================================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        padding: 5px 10px;

        border-radius: 20px;

        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-active {
        background: #e8f7ee;
        border: 1px solid #bfe7cf;
        color: #18794e;
    }

    .status-inactive {
        background: #f1f5f9;
        border: 1px solid #dbe2ea;
        color: #64748b;
    }

    /* =========================================================
       ACTIONS
       ========================================================= */

    .table-actions {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        min-height: 32px;
        padding: 0 10px;

        border-radius: 6px;

        font-size: 11px;
        font-weight: 650;

        text-decoration: none;
        cursor: pointer;
        white-space: nowrap;
    }

    .edit-button {
        border: 1px solid #c9ddf8;
        background: #f0f6ff;
        color: #0D5CC1;
    }

    .edit-button:hover {
        background: #e3efff;
        color: #094b9f;
        text-decoration: none;
    }

    .toggle-button {
        border: 1px solid #d7dee8;
        background: #ffffff;
        color: #64748b;
    }

    .toggle-button:hover {
        background: #f8fafc;
        color: #374151;
    }

    /* =========================================================
       EMPTY STATE
       ========================================================= */

    .empty-state {
        padding: 55px 25px;
        text-align: center;
    }

    .empty-icon {
        width: 48px;
        height: 48px;
        margin: 0 auto 14px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        background: #f0f6ff;
        color: #0D5CC1;

        font-size: 21px;
        font-weight: 700;
    }

    .empty-state h3 {
        margin: 0 0 6px;
        color: #334155;
        font-size: 16px;
    }

    .empty-state p {
        max-width: 450px;
        margin: 0 auto;
        color: #64748b;
        font-size: 12px;
        line-height: 1.55;
    }

    /* =========================================================
       MODAL
       ========================================================= */

    .modal-overlay {
        display: none;

        position: fixed;
        inset: 0;
        z-index: 9999;

        background: rgba(15, 23, 42, 0.55);

        align-items: center;
        justify-content: center;

        padding: 20px;
    }

    .modal-overlay.active {
        display: flex;
    }

    .fee-modal {
        width: 100%;
        max-width: 570px;

        max-height: calc(100vh - 40px);
        overflow-y: auto;

        background: #ffffff;
        border-radius: 12px;

        box-shadow: 0 20px 55px rgba(15, 23, 42, 0.25);
    }

    .modal-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 15px;

        padding: 21px 23px;

        border-bottom: 1px solid #e8edf3;
    }

    .modal-header h3 {
        margin: 0 0 4px;
        color: #16324f;
        font-size: 19px;
    }

    .modal-header p {
        margin: 0;
        color: #64748b;
        font-size: 12px;
        line-height: 1.5;
    }

    .modal-close {
        width: 32px;
        height: 32px;

        border: 1px solid #d7dee8;
        border-radius: 7px;

        background: #ffffff;
        color: #64748b;

        font-size: 19px;
        line-height: 1;

        cursor: pointer;
    }

    .modal-close:hover {
        background: #f8fafc;
        color: #1f2937;
    }

    .modal-body {
        padding: 23px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 17px;
    }

    .form-group {
        min-width: 0;
    }

    .form-group.full-width {
        grid-column: 1 / -1;
    }

    .form-label {
        display: block;
        margin-bottom: 6px;

        color: #374151;
        font-size: 12px;
        font-weight: 700;
    }

    .form-control {
        width: 100%;
        height: 40px;

        box-sizing: border-box;

        border: 1px solid #cfd7e3;
        border-radius: 7px;

        padding: 0 11px;

        background: #ffffff;
        color: #1f2937;

        font-size: 13px;
    }

    .form-control:focus {
        outline: none;
        border-color: #0D5CC1;
        box-shadow: 0 0 0 3px rgba(13, 92, 193, 0.10);
    }

    textarea.form-control {
        height: auto;
        min-height: 90px;
        padding: 10px 11px;
        resize: vertical;
    }

    .field-help {
        margin-top: 5px;
        color: #94a3b8;
        font-size: 10px;
        line-height: 1.45;
    }

    .field-validation {
        display: block;
        margin-top: 5px;
        color: #b42318;
        font-size: 11px;
    }

    /* =========================================================
       CHECKBOX
       ========================================================= */

    .checkbox-panel {
        display: flex;
        align-items: flex-start;
        gap: 10px;

        padding: 12px 13px;

        border: 1px solid #e1e7ef;
        border-radius: 8px;

        background: #f8fafc;
    }

    .checkbox-panel input[type="checkbox"] {
        width: 16px;
        height: 16px;

        margin-top: 1px;

        accent-color: #0D5CC1;
        cursor: pointer;
        flex-shrink: 0;
    }

    .checkbox-panel label {
        color: #374151;
        font-size: 12px;
        font-weight: 650;
        line-height: 1.45;
        cursor: pointer;
    }

    /* =========================================================
       MODAL FOOTER
       ========================================================= */

    .modal-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 9px;

        padding: 17px 23px;

        border-top: 1px solid #e8edf3;
        background: #fbfcfe;
    }

    .modal-cancel {
        min-height: 40px;
        padding: 0 15px;

        border: 1px solid #cfd7e3;
        border-radius: 7px;

        background: #ffffff;
        color: #475569;

        font-size: 12px;
        font-weight: 650;

        cursor: pointer;
    }

    .modal-cancel:hover {
        background: #f8fafc;
    }

    .modal-submit {
        min-height: 40px;
        padding: 0 16px;

        border: 1px solid #0D5CC1;
        border-radius: 7px;

        background: #0D5CC1;
        color: #ffffff;

        font-size: 12px;
        font-weight: 650;

        cursor: pointer;
    }

    .modal-submit:hover {
        background: #094b9f;
        border-color: #094b9f;
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 1050px) {

        .summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .filter-grid {
            grid-template-columns: 1fr 1fr;
        }

        .filter-actions {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 800px) {

        .fee-page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .fee-page-header-actions {
            width: 100%;
            justify-content: flex-start;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .form-group.full-width {
            grid-column: auto;
        }
    }

    @@media (max-width: 600px) {

        .fee-page {
            padding: 20px 12px 35px;
        }

        .fee-page-header {
            padding: 20px;
        }

        .fee-page-header h1 {
            font-size: 21px;
        }

        .fee-page-header-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .back-dashboard-button,
        .add-fee-button {
            width: 100%;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .filter-grid {
            grid-template-columns: 1fr;
        }

        .filter-actions {
            grid-column: auto;
        }

        .filter-button,
        .clear-filter {
            width: 100%;
        }

        .clear-filter {
            margin: 5px 0 0;
        }

        .modal-footer {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .modal-cancel,
        .modal-submit {
            width: 100%;
        }
    }

</style>


<div class="fee-page">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="fee-page-header">

        <div>
            <h1>Manage Service Fees</h1>

            <p>
                Configure municipal service fees and maintain effective fee schedules.
            </p>
        </div>

        <div class="fee-page-header-actions">

            <a href="@Url.Action("Index", "FinanceDashboard")"
               class="back-dashboard-button">

                <span class="back-dashboard-icon">←</span>

                Back to Finance Dashboard

            </a>

            <button type="button"
                    class="add-fee-button"
                    onclick="openCreateFeeModal()">

                + Add Service Fee

            </button>

        </div>

    </div>


    <!-- =========================================================
         ALERTS
         ========================================================= -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-error">
            @TempData["ErrorMessage"]
        </div>
    }


    <!-- =========================================================
         SUMMARY
         ========================================================= -->

    <div class="summary-grid">

        <div class="summary-card service">

            <span class="summary-label">
                Total Fee Schedules
            </span>

            <span class="summary-value">
                @Model.TotalFees
            </span>

            <div class="summary-description">
                All configured fee records
            </div>

        </div>


        <div class="summary-card active">

            <span class="summary-label">
                Active Fees
            </span>

            <span class="summary-value">
                @Model.ActiveFees
            </span>

            <div class="summary-description">
                Currently available fee schedules
            </div>

        </div>


        <div class="summary-card inactive">

            <span class="summary-label">
                Inactive Fees
            </span>

            <span class="summary-value">
                @Model.InactiveFees
            </span>

            <div class="summary-description">
                Historical or unavailable fees
            </div>

        </div>


        <div class="summary-card">

            <span class="summary-label">
                Service Types With Fees
            </span>

            
            <div class="summary-card-value">
                @(Model.Fees.Select(f => f.ServiceTypeID).Distinct().Count())
            </div>
           

            <div class="summary-description">
                Services represented in this view
            </div>

        </div>

    </div>


    <!-- =========================================================
         FILTERS
         ========================================================= -->

    <div class="filter-card">

        <h2 class="filter-title">
            Search and Filter
        </h2>

        @using (Html.BeginForm(
            "Index",
            "FeeSchedule",
            FormMethod.Get))
        {
            <div class="filter-grid">

                <div class="filter-group">

                    <label for="searchTerm">
                        Search
                    </label>

                    <input type="text"
                           id="searchTerm"
                           name="searchTerm"
                           value="@Model.SearchTerm"
                           class="filter-control"
                           placeholder="Service name, code or fee type..." />

                </div>


                <div class="filter-group">

                    <label for="statusFilter">
                        Status
                    </label>

                    <select id="statusFilter"
                            name="statusFilter"
                            class="filter-control">

                        <option value="">
                            All Statuses
                        </option>

                        <option value="Active"
                                @(Model.StatusFilter == "Active"
                                    ? "selected"
                                    : "")>
                            Active
                        </option>

                        <option value="Inactive"
                                @(Model.StatusFilter == "Inactive"
                                    ? "selected"
                                    : "")>
                            Inactive
                        </option>

                    </select>

                </div>


                <div class="filter-group">

                    <label for="serviceTypeFilter">
                        Service Type
                    </label>

                    <select id="serviceTypeFilter"
                            name="serviceTypeFilter"
                            class="filter-control">

                        <option value="">
                            All Service Types
                        </option>

                        @foreach (var service in ViewBag.ServiceTypes)
                        {
                            <option value="@service.Value"
                                    @(Model.ServiceTypeFilter == service.Value
                                        ? "selected"
                                        : "")>
                                @service.Text
                            </option>
                        }

                    </select>

                </div>


                <div class="filter-actions">

                    <button type="submit"
                            class="filter-button">
                        Apply Filters
                    </button>

                    <a href="@Url.Action("Index", "FeeSchedule")"
                       class="clear-filter">
                        Clear
                    </a>

                </div>

            </div>
        }

    </div>


    <!-- =========================================================
         FEE TABLE
         ========================================================= -->

    <div class="table-card">

        <div class="table-card-header">

            <div>

                <h2>
                    Fee Schedule Catalogue
                </h2>

                <p>
                    Review and maintain the configured fees for municipal services.
                </p>

            </div>

            <span class="record-count">
                @Model.Fees.Count record@(Model.Fees.Count == 1 ? "" : "s")
            </span>

        </div>


        @if (Model.Fees.Any())
        {
            <div class="table-wrapper">

                <table class="fee-table">

                    <thead>

                        <tr>
                            <th>Service</th>
                            <th>Fee Type</th>
                            <th>Amount</th>
                            <th>Effective From</th>
                            <th>Effective To</th>
                            <th>Status</th>
                            <th>Created By</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var fee in Model.Fees)
                        {
                            <tr>

                                <td>

                                    <div class="service-name">
                                        @fee.ServiceName
                                    </div>

                                    <span class="service-code">
                                        @fee.ServiceCode
                                    </span>

                                </td>


                                <td>

                                    <div class="fee-type">
                                        @fee.FeeType
                                    </div>

                                </td>


                                <td>

                                    <span class="fee-amount">
                                        R @fee.Amount.ToString("N2")
                                    </span>

                                </td>


                                <td>

                                    <span class="date-value">
                                        @fee.EffectiveFrom.ToString("dd MMM yyyy")
                                    </span>

                                </td>


                                <td>

                                    @if (fee.EffectiveTo.HasValue)
                                    {
                                        <span class="date-value">
                                            @fee.EffectiveTo.Value.ToString("dd MMM yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="date-value date-open">
                                            No end date
                                        </span>
                                    }

                                </td>


                                <td>

                                    @if (fee.IsActive)
                                    {
                                        <span class="status-badge status-active">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            Inactive
                                        </span>
                                    }

                                </td>


                                <td>

                                    <span class="date-value">
                                        @fee.CreatedByName
                                    </span>

                                </td>


                                <td>

                                    <div class="table-actions">

                                       
                                        <button type="button"
                                                class="action-button edit-button edit-fee-button"
                                                data-id="@fee.FeeScheduleID"
                                                data-service-type-id="@fee.ServiceTypeID"
                                                data-fee-type="@fee.FeeType"
                                                data-amount="@fee.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                data-effective-from="@fee.EffectiveFrom.ToString("yyyy-MM-dd")"
                                                data-effective-to="@(fee.EffectiveTo.HasValue ? fee.EffectiveTo.Value.ToString("yyyy-MM-dd") : "")"
                                                data-active="@fee.IsActive.ToString().ToLower()">
                                            Edit
                                        </button>
                                     



                                        @using (Html.BeginForm(
                                            "ToggleStatus",
                                            "FeeSchedule",
                                            FormMethod.Post,
                                            new
                                            {
                                                style = "display:inline;"
                                            }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@fee.FeeScheduleID" />

                                            <button type="submit"
                                                    class="action-button toggle-button">

                                                @(fee.IsActive
                                                    ? "Deactivate"
                                                    : "Activate")

                                            </button>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <div class="empty-icon">
                    $
                </div>

                <h3>
                    No fee schedules found
                </h3>

                <p>
                    There are currently no fee schedules matching the selected
                    criteria. Create a service fee to begin configuring the
                    municipal service catalogue.
                </p>

            </div>
        }

    </div>

</div>


<!-- =============================================================
     CREATE FEE MODAL
     ============================================================= -->

<div id="createFeeModal"
     class="modal-overlay">

    <div class="fee-modal">

        <div class="modal-header">

            <div>

                <h3>
                    Add Service Fee
                </h3>

                <p>
                    Create a fee schedule for an active municipal service.
                </p>

            </div>

            <button type="button"
                    class="modal-close"
                    onclick="closeCreateFeeModal()">
                ×
            </button>

        </div>


        @using (Html.BeginForm(
            "Create",
            "FeeSchedule",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="modal-body">

                <div class="form-grid">

                    <div class="form-group full-width">

                        <label class="form-label"
                               for="Create_ServiceTypeID">
                            Service Type
                        </label>

                        <select name="ServiceTypeID"
                                id="Create_ServiceTypeID"
                                class="form-control"
                                required>

                            <option value="">
                                Select a service type
                            </option>

                            @foreach (var service in ViewBag.ServiceTypes)
                            {
                                <option value="@service.Value">
                                    @service.Text
                                </option>
                            }

                        </select>

                        <span class="field-help">
                            Only active service types can receive new fees.
                        </span>

                    </div>


                    <div class="form-group full-width">

                        <label class="form-label"
                               for="Create_FeeType">
                            Fee Type
                        </label>

                        <input type="text"
                               id="Create_FeeType"
                               name="FeeType"
                               class="form-control"
                               maxlength="50"
                               placeholder="e.g. Booking Fee"
                               required />

                    </div>


                    <div class="form-group">

                        <label class="form-label"
                               for="Create_Amount">
                            Amount
                        </label>

                        <input type="number"
                               id="Create_Amount"
                               name="Amount"
                               class="form-control"
                               min="0.01"
                               max="999999999.99"
                               step="0.01"
                               placeholder="0.00"
                               required />

                    </div>


                    <div class="form-group">

                        <label class="form-label"
                               for="Create_EffectiveFrom">
                            Effective From
                        </label>

                        <input type="date"
                               id="Create_EffectiveFrom"
                               name="EffectiveFrom"
                               class="form-control"
                               required />

                    </div>


                    <div class="form-group">

                        <label class="form-label"
                               for="Create_EffectiveTo">
                            Effective To
                        </label>

                        <input type="date"
                               id="Create_EffectiveTo"
                               name="EffectiveTo"
                               class="form-control" />

                        <div class="field-help">
                            Leave blank if the fee has no planned end date.
                        </div>

                    </div>


                    <div class="form-group">

                        <label class="form-label">
                            Status
                        </label>

                        <div class="checkbox-panel">

                            <input type="checkbox"
                                   id="Create_IsActive"
                                   name="IsActive"
                                   value="true"
                                   checked />

                            <label for="Create_IsActive">
                                Make this fee schedule active immediately.
                            </label>

                        </div>

                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="modal-cancel"
                        onclick="closeCreateFeeModal()">
                    Cancel
                </button>

                <button type="submit"
                        class="modal-submit">
                    Create Fee Schedule
                </button>

            </div>
        }

    </div>

</div>


<!-- =============================================================
     EDIT FEE MODAL
     ============================================================= -->

<div id="editFeeModal"
     class="modal-overlay">

    <div class="fee-modal">

        <div class="modal-header">

            <div>

                <h3>
                    Edit Service Fee
                </h3>

                <p>
                    Update the selected fee schedule.
                </p>

            </div>

            <button type="button"
                    class="modal-close"
                    onclick="closeEditFeeModal()">
                ×
            </button>

        </div>


        @using (Html.BeginForm(
            "Edit",
            "FeeSchedule",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="modal-body">

                <input type="hidden"
                       id="Edit_FeeScheduleID"
                       name="FeeScheduleID" />


                <div class="form-grid">

                    <div class="form-group full-width">

                        <label class="form-label"
                               for="Edit_ServiceTypeID">
                            Service Type
                        </label>

                        <select name="ServiceTypeID"
                                id="Edit_ServiceTypeID"
                                class="form-control"
                                required>

                            @foreach (var service in ViewBag.ServiceTypes)
                            {
                                <option value="@service.Value">
                                    @service.Text
                                </option>
                            }

                        </select>

                    </div>


                    <div class="form-group full-width">

                        <label class="form-label"
                               for="Edit_FeeType">
                            Fee Type
                        </label>

                        <input type="text"
                               id="Edit_FeeType"
                               name="FeeType"
                               class="form-control"
                               maxlength="50"
                               required />

                    </div>


                    <div class="form-group">

                        <label class="form-label"
                               for="Edit_Amount">
                            Amount
                        </label>

                        <input type="number"
                               id="Edit_Amount"
                               name="Amount"
                               class="form-control"
                               min="0.01"
                               max="999999999.99"
                               step="0.01"
                               required />

                    </div>


                    <div class="form-group">

                        <label class="form-label"
                               for="Edit_EffectiveFrom">
                            Effective From
                        </label>

                        <input type="date"
                               id="Edit_EffectiveFrom"
                               name="EffectiveFrom"
                               class="form-control"
                               required />

                    </div>


                    <div class="form-group">

                        <label class="form-label"
                               for="Edit_EffectiveTo">
                            Effective To
                        </label>

                        <input type="date"
                               id="Edit_EffectiveTo"
                               name="EffectiveTo"
                               class="form-control" />

                        <div class="field-help">
                            Leave blank if there is no planned end date.
                        </div>

                    </div>


                    <div class="form-group">

                        <label class="form-label">
                            Status
                        </label>

                        <div class="checkbox-panel">

                            <input type="checkbox"
                                   id="Edit_IsActive"
                                   name="IsActive"
                                   value="true" />

                            <label for="Edit_IsActive">
                                Keep this fee schedule active.
                            </label>

                        </div>

                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="modal-cancel"
                        onclick="closeEditFeeModal()">
                    Cancel
                </button>

                <button type="submit"
                        class="modal-submit">
                    Save Changes
                </button>

            </div>
        }

    </div>

</div>


<script>

    /* =========================================================
       CREATE MODAL
       ========================================================= */

    function openCreateFeeModal() {

        var modal = document.getElementById("createFeeModal");

        var effectiveFrom =
            document.getElementById("Create_EffectiveFrom");

        if (effectiveFrom && !effectiveFrom.value) {

            var today = new Date();

            var year = today.getFullYear();

            var month = String(
                today.getMonth() + 1
            ).padStart(2, "0");

            var day = String(
                today.getDate()
            ).padStart(2, "0");

            effectiveFrom.value =
                year + "-" + month + "-" + day;
        }

        modal.classList.add("active");
    }


    function closeCreateFeeModal() {

        document
            .getElementById("createFeeModal")
            .classList.remove("active");
    }


    /* =========================================================
       EDIT MODAL
       ========================================================= */
    
document.addEventListener("DOMContentLoaded", function () {

    var editButtons = document.querySelectorAll(".edit-fee-button");

    editButtons.forEach(function (button) {

        button.addEventListener("click", function () {

            document.getElementById("Edit_FeeScheduleID").value =
                button.dataset.id;

            document.getElementById("Edit_ServiceTypeID").value =
                button.dataset.serviceTypeId;

            document.getElementById("Edit_FeeType").value =
                button.dataset.feeType;

            document.getElementById("Edit_Amount").value =
                button.dataset.amount;

            document.getElementById("Edit_EffectiveFrom").value =
                button.dataset.effectiveFrom;

            document.getElementById("Edit_EffectiveTo").value =
                button.dataset.effectiveTo;

            document.getElementById("Edit_IsActive").checked =
                button.dataset.active === "true";

            document
                .getElementById("editFeeModal")
                .classList.add("active");
        });

    });

});


    function closeEditFeeModal() {

        document
            .getElementById("editFeeModal")
            .classList.remove("active");
    }


    /* =========================================================
       MODAL BACKDROP
       ========================================================= */

    document.addEventListener(
        "click",
        function (event) {

            var createModal =
                document.getElementById("createFeeModal");

            var editModal =
                document.getElementById("editFeeModal");

            if (event.target === createModal) {
                closeCreateFeeModal();
            }

            if (event.target === editModal) {
                closeEditFeeModal();
            }

        }
    );


    /* =========================================================
       ESCAPE KEY
       ========================================================= */

    document.addEventListener(
        "keydown",
        function (event) {

            if (event.key === "Escape") {

                closeCreateFeeModal();
                closeEditFeeModal();

            }

        }
    );

</script>

