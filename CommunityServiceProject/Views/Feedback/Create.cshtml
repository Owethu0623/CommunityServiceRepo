@model CommunityServiceProject.Models.Feedback

@{
    ViewBag.Title = "Service Feedback";

    var request = ViewBag.Request as CommunityServiceProject.Models.Request;
}

<style>
    .feedback-page {
        max-width: 1500px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .feedback-card {
        background: #ffffff;
        border-radius: 14px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .feedback-header {
        background: #0D5CC1;
        color: #ffffff;
        padding: 20px 22px;
    }

        .feedback-header h2 {
            margin: 0 0 6px;
            font-size: 15px;
            font-weight: 700;
        }

        .feedback-header p {
            margin: 0;
            opacity: 0.9;
        }

    .feedback-body {
        padding: 32px;
    }

    .request-summary {
        background: #F4F7FB;
        border-left: 4px solid #0D5CC1;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
    }

        .request-summary h4 {
            margin-top: 0;
            color: #0D5CC1;
            font-weight: 500;
        }

        .request-summary p {
            margin: 7px 0;
            color: #444;
        }

    .feedback-section {
        margin-bottom: 28px;
    }

        .feedback-section label.section-label {
            display: block;
            font-weight: 700;
            color: #333;
            margin-bottom: 12px;
            font-size: 12px;
        }

    .rating-options {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .rating-option {
        position: relative;
    }

        .rating-option input {
            position: absolute;
            opacity: 0;
        }

        .rating-option label {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 58px;
            height: 50px;
            border: 2px solid #d9e0ea;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            color: #555;
            transition: all 0.2s ease;
        }

        .rating-option input:checked + label {
            background: #0D5CC1;
            border-color: #0D5CC1;
            color: #ffffff;
        }

        .rating-option label:hover {
            border-color: #0D5CC1;
            color: #0D5CC1;
        }

    .resolution-options {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .resolution-option {
        flex: 1;
        min-width: 150px;
    }

        .resolution-option input {
            display: none;
        }

        .resolution-option label {
            display: block;
            text-align: center;
            padding: 14px 18px;
            border: 2px solid #d9e0ea;
            border-radius: 8px;
            cursor: pointer;
            color: #444;
            font-weight: 400;
            transition: all 0.2s ease;
        }

        .resolution-option input:checked + label {
            background: #0D5CC1;
            border-color: #0D5CC1;
            color: #ffffff;
        }

    .feedback-textarea {
        width: 100%;
        min-height: 130px;
        border: 1px solid #d9e0ea;
        border-radius: 8px;
        padding: 14px;
        resize: vertical;
        font-size: 15px;
        box-sizing: border-box;
    }

        .feedback-textarea:focus {
            outline: none;
            border-color: #0D5CC1;
            box-shadow: 0 0 0 3px rgba(13, 92, 193, 0.1);
        }

    .field-validation {
        color: #c62828;
        margin-top: 6px;
        display: block;
    }

    .feedback-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-top: 30px;
        padding-top: 25px;
        border-top: 1px solid #e5e9ef;
    }

    .feedback-button {
        display: inline-block;
        background: #0D5CC1;
        color: #ffffff;
        border: none;
        border-radius: 7px;
        padding: 12px 24px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
    }

        .feedback-button:hover {
            background: #094a9d;
            color: #ffffff;
            text-decoration: none;
        }

    .feedback-back {
        color: #555;
        text-decoration: none;
        font-weight: 600;
    }

        .feedback-back:hover {
            color: #0D5CC1;
        }

    @@media (max-width: 800px) {
        .feedback-body {
            padding: 22px;
        }

        .feedback-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .feedback-button,
        .feedback-back {
            text-align: center;
        }
    }
</style>

<div class="feedback-page">

    <div class="feedback-card">

        <div class="feedback-header">
            <h2>Service Feedback</h2>
            <p>Tell us about your experience with this completed service request.</p>
        </div>

        <div class="feedback-body">

            @if (request != null)
            {
                <div class="request-summary">

                    <h4>Request Information</h4>

                    <p>
                        <strong>Reference:</strong>
                        @request.ReferenceNumber
                    </p>

                    <p>
                        <strong>Category:</strong>
                        @request.Category.CategoryName
                    </p>

                    <p>
                        <strong>Request:</strong>
                        @request.Title
                    </p>

                </div>
            }

            @using (Html.BeginForm("Create", "Feedback", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(model => model.RequestID)

                <div class="feedback-section">

                    <label class="section-label">
                        How satisfied were you with the service?
                    </label>

                    <div class="rating-options">

                        @for (int i = 1; i <= 5; i++)
                        {
                            <div class="rating-option">

                                @Html.RadioButtonFor(
                                         model => model.Rating,
                                         i,
                                         new { id = "rating-" + i }
                                     )

                                <label for="rating-@i">
                                    @i
                                </label>

                            </div>
                        }

                    </div>

                    @Html.ValidationMessageFor(
                             model => model.Rating,
                             "",
                             new { @class = "field-validation" }
                         )

                </div>

                <div class="feedback-section">

                    <label class="section-label">
                        Was the reported issue resolved?
                    </label>

                    <div class="resolution-options">

                        <div class="resolution-option">

                            @Html.RadioButtonFor(
                                     model => model.ResolutionStatus,
                                     CommunityServiceProject.Models.FeedbackResolutionStatus.Yes,
                                     new { id = "resolution-yes" }
                                 )

                            <label for="resolution-yes">
                                Yes
                            </label>

                        </div>

                        <div class="resolution-option">

                            @Html.RadioButtonFor(
                                     model => model.ResolutionStatus,
                                     CommunityServiceProject.Models.FeedbackResolutionStatus.Partially,
                                     new { id = "resolution-partially" }
                                 )

                            <label for="resolution-partially">
                                Partially
                            </label>

                        </div>

                        <div class="resolution-option">

                            @Html.RadioButtonFor(
                                     model => model.ResolutionStatus,
                                     CommunityServiceProject.Models.FeedbackResolutionStatus.No,
                                     new { id = "resolution-no" }
                                 )

                            <label for="resolution-no">
                                No
                            </label>

                        </div>

                    </div>

                    @Html.ValidationMessageFor(
                             model => model.ResolutionStatus,
                             "",
                             new { @class = "field-validation" }
                         )

                </div>

                <div class="feedback-section">

                    <label class="section-label" for="Comment">
                        Additional comments
                        <span style="font-weight: normal; color: #777;">
                            (optional)
                        </span>
                    </label>

                    @Html.TextAreaFor(
                             model => model.Comment,
                             new
                             {
                                 @class = "feedback-textarea",
                                 placeholder = "Share any comments about the service you received..."
                             }
                         )

                    @Html.ValidationMessageFor(
                             model => model.Comment,
                             "",
                             new { @class = "field-validation" }
                         )

                </div>

                <div class="feedback-actions">

                    <a href="@Url.Action("Details", "Requests", new { id = Model.RequestID })"
                       class="feedback-back">
                        ← Back to Request
                    </a>

                    <button type="submit" class="feedback-button">
                        Submit Feedback
                    </button>

                </div>
            }

        </div>

    </div>

</div>
