@model IEnumerable<CommunityServiceProject.Models.Payment>

@{
    ViewBag.Title = "Payment Verification";
}

<div class="finance-payment-page">

    <div class="finance-payment-header">
        <div>
            <span class="finance-payment-eyebrow">
                US141 • PAYMENT VERIFICATION
            </span>

            <h1>Payment Verification</h1>

            <p>
                Review citizen payment submissions and proof of payment
                before confirming or rejecting the transaction.
            </p>
        </div>

        <div class="finance-payment-count">
            <span>@Model.Count()</span>
            <small>Awaiting Verification</small>
        </div>
    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="finance-alert finance-alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="finance-alert finance-alert-error">
            @TempData["ErrorMessage"]
        </div>
    }


<div class="finance-payment-card">

    <div class="finance-payment-card-header">
        <div>
            <h2>Payments Awaiting Verification</h2>
            <p>
                These payments have been submitted by citizens and
                require Finance Officer verification.
            </p>
        </div>
    </div>


    @if (Model.Any())
    {
        <div class="finance-payment-table-wrapper">

            <table class="finance-payment-table">

                <thead>
                    <tr>
                        <th>Transaction</th>
                        <th>Invoice</th>
                        <th>Citizen</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Submitted</th>
                        <th>POP</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var payment in Model)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @payment.TransactionReference
                                </strong>
                            </td>

                            <td>
                                @(payment.Invoice != null
                                        ? payment.Invoice.InvoiceNumber
                                        : "N/A")
                            </td>

                            <td>
                                @(payment.Citizen != null
                                        ? payment.Citizen.FirstName + " " + payment.Citizen.LastName
                                        : "N/A")
                            </td>

                            <td>
                                <strong>
                                    R @payment.Amount.ToString("N2")
                                </strong>
                            </td>

                            <td>
                                @payment.PaymentMethod
                            </td>

                            <td>
                                @payment.PaymentDate.ToString("dd MMM yyyy, HH:mm")
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(payment.ProofOfPaymentPath))
                                {
                                    <span class="pop-badge">
                                        ✓ Submitted
                                    </span>
                                }
                                else
                                {
                                    <span class="pop-missing">
                                        Missing
                                    </span>
                                }
                            </td>

                            <td>
                                <a href="@Url.Action(
                                        "Review",
                                        "FinancePayment",
                                        new { id = payment.PaymentID })"
                                   class="finance-review-button">
                                    Review Payment
                                </a>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="finance-empty-state">

            <div class="finance-empty-icon">
                ✓
            </div>

            <h3>No Payments Awaiting Verification</h3>

            <p>
                There are currently no citizen payments waiting
                for Finance Officer verification.
            </p>

        </div>
    }
    <div>
        <a href="@Url.Action("Index", "FinanceDashboard")" class="back-btn">
            <span class="back-arrow">←</span>
            Back
        </a>
    </div>
</div>

</div>


