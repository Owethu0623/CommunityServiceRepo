@model CommunityServiceProject.ViewModels.RefundReviewViewModel

@{
    ViewBag.Title = "Refund Decision";
}

<style>
    .result-page {
        max-width: 850px;
        margin: 45px auto;
        padding: 0 20px;
    }

    .result-card {
        background: #ffffff;
        border: 1px solid #e4e7ec;
        border-radius: 16px;
        box-shadow: 0 12px 35px rgba(16, 24, 40, 0.08);
        overflow: hidden;
    }

    .result-header {
        padding: 35px 35px 30px;
        text-align: center;
        background: #f8fafc;
        border-bottom: 1px solid #e4e7ec;
    }

    .result-icon {
        width: 68px;
        height: 68px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 30px;
        font-weight: 800;
    }

    .approved-icon {
        background: #dcfce7;
        color: #15803d;
    }

    .rejected-icon {
        background: #fee4e2;
        color: #b42318;
    }

    .result-header h1 {
        margin: 0 0 8px;
        color: #172033;
        font-size: 27px;
        font-weight: 800;
    }

    .result-header p {
        margin: 0;
        color: #667085;
        font-size: 14px;
        line-height: 1.6;
    }

    .result-body {
        padding: 30px 35px;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }

    .summary-item {
        padding: 16px 18px;
        background: #f8fafc;
        border: 1px solid #eaecf0;
        border-radius: 10px;
    }

    .summary-item span {
        display: block;
        margin-bottom: 5px;
        color: #667085;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .7px;
        text-transform: uppercase;
    }

    .summary-item strong {
        color: #172033;
        font-size: 14px;
        font-weight: 700;
    }

    .review-message {
        margin-top: 22px;
        padding: 18px;
        border-radius: 10px;
        background: #f8fafc;
        border: 1px solid #eaecf0;
    }

    .review-message-title {
        margin-bottom: 7px;
        color: #253044;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .7px;
    }

    .review-message p {
        margin: 0;
        color: #667085;
        font-size: 14px;
        line-height: 1.6;
    }

    .result-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 28px;
    }

    .result-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 190px;
        padding: 12px 18px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
        transition: all .2s ease;
    }

    .primary-result-button {
        background: #0d5cc1;
        border: 1px solid #0d5cc1;
        color: #ffffff;
    }

    .primary-result-button:hover {
        background: #084a9d;
        border-color: #084a9d;
        color: #ffffff;
        text-decoration: none;
    }

    .secondary-result-button {
        background: #ffffff;
        border: 1px solid #d0d5dd;
        color: #344054;
    }

    .secondary-result-button:hover {
        background: #f8fafc;
        color: #172033;
        text-decoration: none;
    }

    @@media (max-width: 650px) {
        .summary-grid {
            grid-template-columns: 1fr;
        }

        .result-actions {
            flex-direction: column;
        }

        .result-button {
            width: 100%;
        }

        .result-body,
        .result-header {
            padding: 25px 20px;
        }
    }
</style>

<div class="result-page">

    <div class="result-card">

        @if (Model.Status == CommunityServiceProject.Models.RefundStatus.Approved)
        {
            <div class="result-header">

                <div class="result-icon approved-icon">
                    ✓
                </div>

                <h1>Refund Approved</h1>

                <p>
                    The refund request has been successfully reviewed and approved.
                    It is now ready for refund processing.
                </p>

            </div>
        }
        else
        {
            <div class="result-header">

                <div class="result-icon rejected-icon">
                    ✕
                </div>

                <h1>Refund Rejected</h1>

                <p>
                    The refund request has been reviewed and rejected.
                    The decision has been recorded.
                </p>

            </div>
        }

        <div class="result-body">

            <div class="summary-grid">

                <div class="summary-item">
                    <span>Refund Reference</span>
                    <strong>@Model.RefundReference</strong>
                </div>

                <div class="summary-item">
                    <span>Transaction Reference</span>
                    <strong>@Model.TransactionReference</strong>
                </div>

                <div class="summary-item">
                    <span>Refund Amount</span>
                    <strong>R @Model.RefundAmount.ToString("N2")</strong>
                </div>

                <div class="summary-item">
                    <span>Decision</span>
                    <strong>@Model.Status</strong>
                </div>

            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ReviewComments))
            {
                <div class="review-message">

                    <div class="review-message-title">
                        Review Comments
                    </div>

                    <p>
                        @Model.ReviewComments
                    </p>

                </div>
            }

            <div class="result-actions">

                @if (Model.Status ==
                    CommunityServiceProject.Models.RefundStatus.Approved)
                {
                    <a href="@Url.Action("ProcessRefunds", "FinancePayment")"
                       class="result-button primary-result-button">
                        Continue to Refund Processing
                    </a>
                }

                <a href="@Url.Action("RefundRequests", "FinancePayment")"
                   class="result-button secondary-result-button">
                    Back to Refund Requests
                </a>

            </div>

        </div>

    </div>

</div>