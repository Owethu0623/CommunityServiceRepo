@model CommunityServiceProject.ViewModels.RefundReviewViewModel

@{
    ViewBag.Title = "Review Refund";
}

<div class="review-refund-page">

    <div class="review-refund-shell">

        <div class="review-refund-header">

            <div>
                <div class="review-refund-kicker">
                    REFUND REVIEW • @Model.RefundReference
                </div>

                <h1>
                    Review Refund Request
                </h1>

                <p>
                    Review the payment, citizen request and supporting evidence
                    before making a refund decision.
                </p>
            </div>

            <a href="@Url.Action("RefundRequests","FinancePayment")"
               class="review-refund-back">
                ← Back to Refund Requests
            </a>

        </div>


        <div class="review-refund-layout">

            <div class="review-main-card">

                <div class="review-status-header">

                    <div>
                        <span>REFUND STATUS</span>

                        @if (Model.Status ==
                            CommunityServiceProject.Models.RefundStatus.UnderReview)
                        {
                            <strong class="status-under-review">
                                Under Review
                            </strong>
                        }
                        else if (Model.Status ==
                            CommunityServiceProject.Models.RefundStatus.Approved)
                        {
                            <strong class="status-approved">
                                Approved
                            </strong>
                        }
                        else if (Model.Status ==
                            CommunityServiceProject.Models.RefundStatus.Rejected)
                        {
                            <strong class="status-rejected">
                                Rejected
                            </strong>
                        }
                        else
                        {
                            <strong>
                                @Model.Status
                            </strong>
                        }

                    </div>

                    <div class="review-reference">

                        <span>
                            REQUESTED
                        </span>

                        <strong>
                            @Model.RequestDate.ToString("dd MMM yyyy")
                        </strong>

                    </div>

                </div>


                <div class="review-section">

                    <div class="review-section-title">
                        PAYMENT INFORMATION
                    </div>

                    <div class="review-grid">

                        <div>
                            <span>Transaction Reference</span>
                            <strong>@Model.TransactionReference</strong>
                        </div>

                        <div>
                            <span>Invoice Number</span>
                            <strong>@Model.InvoiceNumber</strong>
                        </div>

                        <div>
                            <span>Request Reference</span>
                            <strong>@Model.RequestReference</strong>
                        </div>

                        <div>
                            <span>Citizen</span>
                            <strong>@Model.CitizenName</strong>
                        </div>

                        <div>
                            <span>Municipal Service</span>
                            <strong>@Model.ServiceName</strong>
                        </div>

                        <div>
                            <span>Original Payment</span>
                            <strong>R @Model.OriginalPaymentAmount.ToString("N2")</strong>
                        </div>

                    </div>

                </div>


                <div class="refund-amount-review">

                    <span>
                        REFUND REQUESTED
                    </span>

                    <strong>
                        R @Model.RefundAmount.ToString("N2")
                    </strong>

                </div>


                <div class="review-section">

                    <div class="review-section-title">
                        CITIZEN'S REASON
                    </div>

                    <div class="reason-box">
                        @Model.Reason
                    </div>

                </div>


                <div class="review-section">

                    <div class="review-section-title">
                        SUPPORTING DOCUMENT
                    </div>

                    @if (!string.IsNullOrEmpty(Model.SupportingDocumentPath))
                    {
                        <div class="supporting-document-card">

                            <div class="document-icon">
                                📄
                            </div>

                            <div class="document-info">
                                <span class="document-label">Supporting Document</span>

                                <strong>
                                    @Model.SupportingDocumentName
                                </strong>
                            </div>

                            <a href="@Url.Content(Model.SupportingDocumentPath)"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="document-button">
                                View Document
                            </a>

                        </div>
                    }
                    else
                    {
                        <div class="no-document-message">
                            No supporting document was attached to this refund request.
                        </div>
                    }

                </div>


                @if (Model.CanDecide)
                {
                    <div class="review-decision-section">

                        <div class="review-section-title">
                            FINANCE DECISION
                        </div>

                        @using (Html.BeginForm(
                            "DecideRefund",
                            "FinancePayment",
                            FormMethod.Post,
                            new
                            {
                                @class = "refund-decision-form"
                            }))
                        {
                            @Html.AntiForgeryToken()

                            @Html.Hidden(
                                "id",
                                Model.RefundID)

                            <label>
                                Review Comments
                            </label>

                            <textarea name="reviewComments"
                                      rows="5"
                                      maxlength="500"
                                      class="review-comments-textarea"
                                      placeholder="Record the reason for your decision..."></textarea>

                            <div class="decision-buttons">

                                <button type="submit"
                                        name="decision"
                                        value="Rejected"
                                        class="reject-refund-button"
                                        onclick="return confirm('Reject this refund request?');">
                                    Reject Refund
                                </button>

                                <button type="submit"
                                        name="decision"
                                        value="Approved"
                                        class="approve-refund-button"
                                        onclick="return confirm('Approve this refund request?');">
                                    Approve Refund
                                </button>

                            </div>
                        }

                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(Model.ReviewComments))
                {
                    <div class="existing-decision-box">

                        <span>
                            FINANCE REVIEW COMMENTS
                        </span>

                        <p>
                            @Model.ReviewComments
                        </p>

                    </div>
                }
            </div>
        </div>


                <div class="review-refund-bottom">

                    <a href="@Url.Action("RefundRequests", "FinancePayment")">
                        ← Back to Refund Requests
                    </a>

                    <a href="@Url.Action("Index", "FinanceDashboard")">
                        Finance Dashboard
                    </a>

                </div>

            </div>

</div>

<style>

    .review-refund-page {
        min-height: 100vh;
        padding: 38px 25px 60px;
        background: #f4f6f9;
    }

    .review-refund-shell {
        width: min(1150px, 100%);
        margin: 0 auto;
    }

    .review-refund-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 25px;
        margin-bottom: 22px;
    }

    .review-refund-kicker {
        color: #0D5CC1;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 1.4px;
    }

    .review-refund-header h1 {
        margin: 7px 0;
        color: #172033;
        font-size: 30px;
        font-weight: 850;
    }

    .review-refund-header p {
        max-width: 700px;
        margin: 0;
        color: #667085;
        font-size: 13px;
        line-height: 1.65;
    }

    .review-refund-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 16px;
        border: 1px solid #d7dde6;
        border-radius: 9px;
        background: #ffffff;
        color: #344054;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
    }

    .review-refund-back:hover {
        background: #f8fafc;
        color: #172033;
        text-decoration: none;
    }

    .review-refund-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 270px;
        gap: 20px;
    }

    .review-main-card,
    .review-side-card {
        background: #ffffff;
        border: 1px solid #e1e6ec;
        border-radius: 15px;
        box-shadow: 0 8px 28px rgba(20,29,44,.06);
    }

    .review-main-card {
        overflow: hidden;
    }

    .review-status-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 21px 25px;
        background: #fafbfc;
        border-bottom: 1px solid #e7ebf0;
    }

    .review-status-header span,
    .review-reference span,
    .existing-decision-box span {
        display: block;
        margin-bottom: 5px;
        color: #667085;
        font-size: 9px;
        font-weight: 900;
        letter-spacing: 1px;
    }

    .review-status-header strong {
        font-size: 15px;
        font-weight: 850;
    }

    .status-under-review {
        color: #956700;
    }

    .status-approved {
        color: #176b42;
    }

    .status-rejected {
        color: #b42318;
    }

    .review-reference {
        text-align: right;
    }

    .review-reference strong {
        color: #344054;
        font-size: 12px;
    }

    .review-section {
        padding: 25px;
        border-bottom: 1px solid #e7ebf0;
    }

    .review-section-title {
        margin-bottom: 17px;
        color: #172033;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 1.1px;
    }

    .review-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 19px 30px;
    }

    .review-grid span {
        display: block;
        margin-bottom: 5px;
        color: #667085;
        font-size: 9px;
        font-weight: 850;
        letter-spacing: .7px;
        text-transform: uppercase;
    }

    .review-grid strong {
        color: #253044;
        font-size: 12px;
        font-weight: 800;
        line-height: 1.45;
    }

    .refund-amount-review {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin: 20px 25px;
        padding: 18px 20px;
        border-radius: 10px;
        background: #eef4fc;
        border: 1px solid #d7e4f5;
    }

    .refund-amount-review span {
        color: #667085;
        font-size: 9px;
        font-weight: 900;
        letter-spacing: 1px;
    }

    .refund-amount-review strong {
        color: #0D5CC1;
        font-size: 23px;
        font-weight: 900;
    }

    .reason-box {
        padding: 16px;
        border: 1px solid #e2e6eb;
        border-radius: 9px;
        background: #fafbfc;
        color: #52606d;
        font-size: 12px;
        line-height: 1.7;
    }

    /* ================================
   SUPPORTING DOCUMENT
   ================================ */

.supporting-document-card {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 16px;
    padding: 18px 20px;
    background: #f8fafc;
    border: 1px solid #e4e7ec;
    border-radius: 12px;
    transition: all 0.2s ease;
}

.supporting-document-card:hover {
    background: #ffffff;
    border-color: #cfd6df;
    box-shadow: 0 6px 18px rgba(16, 24, 40, 0.08);
}

.document-icon {
    width: 46px;
    height: 46px;
    min-width: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eaf2ff;
    border: 1px solid #d6e4ff;
    border-radius: 10px;
    font-size: 21px;
}

.document-info {
    flex: 1;
    min-width: 0;
}

.document-label {
    display: block;
    margin-bottom: 4px;
    color: #667085;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
}

.document-info strong {
    display: block;
    overflow: hidden;
    color: #172033;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.document-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid #0d5cc1;
    border-radius: 8px;
    background: #0d5cc1;
    color: #ffffff;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s ease;
}

.document-button:hover {
    background: #084a9d;
    border-color: #084a9d;
    color: #ffffff;
    text-decoration: none;
    transform: translateY(-1px);
}

.document-button:active {
    transform: translateY(0);
}

.no-document-message {
    margin-top: 16px;
    padding: 15px 18px;
    border: 1px dashed #d0d5dd;
    border-radius: 10px;
    background: #f9fafb;
    color: #667085;
    font-size: 13px;
    line-height: 1.5;
}

@@media (max-width: 700px) {

    .supporting-document-card {
        flex-wrap: wrap;
        align-items: flex-start;
    }

    .document-info {
        width: calc(100% - 62px);
    }

    .document-button {
        width: 100%;
        margin-top: 4px;
    }
}

    .review-decision-section {
        padding: 25px;
    }

    .review-decision-form > label {
        display: block;
        margin-bottom: 7px;
        color: #344054;
        font-size: 11px;
        font-weight: 850;
    }

    .review-comments-textarea {
        width: 100%;
        box-sizing: border-box;
        resize: vertical;
        min-height: 125px;
        padding: 12px;
        border: 1px solid #cfd6df;
        border-radius: 9px;
        color: #253044;
        font-family: inherit;
        font-size: 12px;
        line-height: 1.55;
        outline: none;
    }

    .review-comments-textarea:focus {
        border-color: #0D5CC1;
        box-shadow: 0 0 0 3px rgba(13,92,193,.08);
    }

    .decision-buttons {
        display: flex;
        justify-content: flex-end;
        gap: 9px;
        margin-top: 14px;
    }

    .approve-refund-button,
    .reject-refund-button {
        min-height: 40px;
        padding: 0 15px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 850;
        cursor: pointer;
    }

    .approve-refund-button {
        background: #176b42;
        border: 1px solid #176b42;
        color: #ffffff;
    }

    .approve-refund-button:hover {
        background: #125735;
    }

    .reject-refund-button {
        background: #ffffff;
        border: 1px solid #e3b7b3;
        color: #b42318;
    }

    .reject-refund-button:hover {
        background: #fff5f4;
    }

    .existing-decision-box {
        margin: 0 25px 25px;
        padding: 15px;
        border-radius: 9px;
        background: #fafbfc;
        border: 1px solid #e2e6eb;
    }

    .existing-decision-box p {
        margin: 0;
        color: #52606d;
        font-size: 12px;
        line-height: 1.6;
    }

    .review-side-card {
        padding: 22px;
        height: fit-content;
    }

    .side-card-kicker {
        color: #0D5CC1;
        font-size: 9px;
        font-weight: 900;
        letter-spacing: 1px;
    }

    .review-side-card h2 {
        margin: 7px 0 20px;
        color: #172033;
        font-size: 18px;
    }

    .decision-guide > div {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 13px 0;
        border-bottom: 1px solid #edf0f3;
    }

    .decision-guide > div:last-child {
        border-bottom: none;
    }

    .guide-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 29px;
        width: 29px;
        height: 29px;
        border-radius: 50%;
        background: #eef4fc;
        color: #0D5CC1;
        font-size: 8px;
        font-weight: 900;
    }

    .decision-guide p {
        margin: 0;
        color: #667085;
        font-size: 10px;
        line-height: 1.55;
    }

    .review-refund-bottom {
        display: flex;
        justify-content: space-between;
        margin-top: 18px;
    }

    .review-refund-bottom a {
        color: #344054;
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
    }

    .review-refund-bottom a:last-child {
        color: #0D5CC1;
    }

    @@media (max-width: 850px) {

        .review-refund-layout {
            grid-template-columns: 1fr;
        }

        .review-refund-header {
            align-items: flex-start;
            flex-direction: column;
        }

    }

    @@media (max-width: 600px) {

        .review-refund-page {
            padding: 22px 13px 40px;
        }

        .review-refund-back {
            width: 100%;
        }

        .review-grid {
            grid-template-columns: 1fr;
        }

        .review-status-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .review-reference {
            text-align: left;
        }

        .decision-buttons {
            flex-direction: column;
        }

        .decision-buttons button {
            width: 100%;
        }

        .review-refund-bottom {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
        }

    }

</style>