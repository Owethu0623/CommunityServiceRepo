@model IEnumerable<CommunityServiceProject.Models.Payment>

@{
    ViewBag.Title = "Successful Payments";
}

<div class="successful-payment-page">

    <div class="successful-payment-shell">

        <div class="successful-payment-header">

            <div>
                <div class="page-kicker">
                    US142 • PAYMENT RECEIPTS
                </div>

                <h1>Successful Payments</h1>

                <p>
                    View verified payments and generate formal municipal
                    payment receipts for completed transactions.
                </p>
            </div>

            <div class="header-actions">

                <a href="@Url.Action("Index", "FinanceDashboard")"
                   class="finance-back-button">
                    <span class="back-arrow">←</span>
                    Finance Dashboard
                </a>

                <a href="@Url.Action("Index", "FinancePayment")"
                   class="finance-secondary-button">
                    Payment Verification
                </a>

            </div>

        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="finance-alert finance-alert-success">
                <span class="alert-icon">✓</span>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="finance-alert finance-alert-error">
                <span class="alert-icon">!</span>
                <span>@TempData["ErrorMessage"]</span>
            </div>
        }

        <div class="successful-payment-card">

            <div class="card-heading">

                <div>
                    <span class="section-kicker">
                        VERIFIED PAYMENTS
                    </span>

                    <h2>Payment Receipt Register</h2>
                </div>

                <div class="verified-count">
                    @Model.Count()
                    <span>Verified</span>
                </div>

            </div>

            @if (Model != null && Model.Any())
            {
                <div class="successful-payment-table-wrapper">

                    <table class="successful-payment-table">

                        <thead>
                            <tr>
                                <th>Transaction</th>
                                <th>Invoice</th>
                                <th>Citizen</th>
                                <th>Amount Paid</th>
                                <th>Payment Date</th>
                                <th>Receipt</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var payment in Model)
                            {
                                var receipt =
                                    payment.Receipts != null
                                        ? payment.Receipts.FirstOrDefault()
                                        : null;

                                <tr>

                                    <td>
                                        <span class="transaction-reference">
                                            @payment.TransactionReference
                                        </span>
                                    </td>

                                    <td>
                                        @(payment.Invoice != null
                                            ? payment.Invoice.InvoiceNumber
                                            : "N/A")
                                    </td>

                                    <td>
                                        @if (payment.Citizen != null)
                                        {
                                            <div class="citizen-name">
                                                @payment.Citizen.FirstName
                                                @payment.Citizen.LastName
                                            </div>
                                        }
                                        else
                                        {
                                            <span>N/A</span>
                                        }
                                    </td>

                                    <td>
                                        <strong class="amount-value">
                                            R @payment.Amount.ToString("N2")
                                        </strong>
                                    </td>

                                    <td>
                                        @payment.PaymentDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>

                                        @if (receipt != null)
                                        {
                                            <span class="receipt-generated-badge">
                                                ✓ Generated
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="receipt-pending-badge">
                                                Not Generated
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (receipt != null)
                                        {
                                            <a href="@Url.Action("GenerateReceipt", "FinancePayment", new { id = payment.PaymentID })"
                                               class="receipt-view-button">
                                                View Receipt
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("GenerateReceipt", "FinancePayment", new { id = payment.PaymentID })"
                                               class="receipt-generate-button">
                                                Generate Receipt
                                            </a>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="successful-payment-empty">

                    <div class="empty-icon">
                        ✓
                    </div>

                    <h3>No Successful Payments</h3>

                    <p>
                        There are currently no verified payments available
                        for receipt generation.
                    </p>

                    <a href="@Url.Action("Index", "FinancePayment")"
                       class="empty-back-button">
                        ← Back to Payment Verification
                    </a>

                </div>
            }

        </div>

    </div>

</div>

<style>

    .successful-payment-page {
        min-height: 100vh;
        background: #f5f7fa;
        padding: 38px 28px 60px;
    }

    .successful-payment-shell {
        width: min(1400px, 100%);
        margin: 0 auto;
    }

    .successful-payment-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 30px;
        margin-bottom: 25px;
    }

    .page-kicker,
    .section-kicker {
        color: #0D5CC1;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .successful-payment-header h1 {
        margin: 7px 0 7px;
        color: #172033;
        font-size: 31px;
        font-weight: 850;
    }

    .successful-payment-header p {
        max-width: 720px;
        margin: 0;
        color: #667085;
        font-size: 14px;
        line-height: 1.65;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .finance-back-button,
    .finance-secondary-button,
    .receipt-generate-button,
    .receipt-view-button,
    .empty-back-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 0 16px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 800;
        transition: .2s ease;
    }

    .finance-back-button {
        background: #ffffff;
        border: 1px solid #d7dde6;
        color: #344054;
    }

    .finance-back-button:hover {
        background: #f8fafc;
        color: #172033;
        text-decoration: none;
    }

    .finance-secondary-button {
        background: #eef4fc;
        border: 1px solid #d8e6f8;
        color: #0D5CC1;
    }

    .finance-secondary-button:hover {
        background: #e3eefc;
        text-decoration: none;
    }

    .back-arrow {
        font-size: 18px;
        line-height: 1;
    }

    .finance-alert {
        display: flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 20px;
        padding: 13px 16px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
    }

    .finance-alert-success {
        color: #176b42;
        background: #ecfdf3;
        border: 1px solid #b7ebcd;
    }

    .finance-alert-error {
        color: #b42318;
        background: #fff1f0;
        border: 1px solid #f3c2bf;
    }

    .alert-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 23px;
        height: 23px;
        border-radius: 50%;
        background: rgba(255,255,255,.75);
        font-weight: 900;
    }

    .successful-payment-card {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e3e7ed;
        border-radius: 15px;
        box-shadow: 0 8px 28px rgba(20, 29, 44, .06);
    }

    .card-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 22px 24px;
        border-bottom: 1px solid #e7ebf0;
    }

    .card-heading h2 {
        margin: 6px 0 0;
        color: #172033;
        font-size: 20px;
        font-weight: 800;
    }

    .verified-count {
        min-width: 92px;
        padding: 10px 14px;
        color: #176b42;
        background: #ecfdf3;
        border: 1px solid #c7ead7;
        border-radius: 9px;
        text-align: center;
        font-size: 20px;
        font-weight: 900;
    }

    .verified-count span {
        display: block;
        margin-top: 1px;
        color: #667085;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .7px;
    }

    .successful-payment-table-wrapper {
        overflow-x: auto;
    }

    .successful-payment-table {
        width: 100%;
        border-collapse: collapse;
    }

    .successful-payment-table th {
        padding: 13px 18px;
        background: #fafbfc;
        color: #667085;
        border-bottom: 1px solid #e7ebf0;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: .7px;
        text-align: left;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .successful-payment-table td {
        padding: 17px 18px;
        border-bottom: 1px solid #edf0f3;
        color: #344054;
        font-size: 13px;
        vertical-align: middle;
        white-space: nowrap;
    }

    .successful-payment-table tbody tr:hover {
        background: #fbfcfe;
    }

    .transaction-reference {
        color: #0D5CC1;
        font-weight: 800;
    }

    .citizen-name {
        color: #172033;
        font-weight: 750;
    }

    .amount-value {
        color: #172033;
        font-size: 14px;
    }

    .receipt-generated-badge,
    .receipt-pending-badge {
        display: inline-flex;
        align-items: center;
        min-height: 27px;
        padding: 0 9px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 850;
    }

    .receipt-generated-badge {
        color: #176b42;
        background: #ecfdf3;
        border: 1px solid #c7ead7;
    }

    .receipt-pending-badge {
        color: #667085;
        background: #f4f6f8;
        border: 1px solid #e2e6eb;
    }

    .receipt-generate-button {
        background: #0D5CC1;
        color: #ffffff;
        border: 1px solid #0D5CC1;
    }

    .receipt-generate-button:hover {
        background: #083f8a;
        border-color: #083f8a;
        color: #ffffff;
        text-decoration: none;
    }

    .receipt-view-button {
        background: #eef4fc;
        color: #0D5CC1;
        border: 1px solid #d5e3f6;
    }

    .receipt-view-button:hover {
        background: #e2edfb;
        color: #083f8a;
        text-decoration: none;
    }

    .successful-payment-empty {
        padding: 70px 25px;
        text-align: center;
    }

    .empty-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 54px;
        height: 54px;
        margin: 0 auto 16px;
        border-radius: 50%;
        background: #ecfdf3;
        border: 1px solid #c7ead7;
        color: #176b42;
        font-size: 22px;
        font-weight: 900;
    }

    .successful-payment-empty h3 {
        margin: 0 0 7px;
        color: #172033;
        font-size: 20px;
        font-weight: 800;
    }

    .successful-payment-empty p {
        margin: 0 auto 22px;
        max-width: 500px;
        color: #667085;
        font-size: 13px;
        line-height: 1.6;
    }

    .empty-back-button {
        background: #0D5CC1;
        color: #ffffff;
        border: 1px solid #0D5CC1;
    }

    .empty-back-button:hover {
        background: #083f8a;
        color: #ffffff;
        text-decoration: none;
    }

    @@media (max-width: 900px) {

        .successful-payment-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .header-actions {
            width: 100%;
        }

    }

    @@media (max-width: 600px) {

        .successful-payment-page {
            padding: 22px 14px 40px;
        }

        .successful-payment-header h1 {
            font-size: 26px;
        }

        .card-heading {
            align-items: flex-start;
            flex-direction: column;
        }

        .verified-count {
            min-width: 80px;
        }

        .finance-back-button,
        .finance-secondary-button {
            width: 100%;
        }

    }

</style>