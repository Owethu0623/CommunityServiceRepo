@model CommunityServiceProject.ViewModels.FinancialAuditHistoryViewModel

@{
    ViewBag.Title = "Financial Audit History";
}

<style>

    .audit-page {
        max-width: 1280px;
        margin: 35px auto;
        padding: 0 20px 55px;
    }

    /* =========================================================
       HEADER
       ========================================================= */

    .audit-header {
        margin-bottom: 24px;
    }

    .audit-header h1 {
        margin: 0 0 7px;
        color: #172033;
        font-size: 29px;
        font-weight: 800;
    }

    .audit-header p {
        margin: 0;
        color: #667085;
        font-size: 14px;
        line-height: 1.6;
    }

    /* =========================================================
       SUMMARY
       ========================================================= */

    .audit-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        margin-bottom: 22px;
    }

    .audit-summary-card {
        padding: 19px;
        background: #ffffff;
        border: 1px solid #e4e7ec;
        border-radius: 12px;
        box-shadow: 0 5px 18px rgba(16, 24, 40, .05);
    }

    .audit-summary-label {
        color: #667085;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .7px;
    }

    .audit-summary-value {
        margin-top: 7px;
        color: #172033;
        font-size: 25px;
        font-weight: 800;
    }

    /* =========================================================
       FILTERS
       ========================================================= */

    .audit-filter-card {
        margin-bottom: 22px;
        padding: 21px;
        background: #ffffff;
        border: 1px solid #e4e7ec;
        border-radius: 12px;
        box-shadow: 0 5px 18px rgba(16, 24, 40, .05);
    }

    .audit-filter-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr 1fr auto;
        gap: 12px;
        align-items: end;
    }

    .audit-filter-group label {
        display: block;
        margin-bottom: 6px;
        color: #344054;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .6px;
    }

    .audit-input,
    .audit-select {
        width: 100%;
        height: 40px;
        padding: 0 11px;
        box-sizing: border-box;
        border: 1px solid #d0d5dd;
        border-radius: 8px;
        background: #ffffff;
        color: #172033;
        font-size: 13px;
        outline: none;
    }

    .audit-input:focus,
    .audit-select:focus {
        border-color: #0d5cc1;
        box-shadow: 0 0 0 3px rgba(13, 92, 193, .08);
    }

    .audit-filter-button {
        height: 40px;
        padding: 0 18px;
        border: 1px solid #0d5cc1;
        border-radius: 8px;
        background: #0d5cc1;
        color: #ffffff;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
    }

    .audit-filter-button:hover {
        background: #084a9d;
        border-color: #084a9d;
    }

    /* =========================================================
       AUDIT TABLE
       ========================================================= */

    .audit-table-card {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e4e7ec;
        border-radius: 12px;
        box-shadow: 0 5px 18px rgba(16, 24, 40, .05);
    }

    .audit-table-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 21px;
        border-bottom: 1px solid #eaecf0;
    }

    .audit-table-header h2 {
        margin: 0;
        color: #172033;
        font-size: 16px;
        font-weight: 800;
    }

    .audit-table-count {
        color: #667085;
        font-size: 11px;
        font-weight: 700;
    }

    .audit-table-wrapper {
        overflow-x: auto;
    }

    .audit-table {
        width: 100%;
        min-width: 1200px;
        border-collapse: collapse;
    }

    .audit-table th {
        padding: 12px 16px;
        background: #f8fafc;
        border-bottom: 1px solid #eaecf0;
        color: #667085;
        font-size: 10px;
        font-weight: 800;
        text-align: left;
        text-transform: uppercase;
        letter-spacing: .6px;
        white-space: nowrap;
    }

    .audit-table td {
        padding: 15px 16px;
        border-bottom: 1px solid #f0f2f5;
        color: #344054;
        font-size: 12px;
        vertical-align: top;
    }

    .audit-table tbody tr:hover {
        background: #fafcff;
    }

    .audit-date {
        color: #475467;
        white-space: nowrap;
    }

    .audit-performer {
        color: #172033;
        font-weight: 700;
        white-space: nowrap;
    }

    .audit-action {
        color: #0d5cc1;
        font-weight: 800;
    }

    .audit-reference {
        color: #172033;
        font-weight: 700;
        white-space: nowrap;
    }

    .audit-entity {
        display: inline-flex;
        padding: 5px 8px;
        border-radius: 6px;
        background: #f2f4f7;
        border: 1px solid #e4e7ec;
        color: #475467;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .audit-status {
        color: #667085;
        white-space: nowrap;
    }

    .audit-status strong {
        color: #172033;
    }

    .audit-status-arrow {
        padding: 0 5px;
        color: #98a2b3;
    }

    .audit-amount {
        color: #172033;
        font-weight: 800;
        white-space: nowrap;
    }

    .audit-details {
        max-width: 340px;
        color: #667085;
        line-height: 1.5;
    }

    .audit-ip {
        color: #98a2b3;
        font-size: 11px;
        white-space: nowrap;
    }

    /* =========================================================
       EMPTY
       ========================================================= */

    .audit-empty {
        padding: 55px 25px;
        text-align: center;
    }

    .audit-empty h3 {
        margin: 0 0 7px;
        color: #172033;
        font-size: 17px;
        font-weight: 800;
    }

    .audit-empty p {
        margin: 0;
        color: #667085;
        font-size: 12px;
    }

    /* =========================================================
       FOOTER ACTIONS
       ========================================================= */

    .audit-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 20px;
    }

    .audit-back-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 0 17px;
        border: 1px solid #d0d5dd;
        border-radius: 8px;
        background: #ffffff;
        color: #344054;
        font-size: 12px;
        font-weight: 800;
        text-decoration: none;
    }

    .audit-back-button:hover {
        background: #f8fafc;
        color: #172033;
        text-decoration: none;
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 1050px) {

        .audit-filter-grid {
            grid-template-columns: repeat(3, 1fr);
        }

        .audit-filter-group:first-child {
            grid-column: span 3;
        }

        .audit-summary-grid {
            grid-template-columns: repeat(2, 1fr);
        }

    }

    @@media (max-width: 600px) {

        .audit-page {
            padding: 0 12px 35px;
        }

        .audit-filter-grid {
            grid-template-columns: 1fr;
        }

        .audit-filter-group:first-child {
            grid-column: span 1;
        }

        .audit-summary-grid {
            grid-template-columns: 1fr;
        }

        .audit-actions {
            justify-content: stretch;
        }

        .audit-back-button {
            width: 100%;
        }

    }

</style>


<div class="audit-page">

    <div class="audit-header">

        <h1>
            Financial Audit History
        </h1>

        <p>
            Review recorded Finance Officer actions and financial state changes.
        </p>

    </div>


    <!-- =========================================================
         SUMMARY
         ========================================================= -->

    <div class="audit-summary-grid">

        <div class="audit-summary-card">

            <div class="audit-summary-label">
                Total Audit Events
            </div>

            <div class="audit-summary-value">
                @Model.TotalEvents
            </div>

        </div>


        <div class="audit-summary-card">

            <div class="audit-summary-label">
                Payment Events
            </div>

            <div class="audit-summary-value">
                @Model.PaymentEvents
            </div>

        </div>


        <div class="audit-summary-card">

            <div class="audit-summary-label">
                Refund Events
            </div>

            <div class="audit-summary-value">
                @Model.RefundEvents
            </div>

        </div>


        <div class="audit-summary-card">

            <div class="audit-summary-label">
                Receipt Events
            </div>

            <div class="audit-summary-value">
                @Model.ReceiptEvents
            </div>

        </div>

    </div>


    <!-- =========================================================
         FILTERS
         ========================================================= -->

    <div class="audit-filter-card">

        @using (Html.BeginForm(
            "AuditHistory",
            "FinanceReports",
            FormMethod.Get))
        {
            <div class="audit-filter-grid">

                <div class="audit-filter-group">

                    <label>
                        Search
                    </label>

                    <input type="text"
                           name="searchTerm"
                           value="@Model.SearchTerm"
                           class="audit-input"
                           placeholder="Reference, action or details..." />

                </div>


                <div class="audit-filter-group">

                    <label>
                        Action
                    </label>

                    <select name="actionFilter"
                            class="audit-select">

                        <option value="">
                            All Actions
                        </option>

                        <option value="Payment Verified"
                                @(Model.ActionFilter == "Payment Verified" ? "selected" : "")>
                            Payment Verified
                        </option>

                        <option value="Payment Rejected"
                                @(Model.ActionFilter == "Payment Rejected" ? "selected" : "")>
                            Payment Rejected
                        </option>

                        <option value="Refund Approved"
                                @(Model.ActionFilter == "Refund Approved" ? "selected" : "")>
                            Refund Approved
                        </option>

                        <option value="Refund Rejected"
                                @(Model.ActionFilter == "Refund Rejected" ? "selected" : "")>
                            Refund Rejected
                        </option>

                        <option value="Refund Processing Started"
                                @(Model.ActionFilter == "Refund Processing Started" ? "selected" : "")>
                            Refund Processing Started
                        </option>

                        <option value="Refund Processed"
                                @(Model.ActionFilter == "Refund Processed" ? "selected" : "")>
                            Refund Processed
                        </option>

                        <option value="Receipt Generated"
                                @(Model.ActionFilter == "Receipt Generated" ? "selected" : "")>
                            Receipt Generated
                        </option>

                    </select>

                </div>


                <div class="audit-filter-group">

                    <label>
                        Entity
                    </label>

                    <select name="entityFilter"
                            class="audit-select">

                        <option value="">
                            All
                        </option>

                        <option value="Payment"
                                @(Model.EntityFilter == "Payment" ? "selected" : "")>
                            Payment
                        </option>

                        <option value="Refund"
                                @(Model.EntityFilter == "Refund" ? "selected" : "")>
                            Refund
                        </option>

                        <option value="Receipt"
                                @(Model.EntityFilter == "Receipt" ? "selected" : "")>
                            Receipt
                        </option>

                    </select>

                </div>


                <div class="audit-filter-group">

                    <label>
                        From
                    </label>

                    <input type="date"
                           name="fromDate"
                           value="@(Model.FromDate.HasValue ? Model.FromDate.Value.ToString("yyyy-MM-dd") : "")"
                           class="audit-input" />

                </div>


                <div class="audit-filter-group">

                    <label>
                        To
                    </label>

                    <input type="date"
                           name="toDate"
                           value="@(Model.ToDate.HasValue ? Model.ToDate.Value.ToString("yyyy-MM-dd") : "")"
                           class="audit-input" />

                </div>


                <div>

                    <button type="submit"
                            class="audit-filter-button">
                        Apply Filters
                    </button>

                </div>

            </div>
        }

    </div>


    <!-- =========================================================
         AUDIT TABLE
         ========================================================= -->

    <div class="audit-table-card">

        <div class="audit-table-header">

            <h2>
                Finance Audit Trail
            </h2>

            <span class="audit-table-count">
                @Model.TotalEvents event(s)
            </span>

        </div>


        @if (Model.Records.Any())
        {
            <div class="audit-table-wrapper">

                <table class="audit-table">

                    <thead>

                        <tr>

                            <th>
                                Date / Time
                            </th>

                            <th>
                                Finance Officer
                            </th>

                            <th>
                                Action
                            </th>

                            <th>
                                Entity
                            </th>

                            <th>
                                Reference
                            </th>

                            <th>
                                Status Change
                            </th>

                            <th>
                                Amount
                            </th>

                            <th>
                                Details
                            </th>

                            <th>
                                IP Address
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var record in Model.Records)
                        {
                            <tr>

                                <td>

                                    <span class="audit-date">
                                        @record.AuditDate.ToString("dd MMM yyyy, HH:mm")
                                    </span>

                                </td>


                                <td>

                                    <span class="audit-performer">
                                        @record.PerformedBy
                                    </span>

                                </td>


                                <td>

                                    <span class="audit-action">
                                        @record.Action
                                    </span>

                                </td>


                                <td>

                                    <span class="audit-entity">
                                        @record.EntityType
                                    </span>

                                </td>


                                <td>

                                    <span class="audit-reference">
                                        @record.Reference
                                    </span>

                                </td>


                                <td>

                                    @if (!string.IsNullOrWhiteSpace(record.PreviousStatus) ||
                                         !string.IsNullOrWhiteSpace(record.NewStatus))
                                    {
                                        <div class="audit-status">

                                            <strong>
                                                @record.PreviousStatus
                                            </strong>

                                            <span class="audit-status-arrow">
                                                →
                                            </span>

                                            <strong>
                                                @record.NewStatus
                                            </strong>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="audit-status">
                                            No status change
                                        </span>
                                    }

                                </td>


                                <td>

                                    @if (record.Amount.HasValue)
                                    {
                                        <span class="audit-amount">
                                            R @record.Amount.Value.ToString("N2")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="audit-status">
                                            —
                                        </span>
                                    }

                                </td>


                                <td>

                                    <div class="audit-details">
                                        @record.Details
                                    </div>

                                </td>


                                <td>

                                    <span class="audit-ip">
                                        @(!string.IsNullOrWhiteSpace(record.IPAddress)
                                            ? record.IPAddress
                                            : "Not recorded")
                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="audit-empty">

                <h3>
                    No Audit Events Found
                </h3>

                <p>
                    Finance activity will appear here when state-changing financial actions are performed.
                </p>

            </div>
        }

    </div>


    <div class="audit-actions">

        <a href="@Url.Action("Index", "FinanceDashboard")"
           class="audit-back-button">
            ← Back to Finance Dashboard
        </a>

    </div>

</div>