@model CommunityServiceProject.Models.ForgotPasswordViewModel

@{
    Layout = null;
    ViewBag.Title = "Forgot Password";
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <title>Forgot Password</title>

    <link rel="stylesheet"
          href="@Url.Content("~/Content/ForgotPassword.css")" />

</head>

<body>

    <div class="forgot-page">

        <div class="forgot-top-header">
            <span>7. Forgot Password</span>
        </div>

        <div class="forgot-card">

            <div class="forgot-heading">

                <div class="lock-icon">
                </div>

                <div>
                    <h1>FORGOT PASSWORD</h1>

                    <p>
                        Reset your password securely using a
                        verification code sent to your phoe email.
                    </p>
                </div>

            </div>


            @using (Html.BeginForm(
                "Index",
                "ForgotPassword",
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(
                    true,
                    "",
                    new { @class = "forgot-validation" }
                )


                <!-- ==========================================
                     EMAIL
                     ========================================== -->

                <div class="forgot-form-group">

                    @Html.LabelFor(
                        model => model.EmailAddress,
                        "Email Address"
                    )

                    @Html.TextBoxFor(
                        model => model.EmailAddress,
                        new
                        {
                            @class = "forgot-input",
                            type = "email",
                            placeholder =
                                "Enter your registered email address",
                            autocomplete = "off"
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.EmailAddress,
                        "",
                        new { @class = "forgot-error" }
                    )

                </div>


                <!-- ==========================================
                     STEP 1 - SEND OTP
                     ========================================== -->

                if (!Model.OTPsent)
                {
                    <button type="submit"
                            name="action"
                            value="SendOTP"
                            class="forgot-button">

                        Send Verification Code

                    </button>
                }


                <!-- ==========================================
                     STEP 2 - ENTER OTP
                     ========================================== -->

                if (Model.OTPsent && !Model.OTPVerified)
                {
                    <div class="verified-message">
                        ✓ A verification code has been sent
                        to your registered email address.
                    </div>

                    <div class="forgot-form-group">

                        @Html.LabelFor(
                            model => model.OTP,
                            "Verification Code"
                        )

                        @Html.TextBoxFor(
                            model => model.OTP,
                            new
                            {
                                @class = "forgot-input",
                                placeholder =
                                    "Enter your 6-digit code",
                                maxlength = "6",
                                autocomplete = "one-time-code"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.OTP,
                            "",
                            new { @class = "forgot-error" }
                        )

                    </div>

                    <button type="submit"
                            name="action"
                            value="VerifyOTP"
                            class="forgot-button">

                        Verify Code

                    </button>
                }


                <!-- ==========================================
                     STEP 3 - NEW PASSWORD
                     ========================================== -->

                if (Model.OTPVerified)
                {
                    <div class="verified-message">
                        ✓ Email successfully verified.
                    </div>


                    <div class="forgot-form-group">

                        @Html.LabelFor(
                            model => model.NewPassword,
                            "New Password"
                        )

                        @Html.PasswordFor(
                            model => model.NewPassword,
                            new
                            {
                                @class = "forgot-input",
                                placeholder =
                                    "Enter your new password",
                                autocomplete = "new-password"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.NewPassword,
                            "",
                            new { @class = "forgot-error" }
                        )

                    </div>


                    <div class="forgot-form-group">

                        @Html.LabelFor(
                            model => model.ConfirmPassword,
                            "Confirm Password"
                        )

                        @Html.PasswordFor(
                            model => model.ConfirmPassword,
                            new
                            {
                                @class = "forgot-input",
                                placeholder =
                                    "Confirm your new password",
                                autocomplete = "new-password"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.ConfirmPassword,
                            "",
                            new { @class = "forgot-error" }
                        )

                    </div>


                    <button type="submit"
                            name="action"
                            value="ResetPassword"
                            class="forgot-button">

                        Reset Password

                    </button>
                }

            }


            <div class="login-link">

               

                @Html.ActionLink(
                    "Login here",
                    "Index",
                    "Login"
                )

            </div>

        </div>

    </div>

</body>
</html>