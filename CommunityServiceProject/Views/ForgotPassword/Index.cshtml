@model CommunityServiceProject.Models.ForgotPasswordViewModel

@{
    Layout = null;
    ViewBag.Title = "Forgot Password";
}

<!DOCTYPE html>
<html>
<head>
    

        <meta charset="utf-8" />

        <title>Forgot Password</title>

        <link rel="stylesheet"
              href="@Url.Content("~/Content/ForgotPassword.css")" />

    

   
</head>

<body>

    <div class="forgot-page">

        <!-- Top Blue Header -->
        <div class="forgot-top-header">
            <span>7. Forgot Password</span>
        </div>


        <!-- Main Card -->
        <div class="forgot-card">

            <!-- Heading -->
            <div class="forgot-heading">

                <div class="lock-icon">
                    
                </div>

                <div>
                    <h1>FORGOT PASSWORD</h1>

                    <p>
                        Enter your registered email address to reset your password.
                    </p>
                </div>

            </div>


            @using (Html.BeginForm(
                "Index",
                "ForgotPassword",
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(
                    true,
                    "",
                    new { @class = "forgot-validation" }
                )


                <!-- Email -->
                <div class="forgot-form-group">

                    @Html.LabelFor(
                        model => model.EmailAddress,
                        "Email Address"
                    )

                    @Html.TextBoxFor(
                        model => model.EmailAddress,
                        new
                        {
                            @class = "forgot-input",
                            type = "email",
                            placeholder = "Enter your registered email address"
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.EmailAddress,
                        "",
                        new { @class = "forgot-error" }
                    )

                </div>


                if (!Model.EmailVerified)
                {
                    <!-- Verify Email -->
                    <button type="submit"
                            name="action"
                            value="VerifyEmail"
                            class="forgot-button">

                        <span></span>
                        Verify Email

                    </button>
                }
                else
                {
                    <!-- Verified Message -->
                    <div class="verified-message">
                        ✓ Email verified successfully.
                    </div>


                    <!-- New Password -->
                    <div class="forgot-form-group">

                        @Html.LabelFor(
                            model => model.NewPassword,
                            "New Password"
                        )

                        @Html.PasswordFor(
                            model => model.NewPassword,
                            new
                            {
                                @class = "forgot-input",
                                placeholder = "Enter your new password"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.NewPassword,
                            "",
                            new { @class = "forgot-error" }
                        )

                    </div>


                    <!-- Confirm Password -->
                    <div class="forgot-form-group">

                        @Html.LabelFor(
                            model => model.ConfirmPassword,
                            "Confirm Password"
                        )

                        @Html.PasswordFor(
                            model => model.ConfirmPassword,
                            new
                            {
                                @class = "forgot-input",
                                placeholder = "Confirm your new password"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.ConfirmPassword,
                            "",
                            new { @class = "forgot-error" }
                        )

                    </div>


                    <!-- Reset Button -->
                    <button type="submit"
                            name="action"
                            value="ResetPassword"
                            class="forgot-button">

                        <span></span>
                        Reset Password

                    </button>
                }

            }


            <!-- Back to Login -->
            <div class="login-link">

                Remember your password?

                @Html.ActionLink(
                    "Login here",
                    "Index",
                    "Login"
                )

            </div>

        </div>

    </div>

</body>
</html>