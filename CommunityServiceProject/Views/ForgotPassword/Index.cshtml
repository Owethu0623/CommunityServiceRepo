@model CommunityServiceProject.Models.ForgotPasswordViewModel

@{
    Layout = null;
    ViewBag.Title = "Forgot Password";
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Forgot Password</title>

    <link rel="stylesheet"
          href="@Url.Content("~/Content/ForgotPassword.css")" />

    <link rel="stylesheet"
          href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" />

</head>

<body>

    <div class="forgot-page">

        <!-- ==========================================
             TOP HEADER
             ========================================== -->

        <div class="forgot-top-header">

            <span>Forgot Password</span>

        </div>


        <!-- ==========================================
             MAIN CARD
             ========================================== -->

        <div class="forgot-card">


            <!-- ==========================================
                 HEADING
                 ========================================== -->

            <div class="forgot-heading">

                <div class="lock-icon">
                    <span class="glyphicon glyphicon-lock"></span>
                </div>

                <div>

                    <h1>
                        FORGOT PASSWORD
                    </h1>

                    <p>
                        Reset your password securely using a
                        verification code sent to your email.
                    </p>

                </div>

            </div>


            @using (Html.BeginForm(
                "Index",
                "ForgotPassword",
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()


                <!-- ==========================================
                     VALIDATION
                     ========================================== -->

                @Html.ValidationSummary(
                    true,
                    "",
                    new { @class = "forgot-validation" }
                )


                <!-- ==========================================
                     EMAIL
                     ========================================== -->

                <div class="forgot-form-group">

                    @Html.LabelFor(
                        model => model.EmailAddress,
                        "Email Address"
                    )

                    @Html.TextBoxFor(
                        model => model.EmailAddress,
                        new
                        {
                            @class = "forgot-input",
                            type = "email",
                            placeholder =
                                "Enter your registered email address",
                            autocomplete = "off"
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.EmailAddress,
                        "",
                        new { @class = "forgot-error" }
                    )

                </div>


                <!-- ==========================================
                     STEP 1 - SEND OTP
                     ========================================== -->

                if (!Model.OTPsent)
                {
                    <button type="submit"
                            name="action"
                            value="SendOTP"
                            class="forgot-button">

                        Send Verification Code

                    </button>
                }


                <!-- ==========================================
                     STEP 2 - ENTER OTP
                     ========================================== -->

                if (Model.OTPsent && !Model.OTPVerified)
                {
                    <div class="verified-message">

                        ✓ A verification code has been sent
                        to your registered email address.

                    </div>


                    <div class="forgot-form-group">

                        @Html.LabelFor(
                            model => model.OTP,
                            "Verification Code"
                        )

                        @Html.TextBoxFor(
                            model => model.OTP,
                            new
                            {
                                @class = "forgot-input",
                                placeholder =
                                    "Enter your 6-digit code",
                                maxlength = "6",
                                autocomplete = "one-time-code"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.OTP,
                            "",
                            new { @class = "forgot-error" }
                        )

                    </div>


                    <button type="submit"
                            name="action"
                            value="VerifyOTP"
                            class="forgot-button">

                        Verify Code

                    </button>
                }


                <!-- ==========================================
                     STEP 3 - NEW PASSWORD
                     ========================================== -->

                if (Model.OTPVerified)
                {
                    <div class="verified-message">

                        ✓ Email successfully verified.

                    </div>


                    <!-- NEW PASSWORD -->

                    <div class="forgot-form-group">

                        @Html.LabelFor(
                            model => model.NewPassword,
                            "New Password"
                        )

                        <div class="forgot-input-wrapper">

                            @Html.PasswordFor(
                                model => model.NewPassword,
                                new
                                {
                                    @class =
                                        "forgot-input forgot-password-input",
                                    placeholder =
                                        "Enter your new password",
                                    autocomplete =
                                        "new-password",
                                    id = "NewPassword"
                                }
                            )


                            <!-- EYE -->

                            <button type="button"
                                    class="forgot-password-toggle"
                                    id="newPasswordToggle"
                                    aria-label="Show password">

                                <span class="glyphicon glyphicon-eye-open"></span>

                            </button>

                        </div>


                        @Html.ValidationMessageFor(
                            model => model.NewPassword,
                            "",
                            new { @class = "forgot-error" }
                        )

                    </div>


                    <!-- CONFIRM PASSWORD -->

                    <div class="forgot-form-group">

                        @Html.LabelFor(
                            model => model.ConfirmPassword,
                            "Confirm Password"
                        )

                        @Html.PasswordFor(
                            model => model.ConfirmPassword,
                            new
                            {
                                @class = "forgot-input",
                                placeholder =
                                    "Confirm your new password",
                                autocomplete =
                                    "new-password"
                            }
                        )

                        @Html.ValidationMessageFor(
                            model => model.ConfirmPassword,
                            "",
                            new { @class = "forgot-error" }
                        )

                    </div>


                    <!-- RESET BUTTON -->

                    <button type="submit"
                            name="action"
                            value="ResetPassword"
                            class="forgot-button">

                        Reset Password

                    </button>
                }

            }


            <!-- ==========================================
                 LOGIN LINK
                 ========================================== -->

            <div class="login-link">

                Remember your password?

                @Html.ActionLink(
                    "Login here",
                    "Index",
                    "Login"
                )

            </div>

        </div>

    </div>


    <!-- ==========================================
         PASSWORD EYE SCRIPT
         ========================================== -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            var toggle = document.getElementById("newPasswordToggle");

            if (toggle) {

                toggle.addEventListener("click", function () {

                    var password =
                        document.getElementById("NewPassword");

                    var icon =
                        this.querySelector(".glyphicon");


                    if (password.type === "password") {

                        password.type = "text";

                        icon.classList.remove(
                            "glyphicon-eye-open"
                        );

                        icon.classList.add(
                            "glyphicon-eye-close"
                        );

                    }
                    else {

                        password.type = "password";

                        icon.classList.remove(
                            "glyphicon-eye-close"
                        );

                        icon.classList.add(
                            "glyphicon-eye-open"
                        );

                    }

                });

            }

        });

    </script>

</body>
</html>