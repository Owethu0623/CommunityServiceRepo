
@model CommunityServiceProject.ViewModels.GenerateInvoiceViewModel

@{
    ViewBag.Title = "Generate Invoice";
}

<style>
    .generate-invoice-page {
        max-width: 1150px;
        margin: 0 auto;
        padding: 30px 22px 50px;
        color: #1f2937;
    }

    .page-header {
        background: linear-gradient(135deg, #0D5CC1, #083f8a);
        border-radius: 15px;
        padding: 28px 30px;
        color: white;
        margin-bottom: 24px;
        box-shadow: 0 10px 26px rgba(13,92,193,.18);
    }

        .page-header h1 {
            margin: 0 0 7px;
            font-size: 27px;
        }

        .page-header p {
            margin: 0;
            font-size: 14px;
            opacity: .92;
            line-height: 1.55;
        }

    .reference-pill {
        display: inline-flex;
        margin-top: 17px;
        padding: 7px 12px;
        border-radius: 20px;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.25);
        font-size: 12px;
        font-weight: 700;
    }

    .content-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) minmax(280px, .8fr);
        gap: 22px;
        align-items: start;
    }

    .card {
        background: white;
        border: 1px solid #e1e7ef;
        border-radius: 13px;
        padding: 24px;
        box-shadow: 0 4px 15px rgba(15,23,42,.05);
        margin-bottom: 20px;
    }

        .card:last-child {
            margin-bottom: 0;
        }

        .card h2 {
            margin: 0 0 6px;
            color: #16324f;
            font-size: 19px;
        }

    .card-description {
        margin: 0 0 20px;
        color: #64748b;
        font-size: 13px;
        line-height: 1.5;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px 24px;
    }

    .info-label {
        display: block;
        margin-bottom: 5px;
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .info-value {
        color: #1f2937;
        font-size: 14px;
        font-weight: 650;
        word-break: break-word;
    }

        .info-value.muted {
            color: #64748b;
            font-weight: 500;
        }

    .fee-panel {
        border: 1px solid #d8e4f5;
        background: #f5f9ff;
        border-radius: 11px;
        padding: 19px;
    }

    .fee-amount {
        font-size: 30px;
        font-weight: 800;
        color: #0D5CC1;
        margin-top: 5px;
    }

    .fee-caption {
        color: #64748b;
        font-size: 12px;
        margin-top: 4px;
    }

    .fee-divider {
        height: 1px;
        background: #dbe5f1;
        margin: 17px 0;
    }

    .fee-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 7px 0;
        font-size: 12px;
    }

        .fee-row span:first-child {
            color: #64748b;
        }

        .fee-row span:last-child {
            color: #1f2937;
            font-weight: 650;
            text-align: right;
        }

    .form-group {
        margin-top: 20px;
    }

    .form-label {
        display: block;
        margin-bottom: 7px;
        color: #374151;
        font-size: 13px;
        font-weight: 700;
    }

    .form-control {
        width: 100%;
        box-sizing: border-box;
        border: 1px solid #cfd7e3;
        border-radius: 8px;
        padding: 11px 12px;
        font-size: 14px;
        color: #1f2937;
        background: white;
    }

        .form-control:focus {
            outline: none;
            border-color: #0D5CC1;
            box-shadow: 0 0 0 3px rgba(13,92,193,.10);
        }

    .field-validation {
        display: block;
        margin-top: 5px;
        color: #b42318;
        font-size: 12px;
    }

    .notice {
        margin-top: 17px;
        background: #fff8e8;
        border: 1px solid #f1d99b;
        border-radius: 9px;
        padding: 13px 14px;
        color: #70551c;
        font-size: 12px;
        line-height: 1.55;
    }

    .action-area {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-top: 22px;
        padding-top: 20px;
        border-top: 1px solid #e8edf3;
    }

    .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 17px;
        border-radius: 8px;
        text-decoration: none;
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;
        box-sizing: border-box;
    }

    .primary-button {
        border: 1px solid #0D5CC1;
        background: #0D5CC1;
        color: white;
    }

        .primary-button:hover {
            background: #094b9f;
            border-color: #094b9f;
            color: white;
        }

    .secondary-button {
        border: 1px solid #cfd7e3;
        background: white;
        color: #374151;
    }

        .secondary-button:hover {
            background: #f5f7fa;
            color: #1f2937;
        }

    @@media (max-width: 850px) {
        .content-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .generate-invoice-page {
            padding: 20px 12px 35px;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .action-area {
            flex-direction: column-reverse;
        }

        .button {
            width: 100%;
        }
    }
</style>

<div class="generate-invoice-page">

    <div class="page-header">

        <h1>Generate Invoice</h1>

        <p>
            Review the approved municipal service request and confirm
            the invoice details before issuing the invoice.
        </p>

        <div class="reference-pill">
            Request: @Model.RequestReference
        </div>

    </div>

    @using (Html.BeginForm(
        "Generate",
        "Invoice",
        FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(
            m => m.MunicipalServiceRequestID)

        <div class="content-grid">

            <div>

                <div class="card">

                    <h2>Service Request</h2>

                    <p class="card-description">
                        This request has already been approved by an Administrator
                        and is now ready for Finance processing.
                    </p>

                    <div class="info-grid">

                        <div>
                            <span class="info-label">
                                Request Reference
                            </span>

                            <div class="info-value">
                                @Model.RequestReference
                            </div>
                        </div>

                        <div>
                            <span class="info-label">
                                Citizen
                            </span>

                            <div class="info-value">
                                @Model.CitizenName
                            </div>
                        </div>

                        <div>
                            <span class="info-label">
                                Citizen Email
                            </span>

                            <div class="info-value">
                                @Model.CitizenEmail
                            </div>
                        </div>

                        <div>
                            <span class="info-label">
                                Service Code
                            </span>

                            <div class="info-value">
                                @Model.ServiceCode
                            </div>
                        </div>

                        <div>
                            <span class="info-label">
                                Municipal Service
                            </span>

                            <div class="info-value">
                                @Model.ServiceName
                            </div>
                        </div>

                        <div>
                            <span class="info-label">
                                Fee Type
                            </span>

                            <div class="info-value">
                                @Model.FeeType
                            </div>
                        </div>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(
                        Model.ServiceDescription))
                    {
                        <div class="notice">
                            <strong>Service description:</strong><br />

                            @Model.ServiceDescription
                        </div>
                    }

                </div>

                <div class="card">

                    <h2>Invoice Details</h2>

                    <p class="card-description">
                        Confirm the amount and select the payment due date
                        before issuing the invoice.
                    </p>

                    <div class="fee-panel">

                        <span class="info-label">
                            Amount Payable
                        </span>

                        <div class="fee-amount">
                            @String.Format(
                                System.Globalization.CultureInfo.GetCultureInfo("en-ZA"),
                                "R {0:N2}",
                                Model.Amount)
                        </div>

                        <div class="fee-caption">
                            Amount obtained from the applicable active fee schedule.
                        </div>

                        <div class="fee-divider"></div>

                        <div class="fee-row">
                            <span>Fee Type</span>
                            <span>@Model.FeeType</span>
                        </div>

                        <div class="fee-row">
                            <span>Fee Schedule</span>
                            <span>#@Model.FeeScheduleID</span>
                        </div>

                        <div class="fee-row">
                            <span>Effective From</span>
                            <span>@Model.EffectiveFrom.ToString("dd MMM yyyy")</span>
                        </div>

                        @if (Model.EffectiveTo.HasValue)
                        {
                            <div class="fee-row">
                                <span>Effective To</span>
                                <span>@Model.EffectiveTo.Value.ToString("dd MMM yyyy")</span>
                            </div>
                        }

                    </div>

                    <div class="form-group">

                        <label class="form-label"
                               for="DueDate">
                            Invoice Due Date
                        </label>

                        @Html.TextBoxFor(
                            m => m.DueDate,
                            "{0:yyyy-MM-dd}",
                            new
                            {
                                @class = "form-control",
                                type = "date"
                            })

                        @Html.ValidationMessageFor(
                            m => m.DueDate,
                            "",
                            new
                            {
                                @class = "field-validation"
                            })

                    </div>

                </div>

            </div>

            <div>

                <div class="card">

                    <h2>Before You Issue</h2>

                    <p class="card-description">
                        Confirm the following financial information.
                    </p>

                    <div class="fee-row">
                        <span>Request</span>
                        <span>@Model.RequestReference</span>
                    </div>

                    <div class="fee-row">
                        <span>Service</span>
                        <span>@Model.ServiceName</span>
                    </div>

                    <div class="fee-row">
                        <span>Invoice Amount</span>
                        <span>
                            @String.Format(
                                System.Globalization.CultureInfo.GetCultureInfo("en-ZA"),
                                "R {0:N2}",
                                Model.Amount)
                        </span>
                    </div>

                    <div class="fee-row">
                        <span>Initial Amount Paid</span>
                        <span>R 0.00</span>
                    </div>

                    <div class="fee-row">
                        <span>Initial Balance</span>
                        <span>
                            @String.Format(
                                System.Globalization.CultureInfo.GetCultureInfo("en-ZA"),
                                "R {0:N2}",
                                Model.Amount)
                        </span>
                    </div>

                    <div class="notice">
                        Once the invoice is generated, the municipal service
                        request will proceed to <strong>Payment Required</strong>.
                        Generating an invoice does not mean that the citizen
                        has paid.
                    </div>

                </div>

            </div>

        </div>

        <div class="action-area">

            <a href="@Url.Action(
                "Index",
                "Invoice")"
               class="button secondary-button">
                ← Back to Invoices
            </a>

            <button type="submit"
                    class="button primary-button">
                Generate Invoice
            </button>

        </div>
    }

</div>

