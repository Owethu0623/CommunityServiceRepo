
@model CommunityServiceProject.Models.LoginViewModel

@{
    ViewBag.Title = "Login";
}

<style>
    .municipal-login-page {
        min-height: calc(100vh - 100px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 36px 24px;
        background: #F8FAFD;
        font-family: "Segoe UI", Arial, sans-serif;
    }

    .login-content {
        width: 100%;
        max-width: 500px;
        background: #FFFFFF;
        border: 1px solid #E1E6ED;
        border-radius: 10px;
        padding: 36px 42px 32px;
        box-shadow: 0 6px 20px rgba(20, 33, 61, 0.07);
    }

    .login-brand {
        text-align: center;
        margin-bottom: 22px;
    }

    .brand-icon {
        width: 44px;
        height: 44px;
        margin: 0 auto 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #0D5CC1;
        color: #FFFFFF;
        font-size: 19px;
    }

    .login-brand h1 {
        margin: 0 0 6px;
        color: #14213D;
        font-size: 23px;
        font-weight: 650;
        letter-spacing: -0.2px;
    }

    .login-brand p {
        margin: 0;
        color: #7A8495;
        font-size: 12px;
        line-height: 1.5;
    }

    .validation-summary {
        margin-bottom: 16px;
        padding: 10px 12px;
        border: 1px solid #E1C9C9;
        border-radius: 6px;
        background: #FFF8F8;
        color: #C0392B;
        font-size: 11.5px;
        line-height: 1.5;
    }

        .validation-summary ul {
            margin: 0;
            padding-left: 18px;
        }

        .validation-summary li {
            margin-bottom: 2px;
        }

            .validation-summary li:last-child {
                margin-bottom: 0;
            }

    .form-group {
        margin-bottom: 16px;
    }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            color: #25334A;
            font-size: 12px;
            font-weight: 600;
        }

    .login-input {
        width: 100%;
        height: 46px;
        padding: 0 14px;
        border: 1px solid #D9E1EA;
        border-radius: 6px;
        background: #FFFFFF;
        color: #25334A;
        font-size: 13px;
        box-sizing: border-box;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

        .login-input::placeholder {
            color: #A0A9B6;
        }

        .login-input:focus {
            outline: none;
            border-color: #0D5CC1;
            box-shadow: 0 0 0 3px rgba(13, 92, 193, 0.09);
        }

    .password-wrapper {
        position: relative;
    }

        .password-wrapper .login-input {
            padding-right: 48px;
        }

    .password-toggle {
        position: absolute;
        top: 50%;
        right: 12px;
        transform: translateY(-50%);
        width: 30px;
        height: 30px;
        border: none;
        background: transparent;
        cursor: pointer;
        padding: 0;
    }

    .password-eye {
        position: relative;
        display: block;
        width: 17px;
        height: 11px;
        margin: auto;
        border: 1.5px solid #7A8495;
        border-radius: 50% / 60%;
    }

        .password-eye::after {
            content: "";
            position: absolute;
            width: 4px;
            height: 4px;
            top: 2.5px;
            left: 5px;
            border-radius: 50%;
            background: #7A8495;
        }

    .password-eye-visible {
        border-color: #0D5CC1;
    }

        .password-eye-visible::after {
            background: #0D5CC1;
        }

    .field-validation-error {
        display: block;
        margin-top: 5px;
        color: #C0392B;
        font-size: 11px;
    }

    .appeal-message {
        margin-bottom: 18px;
        padding: 12px 13px;
        border: 1px solid #D9E1EA;
        border-left: 3px solid #0D5CC1;
        border-radius: 6px;
        background: #F8FAFD;
        color: #25334A;
        font-size: 11.5px;
        line-height: 1.5;
    }

        .appeal-message p {
            margin: 0 0 10px;
        }

    .appeal-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 34px;
        padding: 0 14px;
        border-radius: 5px;
        background: #0D5CC1;
        color: #FFFFFF;
        text-decoration: none;
        font-size: 11px;
        font-weight: 600;
    }

        .appeal-button:hover {
            background: #0A4FA8;
            color: #FFFFFF;
            text-decoration: none;
        }

    .forgot-password {
        display: flex;
        justify-content: flex-end;
        margin-top: -5px;
        margin-bottom: 17px;
    }

        .forgot-password a {
            color: #0D5CC1;
            font-size: 11px;
            font-weight: 600;
            text-decoration: none;
        }

            .forgot-password a:hover {
                text-decoration: underline;
            }

    .login-button {
        width: 100%;
        height: 46px;
        border: none;
        border-radius: 6px;
        background: #0D5CC1;
        color: #FFFFFF;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s ease;
    }

        .login-button:hover {
            background: #0A4FA8;
        }

    .login-divider {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 22px 0 17px;
        color: #9AA4B2;
        font-size: 10.5px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .login-divider::before,
        .login-divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #E1E6ED;
        }

    .register-link {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 44px;
        border: 1px solid #D9E1EA;
        border-radius: 6px;
        background: #FFFFFF;
        color: #25334A;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
        box-sizing: border-box;
        transition: border-color 0.15s ease, background 0.15s ease;
    }

        .register-link:hover {
            border-color: #0D5CC1;
            background: #F8FAFD;
            color: #0D5CC1;
            text-decoration: none;
        }

    .security-note {
        margin: 18px 0 0;
        text-align: center;
        color: #7A8495;
        font-size: 10.5px;
        line-height: 1.5;
    }

    .back-home {
        display: block;
        margin-top: 17px;
        text-align: center;
        color: #0D5CC1;
        font-size: 11px;
        font-weight: 600;
        text-decoration: none;
    }

        .back-home:hover {
            text-decoration: underline;
        }

    @@media (max-width: 520px) {
        .municipal-login-page {
            padding: 25px 15px;
        }

        .login-content {
            max-width: 100%;
            padding: 30px 25px 27px;
        }

        .login-brand h1 {
            font-size: 21px;
        }

        .login-input {
            height: 45px;
        }
    /* =========================================================
   ACCOUNT RESTRICTION MESSAGE
   ========================================================= */

.login-restriction-message {
    width: 100%;
    margin: 20px 0;
    padding: 20px 22px;
    border: 1px solid #e0a800;
    border-left: 5px solid #d39e00;
    border-radius: 8px;
    background-color: #fff8e1;
    box-sizing: border-box;
    color: #4a3b00;
}

.login-restriction-message h3 {
    margin: 0 0 12px 0;
    font-size: 20px;
    font-weight: 700;
    color: #7a5c00;
}

.login-restriction-message p {
    margin: 8px 0;
    line-height: 1.6;
    font-size: 14px;
}

.login-restriction-message p strong {
    font-weight: 700;
    color: #5f4800;
}


/* =========================================================
   RESTRICTION DATE INFORMATION
   ========================================================= */

.login-restriction-message p:nth-of-type(2),
.login-restriction-message p:nth-of-type(3) {
    padding: 10px 12px;
    margin: 10px 0;
    border-radius: 5px;
    background-color: #fff3cd;
}


/* =========================================================
   RESTRICTION EXPIRY
   ========================================================= */

.login-restriction-message p:nth-of-type(4) {
    font-weight: 600;
}


/* =========================================================
   RESPONSIVE DESIGN
   ========================================================= */

@@media (max-width: 600px) {

    .login-restriction-message {
        padding: 16px;
        margin: 15px 0;
    }

    .login-restriction-message h3 {
        font-size: 18px;
    }

    .login-restriction-message p {
        font-size: 13px;
    }
}
    }
</style>

<div class="municipal-login-page">

    <div class="login-content">

        <!-- =========================================================
             LOGIN HEADER
             ========================================================= -->

        <div class="login-brand">

            <div class="brand-icon">
                <span class="glyphicon glyphicon-home"></span>
            </div>

            <h1>Welcome Back</h1>

            <p>
                Sign in to your Municipal Service Platform
            </p>

        </div>


        <!-- =========================================================
             GENERAL LOGIN VALIDATION
             ========================================================= -->

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-summary">

                @Html.ValidationSummary(
                         true,
                         "",
                         new { @class = "text-danger" })

            </div>
        }


        <!-- =========================================================
             ACCOUNT RESTRICTION / APPEAL MESSAGE

             These values are supplied by LoginController:
             ViewBag.ShowAppealButton
             ViewBag.AccountStatusMessage
             ViewBag.AppealButtonAction
             ViewBag.AppealID
             ========================================================= -->

        @if (ViewBag.ShowAppealButton == true)
        {
            <div class="appeal-message">

                <p>
                    @ViewBag.AccountStatusMessage
                </p>


                @if (ViewBag.AppealButtonAction == "MakeAppeal")
                {
                    <a href="@Url.Action("Index", "AppealAccess")"
                       class="appeal-button">

                        Make an Appeal

                    </a>
                }
                else if (ViewBag.AppealButtonAction == "ViewStatus")
                {
                    <a href="@Url.Action(
                                "AppealStatus",
                                "Login",
                                new { id = ViewBag.AppealID })"
                       class="appeal-button">

                        View Appeal Status

                    </a>
                }

                @if (ViewBag.IsRestricted == true)
                {
                    <div class="login-restriction-message">

                        <h3>Account Temporarily Restricted</h3>

                        <p>
                            Your account has been restricted from accessing
                            the Municipal Service Platform.
                        </p>

                        <p>
                            <strong>Restriction Type:</strong>
                            New Request Submission
                        </p>

                        <p>
                            <strong>Restriction Period:</strong>
                            @(((DateTime)ViewBag.RestrictionStartDate).ToString("dd MMMM yyyy"))
                            -
                            @(((DateTime)ViewBag.RestrictionEndDate).ToString("dd MMMM yyyy"))
                        </p>

                        <p>
                            <strong>Expires:</strong>
                            @(((DateTime)ViewBag.RestrictionEndDate).ToString("dd MMMM yyyy"))
                        </p>

                        <p>
                            <strong>Reason:</strong>
                            @ViewBag.RestrictionReason
                        </p>

                        <p>
                            You will not be able to access your account while
                            this restriction is active. Please try again after
                            the restriction expiry date.
                        </p>

                    </div>
                }

            </div>
        }


        <!-- =========================================================
             LOGIN FORM

             IMPORTANT:
             LoginController uses:
             POST: /Login/Index
             ========================================================= -->

        @using (Html.BeginForm(
            "Index",
            "Login",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()


            <!-- EMAIL -->

            <div class="form-group">

                <label for="EmailAddress">
                    Email Address
                </label>

                @Html.TextBoxFor(
                         m => m.EmailAddress,
                         new
                         {
                             @class = "login-input",
                             type = "email",
                             autocomplete = "username",
                             placeholder = "Enter your email address"
                         })

                @Html.ValidationMessageFor(
                         m => m.EmailAddress,
                         "",
                         new
                         {
                             @class = "field-validation-error"
                         })

            </div>


            <!-- PASSWORD -->

            <div class="form-group">

                <label for="Password">
                    Password
                </label>

                <div class="password-wrapper">

                    @Html.PasswordFor(
                             m => m.Password,
                             new
                             {
                                 @class = "login-input",
                                 id = "Password",
                                 autocomplete = "current-password",
                                 placeholder = "Enter your password"
                             })


                    <button type="button"
                            id="passwordToggle"
                            class="password-toggle"
                            aria-label="Show password">

                        <span class="password-eye"></span>

                    </button>

                </div>

                @Html.ValidationMessageFor(
                         m => m.Password,
                         "",
                         new
                         {
                             @class = "field-validation-error"
                         })

            </div>


            <!-- FORGOT PASSWORD -->

            <div class="forgot-password">

                <a href="@Url.Action(
                            "Index",
                            "ForgotPassword")">

                    Forgot Password?

                </a>

            </div>


            <!-- SIGN IN -->

            <button type="submit"
                    class="login-button">

                Sign In

            </button>

        }


        <!-- =========================================================
             CITIZEN REGISTRATION
             ========================================================= -->

        <div class="login-divider">

            <span>OR</span>

        </div>


        <a href="@Url.Action(
                    "Create",
                    "Citizens")"
           class="register-link">

            Create Citizen Account

        </a>


        <!-- =========================================================
             SECURITY MESSAGE
             ========================================================= -->

        <p class="security-note">

            Your account information is protected and securely
            managed by the Municipal Service Platform.

        </p>


        <!-- =========================================================
             BACK TO HOME
             ========================================================= -->

        <a href="@Url.Action(
                    "Index",
                    "Home")"
           class="back-home">

            Back to Home

        </a>

    </div>

</div>


@section Scripts {

    @Scripts.Render("~/bundles/jqueryval")


    <script>

        document
            .getElementById("passwordToggle")
            .addEventListener("click", function () {

                var password =
                    document.getElementById("Password");

                var eye =
                    this.querySelector(".password-eye");


                if (password.type === "password") {

                    password.type = "text";

                    eye.classList.add(
                        "password-eye-visible"
                    );

                    this.setAttribute(
                        "aria-label",
                        "Hide password"
                    );

                }
                else {

                    password.type = "password";

                    eye.classList.remove(
                        "password-eye-visible"
                    );

                    this.setAttribute(
                        "aria-label",
                        "Show password"
                    );

                }

            });

    </script>

}

