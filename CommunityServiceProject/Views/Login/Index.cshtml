@model CommunityServiceProject.Models.LoginViewModel

@{
    ViewBag.Title = "Login";
}



<div class="login-page">

    <!-- PAGE HEADING -->
    <div class="login-header">

        <h1>
            CITIZEN LOGIN
        </h1>

        <p>
            Login to your Community Service Request ad maitece accout account
        </p>

        <hr />

    </div>


    <!-- LOGIN CARD -->
    <div class="login-card">

        @using (Html.BeginForm("Index", "Login", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <!-- VALIDATION -->
            @Html.ValidationSummary(
                true,
                "",
                new { @class = "login-validation" }
            )


            <!-- EMAIL -->
            <div class="login-form-group">

                @Html.LabelFor(
                    m => m.EmailAddress,
                    "Email Address"
                )

                <div class="login-input-wrapper">

                    <span class="login-input-icon">
                        <span class="glyphicon glyphicon-envelope"></span>
                    </span>

                    @Html.TextBoxFor(
                        m => m.EmailAddress,
                        new
                        {
                            @class = "form-control login-input",
                            placeholder = "Enter your email address",
                            autocomplete = "off"
                        }
                    )

                </div>

                @Html.ValidationMessageFor(
                    m => m.EmailAddress,
                    "",
                    new { @class = "text-danger" }
                )

            </div>


            <!-- PASSWORD -->
            <div class="login-form-group">

                @Html.LabelFor(
                    m => m.Password,
                    "Password"
                )

                <div class="login-input-wrapper">

                    <span class="login-input-icon">
                        <span class="glyphicon glyphicon-lock"></span>
                    </span>

                    @Html.PasswordFor(
                        m => m.Password,
                        new
                        {
                            @class = "form-control login-input password-input",
                            placeholder = "Enter your password",
                            autocomplete = "off",
                            id = "Password"
                        }
                    )

                    <button type="button"
                            class="password-toggle"
                            id="passwordToggle"
                            aria-label="Show password">

                        <span class="password-eye"></span>

                    </button>

                </div>

                @Html.ValidationMessageFor(
                    m => m.Password,
                    "",
                    new { @class = "text-danger" }
                )

            </div>
            <!-- FORGOT PASSWORD -->
            <div class="forgot-password">

                <a href="@Url.Action("Index", "ForgotPassword")">
                    Forgot Password?
                </a>

            </div>


            <!-- LOGIN BUTTON -->
            <button type="submit"
                    class="login-submit-button">

                <span class="glyphicon glyphicon-log-in"></span>

                <span>
                    Login
                </span>

            </button>

        }


        <!-- OR DIVIDER -->
        <div class="login-or">

            <span></span>

            <strong>OR</strong>

            <span></span>

        </div>


        <!-- CREATE ACCOUNT -->
        <div class="create-account-box">

            <p>
                Don't have an account?
            </p>

            <a href="@Url.Action("Create", "Citizens")"
               class="create-account-button">

                Create an Account

            </a>

        </div>
        </div>
    </div>


    <!-- BACK HOME -->
    <div class="login-home-link">

        <a href="@Url.Action("Index", "Home")">
            <span class="glyphicon glyphicon-arrow-left"></span>
            Back to Home
        </a>

    </div>

    @section Scripts {

        @Scripts.Render("~/bundles/jqueryval")

        <script>
            document.getElementById("passwordToggle").addEventListener("click", function () {

                var password = document.getElementById("Password");
                var eye = this.querySelector(".password-eye");

                if (password.type === "password") {
                    password.type = "text";
                    eye.classList.add("password-eye-visible");
                    this.setAttribute("aria-label", "Hide password");
                }
                else {
                    password.type = "password";
                    eye.classList.remove("password-eye-visible");
                    this.setAttribute("aria-label", "Show password");
                }

            });
        </script>

    }
