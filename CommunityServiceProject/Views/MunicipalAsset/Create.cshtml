@model CommunityServiceProject.ViewModels.MunicipalAssetEditViewModel

@{
    ViewBag.Title = "Edit Municipal Asset";
}

<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="" />

<div class="municipal-asset-edit-page">

    <div class="municipal-asset-edit-header">

        <div>

            <div class="page-eyebrow">
                MUNICIPAL ASSET MANAGEMENT
            </div>

            <h1>
                <span class="header-icon">▣</span>
                Edit Municipal Asset
            </h1>

            <p>
                Update the registered information, location and operational
                details of this municipal asset.
            </p>

        </div>

        <div class="header-actions">

            <a href="@Url.Action("Details", "MunicipalAsset", new { id = Model.AssetID })"
               class="btn btn-secondary">

                ← Back to Asset Details

            </a>

        </div>

    </div>


    <!-- =========================================================
         EDIT INFORMATION NOTICE
         ========================================================= -->

    <div class="asset-info-notice">

        <div class="notice-icon">
            i
        </div>

        <div>

            <strong>
                Updating a municipal asset
            </strong>

            <p>
                Review the existing asset information carefully before saving.
                Changes made to this asset are recorded in the asset history
                for administrative auditing.
            </p>

        </div>

    </div>


    @using (Html.BeginForm(
        "Edit",
        "MunicipalAsset",
        FormMethod.Post,
        new
        {
            @class = "asset-edit-form",
            id = "assetEditForm"
        }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(
            model => model.AssetID)

        @Html.HiddenFor(
            model => model.AssetCode)


        <!-- =========================================================
             VALIDATION SUMMARY
             ========================================================= -->

        <div class="validation-container">

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "validation-summary" })

        </div>


        <!-- =========================================================
             SECTION 1 - ASSET IDENTIFICATION
             ========================================================= -->

        <div class="form-card">

            <div class="form-card-header">

                <div class="section-number">
                    01
                </div>

                <div>

                    <h2>
                        Asset Identification
                    </h2>

                    <p>
                        Review the registered identity of the municipal asset.
                    </p>

                </div>

            </div>


            <div class="form-card-body">

                <div class="form-grid">

                    <!-- Asset Code -->

                    <div class="form-group">

                        @Html.LabelFor(
                            model => model.AssetCode,
                            new { @class = "form-label" })

                        @Html.TextBoxFor(
                            model => model.AssetCode,
                            new
                            {
                                @class = "form-control",
                                @readonly = "readonly"
                            })

                        <small class="field-help">
                            Asset Code is generated by the system and cannot be changed.
                        </small>

                    </div>


                    <!-- Asset Name -->

                    <div class="form-group">

                        @Html.LabelFor(
                            model => model.AssetName,
                            new { @class = "form-label" })

                        @Html.TextBoxFor(
                            model => model.AssetName,
                            new
                            {
                                @class = "form-control",
                                maxlength = "150",
                                placeholder = "Enter asset name"
                            })

                        @Html.ValidationMessageFor(
                            model => model.AssetName,
                            "",
                            new { @class = "field-validation" })

                        <small class="field-help">
                            Update the asset name if the registered description requires correction.
                        </small>

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================================================
             SECTION 2 - ASSET CLASSIFICATION
             ========================================================= -->

        <div class="form-card">

            <div class="form-card-header">

                <div class="section-number">
                    02
                </div>

                <div>

                    <h2>
                        Asset Classification
                    </h2>

                    <p>
                        Update the type, category, description and municipal ward.
                    </p>

                </div>

            </div>


            <div class="form-card-body">

                <div class="form-grid">


                    <!-- Asset Type -->

                    <div class="form-group">

                        @Html.LabelFor(
                            model => model.AssetType,
                            new { @class = "form-label" })

                        @Html.DropDownListFor(
                            model => model.AssetType,
                            Model.AssetTypeOptions,
                            "-- Select Asset Type --",
                            new
                            {
                                @class = "form-control",
                                id = "AssetType"
                            })

                        @Html.ValidationMessageFor(
                            model => model.AssetType,
                            "",
                            new { @class = "field-validation" })

                        <small class="field-help">
                            Select the main municipal infrastructure classification.
                        </small>

                    </div>


                    <!-- Asset Category -->

                    <div class="form-group">

                        @Html.LabelFor(
                            model => model.AssetCategory,
                            new { @class = "form-label" })

                        @Html.DropDownListFor(
                            model => model.AssetCategory,
                            Model.AssetCategoryOptions,
                            "-- Select Asset Category --",
                            new
                            {
                                @class = "form-control",
                                id = "AssetCategory"
                            })

                        @Html.ValidationMessageFor(
                            model => model.AssetCategory,
                            "",
                            new { @class = "field-validation" })

                        <small class="field-help">
                            Available categories depend on the selected asset type.
                        </small>

                    </div>

                </div>


                <!-- Description -->

                <div class="form-group full-width">

                    @Html.LabelFor(
                        model => model.Description,
                        new { @class = "form-label" })

                    @Html.TextAreaFor(
                        model => model.Description,
                        new
                        {
                            @class = "form-control textarea-control",
                            rows = "4",
                            maxlength = "1000",
                            placeholder = "Provide a brief description of the asset..."
                        })

                    @Html.ValidationMessageFor(
                        model => model.Description,
                        "",
                        new { @class = "field-validation" })

                    <small class="field-help">
                        Update useful identifying or operational information where required.
                    </small>

                </div>


                <!-- Ward -->

                <div class="form-group">

                    @Html.LabelFor(
                        model => model.WardID,
                        new { @class = "form-label" })

                    @Html.DropDownListFor(
                        model => model.WardID,
                        Model.WardOptions,
                        "-- Select Municipal Ward --",
                        new
                        {
                            @class = "form-control",
                            id = "WardID"
                        })

                    @Html.ValidationMessageFor(
                        model => model.WardID,
                        "",
                        new { @class = "field-validation" })

                    <small class="field-help">
                        Select the municipal ward where this asset is physically located.
                    </small>

                </div>

            </div>

        </div>


        <!-- =========================================================
             SECTION 3 - ASSET LOCATION
             ========================================================= -->

        <div class="form-card">

            <div class="form-card-header">

                <div class="section-number">
                    03
                </div>

                <div>

                    <h2>
                        Asset Location
                    </h2>

                    <p>
                        Review or update the physical location of the municipal asset.
                    </p>

                </div>

            </div>


            <div class="form-card-body">


                <div class="location-notice">

                    <div class="location-notice-icon">
                        ⌖
                    </div>

                    <div>

                        <strong>
                            Location information
                        </strong>

                        <p>
                            The current asset location is displayed on the map.
                            Search for a new address, click the map, or drag the
                            marker to update the location.
                        </p>

                    </div>

                </div>


                <!-- Address Search -->

                <div class="address-search-section">

                    <label class="form-label"
                           for="addressSearch">

                        Search for an Address

                    </label>

                    <div class="address-search-row">

                        <input type="text"
                               id="addressSearch"
                               class="form-control"
                               maxlength="200"
                               autocomplete="off"
                               placeholder="e.g. Cedar Street, Durban" />

                        <button type="button"
                                id="searchAddressButton"
                                class="btn btn-search">

                            <span class="button-icon">
                                ⌕
                            </span>

                            Search Address

                        </button>

                    </div>


                    <div id="searchStatus"
                         class="location-status"
                         aria-live="polite">
                    </div>


                    <div id="searchResults"
                         class="location-search-results">
                    </div>

                </div>


                <!-- Map -->

                <div class="map-container">

                    <div id="assetEditMap"></div>

                </div>


                <div class="map-help">

                    <span>●</span>

                    Click anywhere on the map or drag the marker to update the asset location.

                </div>


                <!-- Select Centre -->

                <div class="map-centre-row">

                    <button type="button"
                            id="selectMapCentre"
                            class="btn btn-map-centre">

                        ⌖ Select Map Centre

                    </button>

                    <span id="locationStatus"
                          class="location-status"
                          aria-live="polite">
                    </span>

                </div>


                <!-- Existing Coordinates -->

                <div class="selected-location-panel">

                    <div class="selected-location-header">

                        <div>

                            <span class="selected-location-icon">
                                ✓
                            </span>

                            <div>

                                <strong>
                                    Current Asset Location
                                </strong>

                                <small>
                                    Existing coordinates for this asset
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="coordinate-grid">

                        <div class="coordinate-box">

                            <span class="coordinate-label">
                                Latitude
                            </span>

                            <strong id="latitudeDisplay">
                                @Model.Latitude
                            </strong>

                        </div>


                        <div class="coordinate-box">

                            <span class="coordinate-label">
                                Longitude
                            </span>

                            <strong id="longitudeDisplay">
                                @Model.Longitude
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- Location Description -->

                <div class="form-group location-description-group">

                    @Html.LabelFor(
                        model => model.LocationDescription,
                        new { @class = "form-label" })

                    @Html.TextBoxFor(
                        model => model.LocationDescription,
                        new
                        {
                            @class = "form-control",
                            id = "LocationDescription",
                            maxlength = "500",
                            placeholder = "e.g. Cedar Street near the municipal offices"
                        })

                    @Html.ValidationMessageFor(
                        model => model.LocationDescription,
                        "",
                        new { @class = "field-validation" })

                    <small class="field-help">
                        Update the physical location description or nearby landmark if required.
                    </small>

                </div>

            </div>

        </div>


        <!-- =========================================================
             SECTION 4 - OPERATIONAL INFORMATION
             ========================================================= -->

        <div class="form-card">

            <div class="form-card-header">

                <div class="section-number">
                    04
                </div>

                <div>

                    <h2>
                        Operational Information
                    </h2>

                    <p>
                        Update the current condition and operational status of the asset.
                    </p>

                </div>

            </div>


            <div class="form-card-body">

                <div class="form-grid">


                    <!-- Condition -->

                    <div class="form-group">

                        @Html.LabelFor(
                            model => model.Condition,
                            new { @class = "form-label" })

                        @Html.EnumDropDownListFor(
                            model => model.Condition,
                            "-- Select Condition --",
                            new
                            {
                                @class = "form-control",
                                id = "Condition"
                            })

                        @Html.ValidationMessageFor(
                            model => model.Condition,
                            "",
                            new { @class = "field-validation" })

                    </div>


                    <!-- Status -->

                    <div class="form-group">

                        @Html.LabelFor(
                            model => model.Status,
                            new { @class = "form-label" })

                        @Html.EnumDropDownListFor(
                            model => model.Status,
                            "-- Select Status --",
                            new
                            {
                                @class = "form-control",
                                id = "Status"
                            })

                        @Html.ValidationMessageFor(
                            model => model.Status,
                            "",
                            new { @class = "field-validation" })

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================================================
             SECTION 5 - UPDATE INFORMATION
             ========================================================= -->

        <div class="form-card update-information-card">

            <div class="form-card-header">

                <div class="section-number">
                    05
                </div>

                <div>

                    <h2>
                        Update Information
                    </h2>

                    <p>
                        Information about how this update is recorded.
                    </p>

                </div>

            </div>


            <div class="form-card-body">

                <div class="update-information">

                    <div class="update-information-icon">
                        ✓
                    </div>

                    <div>

                        <strong>
                            Changes are recorded automatically
                        </strong>

                        <p>
                            When you save changes, the system records the
                            updated information, the date of the update and
                            the administrator responsible for the change.
                        </p>

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================================================
             FORM ACTIONS
             ========================================================= -->

        <div class="form-actions">

            <a href="@Url.Action("Details", "MunicipalAsset", new { id = Model.AssetID })"
               class="btn btn-cancel">

                Cancel

            </a>


            <button type="submit"
                    id="saveAssetButton"
                    class="btn btn-primary">

                <span class="button-icon">
                    ✓
                </span>

                Save Changes

            </button>

        </div>

    }

</div>


<!-- ================================================================
     LEAFLET
     ================================================================ -->

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin="">
</script>


<script>

    (function () {

        "use strict";


        function initialiseEditPage() {


            /* =========================================================
               CLASSIFICATION
               ========================================================= */

            var categoryMap = {

                "Road Infrastructure": [
                    "Road"
                ],

                "Street Lighting": [
                    "Streetlight",
                    "High-Mast Light"
                ],

                "Water Infrastructure": [
                    "Water Pipe",
                    "Water Valve",
                    "Fire Hydrant"
                ],

                "Stormwater Infrastructure": [
                    "Stormwater Drain",
                    "Drainage Channel"
                ],

                "Traffic Infrastructure": [
                    "Traffic Signal"
                ],

                "Waste Management": [
                    "Waste Container"
                ],

                "Public Facilities": [
                    "Community Facility"
                ],

                "Parks and Recreation": [
                    "Park Facility"
                ],

                "Municipal Buildings": [
                    "Municipal Building"
                ]

            };


            var assetType =
                document.getElementById("AssetType");

            var assetCategory =
                document.getElementById("AssetCategory");


            function updateCategories() {

                var selectedType =
                    assetType.value;

                var currentCategory =
                    assetCategory.value;

                assetCategory.innerHTML = "";


                var defaultOption =
                    document.createElement("option");

                defaultOption.value = "";

                defaultOption.textContent =
                    "-- Select Asset Category --";

                assetCategory.appendChild(
                    defaultOption
                );


                if (
                    selectedType &&
                    categoryMap[selectedType]
                ) {

                    categoryMap[selectedType].forEach(
                        function (category) {

                            var option =
                                document.createElement(
                                    "option"
                                );

                            option.value =
                                category;

                            option.textContent =
                                category;

                            assetCategory.appendChild(
                                option
                            );

                        }
                    );


                    if (
                        categoryMap[selectedType]
                            .indexOf(currentCategory) !== -1
                    ) {

                        assetCategory.value =
                            currentCategory;

                    }

                }

            }


            assetType.addEventListener(
                "change",
                updateCategories
            );


            /* =========================================================
               MAP
               ========================================================= */

            var mapElement =
                document.getElementById(
                    "assetEditMap"
                );


            if (!mapElement) {

                console.error(
                    "Municipal asset edit map element was not found."
                );

                return;

            }


            if (typeof L === "undefined") {

                var failedMapMessage =
                    document.createElement(
                        "div"
                    );

                failedMapMessage.className =
                    "map-load-error";

                failedMapMessage.textContent =
                    "The map could not be loaded. Please refresh the page and try again.";

                mapElement.appendChild(
                    failedMapMessage
                );

                return;

            }


            var latitudeInput =
                document.getElementById(
                    "Latitude"
                );

            var longitudeInput =
                document.getElementById(
                    "Longitude"
                );


            /*
             * MVC TextBoxFor creates IDs:
             *
             * Latitude
             * Longitude
             *
             * We therefore use those exact IDs here.
             */


            var latitude =
                parseFloat(
                    latitudeInput.value
                );

            var longitude =
                parseFloat(
                    longitudeInput.value
                );


            var defaultLatitude =
                -29.8587;

            var defaultLongitude =
                31.0218;


            if (
                !Number.isFinite(latitude) ||
                latitude < -90 ||
                latitude > 90
            ) {

                latitude =
                    defaultLatitude;

            }


            if (
                !Number.isFinite(longitude) ||
                longitude < -180 ||
                longitude > 180
            ) {

                longitude =
                    defaultLongitude;

            }


            var map =
                L.map(
                    "assetEditMap",
                    {
                        zoomControl: true
                    }
                );


            map.setView(
                [
                    latitude,
                    longitude
                ],
                15
            );


            L.tileLayer(
                "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                {
                    maxZoom: 19,
                    attribution:
                        "&copy; OpenStreetMap contributors"
                }
            ).addTo(map);


            var marker =
                L.marker(
                    [
                        latitude,
                        longitude
                    ],
                    {
                        draggable: true
                    }
                );


            marker.addTo(map);


            var latitudeDisplay =
                document.getElementById(
                    "latitudeDisplay"
                );

            var longitudeDisplay =
                document.getElementById(
                    "longitudeDisplay"
                );


            var locationDescription =
                document.getElementById(
                    "LocationDescription"
                );


            var locationStatus =
                document.getElementById(
                    "locationStatus"
                );


            var searchStatus =
                document.getElementById(
                    "searchStatus"
                );


            var searchResults =
                document.getElementById(
                    "searchResults"
                );


            var addressSearch =
                document.getElementById(
                    "addressSearch"
                );


            var searchButton =
                document.getElementById(
                    "searchAddressButton"
                );


            var selectMapCentre =
                document.getElementById(
                    "selectMapCentre"
                );


            var editForm =
                document.getElementById(
                    "assetEditForm"
                );


            var saveButton =
                document.getElementById(
                    "saveAssetButton"
                );


            function setLocationStatus(
                message,
                type
            ) {

                locationStatus.textContent =
                    message;

                locationStatus.classList.remove(
                    "success",
                    "error",
                    "warning"
                );


                if (type) {

                    locationStatus.classList.add(
                        type
                    );

                }

            }


            function setSearchStatus(
                message,
                type
            ) {

                searchStatus.textContent =
                    message;

                searchStatus.classList.remove(
                    "success",
                    "error",
                    "warning"
                );


                if (type) {

                    searchStatus.classList.add(
                        type
                    );

                }

            }


            function updateCoordinateDisplay(
                latitude,
                longitude
            ) {

                latitudeDisplay.textContent =
                    Number(latitude).toFixed(6);

                longitudeDisplay.textContent =
                    Number(longitude).toFixed(6);

            }


            function updateCoordinates(
                latitude,
                longitude
            ) {

                var lat =
                    parseFloat(latitude);

                var lon =
                    parseFloat(longitude);


                if (
                    !Number.isFinite(lat) ||
                    !Number.isFinite(lon)
                ) {

                    return false;

                }


                latitudeInput.value =
                    lat.toFixed(6);

                longitudeInput.value =
                    lon.toFixed(6);


                updateCoordinateDisplay(
                    lat,
                    lon
                );


                return true;

            }


            function selectLocation(
                latitude,
                longitude,
                performReverseGeocode
            ) {

                latitude =
                    parseFloat(latitude);

                longitude =
                    parseFloat(longitude);


                if (
                    !Number.isFinite(latitude) ||
                    !Number.isFinite(longitude)
                ) {

                    setLocationStatus(
                        "The selected coordinates are invalid.",
                        "error"
                    );

                    return;

                }


                if (
                    latitude < -90 ||
                    latitude > 90 ||
                    longitude < -180 ||
                    longitude > 180
                ) {

                    setLocationStatus(
                        "The selected coordinates are outside the valid range.",
                        "error"
                    );

                    return;

                }


                if (
                    Math.abs(latitude) < 0.000001 &&
                    Math.abs(longitude) < 0.000001
                ) {

                    setLocationStatus(
                        "Please select a valid municipal location.",
                        "error"
                    );

                    return;

                }


                updateCoordinates(
                    latitude,
                    longitude
                );


                marker.setLatLng(
                    [
                        latitude,
                        longitude
                    ]
                );


                map.setView(
                    [
                        latitude,
                        longitude
                    ],
                    Math.max(
                        map.getZoom(),
                        15
                    )
                );


                setLocationStatus(
                    "Location selected.",
                    "success"
                );


                if (performReverseGeocode) {

                    reverseGeocode(
                        latitude,
                        longitude
                    );

                }

            }


            /* =========================================================
               INITIAL DISPLAY
               ========================================================= */

            updateCoordinateDisplay(
                latitude,
                longitude
            );


            setLocationStatus(
                "Current asset location loaded.",
                "success"
            );


            /* =========================================================
               MARKER DRAG
               ========================================================= */

            marker.on(
                "dragend",
                function () {

                    var position =
                        marker.getLatLng();

                    selectLocation(
                        position.lat,
                        position.lng,
                        true
                    );

                }
            );


            /* =========================================================
               MAP CLICK
               ========================================================= */

            map.on(
                "click",
                function (event) {

                    selectLocation(
                        event.latlng.lat,
                        event.latlng.lng,
                        true
                    );

                }
            );


            /* =========================================================
               MAP CENTRE
               ========================================================= */

            selectMapCentre.addEventListener(
                "click",
                function () {

                    var centre =
                        map.getCenter();

                    selectLocation(
                        centre.lat,
                        centre.lng,
                        true
                    );

                }
            );


            /* =========================================================
               REVERSE GEOCODING
               ========================================================= */

            var reverseGeocodeTimer =
                null;


            function reverseGeocode(
                latitude,
                longitude
            ) {

                if (
                    reverseGeocodeTimer !== null
                ) {

                    clearTimeout(
                        reverseGeocodeTimer
                    );

                }


                reverseGeocodeTimer =
                    setTimeout(
                        function () {

                            setLocationStatus(
                                "Identifying selected location...",
                                "warning"
                            );


                            var url =
                                "@Url.Action("ReverseGeocode", "MunicipalAsset")";


                            var separator =
                                url.indexOf("?") === -1
                                    ? "?"
                                    : "&";


                            url +=
                                separator +
                                "lat=" +
                                encodeURIComponent(
                                    latitude
                                ) +
                                "&lon=" +
                                encodeURIComponent(
                                    longitude
                                );


                            fetch(
                                url,
                                {
                                    method: "GET",

                                    headers: {
                                        "Accept":
                                            "application/json"
                                    }
                                }
                            )
                            .then(
                                function (response) {

                                    if (!response.ok) {

                                        throw new Error(
                                            "Reverse geocoding request failed."
                                        );

                                    }

                                    return response.json();

                                }
                            )
                            .then(
                                function (data) {

                                    if (
                                        data &&
                                        data.success === false
                                    ) {

                                        setLocationStatus(
                                            data.message ||
                                            "Unable to identify the selected location.",
                                            "error"
                                        );

                                        return;

                                    }


                                    if (
                                        data &&
                                        data.display_name
                                    ) {

                                        if (
                                            !locationDescription
                                                .value
                                                .trim()
                                        ) {

                                            locationDescription.value =
                                                data.display_name;

                                        }


                                        setLocationStatus(
                                            "Location identified successfully.",
                                            "success"
                                        );

                                    }
                                    else {

                                        setLocationStatus(
                                            "Coordinates updated. Location description can be entered manually.",
                                            "success"
                                        );

                                    }

                                }
                            )
                            .catch(
                                function (error) {

                                    console.error(error);

                                    setLocationStatus(
                                        "Coordinates updated. Location description can be entered manually.",
                                        "success"
                                    );

                                }
                            );

                        },
                        350
                    );

            }


            /* =========================================================
               ADDRESS SEARCH
               ========================================================= */

            searchButton.addEventListener(
                "click",
                function () {

                    var query =
                        addressSearch.value.trim();


                    if (!query) {

                        setSearchStatus(
                            "Please enter an address or location to search.",
                            "error"
                        );

                        addressSearch.focus();

                        return;

                    }


                    searchButton.disabled =
                        true;


                    searchResults.innerHTML =
                        "";


                    setSearchStatus(
                        "Searching for locations...",
                        "warning"
                    );


                    var url =
                        "@Url.Action("SearchAddress", "MunicipalAsset")";


                    var separator =
                        url.indexOf("?") === -1
                            ? "?"
                            : "&";


                    url +=
                        separator +
                        "query=" +
                        encodeURIComponent(
                            query
                        );


                    fetch(
                        url,
                        {
                            method: "GET",

                            headers: {
                                "Accept":
                                    "application/json"
                            }
                        }
                    )
                    .then(
                        function (response) {

                            if (!response.ok) {

                                throw new Error(
                                    "Address search request failed."
                                );

                            }

                            return response.json();

                        }
                    )
                    .then(
                        function (data) {

                            searchResults.innerHTML =
                                "";


                            if (
                                data &&
                                data.success === false
                            ) {

                                setSearchStatus(
                                    data.message ||
                                    "Unable to search for the location.",
                                    "error"
                                );

                                return;

                            }


                            if (!Array.isArray(data)) {

                                setSearchStatus(
                                    "The location search returned an unexpected response.",
                                    "error"
                                );

                                return;

                            }


                            if (data.length === 0) {

                                setSearchStatus(
                                    "No matching locations were found.",
                                    "warning"
                                );

                                return;

                            }


                            setSearchStatus(
                                data.length +
                                " location(s) found. Select a result below.",
                                "success"
                            );


                            data.forEach(
                                function (result) {

                                    if (
                                        !result.lat ||
                                        !result.lon
                                    ) {

                                        return;

                                    }


                                    var resultButton =
                                        document.createElement(
                                            "button"
                                        );


                                    resultButton.type =
                                        "button";


                                    resultButton.className =
                                        "location-search-result";


                                    resultButton.textContent =
                                        result.display_name ||
                                        "Location";


                                    resultButton.addEventListener(
                                        "click",
                                        function () {

                                            var resultLatitude =
                                                parseFloat(
                                                    result.lat
                                                );


                                            var resultLongitude =
                                                parseFloat(
                                                    result.lon
                                                );


                                            if (
                                                !Number.isFinite(
                                                    resultLatitude
                                                ) ||
                                                !Number.isFinite(
                                                    resultLongitude
                                                )
                                            ) {

                                                setSearchStatus(
                                                    "The selected result has invalid coordinates.",
                                                    "error"
                                                );

                                                return;

                                            }


                                            selectLocation(
                                                resultLatitude,
                                                resultLongitude,
                                                false
                                            );


                                            if (
                                                !locationDescription
                                                    .value
                                                    .trim()
                                            ) {

                                                locationDescription.value =
                                                    result.display_name ||
                                                    "";

                                            }


                                            searchResults.innerHTML =
                                                "";


                                            setSearchStatus(
                                                "Location selected.",
                                                "success"
                                            );

                                        }
                                    );


                                    searchResults.appendChild(
                                        resultButton
                                    );

                                }
                            );

                        }
                    )
                    .catch(
                        function (error) {

                            console.error(error);

                            setSearchStatus(
                                "Unable to search for the requested location. Please try again.",
                                "error"
                            );

                            searchResults.innerHTML =
                                "";

                        }
                    )
                    .finally(
                        function () {

                            searchButton.disabled =
                                false;

                        }
                    );

                }
            );


            addressSearch.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key === "Enter"
                    ) {

                        event.preventDefault();

                        searchButton.click();

                    }

                }
            );


            /* =========================================================
               FORM SUBMISSION
               ========================================================= */

            editForm.addEventListener(
                "submit",
                function (event) {


                    /*
                     * Always synchronize the marker
                     * before submitting.
                     */

                    var markerPosition =
                        marker.getLatLng();


                    if (markerPosition) {

                        updateCoordinates(
                            markerPosition.lat,
                            markerPosition.lng
                        );

                    }


                    var finalLatitude =
                        parseFloat(
                            latitudeInput.value
                        );


                    var finalLongitude =
                        parseFloat(
                            longitudeInput.value
                        );


                    if (
                        !Number.isFinite(
                            finalLatitude
                        ) ||
                        !Number.isFinite(
                            finalLongitude
                        )
                    ) {

                        event.preventDefault();


                        setLocationStatus(
                            "Please select a valid municipal asset location.",
                            "error"
                        );


                        document
                            .querySelector(
                                ".selected-location-panel"
                            )
                            .scrollIntoView(
                                {
                                    behavior: "smooth",
                                    block: "center"
                                }
                            );


                        return false;

                    }


                    if (
                        finalLatitude < -90 ||
                        finalLatitude > 90 ||
                        finalLongitude < -180 ||
                        finalLongitude > 180
                    ) {

                        event.preventDefault();


                        setLocationStatus(
                            "The selected coordinates are invalid.",
                            "error"
                        );


                        return false;

                    }


                    if (
                        Math.abs(finalLatitude) < 0.000001 &&
                        Math.abs(finalLongitude) < 0.000001
                    ) {

                        event.preventDefault();


                        setLocationStatus(
                            "Please select a valid municipal asset location.",
                            "error"
                        );


                        return false;

                    }


                    /*
                     * Confirmation before update.
                     */

                    var confirmed =
                        window.confirm(
                            "Are you sure you want to save these changes to this municipal asset?\n\n" +
                            "The changes will be recorded in the asset history."
                        );


                    if (!confirmed) {

                        event.preventDefault();

                        return false;

                    }


                    saveButton.disabled =
                        true;


                    saveButton.innerHTML =
                        '<span class="button-icon">✓</span> Saving Changes...';


                    /*
                     * Final coordinate values.
                     */

                    latitudeInput.value =
                        finalLatitude.toFixed(6);

                    longitudeInput.value =
                        finalLongitude.toFixed(6);


                    return true;

                }
            );


            /* =========================================================
               MAP RESIZE
               ========================================================= */

            setTimeout(
                function () {

                    map.invalidateSize();

                },
                300
            );


            setTimeout(
                function () {

                    map.invalidateSize();

                },
                1000
            );


            window.addEventListener(
                "resize",
                function () {

                    map.invalidateSize();

                }
            );

        }


        if (
            document.readyState === "loading"
        ) {

            document.addEventListener(
                "DOMContentLoaded",
                initialiseEditPage
            );

        }
        else {

            initialiseEditPage();

        }

    })();

</script>


