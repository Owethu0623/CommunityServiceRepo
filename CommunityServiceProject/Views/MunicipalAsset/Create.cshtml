@model CommunityServiceProject.ViewModels.MunicipalAssetCreateViewModel

@{
    ViewBag.Title = "Register Municipal Asset";
}

<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin="" />

<div class="municipal-asset-create-page">

    <div class="municipal-asset-create-header">
        <div>
            <div class="page-eyebrow">MUNICIPAL ASSET MANAGEMENT</div>

            <h1>
                <span class="header-icon">▣</span>
                Register Municipal Asset
            </h1>

            <p>
                Register an existing municipal asset in the central asset management system.
            </p>
        </div>

        <div class="header-actions">
            <a href="@Url.Action("Index", "MunicipalAsset")"
               class="btn btn-secondary">
                ← Back to Assets
            </a>
        </div>
    </div>

    <div class="asset-info-notice">
        <div class="notice-icon">i</div>

        <div>
            <strong>About asset registration</strong>

            <p>
                Municipal assets are normally existing infrastructure or facilities already owned or operated by the municipality.
                The system automatically generates the Asset Code and Asset Name after registration.
            </p>
        </div>
    </div>

    @using (Html.BeginForm(
        "Create",
        "MunicipalAsset",
        FormMethod.Post,
        new
        {
            @class = "asset-registration-form",
            id = "assetRegistrationForm"
        }))
    {
        @Html.AntiForgeryToken()

        <!-- =========================================================
             LOCATION FIX:
             MVC-generated hidden fields.

             HTML names remain:
             Latitude
             Longitude

             DOM IDs are unique:
             AssetLatitude
             AssetLongitude
             ========================================================= -->

        @Html.Hidden(
            "Latitude",
            Model.Latitude,
            new
            {
                id = "AssetLatitude"
            })

        @Html.Hidden(
            "Longitude",
            Model.Longitude,
            new
            {
                id = "AssetLongitude"
            })

        <div class="validation-container">
            @Html.ValidationSummary(
                true,
                "",
                new { @class = "validation-summary" })
        </div>

        <!-- =========================================================
             SECTION 1 - ASSET CLASSIFICATION
             ========================================================= -->

        <div class="form-card">

            <div class="form-card-header">

                <div class="section-number">01</div>

                <div>
                    <h2>Asset Classification</h2>

                    <p>
                        Identify the type and category of municipal asset being registered.
                    </p>
                </div>

            </div>

            <div class="form-card-body">

                <div class="form-grid">

                    <div class="form-group">

                        @Html.LabelFor(
                            model => model.AssetType,
                            new { @class = "form-label" })

                        @Html.DropDownListFor(
                            model => model.AssetType,
                            Model.AssetTypeOptions,
                            "-- Select Asset Type --",
                            new
                            {
                                @class = "form-control",
                                id = "AssetType"
                            })

                        @Html.ValidationMessageFor(
                            model => model.AssetType,
                            "",
                            new { @class = "field-validation" })

                        <small class="field-help">
                            Select the main municipal infrastructure classification.
                        </small>

                    </div>

                    <div class="form-group">

                        @Html.LabelFor(
                            model => model.AssetCategory,
                            new { @class = "form-label" })

                        @Html.DropDownListFor(
                            model => model.AssetCategory,
                            Model.AssetCategoryOptions,
                            "-- Select Asset Category --",
                            new
                            {
                                @class = "form-control",
                                id = "AssetCategory"
                            })

                        @Html.ValidationMessageFor(
                            model => model.AssetCategory,
                            "",
                            new { @class = "field-validation" })

                        <small class="field-help">
                            Available categories depend on the selected asset type.
                        </small>

                    </div>

                </div>

                <div class="form-group full-width">

                    @Html.LabelFor(
                        model => model.Description,
                        new { @class = "form-label" })

                    @Html.TextAreaFor(
                        model => model.Description,
                        new
                        {
                            @class = "form-control textarea-control",
                            rows = "4",
                            maxlength = "1000",
                            placeholder = "Provide a brief description of the asset..."
                        })

                    @Html.ValidationMessageFor(
                        model => model.Description,
                        "",
                        new { @class = "field-validation" })

                    <small class="field-help">
                        Optional. Include useful identifying or operational information.
                    </small>

                </div>

                <div class="form-group">

                    @Html.LabelFor(
                        model => model.WardID,
                        new { @class = "form-label" })

                    @Html.DropDownListFor(
                        model => model.WardID,
                        Model.WardOptions,
                        "-- Select Municipal Ward --",
                        new
                        {
                            @class = "form-control",
                            id = "WardID"
                        })

                    @Html.ValidationMessageFor(
                        model => model.WardID,
                        "",
                        new { @class = "field-validation" })

                    <small class="field-help">
                        Select the municipal ward where this asset is physically located.
                    </small>

                </div>

            </div>

        </div>

        <!-- =========================================================
             SECTION 2 - ASSET LOCATION
             ========================================================= -->

        <div class="form-card">

            <div class="form-card-header">

                <div class="section-number">02</div>

                <div>
                    <h2>Asset Location</h2>

                    <p>
                        Select the physical location of the municipal asset on the map.
                    </p>
                </div>

            </div>

            <div class="form-card-body">

                <div class="location-notice">

                    <div class="location-notice-icon">⌖</div>

                    <div>
                        <strong>Location is required</strong>

                        <p>
                            Search for an address or select the asset's position directly on the map.
                            You can also drag the marker to refine the location.
                        </p>
                    </div>

                </div>

                <div class="address-search-section">

                    <label class="form-label" for="addressSearch">
                        Search for an Address
                    </label>

                    <div class="address-search-row">

                        <input type="text"
                               id="addressSearch"
                               class="form-control"
                               maxlength="200"
                               autocomplete="off"
                               placeholder="e.g. Cedar Street, Durban" />

                        <button type="button"
                                id="searchAddressButton"
                                class="btn btn-search">

                            <span class="button-icon">⌕</span>
                            Search Address

                        </button>

                    </div>

                    <div id="searchStatus"
                         class="location-status"
                         aria-live="polite">
                    </div>

                    <div id="searchResults"
                         class="location-search-results">
                    </div>

                </div>

                <div class="map-container">

                    <div id="assetMap"></div>

                </div>

                <div class="map-help">
                    <span>●</span>
                    Click anywhere on the map or drag the marker to select the asset location.
                </div>

                <div class="map-centre-row">

                    <button type="button"
                            id="selectMapCentre"
                            class="btn btn-map-centre">

                        ⌖ Select Map Centre

                    </button>

                    <span id="locationStatus"
                          class="location-status"
                          aria-live="polite">
                    </span>

                </div>

                <div class="selected-location-panel">

                    <div class="selected-location-header">

                        <div>

                            <span class="selected-location-icon">
                                ✓
                            </span>

                            <div>

                                <strong>
                                    Selected Location
                                </strong>

                                <small>
                                    Coordinates selected for this asset
                                </small>

                            </div>

                        </div>

                    </div>

                    <div class="coordinate-grid">

                        <div class="coordinate-box">

                            <span class="coordinate-label">
                                Latitude
                            </span>

                            <strong id="latitudeDisplay">
                                Not selected
                            </strong>

                        </div>

                        <div class="coordinate-box">

                            <span class="coordinate-label">
                                Longitude
                            </span>

                            <strong id="longitudeDisplay">
                                Not selected
                            </strong>

                        </div>

                    </div>

                </div>

                <div class="form-group location-description-group">

                    @Html.LabelFor(
                        model => model.LocationDescription,
                        new { @class = "form-label" })

                    @Html.TextBoxFor(
                        model => model.LocationDescription,
                        new
                        {
                            @class = "form-control",
                            id = "LocationDescription",
                            maxlength = "500",
                            placeholder = "e.g. Cedar Street near the municipal offices"
                        })

                    @Html.ValidationMessageFor(
                        model => model.LocationDescription,
                        "",
                        new { @class = "field-validation" })

                    <small class="field-help">
                        Describe the asset's physical position or nearby landmark if useful.
                    </small>

                </div>

            </div>

        </div>

        <!-- =========================================================
             SECTION 3 - INITIAL OPERATIONAL INFORMATION
             ========================================================= -->

        <div class="form-card">

            <div class="form-card-header">

                <div class="section-number">
                    03
                </div>

                <div>

                    <h2>
                        Initial Operational Information
                    </h2>

                    <p>
                        Record the asset's current condition and operational status at the time of registration.
                    </p>

                </div>

            </div>

            <div class="form-card-body">

                <div class="form-grid">

                    <div class="form-group">

                        @Html.LabelFor(
                            model => model.Condition,
                            new { @class = "form-label" })

                        @Html.EnumDropDownListFor(
                            model => model.Condition,
                            "-- Select Condition --",
                            new
                            {
                                @class = "form-control",
                                id = "Condition"
                            })

                        @Html.ValidationMessageFor(
                            model => model.Condition,
                            "",
                            new { @class = "field-validation" })

                    </div>

                    <div class="form-group">

                        @Html.LabelFor(
                            model => model.Status,
                            new { @class = "form-label" })

                        @Html.EnumDropDownListFor(
                            model => model.Status,
                            "-- Select Status --",
                            new
                            {
                                @class = "form-control",
                                id = "Status"
                            })

                        @Html.ValidationMessageFor(
                            model => model.Status,
                            "",
                            new { @class = "field-validation" })

                    </div>

                </div>

            </div>

        </div>

        <!-- =========================================================
             SECTION 4 - SYSTEM GENERATED INFORMATION
             ========================================================= -->

        <div class="form-card system-generated-card">

            <div class="form-card-header">

                <div class="section-number">
                    04
                </div>

                <div>

                    <h2>
                        System-Generated Information
                    </h2>

                    <p>
                        These values are automatically created when the asset is registered.
                    </p>

                </div>

            </div>

            <div class="form-card-body">

                <div class="generated-information-grid">

                    <div class="generated-item">

                        <span class="generated-label">
                            Asset Code
                        </span>

                        <strong>
                            Generated automatically
                        </strong>

                        <small>
                            Example: AST-000124
                        </small>

                    </div>

                    <div class="generated-item">

                        <span class="generated-label">
                            Asset Name
                        </span>

                        <strong>
                            Generated automatically
                        </strong>

                        <small>
                            Based on the asset category and location
                        </small>

                    </div>

                    <div class="generated-item">

                        <span class="generated-label">
                            Date Registered
                        </span>

                        <strong>
                            Current date and time
                        </strong>

                    </div>

                    <div class="generated-item">

                        <span class="generated-label">
                            Registered By
                        </span>

                        <strong>
                            Current administrator
                        </strong>

                    </div>

                </div>

            </div>

        </div>

        <div class="form-actions">

            <a href="@Url.Action("Index", "MunicipalAsset")"
               class="btn btn-cancel">
                Cancel
            </a>

            <button type="submit"
                    id="registerAssetButton"
                    class="btn btn-primary">

                <span class="button-icon">
                    ✓
                </span>

                Register Municipal Asset

            </button>

        </div>
    }

</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin="">
</script>

<script>
    (function () {

        "use strict";

        function initialiseAssetPage() {

            var categoryMap = {

                "Road Infrastructure": [
                    "Road"
                ],

                "Street Lighting": [
                    "Streetlight",
                    "High-Mast Light"
                ],

                "Water Infrastructure": [
                    "Water Pipe",
                    "Water Valve",
                    "Fire Hydrant"
                ],

                "Stormwater Infrastructure": [
                    "Stormwater Drain",
                    "Drainage Channel"
                ],

                "Traffic Infrastructure": [
                    "Traffic Signal"
                ],

                "Waste Management": [
                    "Waste Container"
                ],

                "Public Facilities": [
                    "Community Facility"
                ],

                "Parks and Recreation": [
                    "Park Facility"
                ],

                "Municipal Buildings": [
                    "Municipal Building"
                ]

            };

            var assetType =
                document.getElementById("AssetType");

            var assetCategory =
                document.getElementById("AssetCategory");

            function updateCategories() {

                var selectedType =
                    assetType.value;

                var currentCategory =
                    assetCategory.value;

                assetCategory.innerHTML = "";

                var defaultOption =
                    document.createElement("option");

                defaultOption.value = "";

                defaultOption.textContent =
                    "-- Select Asset Category --";

                assetCategory.appendChild(
                    defaultOption
                );

                if (
                    selectedType &&
                    categoryMap[selectedType]
                ) {

                    categoryMap[selectedType].forEach(
                        function (category) {

                            var option =
                                document.createElement("option");

                            option.value =
                                category;

                            option.textContent =
                                category;

                            assetCategory.appendChild(
                                option
                            );

                        }
                    );

                    if (
                        categoryMap[selectedType]
                            .indexOf(currentCategory) !== -1
                    ) {

                        assetCategory.value =
                            currentCategory;

                    }

                }

            }

            assetType.addEventListener(
                "change",
                updateCategories
            );

            var mapElement =
                document.getElementById("assetMap");

            if (!mapElement) {

                console.error(
                    "Municipal asset map element was not found."
                );

                return;

            }

            if (typeof L === "undefined") {

                var failedMapMessage =
                    document.createElement("div");

                failedMapMessage.className =
                    "map-load-error";

                failedMapMessage.textContent =
                    "The map could not be loaded. Please refresh the page and try again.";

                mapElement.appendChild(
                    failedMapMessage
                );

                return;

            }

            var defaultLatitude =
                -29.8587;

            var defaultLongitude =
                31.0218;

            var map =
                L.map(
                    "assetMap",
                    {
                        zoomControl: true
                    }
                );

            map.setView(
                [
                    defaultLatitude,
                    defaultLongitude
                ],
                12
            );

            L.tileLayer(
                "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                {
                    maxZoom: 19,
                    attribution:
                        "&copy; OpenStreetMap contributors"
                }
            ).addTo(map);

            var marker = null;

            /*
             * =========================================================
             * LOCATION FIX
             * =========================================================
             *
             * MVC field names:
             *
             * name="Latitude"
             * name="Longitude"
             *
             * Unique DOM IDs:
             *
             * id="AssetLatitude"
             * id="AssetLongitude"
             *
             * The browser therefore posts Latitude and Longitude
             * while JavaScript has unique elements to work with.
             * =========================================================
             */

            var latitudeInput =
                document.getElementById("AssetLatitude");

            var longitudeInput =
                document.getElementById("AssetLongitude");

            var latitudeDisplay =
                document.getElementById(
                    "latitudeDisplay"
                );

            var longitudeDisplay =
                document.getElementById(
                    "longitudeDisplay"
                );

            var locationDescription =
                document.getElementById(
                    "LocationDescription"
                );

            var locationStatus =
                document.getElementById(
                    "locationStatus"
                );

            var searchStatus =
                document.getElementById(
                    "searchStatus"
                );

            var searchResults =
                document.getElementById(
                    "searchResults"
                );

            var addressSearch =
                document.getElementById(
                    "addressSearch"
                );

            var searchButton =
                document.getElementById(
                    "searchAddressButton"
                );

            var selectMapCentre =
                document.getElementById(
                    "selectMapCentre"
                );

            var registrationForm =
                document.getElementById(
                    "assetRegistrationForm"
                );

            var registerButton =
                document.getElementById(
                    "registerAssetButton"
                );

            function setLocationStatus(
                message,
                type
            ) {

                locationStatus.textContent =
                    message;

                locationStatus.classList.remove(
                    "success",
                    "error",
                    "warning"
                );

                if (type) {

                    locationStatus.classList.add(
                        type
                    );

                }

            }

            function setSearchStatus(
                message,
                type
            ) {

                searchStatus.textContent =
                    message;

                searchStatus.classList.remove(
                    "success",
                    "error",
                    "warning"
                );

                if (type) {

                    searchStatus.classList.add(
                        type
                    );

                }

            }

            function updateCoordinateDisplay(
                latitude,
                longitude
            ) {

                latitudeDisplay.textContent =
                    Number(latitude).toFixed(6);

                longitudeDisplay.textContent =
                    Number(longitude).toFixed(6);

            }

            /*
             * =========================================================
             * LOCATION FIX
             *
             * Write directly into the MVC fields.
             * =========================================================
             */

            function updateHiddenCoordinates(
                latitude,
                longitude
            ) {

                var lat =
                    parseFloat(latitude);

                var lon =
                    parseFloat(longitude);

                if (
                    !Number.isFinite(lat) ||
                    !Number.isFinite(lon)
                ) {

                    return false;

                }

                /*
                 * These are the actual values that will be posted.
                 */

                latitudeInput.value =
                    lat.toFixed(6);

                longitudeInput.value =
                    lon.toFixed(6);

                latitudeInput.dispatchEvent(
                    new Event(
                        "input",
                        {
                            bubbles: true
                        }
                    )
                );

                longitudeInput.dispatchEvent(
                    new Event(
                        "input",
                        {
                            bubbles: true
                        }
                    )
                );

                latitudeInput.dispatchEvent(
                    new Event(
                        "change",
                        {
                            bubbles: true
                        }
                    )
                );

                longitudeInput.dispatchEvent(
                    new Event(
                        "change",
                        {
                            bubbles: true
                        }
                    )
                );

                return true;

            }

            function synchroniseLocationFromMarker() {

                if (!marker) {

                    return false;

                }

                var position =
                    marker.getLatLng();

                if (!position) {

                    return false;

                }

                return updateHiddenCoordinates(
                    position.lat,
                    position.lng
                );

            }

            var reverseGeocodeTimer =
                null;

            function reverseGeocode(
                latitude,
                longitude
            ) {

                if (
                    reverseGeocodeTimer !== null
                ) {

                    clearTimeout(
                        reverseGeocodeTimer
                    );

                }

                reverseGeocodeTimer =
                    setTimeout(
                        function () {

                            setLocationStatus(
                                "Identifying selected location...",
                                "warning"
                            );

                            var url =
                                "@Url.Action("ReverseGeocode", "MunicipalAsset")";

                            var separator =
                                url.indexOf("?") === -1
                                    ? "?"
                                    : "&";

                            url +=
                                separator +
                                "lat=" +
                                encodeURIComponent(latitude) +
                                "&lon=" +
                                encodeURIComponent(longitude);

                            fetch(
                                url,
                                {
                                    method: "GET",

                                    headers: {
                                        "Accept":
                                            "application/json"
                                    }
                                }
                            )

                            .then(
                                function (response) {

                                    if (!response.ok) {

                                        throw new Error(
                                            "Reverse geocoding request failed."
                                        );

                                    }

                                    return response.json();

                                }
                            )

                            .then(
                                function (data) {

                                    if (
                                        data &&
                                        data.success === false
                                    ) {

                                        setLocationStatus(
                                            data.message ||
                                            "Unable to identify the selected location.",
                                            "error"
                                        );

                                        return;

                                    }

                                    if (
                                        data &&
                                        data.display_name
                                    ) {

                                        if (
                                            !locationDescription
                                                .value
                                                .trim()
                                        ) {

                                            locationDescription.value =
                                                data.display_name;

                                        }

                                        setLocationStatus(
                                            "Location identified successfully.",
                                            "success"
                                        );

                                    }
                                    else {

                                        setLocationStatus(
                                            "Coordinates selected. Location description can be entered manually.",
                                            "success"
                                        );

                                    }

                                }
                            )

                            .catch(
                                function (error) {

                                    console.error(error);

                                    setLocationStatus(
                                        "Coordinates selected. Location description can be entered manually.",
                                        "success"
                                    );

                                }
                            );

                        },
                        350
                    );

            }

            function selectLocation(
                latitude,
                longitude,
                performReverseGeocode
            ) {

                latitude =
                    parseFloat(latitude);

                longitude =
                    parseFloat(longitude);

                if (
                    !Number.isFinite(latitude) ||
                    !Number.isFinite(longitude)
                ) {

                    setLocationStatus(
                        "The selected coordinates are invalid.",
                        "error"
                    );

                    return;

                }

                if (
                    latitude < -90 ||
                    latitude > 90 ||
                    longitude < -180 ||
                    longitude > 180
                ) {

                    setLocationStatus(
                        "The selected coordinates are outside the valid range.",
                        "error"
                    );

                    return;

                }

                if (
                    Math.abs(latitude) < 0.000001 &&
                    Math.abs(longitude) < 0.000001
                ) {

                    setLocationStatus(
                        "Please select a valid municipal location.",
                        "error"
                    );

                    return;

                }

                /*
                 * FIRST:
                 *
                 * Update the actual MVC form fields.
                 */

                if (
                    !updateHiddenCoordinates(
                        latitude,
                        longitude
                    )
                ) {

                    setLocationStatus(
                        "The selected location could not be saved.",
                        "error"
                    );

                    return;

                }

                updateCoordinateDisplay(
                    latitude,
                    longitude
                );

                /*
                 * SECOND:
                 *
                 * Create or move the marker.
                 */

                if (marker === null) {

                    marker =
                        L.marker(
                            [
                                latitude,
                                longitude
                            ],
                            {
                                draggable: true
                            }
                        );

                    marker.addTo(map);

                    marker.on(
                        "dragend",
                        function () {

                            var position =
                                marker.getLatLng();

                            selectLocation(
                                position.lat,
                                position.lng,
                                true
                            );

                        }
                    );

                }
                else {

                    marker.setLatLng(
                        [
                            latitude,
                            longitude
                        ]
                    );

                }

                /*
                 * THIRD:
                 *
                 * Make absolutely sure the marker and
                 * hidden form fields are synchronized.
                 */

                synchroniseLocationFromMarker();

                map.setView(
                    [
                        latitude,
                        longitude
                    ],
                    Math.max(
                        map.getZoom(),
                        15
                    )
                );

                setLocationStatus(
                    "Location selected.",
                    "success"
                );

                if (performReverseGeocode) {

                    reverseGeocode(
                        latitude,
                        longitude
                    );

                }

            }

            map.on(
                "click",
                function (event) {

                    selectLocation(
                        event.latlng.lat,
                        event.latlng.lng,
                        true
                    );

                }
            );

            selectMapCentre.addEventListener(
                "click",
                function () {

                    var centre =
                        map.getCenter();

                    selectLocation(
                        centre.lat,
                        centre.lng,
                        true
                    );

                }
            );

            searchButton.addEventListener(
                "click",
                function () {

                    var query =
                        addressSearch.value.trim();

                    if (!query) {

                        setSearchStatus(
                            "Please enter an address or location to search.",
                            "error"
                        );

                        addressSearch.focus();

                        return;

                    }

                    searchButton.disabled =
                        true;

                    searchResults.innerHTML =
                        "";

                    setSearchStatus(
                        "Searching for locations...",
                        "warning"
                    );

                    var url =
                        "@Url.Action("SearchAddress", "MunicipalAsset")";

                    var separator =
                        url.indexOf("?") === -1
                            ? "?"
                            : "&";

                    url +=
                        separator +
                        "query=" +
                        encodeURIComponent(query);

                    fetch(
                        url,
                        {
                            method: "GET",

                            headers: {
                                "Accept":
                                    "application/json"
                            }
                        }
                    )

                    .then(
                        function (response) {

                            if (!response.ok) {

                                throw new Error(
                                    "Address search request failed."
                                );

                            }

                            return response.json();

                        }
                    )

                    .then(
                        function (data) {

                            searchResults.innerHTML =
                                "";

                            if (
                                data &&
                                data.success === false
                            ) {

                                setSearchStatus(
                                    data.message ||
                                    "Unable to search for the location.",
                                    "error"
                                );

                                return;

                            }

                            if (!Array.isArray(data)) {

                                setSearchStatus(
                                    "The location search returned an unexpected response.",
                                    "error"
                                );

                                return;

                            }

                            if (data.length === 0) {

                                setSearchStatus(
                                    "No matching locations were found.",
                                    "warning"
                                );

                                return;

                            }

                            setSearchStatus(
                                data.length +
                                " location(s) found. Select a result below.",
                                "success"
                            );

                            data.forEach(
                                function (result) {

                                    if (
                                        !result.lat ||
                                        !result.lon
                                    ) {

                                        return;

                                    }

                                    var resultButton =
                                        document.createElement(
                                            "button"
                                        );

                                    resultButton.type =
                                        "button";

                                    resultButton.className =
                                        "location-search-result";

                                    resultButton.textContent =
                                        result.display_name ||
                                        "Location";

                                    resultButton.addEventListener(
                                        "click",
                                        function () {

                                            var latitude =
                                                parseFloat(
                                                    result.lat
                                                );

                                            var longitude =
                                                parseFloat(
                                                    result.lon
                                                );

                                            if (
                                                !Number.isFinite(
                                                    latitude
                                                ) ||
                                                !Number.isFinite(
                                                    longitude
                                                )
                                            ) {

                                                setSearchStatus(
                                                    "The selected result has invalid coordinates.",
                                                    "error"
                                                );

                                                return;

                                            }

                                            selectLocation(
                                                latitude,
                                                longitude,
                                                false
                                            );

                                            if (
                                                !locationDescription
                                                    .value
                                                    .trim()
                                            ) {

                                                locationDescription.value =
                                                    result.display_name ||
                                                    "";

                                            }

                                            searchResults.innerHTML =
                                                "";

                                            setSearchStatus(
                                                "Location selected.",
                                                "success"
                                            );

                                        }
                                    );

                                    searchResults.appendChild(
                                        resultButton
                                    );

                                }
                            );

                        }
                    )

                    .catch(
                        function (error) {

                            console.error(error);

                            setSearchStatus(
                                "Unable to search for the requested location. Please try again.",
                                "error"
                            );

                            searchResults.innerHTML =
                                "";

                        }
                    )

                    .finally(
                        function () {

                            searchButton.disabled =
                                false;

                        }
                    );

                }
            );

            addressSearch.addEventListener(
                "keydown",
                function (event) {

                    if (event.key === "Enter") {

                        event.preventDefault();

                        searchButton.click();

                    }

                }
            );

            /*
             * =========================================================
             * FINAL FORM SUBMISSION
             * =========================================================
             */

            registrationForm.addEventListener(
                "submit",
                function (event) {

                    if (marker) {

                        synchroniseLocationFromMarker();

                    }

                    var latitude =
                        parseFloat(
                            latitudeInput.value
                        );

                    var longitude =
                        parseFloat(
                            longitudeInput.value
                        );

                    if (
                        (
                            !Number.isFinite(latitude) ||
                            !Number.isFinite(longitude)
                        ) &&
                        marker
                    ) {

                        var markerPosition =
                            marker.getLatLng();

                        updateHiddenCoordinates(
                            markerPosition.lat,
                            markerPosition.lng
                        );

                        latitude =
                            parseFloat(
                                latitudeInput.value
                            );

                        longitude =
                            parseFloat(
                                longitudeInput.value
                            );

                    }

                    if (
                        !Number.isFinite(latitude) ||
                        !Number.isFinite(longitude)
                    ) {

                        event.preventDefault();

                        setLocationStatus(
                            "Please select the municipal asset location on the map before registering the asset.",
                            "error"
                        );

                        var locationPanel =
                            document.querySelector(
                                ".selected-location-panel"
                            );

                        if (locationPanel) {

                            locationPanel.scrollIntoView(
                                {
                                    behavior: "smooth",
                                    block: "center"
                                }
                            );

                        }

                        return false;

                    }

                    if (
                        latitude < -90 ||
                        latitude > 90 ||
                        longitude < -180 ||
                        longitude > 180
                    ) {

                        event.preventDefault();

                        setLocationStatus(
                            "The selected coordinates are invalid.",
                            "error"
                        );

                        return false;

                    }

                    if (
                        Math.abs(latitude) < 0.000001 &&
                        Math.abs(longitude) < 0.000001
                    ) {

                        event.preventDefault();

                        setLocationStatus(
                            "Please select a valid municipal asset location.",
                            "error"
                        );

                        return false;

                    }

                    if (
                        !assetType.value ||
                        !assetCategory.value
                    ) {

                        event.preventDefault();

                        alert(
                            "Please select a valid asset type and asset category before registering the asset."
                        );

                        return false;

                    }

                    var confirmed =
                        window.confirm(
                            "Are you sure you want to register this municipal asset with the selected ward and location?"
                        );

                    if (!confirmed) {

                        event.preventDefault();

                        return false;

                    }

                    registerButton.disabled =
                        true;

                    registerButton.innerHTML =
                        '<span class="button-icon">✓</span> Registering Asset...';

                    /*
                     * FINAL WRITE:
                     *
                     * These exact values are submitted as:
                     *
                     * Latitude
                     * Longitude
                     */

                    latitudeInput.value =
                        latitude.toFixed(6);

                    longitudeInput.value =
                        longitude.toFixed(6);

                    return true;

                }
            );

            setTimeout(
                function () {

                    map.invalidateSize();

                },
                300
            );

            setTimeout(
                function () {

                    map.invalidateSize();

                },
                1000
            );

            window.addEventListener(
                "resize",
                function () {

                    map.invalidateSize();

                }
            );

        }

        if (
            document.readyState === "loading"
        ) {

            document.addEventListener(
                "DOMContentLoaded",
                initialiseAssetPage
            );

        }
        else {

            initialiseAssetPage();

        }

    })();
</script>

