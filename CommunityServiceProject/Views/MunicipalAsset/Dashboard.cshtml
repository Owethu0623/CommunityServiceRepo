@model CommunityServiceProject.ViewModels.MunicipalAssetDashboardViewModel

@{
    ViewBag.Title = "Municipal Asset Management";
}

<style>
    .asset-dashboard-page {
        padding: 30px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
    }

    .asset-dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 28px;
    }

    .asset-dashboard-title h1 {
        margin: 0 0 8px 0;
        font-size: 30px;
        font-weight: 700;
        color: #1f2937;
    }

    .asset-dashboard-title p {
        margin: 0;
        color: #6b7280;
        font-size: 15px;
    }

    .asset-dashboard-date {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 12px 16px;
        color: #6b7280;
        font-size: 13px;
        white-space: nowrap;
    }

    .asset-summary-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 24px;
    }

    .asset-summary-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 22px;
        box-shadow: 0 3px 12px rgba(15, 23, 42, 0.05);
    }

    .asset-summary-label {
        color: #6b7280;
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: 10px;
    }

    .asset-summary-value {
        color: #111827;
        font-size: 32px;
        font-weight: 700;
        line-height: 1;
    }

    .asset-dashboard-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px;
        margin-bottom: 24px;
    }

    .asset-dashboard-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 24px;
        box-shadow: 0 3px 12px rgba(15, 23, 42, 0.05);
    }

    .asset-dashboard-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

        .asset-dashboard-card-header h2 {
            margin: 0;
            color: #1f2937;
            font-size: 19px;
            font-weight: 700;
        }

    .asset-condition-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #f0f2f5;
    }

        .asset-condition-row:last-child {
            border-bottom: none;
        }

    .asset-condition-name {
        color: #4b5563;
        font-size: 14px;
    }

    .asset-condition-count {
        color: #111827;
        font-size: 15px;
        font-weight: 700;
    }

    .asset-attention-empty {
        padding: 28px 15px;
        text-align: center;
        color: #6b7280;
        background: #f8fafc;
        border-radius: 10px;
        font-size: 14px;
    }

    .asset-table-wrapper {
        overflow-x: auto;
    }

    .asset-dashboard-table {
        width: 100%;
        border-collapse: collapse;
    }

        .asset-dashboard-table th {
            text-align: left;
            padding: 12px;
            background: #f8fafc;
            color: #6b7280;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .asset-dashboard-table td {
            padding: 14px 12px;
            border-bottom: 1px solid #eef0f3;
            color: #374151;
            font-size: 14px;
        }

    .asset-code {
        font-weight: 700;
        color: #0d5cc1;
    }

    .asset-name {
        font-weight: 600;
        color: #1f2937;
    }

    .asset-status {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        background: #eef6ff;
        color: #0d5cc1;
        font-size: 12px;
        font-weight: 600;
    }

    .asset-condition {
        font-size: 13px;
        font-weight: 600;
    }

    .asset-quick-actions {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
    }

    .asset-action-button {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 58px;
        padding: 12px 16px;
        border-radius: 10px;
        border: 1px solid #dbe2ea;
        background: #ffffff;
        color: #1f2937;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: all .2s ease;
    }

        .asset-action-button:hover {
            border-color: #0d5cc1;
            color: #0d5cc1;
            text-decoration: none;
            transform: translateY(-1px);
        }

    .asset-action-primary {
        background: #0d5cc1;
        color: #ffffff;
        border-color: #0d5cc1;
    }

        .asset-action-primary:hover {
            background: #094c9f;
            color: #ffffff;
        }

    @@media (max-width: 1000px) {
        .asset-summary-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .asset-dashboard-grid {
            grid-template-columns: 1fr;
        }

        .asset-quick-actions {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 650px) {
        .asset-dashboard-page {
            padding: 18px;
        }

        .asset-dashboard-header {
            flex-direction: column;
        }

        .asset-summary-grid {
            grid-template-columns: 1fr;
        }

        .asset-quick-actions {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="asset-dashboard-page">

    <!-- ============================================================
         HEADER
         ============================================================ -->

    <div class="asset-dashboard-header">

        <div class="asset-dashboard-title">
            <h1>Municipal Asset Management</h1>

            <p>
                Monitor, manage and maintain municipal infrastructure
                assets from one central workspace.
            </p>
        </div>

        <div class="asset-dashboard-date">
            Last updated:
            @Model.DashboardDate.ToString("dd MMM yyyy, HH:mm")
        </div>

    </div>


    <!-- ============================================================
         SUMMARY CARDS
         ============================================================ -->

    <div class="asset-summary-grid">

        <div class="asset-summary-card">
            <div class="asset-summary-label">
                Total Assets
            </div>

            <div class="asset-summary-value">
                @Model.TotalAssets
            </div>
        </div>

        <div class="asset-summary-card">
            <div class="asset-summary-label">
                Active Assets
            </div>

            <div class="asset-summary-value">
                @Model.ActiveAssets
            </div>
        </div>

        <div class="asset-summary-card">
            <div class="asset-summary-label">
                Requires Attention
            </div>

            <div class="asset-summary-value">
                @Model.RequiresAttention
            </div>
        </div>

        <div class="asset-summary-card">
            <div class="asset-summary-label">
                Under Maintenance
            </div>

            <div class="asset-summary-value">
                @Model.UnderMaintenance
            </div>
        </div>

        <div class="asset-summary-card">
            <div class="asset-summary-label">
                Inactive Assets
            </div>

            <div class="asset-summary-value">
                @Model.InactiveAssets
            </div>
        </div>

        <div class="asset-summary-card">
            <div class="asset-summary-label">
                Retired Assets
            </div>

            <div class="asset-summary-value">
                @Model.RetiredAssets
            </div>
        </div>

    </div>


    <!-- ============================================================
         CONDITION + ATTENTION
         ============================================================ -->

    <div class="asset-dashboard-grid">

        <!-- CONDITION -->

        <div class="asset-dashboard-card">

            <div class="asset-dashboard-card-header">
                <h2>Asset Condition</h2>
            </div>

            <div class="asset-condition-row">
                <span class="asset-condition-name">
                    Excellent
                </span>

                <span class="asset-condition-count">
                    @Model.ExcellentAssets
                </span>
            </div>

            <div class="asset-condition-row">
                <span class="asset-condition-name">
                    Good
                </span>

                <span class="asset-condition-count">
                    @Model.GoodAssets
                </span>
            </div>

            <div class="asset-condition-row">
                <span class="asset-condition-name">
                    Fair
                </span>

                <span class="asset-condition-count">
                    @Model.FairAssets
                </span>
            </div>

            <div class="asset-condition-row">
                <span class="asset-condition-name">
                    Poor
                </span>

                <span class="asset-condition-count">
                    @Model.PoorAssets
                </span>
            </div>

            <div class="asset-condition-row">
                <span class="asset-condition-name">
                    Critical
                </span>

                <span class="asset-condition-count">
                    @Model.CriticalAssets
                </span>
            </div>

        </div>


        <!-- ATTENTION -->

        <div class="asset-dashboard-card">

            <div class="asset-dashboard-card-header">
                <h2>Assets Requiring Attention</h2>
            </div>

            @if (Model.AttentionAssets != null &&
                 Model.AttentionAssets.Any())
            {
                <div class="asset-table-wrapper">

                    <table class="asset-dashboard-table">

                        <thead>
                            <tr>
                                <th>Asset</th>
                                <th>Condition</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var asset in Model.AttentionAssets)
                            {
                                <tr>

                                    <td>
                                        <div class="asset-code">
                                            @asset.AssetCode
                                        </div>

                                        <div class="asset-name">
                                            @asset.AssetName
                                        </div>
                                    </td>

                                    <td>
                                        <span class="asset-condition">
                                            @asset.Condition
                                        </span>
                                    </td>

                                    <td>
                                        <span class="asset-status">
                                            @asset.Status
                                        </span>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="asset-attention-empty">
                    No assets currently require attention.
                </div>
            }

        </div>

    </div>


    <!-- ============================================================
         RECENT ASSETS
         ============================================================ -->

    <div class="asset-dashboard-card">

        <div class="asset-dashboard-card-header">

            <h2>Recent Assets</h2>

            <a href="@Url.Action("Index", "MunicipalAsset")"
               class="asset-action-button"
               style="min-height: auto;">
                View Asset Register
            </a>

        </div>

        @if (Model.RecentAssets != null &&
             Model.RecentAssets.Any())
        {
            <div class="asset-table-wrapper">

                <table class="asset-dashboard-table">

                    <thead>
                        <tr>
                            <th>Asset Code</th>
                            <th>Asset Name</th>
                            <th>Type</th>
                            <th>Condition</th>
                            <th>Status</th>
                            <th>Registered</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var asset in Model.RecentAssets)
                        {
                            <tr>

                                <td>
                                    <span class="asset-code">
                                        @asset.AssetCode
                                    </span>
                                </td>

                                <td>
                                    <span class="asset-name">
                                        @asset.AssetName
                                    </span>
                                </td>

                                <td>
                                    @asset.AssetType
                                </td>

                                <td>
                                    <span class="asset-condition">
                                        @asset.Condition
                                    </span>
                                </td>

                                <td>
                                    <span class="asset-status">
                                        @asset.Status
                                    </span>
                                </td>

                                <td>
                                    @asset.DateRegistered.ToString("dd MMM yyyy")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="asset-attention-empty">
                No municipal assets have been registered yet.
            </div>
        }

    </div>


    <!-- ============================================================
         QUICK ACTIONS
         ============================================================ -->

    <div class="asset-dashboard-card"
         style="margin-top: 24px;">

        <div class="asset-dashboard-card-header">
            <h2>Quick Actions</h2>
        </div>

        <div class="asset-quick-actions">

            <a href="@Url.Action("Index", "MunicipalAsset")"
               class="asset-action-button">
                View Asset Register
            </a>

            <a href="@Url.Action("Create", "MunicipalAsset")"
               class="asset-action-button asset-action-primary">
                Register New Asset
            </a>

            <a href="#"
               class="asset-action-button">
                Inspections
            </a>

            <a href="#"
               class="asset-action-button">
                Maintenance Needs
            </a>

        </div>

    </div>

</div>

