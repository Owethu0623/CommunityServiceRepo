@model CommunityServiceProject.ViewModels.IdentifyAssetMaintenanceNeedViewModel

@{
    ViewBag.Title = "Identify Maintenance Need";
}

<div class="asset-maintenance-need-page">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="page-header">

        <div class="page-header-left">

            <a href="@Url.Action("Details", "MunicipalAsset", new { id = Model.AssetID })"
               class="back-link">
                <span class="back-icon">←</span>
                Back to Asset Details
            </a>

            <div class="page-title-row">

                <div class="page-icon">🔧</div>

                <div>
                    <h1>Identify Maintenance Need</h1>

                    <p>
                        Record a maintenance requirement identified for this municipal asset.
                    </p>
                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         INFORMATION NOTICE
    ====================================================== -->

    <div class="info-notice">

        <div class="notice-icon">i</div>

        <div>

            <strong>Maintenance planning record</strong>

            <p>
                Use this page to record maintenance that the asset has been
                identified as needing. This does not create or assign a
                maintenance work order.
            </p>

        </div>

    </div>


    @using (Html.BeginForm(
        "IdentifyMaintenanceNeed",
        "MunicipalAsset",
        FormMethod.Post,
        new
        {
            id = "maintenanceNeedForm"
        }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(m => m.AssetID)


        <!-- =================================================
             VALIDATION SUMMARY
        ================================================== -->

        if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-summary">

                @Html.ValidationSummary(
                    false,
                    "Please correct the following before continuing."
                )

            </div>
        }


        <!-- =================================================
             SECTION 01 — ASSET INFORMATION
        ================================================== -->

        <div class="form-card">

            <div class="section-heading">

                <span class="section-number">
                    01
                </span>

                <div>

                    <h2>Asset Information</h2>

                    <p>
                        Confirm the asset for which the maintenance need is being recorded.
                    </p>

                </div>

            </div>


            <div class="information-grid">

                <div class="information-item">

                    <span>Asset Code</span>

                    <strong>
                        @Model.AssetCode
                    </strong>

                </div>


                <div class="information-item">

                    <span>Asset Name</span>

                    <strong>
                        @Model.AssetName
                    </strong>

                </div>


                <div class="information-item">

                    <span>Asset Type</span>

                    <strong>
                        @Model.AssetType
                    </strong>

                </div>


                <div class="information-item">

                    <span>Asset Category</span>

                    <strong>
                        @Model.AssetCategory
                    </strong>

                </div>


                <div class="information-item full-width">

                    <span>Municipal Ward</span>

                    <strong>
                        @Model.WardName
                    </strong>

                </div>

            </div>

        </div>


        <!-- =================================================
             SECTION 02 — MAINTENANCE REQUIREMENT
        ================================================== -->

        <div class="form-card">

            <div class="section-heading">

                <span class="section-number">
                    02
                </span>

                <div>

                    <h2>Maintenance Requirement</h2>

                    <p>
                        Describe the maintenance that has been identified as necessary.
                    </p>

                </div>

            </div>


            <!-- Maintenance Type -->

            <div class="field-group">

                @Html.LabelFor(
                    m => m.MaintenanceType,
                    new
                    {
                        @class = "field-label"
                    }
                )

                @Html.DropDownListFor(
                    m => m.MaintenanceType,
                    Model.MaintenanceTypeOptions,
                    "-- Select maintenance type --",
                    new
                    {
                        @class = "form-control",
                        id = "maintenanceType"
                    }
                )

                @Html.ValidationMessageFor(
                    m => m.MaintenanceType,
                    "",
                    new
                    {
                        @class = "field-error"
                    }
                )

            </div>


            <!-- Description -->

            <div class="field-group">

                @Html.LabelFor(
                    m => m.Description,
                    new
                    {
                        @class = "field-label"
                    }
                )

                @Html.TextAreaFor(
                    m => m.Description,
                    6,
                    20,
                    new
                    {
                        @class = "form-control textarea-control",
                        id = "description",
                        maxlength = "2000",
                        placeholder =
                            "Describe what maintenance is required and why..."
                    }
                )

                @Html.ValidationMessageFor(
                    m => m.Description,
                    "",
                    new
                    {
                        @class = "field-error"
                    }
                )

                <div class="character-count">

                    <span id="descriptionCount">
                        0
                    </span>

                    / 2000

                </div>

            </div>

        </div>


        <!-- =================================================
             SECTION 03 — PRIORITY AND PLANNING
        ================================================== -->

        <div class="form-card">

            <div class="section-heading">

                <span class="section-number">
                    03
                </span>

                <div>

                    <h2>Priority and Planning</h2>

                    <p>
                        Indicate the urgency and intended target date for the maintenance requirement.
                    </p>

                </div>

            </div>


            <div class="two-column">

                <!-- Priority -->

                <div class="field-group">

                    @Html.LabelFor(
                        m => m.Priority,
                        new
                        {
                            @class = "field-label"
                        }
                    )

                    @Html.EnumDropDownListFor(
                        m => m.Priority,
                        "-- Select priority --",
                        new
                        {
                            @class = "form-control",
                            id = "priority"
                        }
                    )

                    @Html.ValidationMessageFor(
                        m => m.Priority,
                        "",
                        new
                        {
                            @class = "field-error"
                        }
                    )

                </div>


                <!-- Target Date -->

                <div class="field-group">

                    @Html.LabelFor(
                        m => m.TargetDate,
                        new
                        {
                            @class = "field-label"
                        }
                    )

                    @Html.TextBoxFor(
                        m => m.TargetDate,
                        "{0:yyyy-MM-dd}",
                        new
                        {
                            @class = "form-control",
                            type = "date",
                            id = "targetDate"
                        }
                    )

                    @Html.ValidationMessageFor(
                        m => m.TargetDate,
                        "",
                        new
                        {
                            @class = "field-error"
                        }
                    )

                    <small class="field-help">
                        Optional. Use this when a target date has been identified.
                    </small>

                </div>

            </div>


            <!-- Status -->

            <div class="status-notice">

                <div class="status-header">

                    <div>

                        <strong>
                            Initial maintenance status
                        </strong>

                        <p>
                            New maintenance requirements are automatically recorded
                            as identified.
                        </p>

                    </div>

                    <span class="status-badge">
                        Identified
                    </span>

                </div>

            </div>

        </div>


        <!-- =================================================
             SECTION 04 — RECORDING INFORMATION
        ================================================== -->

        <div class="form-card">

            <div class="section-heading">

                <span class="section-number">
                    04
                </span>

                <div>

                    <h2>Recording Information</h2>

                    <p>
                        Review how this maintenance requirement will be recorded.
                    </p>

                </div>

            </div>


            <div class="recording-grid">

                <div class="recording-item">

                    <span>Asset</span>

                    <strong>
                        @Model.AssetCode
                    </strong>

                </div>


                <div class="recording-item">

                    <span>Status</span>

                    <strong class="recording-status">
                        Identified
                    </strong>

                </div>


                <div class="recording-item">

                    <span>Recorded By</span>

                    <strong>
                        Current Administrator
                    </strong>

                </div>


                <div class="recording-item">

                    <span>Date</span>

                    <strong>
                        @DateTime.Now.ToString("dd MMM yyyy")
                    </strong>

                </div>

            </div>

        </div>


        <!-- =================================================
             CONFIRMATION
        ================================================== -->

        <div class="confirmation-card">

            <div class="confirmation-icon">
                ✓
            </div>

            <div>

                <h3>
                    Ready to record this maintenance need?
                </h3>

                <p>
                    The maintenance requirement will be recorded against
                    <strong>@Model.AssetCode</strong> and added to the asset's
                    audit history. You can use the record later for maintenance
                    planning and follow-up.
                </p>

            </div>

        </div>


        <!-- =================================================
             ACTIONS
        ================================================== -->

        <div class="form-actions">

            <a href="@Url.Action(
                        "Details",
                        "MunicipalAsset",
                        new { id = Model.AssetID })"
               class="btn-secondary">

                Cancel

            </a>


            <button type="submit"
                    class="btn-primary"
                    id="saveButton">

                <span class="button-icon">✓</span>

                Record Maintenance Need

            </button>

        </div>

    }

</div>


<style>

    /* =====================================================
       PAGE
    ====================================================== */

    .asset-maintenance-need-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 30px 25px 60px;
    }


    /* =====================================================
       HEADER
    ====================================================== */

    .page-header {
        margin-bottom: 25px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #0D5CC1;
        text-decoration: none;
        font-weight: 600;
        margin-bottom: 22px;
    }

        .back-link:hover {
            text-decoration: underline;
        }

    .back-icon {
        font-size: 20px;
    }

    .page-title-row {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .page-icon {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        background: #EAF2FF;
        color: #0D5CC1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
        flex-shrink: 0;
    }

    .page-title-row h1 {
        margin: 0 0 5px;
        font-size: 30px;
        font-weight: 700;
        color: #172033;
    }

    .page-header p {
        margin: 0;
        max-width: 750px;
        color: #374151;
        line-height: 1.6;
    }


    /* =====================================================
       INFORMATION NOTICE
    ====================================================== */

    .info-notice {
        display: flex;
        gap: 14px;
        padding: 18px 20px;
        margin-bottom: 22px;
        background: #F1F7FF;
        border: 1px solid #D8E8FF;
        border-radius: 12px;
    }

    .notice-icon {
        width: 28px;
        height: 28px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #0D5CC1;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .info-notice strong {
        color: #17345D;
    }

    .info-notice p {
        margin: 4px 0 0;
        color: #526276;
        font-size: 14px;
        line-height: 1.5;
    }


    /* =====================================================
       VALIDATION
    ====================================================== */

    .validation-summary {
        padding: 15px 18px;
        margin-bottom: 20px;
        border-radius: 10px;
        background: #FFF4F4;
        border: 1px solid #F0CACA;
        color: #9B2929;
    }

        .validation-summary ul {
            margin: 5px 0 0 20px;
        }


    /* =====================================================
       FORM CARDS
    ====================================================== */

    .form-card {
        background: white;
        border: 1px solid #E4E9F0;
        border-radius: 14px;
        padding: 27px;
        margin-bottom: 20px;
        box-shadow: 0 3px 12px rgba(24, 39, 75, 0.04);
    }


    /* =====================================================
       SECTION HEADINGS
    ====================================================== */

    .section-heading {
        display: flex;
        gap: 14px;
        margin-bottom: 25px;
    }

    .section-number {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        border-radius: 9px;
        background: #EAF2FF;
        color: #0D5CC1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 13px;
    }

    .section-heading h2 {
        margin: 0 0 5px;
        font-size: 19px;
        color: #1C2738;
    }

    .section-heading p {
        margin: 0;
        color: #758093;
        font-size: 14px;
        line-height: 1.5;
    }


    /* =====================================================
       ASSET INFORMATION
    ====================================================== */

    .information-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    .information-item {
        padding: 16px;
        border-radius: 10px;
        background: #F8FAFC;
        border: 1px solid #E8EDF3;
    }

        .information-item.full-width {
            grid-column: 1 / -1;
        }

        .information-item span {
            display: block;
            color: #778397;
            font-size: 12px;
            margin-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .information-item strong {
            color: #1E293B;
            font-size: 15px;
            line-height: 1.4;
        }


    /* =====================================================
       FORM FIELDS
    ====================================================== */

    .field-group {
        position: relative;
        margin-bottom: 22px;
    }

        .field-group:last-child {
            margin-bottom: 0;
        }

    .field-label {
        display: block;
        margin-bottom: 8px;
        color: #263447;
        font-weight: 600;
        font-size: 14px;
    }

    .form-control {
        width: 100%;
        min-height: 46px;
        padding: 11px 13px;
        border: 1px solid #CBD3DF;
        border-radius: 9px;
        background: white;
        color: #202B3C;
        font-size: 14px;
        box-sizing: border-box;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .form-control:focus {
            outline: none;
            border-color: #0D5CC1;
            box-shadow: 0 0 0 3px rgba(13, 92, 193, .10);
        }

    .textarea-control {
        resize: vertical;
        min-height: 145px;
        line-height: 1.5;
    }

    .field-help {
        display: block;
        margin-top: 7px;
        color: #7A8699;
        font-size: 12px;
    }

    .field-error {
        display: block;
        margin-top: 6px;
        color: #C0392B;
        font-size: 12px;
    }

    .character-count {
        text-align: right;
        margin-top: 6px;
        color: #7A8699;
        font-size: 12px;
    }


    /* =====================================================
       TWO COLUMN
    ====================================================== */

    .two-column {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }


    /* =====================================================
       STATUS
    ====================================================== */

    .status-notice {
        margin-top: 20px;
        padding: 17px 18px;
        border-radius: 10px;
        background: #F1F7FF;
        border: 1px solid #D8E8FF;
    }

    .status-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

        .status-header strong {
            color: #17345D;
            font-size: 14px;
        }

        .status-header p {
            margin: 5px 0 0;
            color: #687386;
            font-size: 13px;
            line-height: 1.5;
        }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 12px;
        border-radius: 20px;
        background: #EAF2FF;
        color: #0D5CC1;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }


    /* =====================================================
       RECORDING INFORMATION
    ====================================================== */

    .recording-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }

    .recording-item {
        padding: 15px;
        background: #F8FAFC;
        border: 1px solid #E8EDF3;
        border-radius: 10px;
    }

        .recording-item span {
            display: block;
            margin-bottom: 5px;
            color: #778397;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .recording-item strong {
            color: #1E293B;
            font-size: 14px;
        }

        .recording-item .recording-status {
            color: #0D5CC1;
        }


    /* =====================================================
       CONFIRMATION
    ====================================================== */

    .confirmation-card {
        display: flex;
        gap: 15px;
        align-items: flex-start;
        padding: 20px;
        margin-bottom: 22px;
        background: #F8FAFC;
        border: 1px solid #E4E9F0;
        border-radius: 12px;
    }

    .confirmation-icon {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #E8F6EE;
        color: #21834B;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }

    .confirmation-card h3 {
        margin: 0 0 5px;
        color: #263447;
        font-size: 16px;
    }

    .confirmation-card p {
        margin: 0;
        color: #687386;
        font-size: 13px;
        line-height: 1.6;
    }


    /* =====================================================
       ACTIONS
    ====================================================== */

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    .btn-primary,
    .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 0 21px;
        border-radius: 9px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: background .2s ease, border-color .2s ease, transform .1s ease;
    }

    .btn-primary {
        background: #0D5CC1;
        color: white;
        border: 1px solid #0D5CC1;
    }

        .btn-primary:hover {
            background: #094A9F;
            border-color: #094A9F;
        }

        .btn-primary:active {
            transform: translateY(1px);
        }

    .btn-secondary {
        background: white;
        color: #344054;
        border: 1px solid #CBD3DF;
    }

        .btn-secondary:hover {
            background: #F7F9FC;
        }

    .button-icon {
        font-size: 13px;
    }


    /* =====================================================
       RESPONSIVE
    ====================================================== */

    @@media (max-width: 700px) {

        .asset-maintenance-need-page {
            padding: 22px 15px 45px;
        }

        .page-title-row {
            align-items: flex-start;
        }

            .page-title-row h1 {
                font-size: 24px;
            }

            .page-title-row p {
                font-size: 14px;
            }

        .form-card {
            padding: 20px;
        }

        .information-grid {
            grid-template-columns: 1fr;
        }

        .information-item.full-width {
            grid-column: auto;
        }

        .two-column {
            grid-template-columns: 1fr;
        }

        .recording-grid {
            grid-template-columns: 1fr;
        }

        .status-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .confirmation-card {
            padding: 17px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .btn-primary,
        .btn-secondary {
            width: 100%;
        }
    }
</style>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        /* =================================================
           DESCRIPTION CHARACTER COUNT
        ================================================== */

        var description =
            document.getElementById("description");

        var descriptionCount =
            document.getElementById("descriptionCount");


        function updateDescriptionCount() {

            if (!description || !descriptionCount)
                return;

            descriptionCount.textContent =
                description.value.length;

        }


        if (description) {

            description.addEventListener(
                "input",
                updateDescriptionCount
            );

            updateDescriptionCount();

        }


        /* =================================================
           TARGET DATE
        ================================================== */

        var targetDate =
            document.getElementById("targetDate");


        if (targetDate) {

            var today =
                new Date().toISOString().split("T")[0];

            targetDate.setAttribute(
                "min",
                today
            );

        }


        /* =================================================
           FORM CONFIRMATION
        ================================================== */

        var form =
            document.getElementById("maintenanceNeedForm");


        if (form) {

            form.addEventListener(
                "submit",
                function (event) {

                    var confirmed =
                        confirm(
                            "Are you sure you want to record this maintenance need for the selected asset?"
                        );


                    if (!confirmed) {

                        event.preventDefault();

                    }

                }
            );

        }

    });

</script>
