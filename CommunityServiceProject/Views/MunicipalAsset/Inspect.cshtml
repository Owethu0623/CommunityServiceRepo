            padding: 20px;
        }

        .asset-information-grid,
        .two-column {
            grid-template-columns: 1fr;
        }

        .inspection-comparison {
            flex-direction: column;
            align-items: stretch;
            gap: 10px;
        }

        .comparison-arrow {
            text-align: center;
            transform: rotate(90deg);
        }

        .inspection-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .actions-left,
        .actions-right {
