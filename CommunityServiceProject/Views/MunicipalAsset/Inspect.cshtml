</style>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        var findings = document.getElementById("Findings");
        var findingsCount = document.getElementById("findingsCount");

        var conditionSelect =
            document.getElementById("ConditionObserved");

        var conditionSummary =
            document.getElementById("conditionSummary");

        var summaryCondition =
            document.getElementById("summaryCondition");

        var inspectionDate =
            document.getElementById("InspectionDate");

        var summaryInspectionDate =
            document.getElementById("summaryInspectionDate");

        var nextInspectionDate =
            document.getElementById("NextInspectionDate");

        var summaryNextInspection =
            document.getElementById("summaryNextInspection");

        var form =
            document.getElementById("inspectionForm");


        /* =====================================================
           FINDINGS CHARACTER COUNT
           ===================================================== */

        function updateFindingsCount() {

            if (!findings || !findingsCount) {
                return;
            }

            findingsCount.textContent =
                findings.value.length;
        }


        if (findings) {

            findings.addEventListener(
                "input",
                updateFindingsCount
            );

            updateFindingsCount();
        }


        /* =====================================================
           CONDITION SUMMARY
           ===================================================== */

        function updateConditionSummary() {

            if (!conditionSelect) {
                return;
            }

            var selectedText =
                conditionSelect.options[
                    conditionSelect.selectedIndex
                ].text;

            if (conditionSummary) {
                conditionSummary.textContent =
                    selectedText === "Select condition observed"
                        ? "Not selected"
                        : selectedText;
            }

            if (summaryCondition) {
                summaryCondition.textContent =
                    selectedText === "Select condition observed"
                        ? "Not selected"
                        : selectedText;
            }
        }


        if (conditionSelect) {

            conditionSelect.addEventListener(
                "change",
                updateConditionSummary
            );

            updateConditionSummary();
        }


        /* =====================================================
           INSPECTION DATE SUMMARY
           ===================================================== */

        function updateInspectionDateSummary() {

            if (!inspectionDate ||
                !summaryInspectionDate) {

                return;
            }

            if (!inspectionDate.value) {

                summaryInspectionDate.textContent =
                    "Not specified";

                return;
            }

            var parts =
                inspectionDate.value.split("-");

            if (parts.length !== 3) {
                return;
            }

            var date =
                new Date(
                    parseInt(parts[0], 10),
                    parseInt(parts[1], 10) - 1,
                    parseInt(parts[2], 10)
                );

            summaryInspectionDate.textContent =
                date.toLocaleDateString(
                    "en-GB",
                    {
                        day: "2-digit",
                        month: "short",
                        year: "numeric"
                    }
                );
        }


        if (inspectionDate) {

            inspectionDate.addEventListener(
                "change",
                updateInspectionDateSummary
            );

            updateInspectionDateSummary();
        }


        /* =====================================================
           NEXT INSPECTION SUMMARY
           ===================================================== */

        function updateNextInspectionSummary() {

            if (!nextInspectionDate ||
                !summaryNextInspection) {

                return;
            }

            if (!nextInspectionDate.value) {

                summaryNextInspection.textContent =
                    "Not scheduled";

                return;
            }

            var parts =
                nextInspectionDate.value.split("-");

            if (parts.length !== 3) {
                return;
            }

            var date =
                new Date(
                    parseInt(parts[0], 10),
                    parseInt(parts[1], 10) - 1,
                    parseInt(parts[2], 10)
                );

            summaryNextInspection.textContent =
                date.toLocaleDateString(
                    "en-GB",
                    {
                        day: "2-digit",
                        month: "short",
                        year: "numeric"
                    }
                );
        }


        if (nextInspectionDate) {

            nextInspectionDate.addEventListener(
                "change",
                updateNextInspectionSummary
            );

            updateNextInspectionSummary();
        }


        /* =====================================================
           SUBMISSION CONFIRMATION
           ===================================================== */

        if (form) {

            form.addEventListener(
                "submit",
                function (event) {

                    var findingsValue =
                        findings
                            ? findings.value.trim()
                            : "";

                    var conditionSelected =
                        conditionSelect &&
                        conditionSelect.value !== "";

                    if (!conditionSelected) {

                        return;
                    }

                    if (findingsValue.length < 5) {

                        return;
                    }

                    var selectedCondition =
                        conditionSelect.options[
                            conditionSelect.selectedIndex
                        ].text;

                    var confirmed =
                        window.confirm(
                            "Record this formal asset inspection?\n\n" +
                            "Asset: @Html.Raw(HttpUtility.JavaScriptStringEncode(Model.AssetCode))\n" +
                            "Condition observed: " +
                            selectedCondition +
                            "\n\n" +
                            "The inspection will be saved to the asset's official inspection history."
                        );

                    if (!confirmed) {

                        event.preventDefault();

                    }

                }
            );

        }

    });

</script>