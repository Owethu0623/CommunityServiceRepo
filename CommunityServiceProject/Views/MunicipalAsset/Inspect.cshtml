    .btn-primary {
        border: 1px solid #0d5cc1;
        background: #0d5cc1;
        color: #ffffff;
    }

    .btn-primary:hover {
        background: #0a4fa8;
        border-color: #0a4fa8;
        color: #ffffff;
        text-decoration: none;
    }

    .btn-secondary {
        border: 1px solid #cfd6e1;
        background: #ffffff;
        color: #344054;
    }

