<script>

    document.addEventListener("DOMContentLoaded", function () {

        // =====================================================
        // LINK PROJECT ELEMENTS
        // =====================================================

        var linkModal =
            document.getElementById("linkProjectModal");

        var linkProjectForm =
            document.getElementById("linkProjectForm");

        var linkProjectID =
            document.getElementById("linkProjectID");

        var linkProjectNotes =
            document.getElementById("linkProjectNotes");

        var modalProjectCode =
            document.getElementById("modalProjectCode");

        var modalProjectName =
            document.getElementById("modalProjectName");

        var linkNotes =
            document.getElementById("linkNotes");

        var linkNotesCount =
            document.getElementById("linkNotesCount");

        var cancelLinkProject =
            document.getElementById("cancelLinkProject");

        var confirmLinkProject =
            document.getElementById("confirmLinkProject");


        // =====================================================
        // UNLINK PROJECT ELEMENTS
        // =====================================================

        var unlinkModal =
            document.getElementById("unlinkProjectModal");

        var unlinkProjectForm =
            document.getElementById("unlinkProjectForm");

        var unlinkAssetProjectID =
            document.getElementById("unlinkAssetProjectID");

        var unlinkProjectCode =
            document.getElementById("unlinkProjectCode");

        var unlinkProjectName =
            document.getElementById("unlinkProjectName");

        var cancelUnlinkProject =
            document.getElementById("cancelUnlinkProject");

        var confirmUnlinkProject =
            document.getElementById("confirmUnlinkProject");


        // =====================================================
        // OPEN LINK MODAL
        // =====================================================

        var linkButtons =
            document.querySelectorAll(".link-project-button");

        linkButtons.forEach(function (button) {

            button.addEventListener("click", function () {

                var projectID =
                    button.getAttribute("data-project-id");

                var projectCode =
                    button.getAttribute("data-project-code");

                var projectName =
                    button.getAttribute("data-project-name");


                linkProjectID.value =
                    projectID;

                modalProjectCode.textContent =
                    projectCode;

                modalProjectName.textContent =
                    projectName;

                linkNotes.value =
                    "";

                linkNotesCount.textContent =
                    "0";

                linkModal.classList.add("active");

            });

        });


        // =====================================================
        // LINK NOTES COUNTER
        // =====================================================

        if (linkNotes) {

            linkNotes.addEventListener(
                "input",
                function () {

                    linkNotesCount.textContent =
                        linkNotes.value.length;

                });

        }


        // =====================================================
        // CANCEL LINK
        // =====================================================

        if (cancelLinkProject) {

            cancelLinkProject.addEventListener(
                "click",
                function () {

                    linkModal.classList.remove(
                        "active"
                    );

                });

        }


        // =====================================================
        // CONFIRM LINK
        // =====================================================

        if (confirmLinkProject) {

            confirmLinkProject.addEventListener(
                "click",
                function () {

                    linkProjectNotes.value =
                        linkNotes.value.trim();

                    confirmLinkProject.disabled =
                        true;

                    confirmLinkProject.textContent =
                        "Linking...";

                    linkProjectForm.submit();

                });

        }


        // =====================================================
        // OPEN UNLINK MODAL
        // =====================================================

        var unlinkButtons =
            document.querySelectorAll(
                ".unlink-project-button"
            );

        unlinkButtons.forEach(function (button) {

            button.addEventListener(
                "click",
                function () {

                    var assetProjectID =
                        button.getAttribute(
                            "data-id"
                        );

                    var projectCode =
                        button.getAttribute(
                            "data-project-code"
                        );

                    var projectName =
                        button.getAttribute(
                            "data-project-name"
                        );


                    unlinkAssetProjectID.value =
                        assetProjectID;

                    unlinkProjectCode.textContent =
                        projectCode;

                    unlinkProjectName.textContent =
                        projectName;

                    unlinkModal.classList.add(
                        "active"
                    );

                });

        });


        // =====================================================
        // CANCEL UNLINK
        // =====================================================

        if (cancelUnlinkProject) {

            cancelUnlinkProject.addEventListener(
                "click",
                function () {

                    unlinkModal.classList.remove(
                        "active"
                    );

                });

        }


        // =====================================================
        // CONFIRM UNLINK
        // =====================================================

        if (confirmUnlinkProject) {

            confirmUnlinkProject.addEventListener(
                "click",
                function () {

                    confirmUnlinkProject.disabled =
                        true;

                    confirmUnlinkProject.textContent =
                        "Unlinking...";

                    unlinkProjectForm.submit();

                });

        }


        // =====================================================
        // CLOSE MODALS WHEN CLICKING OUTSIDE
        // =====================================================

        if (linkModal) {

            linkModal.addEventListener(
                "click",
                function (event) {

                    if (event.target === linkModal) {

                        linkModal.classList.remove(
                            "active"
                        );

                    }

                });

        }


        if (unlinkModal) {

            unlinkModal.addEventListener(
                "click",
                function (event) {

                    if (event.target === unlinkModal) {

                        unlinkModal.classList.remove(
                            "active"
                        );

                    }

                });

        }


        // =====================================================
        // ESCAPE KEY
        // =====================================================

        document.addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Escape") {

                    if (linkModal) {

                        linkModal.classList.remove(
                            "active"
                        );

                    }

                    if (unlinkModal) {

                        unlinkModal.classList.remove(
                            "active"
                        );

                    }

                }

            });


        // =====================================================
        // AUTO HIDE ALERTS
        // =====================================================

        var alerts =
            document.querySelectorAll(
                ".page-alert"
            );

        alerts.forEach(function (alert) {

            setTimeout(
                function () {

                    alert.style.transition =
                        "opacity .3s ease";

                    alert.style.opacity =
                        "0";

                    setTimeout(
                        function () {

                            if (alert.parentNode) {

                                alert.parentNode.removeChild(
                                    alert
                                );

                            }

                        },
                        350
                    );

                },
                5000
            );

        });

    });

</script>

