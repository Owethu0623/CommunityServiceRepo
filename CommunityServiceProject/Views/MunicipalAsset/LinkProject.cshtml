
@model CommunityServiceProject.ViewModels.MunicipalAssetProjectsViewModel

@{
    ViewBag.Title = "Link Project to Asset";
}

<div class="asset-project-page">

    <!-- =========================================================
         TOP NAVIGATION
         ========================================================= -->

    <div class="asset-project-navigation">

        <div class="navigation-left">

            <a href="@Url.Action("Details", "MunicipalAsset", new { id = Model.AssetID })"
               class="asset-nav-btn">
                ← Asset Details
            </a>

            <a href="@Url.Action("Index", "MunicipalAsset")"
               class="asset-nav-btn">
                Asset Register
            </a>

            <a href="@Url.Action("Dashboard", "MunicipalAsset")"
               class="asset-nav-btn">
                Asset Dashboard
            </a>

        </div>

        <div class="navigation-right">

            <a href="@Url.Action("Edit", "MunicipalAsset", new { id = Model.AssetID })"
               class="asset-action-btn asset-action-primary">
                Edit Asset
            </a>

        </div>

    </div>


    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="asset-project-hero">

        <div class="asset-project-hero-main">

            <div class="asset-project-eyebrow">
                ASSET PROJECT MANAGEMENT
            </div>

            <div class="asset-project-code">
                @Model.AssetCode
            </div>

            <h1>
                Link Projects to Asset
            </h1>

            <p>
                Manage the municipal projects associated with this asset.
                Existing project relationships are shown below, while
                available projects can be linked to the asset.
            </p>

        </div>

        <div class="asset-project-hero-side">

            <div class="hero-stat">

                <span>
                    Linked Projects
                </span>

                <strong>
                    @Model.LinkedProjects.Count
                </strong>

            </div>

            <div class="hero-stat">

                <span>
                    Available Projects
                </span>

                <strong>
                    @Model.AvailableProjects.Count
                </strong>

            </div>

        </div>

    </div>


    <!-- =========================================================
         SUCCESS / ERROR MESSAGES
         ========================================================= -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="page-alert page-alert-success">

            <div class="alert-icon">
                ✓
            </div>

            <div>
                <strong>
                    Success
                </strong>

                <span>
                    @TempData["SuccessMessage"]
                </span>
            </div>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="page-alert page-alert-error">

            <div class="alert-icon">
                !
            </div>

            <div>
                <strong>
                    Action could not be completed
                </strong>

                <span>
                    @TempData["ErrorMessage"]
                </span>
            </div>

        </div>
    }


    <!-- =========================================================
         ASSET CONTEXT
         ========================================================= -->

    <section class="asset-project-section">

        <div class="section-heading">

            <div>

                <h2>
                    Asset Information
                </h2>

                <p>
                    Confirm the asset before managing its project relationships.
                </p>

            </div>

        </div>

        <div class="asset-context-grid">

            <div class="asset-context-item">

                <span>
                    Asset Code
                </span>

                <strong>
                    @Model.AssetCode
                </strong>

            </div>

            <div class="asset-context-item">

                <span>
                    Asset Name
                </span>

                <strong>
                    @Model.AssetName
                </strong>

            </div>

            <div class="asset-context-item">

                <span>
                    Asset Type
                </span>

                <strong>
                    @Model.AssetType
                </strong>

            </div>

            <div class="asset-context-item">

                <span>
                    Asset Category
                </span>

                <strong>
                    @(string.IsNullOrWhiteSpace(Model.AssetCategory)
                        ? "Not specified"
                        : Model.AssetCategory)
                </strong>

            </div>

            <div class="asset-context-item">

                <span>
                    Ward
                </span>

                <strong>
                    @(string.IsNullOrWhiteSpace(Model.WardName)
                        ? "Ward unavailable"
                        : Model.WardName)
                </strong>

            </div>

            <div class="asset-context-item asset-context-wide">

                <span>
                    Location
                </span>

                <strong>
                    @(string.IsNullOrWhiteSpace(Model.LocationDescription)
                        ? "Location not specified"
                        : Model.LocationDescription)
                </strong>

            </div>

        </div>

    </section>


    <!-- =========================================================
         CURRENTLY LINKED PROJECTS
         ========================================================= -->

    <section class="asset-project-section">

        <div class="section-heading">

            <div>

                <h2>
                    Currently Linked Projects
                </h2>

                <p>
                    These projects are already associated with this municipal asset.
                </p>

            </div>

            <span class="section-count">
                @Model.LinkedProjects.Count
                @(Model.LinkedProjects.Count == 1 ? "Project" : "Projects")
            </span>

        </div>


        @if (Model.LinkedProjects != null &&
             Model.LinkedProjects.Any())
        {
            <div class="linked-project-list">

                @foreach (var project in Model.LinkedProjects)
                {
                    <div class="linked-project-card">

                        <div class="linked-project-main">

                            <div class="project-code">
                                @project.ProjectCode
                            </div>

                            <h3>
                                @project.ProjectName
                            </h3>

                            <div class="project-meta-grid">

                                <div class="project-meta-item">

                                    <span>
                                        Project Type
                                    </span>

                                    <strong>
                                        @project.ProjectType
                                    </strong>

                                </div>

                                <div class="project-meta-item">

                                    <span>
                                        Ward
                                    </span>

                                    <strong>
                                        @project.WardName
                                    </strong>

                                </div>

                                <div class="project-meta-item">

                                    <span>
                                        Status
                                    </span>

                                    <strong>
                                        <span class="project-status-badge project-status-@project.Status">
                                            @project.Status
                                        </span>
                                    </strong>

                                </div>

                                <div class="project-meta-item">

                                    <span>
                                        Priority
                                    </span>

                                    <strong>
                                        <span class="project-priority-badge project-priority-@project.Priority">
                                            @project.Priority
                                        </span>
                                    </strong>

                                </div>

                                <div class="project-meta-item">

                                    <span>
                                        Start Date
                                    </span>

                                    <strong>
                                        @project.StartDate.ToString("dd MMM yyyy")
                                    </strong>

                                </div>

                                <div class="project-meta-item">

                                    <span>
                                        Expected Completion
                                    </span>

                                    <strong>
                                        @(project.ExpectedCompletionDate.HasValue
                                            ? project.ExpectedCompletionDate.Value.ToString("dd MMM yyyy")
                                            : "Not specified")
                                    </strong>

                                </div>

                            </div>

                            <div class="project-location">

                                <span>
                                    Location
                                </span>

                                <strong>
                                    @(string.IsNullOrWhiteSpace(project.ProjectLocation)
                                        ? "Location not specified"
                                        : project.ProjectLocation)
                                </strong>

                            </div>

                            <div class="link-information">

                                <span>
                                    Linked @project.LinkDate.ToString("dd MMM yyyy")
                                </span>

                                <span>
                                    By @(string.IsNullOrWhiteSpace(project.LinkedByAdministratorName)
                                        ? "Administrator"
                                        : project.LinkedByAdministratorName)
                                </span>

                                @if (!string.IsNullOrWhiteSpace(project.Notes))
                                {
                                    <span>
                                        Note: @project.Notes
                                    </span>
                                }

                            </div>

                        </div>

                        <div class="linked-project-actions">

                            <a href="@Url.Action("Details", "MunicipalProject", new { id = project.ProjectID })"
                               class="project-action-btn project-action-view">
                                View Project
                            </a>

                            <button type="button"
                                    class="project-action-btn project-action-danger unlink-project-button"
                                    data-id="@project.AssetProjectID"
                                    data-project-code="@project.ProjectCode"
                                    data-project-name="@project.ProjectName">
                                Unlink
                            </button>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-project-state">

                <div class="empty-state-icon">
                    +
                </div>

                <strong>
                    No projects linked to this asset
                </strong>

                <span>
                    This asset is not currently associated with any municipal projects.
                    Use the available projects section below to establish a relationship.
                </span>

            </div>
        }

    </section>


    <!-- =========================================================
         AVAILABLE PROJECTS
         ========================================================= -->

    <section class="asset-project-section">

        <div class="section-heading">

            <div>

                <h2>
                    Available Municipal Projects
                </h2>

                <p>
                    Search and filter projects that are not currently linked to this asset.
                </p>

            </div>

        </div>


        <!-- =====================================================
             SEARCH / FILTERS
             ===================================================== -->

        <div class="project-filter-panel">

            @using (Html.BeginForm(
                "LinkProject",
                "MunicipalAsset",
                FormMethod.Get,
                new { @class = "project-filter-form" }))
            {
                <input type="hidden"
                       name="id"
                       value="@Model.AssetID" />

                <div class="filter-group filter-search">

                    <label for="searchTerm">
                        Search
                    </label>

                    <input type="text"
                           id="searchTerm"
                           name="searchTerm"
                           value="@Model.SearchTerm"
                           class="filter-control"
                           placeholder="Project code, name, type or location..." />

                </div>


                <div class="filter-group">

                    <label for="projectType">
                        Project Type
                    </label>

                    @Html.DropDownList(
                        "projectType",
                        Model.ProjectTypeOptions,
                        "All Project Types",
                        new { @class = "filter-control" })

                </div>


                <div class="filter-group">

                    <label for="projectStatus">
                        Status
                    </label>

                    @Html.DropDownList(
                        "projectStatus",
                        Model.ProjectStatusOptions,
                        "All Statuses",
                        new { @class = "filter-control" })

                </div>


                <div class="filter-group">

                    <label for="projectPriority">
                        Priority
                    </label>

                    @Html.DropDownList(
                        "projectPriority",
                        Model.ProjectPriorityOptions,
                        "All Priorities",
                        new { @class = "filter-control" })

                </div>


                <div class="filter-group">

                    <label for="ward">
                        Ward
                    </label>

                    @Html.DropDownList(
                        "ward",
                        Model.WardOptions,
                        "All Wards",
                        new { @class = "filter-control" })

                </div>


                <div class="filter-actions">

                    <button type="submit"
                            class="filter-submit-btn">
                        Apply Filters
                    </button>

                    <a href="@Url.Action("LinkProject", "MunicipalAsset", new { id = Model.AssetID })"
                       class="filter-reset-btn">
                        Reset
                    </a>

                </div>
            }

        </div>


        <!-- =====================================================
             AVAILABLE PROJECT RESULTS
             ===================================================== -->

        @if (Model.AvailableProjects != null &&
             Model.AvailableProjects.Any())
        {
            <div class="results-summary">

                <span>
                    Showing
                    <strong>@Model.AvailableProjects.Count</strong>
                    available
                    @(Model.AvailableProjects.Count == 1 ? "project" : "projects")
                </span>

                <span class="results-note">
                    Projects already linked to this asset are excluded.
                </span>

            </div>


            <div class="available-projects-wrapper">

                <table class="available-projects-table">

                    <thead>

                        <tr>

                            <th>
                                Project
                            </th>

                            <th>
                                Type
                            </th>

                            <th>
                                Location
                            </th>

                            <th>
                                Ward
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Priority
                            </th>

                            <th>
                                Start Date
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var project in Model.AvailableProjects)
                        {
                            <tr>

                                <td>

                                    <div class="table-project">

                                        <strong>
                                            @project.ProjectCode
                                        </strong>

                                        <span>
                                            @project.ProjectName
                                        </span>

                                    </div>

                                </td>

                                <td>
                                    @project.ProjectType
                                </td>

                                <td>

                                    @(string.IsNullOrWhiteSpace(project.ProjectLocation)
                                        ? "Not specified"
                                        : project.ProjectLocation)

                                </td>

                                <td>
                                    @project.WardName
                                </td>

                                <td>

                                    <span class="project-status-badge project-status-@project.Status">
                                        @project.Status
                                    </span>

                                </td>

                                <td>

                                    <span class="project-priority-badge project-priority-@project.Priority">
                                        @project.Priority
                                    </span>

                                </td>

                                <td>
                                    @project.StartDate.ToString("dd MMM yyyy")
                                </td>

                                <td>

                                    <button type="button"
                                            class="link-project-button"
                                            data-project-id="@project.ProjectID"
                                            data-project-code="@project.ProjectCode"
                                            data-project-name="@project.ProjectName">
                                        Link Project
                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-project-state">

                <div class="empty-state-icon">
                    ✓
                </div>

                <strong>
                    No available projects found
                </strong>

                <span>
                    There are no projects matching the current search and filters,
                    or all matching projects are already linked to this asset.
                </span>

                <a href="@Url.Action("LinkProject", "MunicipalAsset", new { id = Model.AssetID })"
                   class="asset-small-btn">
                    View All Projects
                </a>

            </div>
        }

    </section>


    <!-- =========================================================
         BOTTOM NAVIGATION
         ========================================================= -->

    <div class="asset-project-bottom-navigation">

        <a href="@Url.Action("Details", "MunicipalAsset", new { id = Model.AssetID })"
           class="asset-nav-btn">
            ← Back to Asset Details
        </a>

        <div class="bottom-navigation-actions">

            <a href="@Url.Action("Index", "MunicipalAsset")"
               class="asset-nav-btn">
                Asset Register
            </a>

            <a href="@Url.Action("Dashboard", "MunicipalAsset")"
               class="asset-nav-btn">
                Asset Dashboard
            </a>

        </div>

    </div>

</div>


<!-- =============================================================
     LINK PROJECT MODAL
     ============================================================= -->

<div id="linkProjectModal"
     class="project-modal-overlay">

    <div class="project-modal">

        <div class="modal-icon modal-icon-link">
            +
        </div>

        <h3>
            Link Project to Asset?
        </h3>

        <p>
            You are about to associate the following project with this municipal asset.
        </p>

        <div class="modal-project-summary">

            <span>
                Project
            </span>

            <strong id="modalProjectCode">
                —
            </strong>

            <span id="modalProjectName">
                —
            </span>

        </div>

        <div class="modal-note-section">

            <label for="linkNotes">
                Link Notes
                <span>(Optional)</span>
            </label>

            <textarea id="linkNotes"
                      maxlength="1000"
                      rows="3"
                      placeholder="Add an optional note about this project relationship..."></textarea>

            <div class="character-counter">
                <span id="linkNotesCount">0</span> / 1000
            </div>

        </div>

        <div class="modal-warning">

            <strong>
                Relationship will be recorded
            </strong>

            <span>
                The system will record the administrator and date
                associated with this project link.
            </span>

        </div>

        <div class="modal-actions">

            <button type="button"
                    id="cancelLinkProject"
                    class="modal-secondary-btn">
                Cancel
            </button>

            <button type="button"
                    id="confirmLinkProject"
                    class="modal-primary-btn">
                Confirm Link
            </button>

        </div>

    </div>

</div>


<!-- =============================================================
     UNLINK PROJECT MODAL
     ============================================================= -->

<div id="unlinkProjectModal"
     class="project-modal-overlay">

    <div class="project-modal">

        <div class="modal-icon modal-icon-danger">
            !
        </div>

        <h3>
            Unlink Project?
        </h3>

        <p>
            You are about to remove the project relationship from this asset.
        </p>

        <div class="modal-project-summary">

            <span>
                Project
            </span>

            <strong id="unlinkProjectCode">
                —
            </strong>

            <span id="unlinkProjectName">
                —
            </span>

        </div>

        <div class="modal-warning modal-warning-danger">

            <strong>
                This does not delete the project
            </strong>

            <span>
                Only the relationship between this asset and the project
                will be removed.
            </span>

        </div>

        <div class="modal-actions">

            <button type="button"
                    id="cancelUnlinkProject"
                    class="modal-secondary-btn">
                Cancel
            </button>

            <button type="button"
                    id="confirmUnlinkProject"
                    class="modal-danger-btn">
                Unlink Project
            </button>

        </div>

    </div>

</div>


<!-- =============================================================
     HIDDEN POST FOR LINK PROJECT
     ============================================================= -->

@using (Html.BeginForm(
    "LinkProject",
    "MunicipalAsset",
    FormMethod.Post,
    new { id = "linkProjectForm" }))
{
    @Html.AntiForgeryToken()

    <input type="hidden"
           id="linkAssetID"
           name="AssetID"
           value="@Model.AssetID" />

    <input type="hidden"
           id="linkProjectID"
           name="ProjectID"
           value="" />

    <input type="hidden"
           id="linkProjectNotes"
           name="Notes"
           value="" />
}


<!-- =============================================================
     HIDDEN POST FOR UNLINK PROJECT
     ============================================================= -->

@using (Html.BeginForm(
    "UnlinkProject",
    "MunicipalAsset",
    FormMethod.Post,
    new { id = "unlinkProjectForm" }))
{
    @Html.AntiForgeryToken()

    <input type="hidden"
           id="unlinkAssetProjectID"
           name="id"
           value="" />

    <input type="hidden"
           id="unlinkAssetID"
           name="assetID"
           value="@Model.AssetID" />
}


<style>

    /* ============================================================
       PAGE
       ============================================================ */

    .asset-project-page {
        max-width: 1450px;
        margin: 0 auto;
        padding: 30px;
        font-family: Arial, sans-serif;
        color: #172033;
    }


    /* ============================================================
       NAVIGATION
       ============================================================ */

    .asset-project-navigation,
    .asset-project-bottom-navigation {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 22px;
    }

    .navigation-left,
    .navigation-right,
    .bottom-navigation-actions {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
    }

    .asset-nav-btn,
    .asset-action-btn,
    .asset-small-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border-radius: 7px;
        font-size: 13px;
        font-weight: 600;
        box-sizing: border-box;
        cursor: pointer;
        transition: all .15s ease;
    }

    .asset-nav-btn {
        min-height: 40px;
        padding: 0 14px;
        background: white;
        color: #344054;
        border: 1px solid #d0d5dd;
    }

        .asset-nav-btn:hover {
            background: #f8fafc;
            color: #172033;
            text-decoration: none;
        }

    .asset-action-btn {
        min-height: 40px;
        padding: 0 15px;
        border: 1px solid transparent;
    }

    .asset-action-primary {
        background: #0D5CC1;
        color: white;
    }

        .asset-action-primary:hover {
            background: #094b9f;
            color: white;
            text-decoration: none;
        }


    /* ============================================================
       HERO
       ============================================================ */

    .asset-project-hero {
        background: white;
        border: 1px solid #e4e7ec;
        border-radius: 12px;
        padding: 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 30px;
        margin-bottom: 22px;
        box-shadow: 0 2px 8px rgba(0,0,0,.04);
    }

    .asset-project-hero-main {
        min-width: 0;
    }

    .asset-project-eyebrow {
        color: #0D5CC1;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .08em;
        margin-bottom: 7px;
    }

    .asset-project-code {
        color: #667085;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .asset-project-hero h1 {
        margin: 0;
        color: #172033;
        font-size: 29px;
        line-height: 1.25;
    }

    .asset-project-hero p {
        margin: 9px 0 0;
        max-width: 850px;
        color: #667085;
        font-size: 13px;
        line-height: 1.6;
    }

    .asset-project-hero-side {
        display: flex;
        gap: 12px;
        flex-shrink: 0;
    }

    .hero-stat {
        min-width: 120px;
        padding: 15px 17px;
        border: 1px solid #e4e7ec;
        border-radius: 9px;
        background: #f8fafc;
    }

        .hero-stat span {
            display: block;
            color: #667085;
            font-size: 11px;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .hero-stat strong {
            display: block;
            color: #0D5CC1;
            font-size: 23px;
        }


    /* ============================================================
       ALERTS
       ============================================================ */

    .page-alert {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 14px 16px;
        border-radius: 9px;
        margin-bottom: 20px;
        border: 1px solid;
        font-size: 13px;
    }

        .page-alert > div:last-child {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

    .page-alert-success {
        background: #ecfdf3;
        border-color: #abefc6;
        color: #067647;
    }

    .page-alert-error {
        background: #fef3f2;
        border-color: #fecdca;
        color: #b42318;
    }

    .alert-icon {
        width: 22px;
        height: 22px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-weight: 700;
        flex-shrink: 0;
    }

    .page-alert-success .alert-icon {
        background: #12b76a;
        color: white;
    }

    .page-alert-error .alert-icon {
        background: #f04438;
        color: white;
    }


    /* ============================================================
       SECTIONS
       ============================================================ */

    .asset-project-section {
        background: white;
        border: 1px solid #e4e7ec;
        border-radius: 10px;
        padding: 24px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,.035);
    }

    .section-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 20px;
    }

        .section-heading h2 {
            margin: 0;
            color: #172033;
            font-size: 19px;
        }

        .section-heading p {
            margin: 5px 0 0;
            color: #667085;
            font-size: 13px;
            line-height: 1.5;
        }

    .section-count {
        display: inline-flex;
        align-items: center;
        min-height: 32px;
        padding: 0 11px;
        border-radius: 20px;
        background: #eff6ff;
        color: #0D5CC1;
        border: 1px solid #c7d9f2;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }


    /* ============================================================
       ASSET CONTEXT
       ============================================================ */

    .asset-context-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1px;
        background: #eaecf0;
        border: 1px solid #eaecf0;
