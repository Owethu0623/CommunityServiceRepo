@model CommunityServiceProject.ViewModels.UpdateAssetConditionAfterMaintenanceViewModel

@{
    ViewBag.Title = "Update Condition After Maintenance";
}

<div class="post-maintenance-page">

    <div class="page-header">

        <div>
            <div class="eyebrow">
                MUNICIPAL ASSET MANAGEMENT
            </div>

            <h1>Update Condition After Maintenance</h1>

            <p>
                Record the asset's condition following completed maintenance work.
            </p>
        </div>

        <div>
            @Html.ActionLink(
                "← Back to Asset Details",
                "Details",
                "MunicipalAsset",
                new { id = Model.AssetID },
                new { @class = "btn-secondary" }
            )
        </div>

    </div>


    <div class="info-notice">

        <div class="notice-icon">i</div>

        <div>
            <strong>Post-maintenance condition update</strong>

            <p>
                Select the completed maintenance work and record the condition
                observed after the work was completed. This will update the
                asset's current condition and maintenance date.
            </p>
        </div>

    </div>


    @using (Html.BeginForm(
        "UpdateConditionAfterMaintenance",
        "MunicipalAsset",
        FormMethod.Post,
        new { id = "conditionForm" }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(m => m.AssetID)


        @Html.ValidationSummary(
            true,
            "",
            new { @class = "validation-summary" }
        )


        <!-- =====================================================
             SECTION 01 — ASSET INFORMATION
        ====================================================== -->

        <div class="form-card">

            <div class="section-heading">

                <div class="section-number">
                    01
                </div>

                <div>
                    <h2>Asset Information</h2>

                    <p>
                        Confirm the asset receiving the post-maintenance assessment.
                    </p>
                </div>

            </div>


            <div class="summary-grid">

                <div class="summary-item">
                    <span>Asset Code</span>
                    <strong>@Model.AssetCode</strong>
                </div>

                <div class="summary-item">
                    <span>Asset Name</span>
                    <strong>@Model.AssetName</strong>
                </div>

                <div class="summary-item">
                    <span>Asset Type</span>
                    <strong>@Model.AssetType</strong>
                </div>

                <div class="summary-item">
                    <span>Asset Category</span>
                    <strong>@Model.AssetCategory</strong>
                </div>

                <div class="summary-item">
                    <span>Municipal Ward</span>
                    <strong>@Model.WardName</strong>
                </div>

                <div class="summary-item">
                    <span>Current Recorded Condition</span>

                    <strong class="condition-current">
                        @Model.CurrentCondition
                    </strong>
                </div>

            </div>

        </div>


        <!-- =====================================================
             SECTION 02 — COMPLETED MAINTENANCE
        ====================================================== -->

        <div class="form-card">

            <div class="section-heading">

                <div class="section-number">
                    02
                </div>

                <div>
                    <h2>Completed Maintenance</h2>

                    <p>
                        Identify the maintenance work that resulted in the condition update.
                    </p>
                </div>

            </div>


            <div class="form-group">

                @Html.LabelFor(
                    m => m.MaintenanceWorkID,
                    new { @class = "form-label" }
                )

                @Html.DropDownListFor(
                    m => m.MaintenanceWorkID,
                    Model.MaintenanceWorkOptions,
                    "-- Select completed maintenance work --",
                    new
                    {
                        @class = "form-control",
                        id = "maintenanceSelect"
                    }
                )

                @Html.ValidationMessageFor(
                    m => m.MaintenanceWorkID,
                    "",
                    new { @class = "field-validation-error" }
                )

                <div class="field-help">
                    Only completed maintenance work already linked to this
                    asset is available for selection.
                </div>

            </div>


            <div class="selected-maintenance">

                <div class="selected-header">
                    <div class="selected-icon">✓</div>

                    <div>
                        <strong>Selected Maintenance Work</strong>

                        <span>
                            Confirm the maintenance record before continuing.
                        </span>
                    </div>
                </div>

                <div id="selectedMaintenanceText"
                     class="selected-text">

                    No maintenance work selected.

                </div>

            </div>

        </div>


        <!-- =====================================================
             SECTION 03 — CONDITION AFTER MAINTENANCE
        ====================================================== -->

        <div class="form-card">

            <div class="section-heading">

                <div class="section-number">
                    03
                </div>

                <div>
                    <h2>Condition After Maintenance</h2>

                    <p>
                        Record the current condition observed after the maintenance work.
                    </p>
                </div>

            </div>


            <div class="condition-comparison">

                <div class="condition-box">

                    <span>Previously Recorded</span>

                    <strong>
                        @Model.CurrentCondition
                    </strong>

                </div>


                <div class="condition-arrow">
                    →
                </div>


                <div class="condition-box new-condition">

                    <span>After Maintenance</span>

                    <strong id="newConditionDisplay">
                        Select condition
                    </strong>

                </div>

            </div>


            <div class="form-group">

                @Html.LabelFor(
                    m => m.ConditionAfterMaintenance,
                    new { @class = "form-label" }
                )

                @Html.EnumDropDownListFor(
                    m => m.ConditionAfterMaintenance,
                    "-- Select condition --",
                    new
                    {
                        @class = "form-control",
                        id = "conditionSelect"
                    }
                )

                @Html.ValidationMessageFor(
                    m => m.ConditionAfterMaintenance,
                    "",
                    new { @class = "field-validation-error" }
                )

            </div>


            <div class="form-group">

                @Html.LabelFor(
                    m => m.Assessment,
                    new { @class = "form-label" }
                )

                @Html.TextAreaFor(
                    m => m.Assessment,
                    new
                    {
                        @class = "form-control textarea-control",
                        id = "assessmentInput",
                        rows = "6",
                        maxlength = "2000",
                        placeholder =
                            "Describe the asset's condition after the maintenance work..."
                    }
                )

                @Html.ValidationMessageFor(
                    m => m.Assessment,
                    "",
                    new { @class = "field-validation-error" }
                )

                <div class="character-counter">
                    <span id="assessmentCount">0</span> / 2000 characters
                </div>

            </div>

        </div>


        <!-- =====================================================
             SECTION 04 — ADDITIONAL NOTES
        ====================================================== -->

        <div class="form-card">

            <div class="section-heading">

                <div class="section-number">
                    04
                </div>

                <div>
                    <h2>Additional Notes</h2>

                    <p>
                        Record any further information relevant to the updated condition.
                    </p>
                </div>

            </div>


            <div class="form-group">

                @Html.LabelFor(
                    m => m.Notes,
                    new { @class = "form-label" }
                )

                @Html.TextAreaFor(
                    m => m.Notes,
                    new
                    {
                        @class = "form-control textarea-control",
                        id = "notesInput",
                        rows = "4",
                        maxlength = "1000",
                        placeholder =
                            "Record any additional observations or follow-up information..."
                    }
                )

                @Html.ValidationMessageFor(
                    m => m.Notes,
                    "",
                    new { @class = "field-validation-error" }
                )

                <div class="character-counter">
                    <span id="notesCount">0</span> / 1000 characters
                </div>

            </div>

        </div>


        <!-- =====================================================
             SECTION 05 — CONFIRMATION
        ====================================================== -->

        <div class="confirmation-card">

            <div class="confirmation-icon">
                ✓
            </div>

            <div>

                <h3>Confirm condition update</h3>

                <p>
                    Saving this record will update the asset's current condition,
                    record the latest maintenance date, and create an entry in
                    the asset history.
                </p>

            </div>

        </div>


        <!-- =====================================================
             ACTIONS
        ====================================================== -->

        <div class="form-actions">

            @Html.ActionLink(
                "Cancel",
                "Details",
                "MunicipalAsset",
                new { id = Model.AssetID },
                new { @class = "btn-secondary btn-large" }
            )

            <button type="submit"
                    id="saveButton"
                    class="btn-primary btn-large">

                Update Asset Condition

            </button>

        </div>

    }

</div>


<style>

    .post-maintenance-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 35px 25px 60px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 30px;
        margin-bottom: 25px;
    }

    .eyebrow {
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.4px;
        color: #0D5CC1;
        margin-bottom: 8px;
    }

    .page-header h1 {
        margin: 0 0 8px;
        color: #172033;
        font-size: 31px;
        font-weight: 800;
    }

    .page-header p {
        margin: 0;
        max-width: 750px;
        color: #374151;
        line-height: 1.6;
    }

    .btn-primary,
    .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0 20px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s ease;
        border: 1px solid transparent;
    }

    .btn-primary {
        background: #0D5CC1;
        color: #fff;
        border-color: #0D5CC1;
    }

    .btn-primary:hover {
        background: #094B9E;
        color: #fff;
    }

    .btn-secondary {
        background: #fff;
        color: #344054;
        border-color: #D0D5DD;
    }

    .btn-secondary:hover {
        background: #F9FAFB;
        color: #172033;
    }

    .btn-large {
        min-height: 48px;
        padding: 0 24px;
    }

    .info-notice {
        display: flex;
        gap: 15px;
        padding: 18px 20px;
        margin-bottom: 25px;
        border: 1px solid #C9DDF7;
        border-left: 4px solid #0D5CC1;
        border-radius: 10px;
        background: #F5F9FF;
    }

    .notice-icon {
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #0D5CC1;
        color: #fff;
        font-weight: 800;
    }

    .info-notice strong {
        display: block;
        margin-bottom: 4px;
        color: #172033;
    }

    .info-notice p {
        margin: 0;
        color: #475467;
        font-size: 14px;
        line-height: 1.6;
    }

    .form-card {
        padding: 28px;
        margin-bottom: 20px;
        background: #fff;
        border: 1px solid #E4E7EC;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(16, 24, 40, .04);
    }

    .section-heading {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 25px;
    }

    .section-number {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 8px;
        background: #EAF2FC;
        color: #0D5CC1;
        font-size: 13px;
        font-weight: 800;
    }

    .section-heading h2 {
        margin: 0 0 5px;
        color: #172033;
        font-size: 19px;
    }

    .section-heading p {
        margin: 0;
        color: #667085;
        font-size: 13px;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }

    .summary-item {
        padding: 15px 16px;
        border: 1px solid #EAECF0;
        border-radius: 8px;
        background: #F9FAFB;
    }

    .summary-item span {
        display: block;
        margin-bottom: 6px;
        color: #667085;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
    }

    .summary-item strong {
        color: #172033;
        font-size: 14px;
    }

    .condition-current {
        color: #0D5CC1 !important;
    }

    .form-group {
        margin-bottom: 22px;
    }

    .form-group:last-child {
        margin-bottom: 0;
    }

    .form-label {
        display: block;
        margin-bottom: 8px;
        color: #344054;
        font-size: 13px;
        font-weight: 700;
    }

    .form-control {
        width: 100%;
        min-height: 47px;
        padding: 10px 13px;
        box-sizing: border-box;
        border: 1px solid #D0D5DD;
        border-radius: 8px;
        background: #fff;
        color: #172033;
        font-size: 14px;
        outline: none;
    }

    .form-control:focus {
        border-color: #0D5CC1;
        box-shadow: 0 0 0 3px rgba(13, 92, 193, .10);
    }

    .textarea-control {
        min-height: 120px;
        resize: vertical;
    }

    .field-help {
        margin-top: 7px;
        color: #667085;
        font-size: 12px;
        line-height: 1.5;
    }

    .field-validation-error {
        display: block;
        margin-top: 6px;
        color: #B42318;
        font-size: 12px;
        font-weight: 600;
    }

    .validation-summary {
        padding: 14px 18px;
        margin-bottom: 20px;
        border: 1px solid #FDA29B;
        border-radius: 8px;
        background: #FEF3F2;
        color: #B42318;
        font-size: 13px;
    }

    .validation-summary:empty {
        display: none;
    }

    .selected-maintenance {
        padding: 18px;
        margin-top: 20px;
        border: 1px solid #D6E5F7;
        border-radius: 10px;
        background: #F7FAFE;
    }

    .selected-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
    }

    .selected-icon {
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #0D5CC1;
        color: #fff;
        font-weight: 800;
    }

    .selected-header strong {
        display: block;
        color: #172033;
        font-size: 14px;
    }

    .selected-header span {
        display: block;
        margin-top: 2px;
        color: #667085;
        font-size: 12px;
    }

    .selected-text {
        padding: 13px 15px;
        border: 1px solid #E4E7EC;
        border-radius: 7px;
        background: #fff;
        color: #344054;
        font-size: 13px;
        line-height: 1.6;
    }

    .condition-comparison {
        display: grid;
        grid-template-columns: 1fr 50px 1fr;
        align-items: center;
        gap: 15px;
        margin-bottom: 25px;
    }

    .condition-box {
        padding: 20px;
        border: 1px solid #E4E7EC;
        border-radius: 10px;
        background: #F9FAFB;
        text-align: center;
    }

    .condition-box span {
        display: block;
        margin-bottom: 8px;
        color: #667085;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
    }

    .condition-box strong {
        color: #344054;
        font-size: 17px;
    }

    .new-condition {
        border-color: #C9DDF7;
        background: #F5F9FF;
    }

    .new-condition strong {
        color: #0D5CC1;
    }

    .condition-arrow {
        text-align: center;
        color: #0D5CC1;
        font-size: 26px;
        font-weight: 700;
    }

    .character-counter {
        margin-top: 6px;
        color: #667085;
        font-size: 11px;
        text-align: right;
    }

    .confirmation-card {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        padding: 20px;
        margin-bottom: 22px;
        border: 1px solid #D6E5F7;
        border-radius: 10px;
        background: #F7FAFE;
    }

    .confirmation-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 50%;
        background: #0D5CC1;
        color: #fff;
        font-weight: 800;
    }

    .confirmation-card h3 {
        margin: 0 0 5px;
        color: #172033;
        font-size: 15px;
    }

    .confirmation-card p {
        margin: 0;
        color: #667085;
        font-size: 13px;
        line-height: 1.6;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    @@media (max-width: 768px) {

        .post-maintenance-page {
            padding: 25px 15px 45px;
        }

        .page-header {
            flex-direction: column;
        }

        .page-header > div:last-child {
            width: 100%;
        }

        .page-header .btn-secondary {
            width: 100%;
        }

        .form-card {
            padding: 20px;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .condition-comparison {
            grid-template-columns: 1fr;
        }

        .condition-arrow {
            transform: rotate(90deg);
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .form-actions .btn-primary,
        .form-actions .btn-secondary {
            width: 100%;
        }
    }

</style>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        var maintenanceSelect =
            document.getElementById("maintenanceSelect");

        var selectedMaintenanceText =
            document.getElementById("selectedMaintenanceText");

        var conditionSelect =
            document.getElementById("conditionSelect");

        var newConditionDisplay =
            document.getElementById("newConditionDisplay");

        var assessmentInput =
            document.getElementById("assessmentInput");

        var assessmentCount =
            document.getElementById("assessmentCount");

        var notesInput =
            document.getElementById("notesInput");

        var notesCount =
            document.getElementById("notesCount");

        var form =
            document.getElementById("conditionForm");

        var saveButton =
            document.getElementById("saveButton");


        function updateMaintenance() {

            if (!maintenanceSelect ||
                !selectedMaintenanceText) {
                return;
            }

            var option =
                maintenanceSelect.options[
                maintenanceSelect.selectedIndex
                ];

            if (!option || !option.value) {

                selectedMaintenanceText.textContent =
                    "No maintenance work selected.";

                return;
            }

            selectedMaintenanceText.textContent =
                option.text;
        }


        function updateCondition() {

            if (!conditionSelect ||
                !newConditionDisplay) {
                return;
            }

            var option =
                conditionSelect.options[
                conditionSelect.selectedIndex
                ];

            if (!option || !option.value) {

                newConditionDisplay.textContent =
                    "Select condition";

                return;
            }

            newConditionDisplay.textContent =
                option.text;
        }


        function updateCounter(
            input,
            counter) {

            if (!input || !counter) {
                return;
            }

            counter.textContent =
                input.value.length;
        }


        if (maintenanceSelect) {

            maintenanceSelect.addEventListener(
                "change",
                updateMaintenance
            );

            updateMaintenance();
        }


        if (conditionSelect) {

            conditionSelect.addEventListener(
                "change",
                updateCondition
            );

            updateCondition();
        }


        if (assessmentInput) {

            assessmentInput.addEventListener(
                "input",
                function () {
                    updateCounter(
                        assessmentInput,
                        assessmentCount
                    );
                }
            );

            updateCounter(
                assessmentInput,
                assessmentCount
            );
        }


        if (notesInput) {

            notesInput.addEventListener(
                "input",
                function () {
                    updateCounter(
                        notesInput,
                        notesCount
                    );
                }
            );

            updateCounter(
                notesInput,
                notesCount
            );
        }


        if (form) {

            form.addEventListener(
                "submit",
                function (event) {

                    if (!maintenanceSelect.value) {

                        event.preventDefault();

                        alert(
                            "Please select the completed maintenance work."
                        );

                        maintenanceSelect.focus();

                        return;
                    }


                    if (!conditionSelect.value) {

                        event.preventDefault();

                        alert(
                            "Please select the condition after maintenance."
                        );

                        conditionSelect.focus();

                        return;
                    }


                    var selectedMaintenance =
                        maintenanceSelect.options[
                            maintenanceSelect.selectedIndex
                        ].text;

                    var selectedCondition =
                        conditionSelect.options[
                            conditionSelect.selectedIndex
                        ].text;


                    var confirmed =
                        confirm(
                            "Are you sure you want to update the asset condition?\n\n" +
                            "Maintenance: " +
                            selectedMaintenance +
                            "\n\n" +
                            "New condition: " +
                            selectedCondition
                        );


                    if (!confirmed) {

                        event.preventDefault();

                        return;
                    }


                    if (saveButton) {

                        saveButton.disabled = true;

                        saveButton.innerText =
                            "Updating...";

                    }

                }
            );
        }

    });

</script>