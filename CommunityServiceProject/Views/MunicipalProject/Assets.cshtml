
@model CommunityServiceProject.ViewModels.MunicipalProjectAssetsViewModel

@{
    ViewBag.Title = "Project Assets";
}

<div class="project-assets-page">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->
    <div class="project-assets-header">

        <div class="project-assets-header-content">

            <div>
                <div class="project-assets-eyebrow">
                    MUNICIPAL PROJECT MANAGEMENT
                </div>

                <h1>Project Assets</h1>

                <div class="project-assets-project-name">
                    @Model.ProjectName
                </div>

                <div class="project-assets-project-meta">
                    <span class="project-code">
                        @Model.ProjectCode
                    </span>

                    <span class="meta-divider">|</span>

                    <span>
                        @Model.ProjectType
                    </span>
                </div>
            </div>

            <div class="project-assets-header-actions">

                <a href="@Url.Action("Details", "MunicipalProject", new { id = Model.ProjectID })"
                   class="header-action-button secondary">
                    Back to Project Details
                </a>

                <a href="@Url.Action("Index", "MunicipalProject")"
                   class="header-action-button">
                    Municipal Projects
                </a>

            </div>

        </div>

    </div>


    <!-- =====================================================
         PROJECT CONTEXT
         ===================================================== -->
    <div class="project-assets-container">

        <div class="project-context-card">

            <div class="project-context-main">

                <div class="context-label">
                    PROJECT
                </div>

                <div class="context-title">
                    @Model.ProjectName
                </div>

                <div class="context-location">
                    @Model.ProjectLocation
                </div>

                <div class="context-ward">
                    @Model.WardName
                </div>

            </div>

            <div class="context-stat">

                <div class="context-stat-number">
                    @Model.LinkedAssetCount
                </div>

                <div class="context-stat-label">
                    Linked Assets
                </div>

            </div>

        </div>


        <!-- =====================================================
             ALERTS
             ===================================================== -->

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="project-alert success">
                <div class="alert-title">Action completed</div>
                <div class="alert-message">
                    @TempData["SuccessMessage"]
                </div>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="project-alert error">
                <div class="alert-title">Action could not be completed</div>
                <div class="alert-message">
                    @TempData["ErrorMessage"]
                </div>
            </div>
        }


        <!-- =====================================================
             LINK ASSET SECTION
             ===================================================== -->

        <div class="assets-section-card">

            <div class="section-heading">

                <div>
                    <div class="section-eyebrow">
                        PROJECT ASSOCIATIONS
                    </div>

                    <h2>Link Municipal Asset</h2>

                    <p>
                        Associate an existing municipal asset with this project.
                        Linked assets can be monitored as part of the project's scope.
                    </p>
                </div>

            </div>


            @using (Html.BeginForm(
                "LinkAsset",
                "MunicipalProject",
                FormMethod.Post,
                new { @class = "asset-link-form", id = "assetLinkForm" }))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.ProjectID)

                <div class="form-grid">

                    <div class="form-group full-width">

                        <label for="AssetID">
                            Municipal Asset
                        </label>

                        <select id="AssetID"
                                name="AssetID"
                                class="form-control asset-selection"
                                required>

                            <option value="">
                                Select a municipal asset
                            </option>

                            @foreach (var asset in Model.AvailableAssets)
                            {
                                <option value="@asset.AssetID">
                                    @asset.AssetCode — @asset.AssetName
                                    | @asset.AssetType
                                    | @asset.WardName
                                </option>
                            }

                        </select>

                        <div class="field-help">
                            Select the asset that forms part of or supports this project.
                        </div>

                    </div>


                    <div class="form-group full-width">

                        <label for="Notes">
                            Link Notes
                            <span class="optional-label">Optional</span>
                        </label>

                        <textarea id="Notes"
                                  name="Notes"
                                  class="form-control notes-input"
                                  rows="4"
                                  maxlength="1000"
                                  placeholder="Record why this asset is associated with the project or provide relevant context."></textarea>

                        <div class="character-counter">
                            <span id="notesCount">0</span> / 1000
                        </div>

                    </div>

                </div>


                <div class="form-actions">

                    <button type="submit"
                            class="primary-button">
                        Link Asset
                    </button>

                    <a href="@Url.Action("Details", "MunicipalProject", new { id = Model.ProjectID })"
                       class="secondary-button">
                        Cancel
                    </a>

                </div>
            }

        </div>


        <!-- =====================================================
             SEARCH AND FILTERS
             ===================================================== -->

        <div class="assets-section-card">

            <div class="section-heading">

                <div>
                    <div class="section-eyebrow">
                        ASSET DIRECTORY
                    </div>

                    <h2>Available Municipal Assets</h2>

                    <p>
                        Search and filter existing municipal assets before linking them
                        to this project.
                    </p>
                </div>

                <div class="available-count">
                    @Model.AvailableAssets.Count available
                </div>

            </div>


            @using (Html.BeginForm(
                "Assets",
                "MunicipalProject",
                FormMethod.Get,
                new { @class = "asset-filter-form" }))
            {
                @Html.Hidden("id", Model.ProjectID)

                <div class="filter-grid">

                    <div class="filter-field search-field">

                        <label for="searchTerm">
                            Search
                        </label>

                        <input type="text"
                               id="searchTerm"
                               name="searchTerm"
                               value="@Model.SearchTerm"
                               class="form-control"
                               placeholder="Asset code, name, type or location..." />

                    </div>


                    <div class="filter-field">

                        <label for="assetType">
                            Asset Type
                        </label>

                        <select id="assetType"
                                name="assetType"
                                class="form-control">

                            <option value="">
                                All Asset Types
                            </option>

                            @foreach (var option in Model.AssetTypeOptions)
                            {
                                <option value="@option.Value"
                                        @(option.Selected ? "selected" : "")>
                                    @option.Text
                                </option>
                            }

                        </select>

                    </div>


                    <div class="filter-field">

                        <label for="condition">
                            Condition
                        </label>

                        <select id="condition"
                                name="condition"
                                class="form-control">

                            <option value="">
                                All Conditions
                            </option>

                            @foreach (var option in Model.ConditionOptions)
                            {
                                <option value="@option.Value"
                                        @(option.Selected ? "selected" : "")>
                                    @option.Text
                                </option>
                            }

                        </select>

                    </div>


                    <div class="filter-field">

                        <label for="status">
                            Status
                        </label>

                        <select id="status"
                                name="status"
                                class="form-control">

                            <option value="">
                                All Statuses
                            </option>

                            @foreach (var option in Model.StatusOptions)
                            {
                                <option value="@option.Value"
                                        @(option.Selected ? "selected" : "")>
                                    @option.Text
                                </option>
                            }

                        </select>

                    </div>


                    <div class="filter-field">

                        <label for="ward">
                            Ward
                        </label>

                        <select id="ward"
                                name="ward"
                                class="form-control">

                            <option value="">
                                All Wards
                            </option>

                            @foreach (var option in Model.WardOptions)
                            {
                                <option value="@option.Value"
                                        @(option.Selected ? "selected" : "")>
                                    @option.Text
                                </option>
                            }

                        </select>

                    </div>

                </div>


                <div class="filter-actions">

                    <button type="submit"
                            class="filter-button">
                        Apply Filters
                    </button>

                    <a href="@Url.Action("Assets", "MunicipalProject", new { id = Model.ProjectID })"
                       class="clear-filter-button">
                        Clear Filters
                    </a>

                </div>
            }

        </div>


        <!-- =====================================================
             AVAILABLE ASSETS TABLE
             ===================================================== -->

        <div class="assets-section-card table-card">

            <div class="table-header">

                <div>
                    <div class="section-eyebrow">
                        AVAILABLE FOR LINKING
                    </div>

                    <h2>Municipal Assets</h2>
                </div>

                <div class="table-result-count">
                    Showing @Model.AvailableAssets.Count asset(s)
                </div>

            </div>


            @if (Model.AvailableAssets.Any())
            {
                <div class="table-wrapper">

                    <table class="assets-table">

                        <thead>
                            <tr>

                                <th>Asset</th>

                                <th>Type</th>

                                <th>Category</th>

                                <th>Ward</th>

                                <th>Condition</th>

                                <th>Status</th>

                                <th>Registered</th>

                                <th>Action</th>

                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var asset in Model.AvailableAssets)
                            {
                                <tr>

                                    <td>

                                        <div class="asset-primary">
                                            @asset.AssetCode
                                        </div>

                                        <div class="asset-secondary">
                                            @asset.AssetName
                                        </div>

                                    </td>


                                    <td>
                                        @asset.AssetType
                                    </td>


                                    <td>
                                        @(string.IsNullOrWhiteSpace(asset.AssetCategory)
                                            ? "Not specified"
                                            : asset.AssetCategory)
                                    </td>


                                    <td>
                                        @asset.WardName
                                    </td>


                                    <td>

                                        <span class="condition-badge condition-@asset.Condition.ToLowerInvariant()">
                                            @asset.Condition
                                        </span>

                                    </td>


                                    <td>

                                        <span class="status-badge status-@asset.Status.ToLowerInvariant()">
                                            @asset.Status
                                        </span>

                                    </td>


                                    <td>
                                        @asset.DateRegistered.ToString("dd MMM yyyy")
                                    </td>


                                    <td>

                                        <button type="button"
                                                class="table-link-button select-asset-button"
                                                data-asset-id="@asset.AssetID">
                                            Select
                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-state-title">
                        No available assets found
                    </div>

                    <div class="empty-state-text">
                        There are no municipal assets matching the current search
                        and filter criteria, or all matching assets are already
                        linked to this project.
                    </div>

                    <a href="@Url.Action("Assets", "MunicipalProject", new { id = Model.ProjectID })"
                       class="empty-state-button">
                        View All Available Assets
                    </a>

                </div>
            }

        </div>


        <!-- =====================================================
             LINKED ASSETS
             ===================================================== -->

        <div class="assets-section-card table-card">

            <div class="table-header">

                <div>
                    <div class="section-eyebrow">
                        PROJECT ASSET REGISTER
                    </div>

                    <h2>Linked Assets</h2>
                </div>

                <div class="table-result-count">
                    @Model.LinkedAssetCount linked asset(s)
                </div>

            </div>


            @if (Model.LinkedAssets.Any())
            {
                <div class="table-wrapper">

                    <table class="assets-table linked-table">

                        <thead>
                            <tr>

                                <th>Asset</th>

                                <th>Type</th>

                                <th>Ward</th>

                                <th>Condition</th>

                                <th>Status</th>

                                <th>Linked</th>

                                <th>Linked By</th>

                                <th>Notes</th>

                                <th>Action</th>

                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var asset in Model.LinkedAssets)
                            {
                                <tr>

                                    <td>

                                        <div class="asset-primary">
                                            @asset.AssetCode
                                        </div>

                                        <div class="asset-secondary">
                                            @asset.AssetName
                                        </div>

                                    </td>


                                    <td>
                                        @asset.AssetType
                                    </td>


                                    <td>
                                        @asset.WardName
                                    </td>


                                    <td>

                                        <span class="condition-badge condition-@asset.Condition.ToLowerInvariant()">
                                            @asset.Condition
                                        </span>

                                    </td>


                                    <td>

                                        <span class="status-badge status-@asset.Status.ToLowerInvariant()">
                                            @asset.Status
                                        </span>

                                    </td>


                                    <td>
                                        @asset.LinkDate.ToString("dd MMM yyyy")
                                    </td>


                                    <td>
                                        @asset.LinkedByAdministratorName
                                    </td>


                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(asset.Notes))
                                        {
                                            <div class="notes-display"
                                                 title="@asset.Notes">
                                                @asset.Notes
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="not-provided">
                                                No notes
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        @using (Html.BeginForm(
                                            "UnlinkAsset",
                                            "MunicipalProject",
                                            FormMethod.Post,
                                            new
                                            {
                                                @class = "unlink-form"
                                            }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@asset.AssetProjectID" />

                                            <input type="hidden"
                                                   name="projectID"
                                                   value="@Model.ProjectID" />

                                            <button type="submit"
                                                    class="unlink-button"
                                                    data-asset-code="@asset.AssetCode">
                                                Unlink
                                            </button>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state compact">

                    <div class="empty-state-title">
                        No assets linked yet
                    </div>

                    <div class="empty-state-text">
                        Select an available municipal asset above to associate it
                        with this project.
                    </div>

                </div>
            }

        </div>


        <!-- =====================================================
             BOTTOM NAVIGATION
             ===================================================== -->

        <div class="bottom-navigation">

            <a href="@Url.Action("Details", "MunicipalProject", new { id = Model.ProjectID })"
               class="bottom-navigation-button">
                Back to Project Details
            </a>

            <a href="@Url.Action("Index", "MunicipalProject")"
               class="bottom-navigation-button secondary">
                Back to Municipal Projects
            </a>

        </div>

    </div>

</div>


<style>

    /* =========================================================
       PAGE
       ========================================================= */

    .project-assets-page {
        min-height: 100vh;
        background: #f4f7fb;
        padding-bottom: 60px;
        color: #172033;
    }


    .project-assets-container {
        width: 94%;
        max-width: 1500px;
        margin: 0 auto;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .project-assets-header {
        background: linear-gradient(
            135deg,
            #0D5CC1 0%,
            #094b9f 100%
        );
        color: #ffffff;
        padding: 34px 0;
        box-shadow: 0 4px 18px rgba(13, 92, 193, 0.16);
    }


    .project-assets-header-content {
        width: 94%;
        max-width: 1500px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
    }


    .project-assets-eyebrow {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.5px;
        opacity: 0.82;
        margin-bottom: 9px;
    }


    .project-assets-header h1 {
        margin: 0;
        font-size: 34px;
        line-height: 1.15;
        font-weight: 700;
        color: #ffffff;
    }


    .project-assets-project-name {
        margin-top: 10px;
        font-size: 18px;
        font-weight: 500;
        color: #ffffff;
    }


    .project-assets-project-meta {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-top: 8px;
        font-size: 14px;
        color: #ffffff;
    }


    .project-code {
        color: #ffffff;
        font-weight: 700;
        letter-spacing: 0.3px;
    }


    .meta-divider {
        opacity: 0.65;
    }


    .project-assets-header-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }


    .header-action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 18px;
        border-radius: 7px;
        border: 1px solid rgba(255,255,255,0.65);
        color: #ffffff;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        background: rgba(255,255,255,0.10);
        transition: 0.2s ease;
    }


    .header-action-button:hover {
        background: #ffffff;
        color: #0D5CC1;
        text-decoration: none;
    }


    .header-action-button.secondary {
        background: #ffffff;
        color: #0D5CC1;
        border-color: #ffffff;
    }


    .header-action-button.secondary:hover {
        background: #eef5ff;
    }


    /* =========================================================
       CONTEXT
       ========================================================= */

    .project-context-card {
        margin-top: 26px;
        background: #ffffff;
        border: 1px solid #dfe6ef;
        border-radius: 10px;
        padding: 22px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        box-shadow: 0 2px 8px rgba(20, 35, 60, 0.04);
    }


    .project-context-main {
        min-width: 0;
    }


    .context-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.3px;
        color: #718096;
        margin-bottom: 5px;
    }


    .context-title {
        font-size: 20px;
        font-weight: 700;
        color: #172033;
    }


    .context-location {
        margin-top: 5px;
        font-size: 14px;
        color: #536174;
    }


    .context-ward {
        margin-top: 3px;
        font-size: 13px;
        color: #718096;
    }


    .context-stat {
        min-width: 150px;
        padding-left: 25px;
        border-left: 1px solid #e4e9f0;
        text-align: center;
    }


    .context-stat-number {
        font-size: 30px;
        line-height: 1;
        font-weight: 700;
        color: #0D5CC1;
    }


    .context-stat-label {
        margin-top: 6px;
        font-size: 12px;
        color: #718096;
        font-weight: 600;
    }


    /* =========================================================
       ALERTS
       ========================================================= */

    .project-alert {
        margin-top: 18px;
        padding: 15px 18px;
        border-radius: 8px;
        border: 1px solid;
    }


    .project-alert.success {
        background: #eefaf3;
        border-color: #b9e4c9;
    }


    .project-alert.error {
        background: #fff3f3;
        border-color: #f0c3c3;
    }


    .alert-title {
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 3px;
    }


    .alert-message {
        font-size: 13px;
        line-height: 1.5;
    }


    /* =========================================================
       SECTION CARDS
       ========================================================= */

    .assets-section-card {
        margin-top: 22px;
        background: #ffffff;
        border: 1px solid #dfe6ef;
        border-radius: 10px;
        padding: 26px;
        box-shadow: 0 2px 8px rgba(20, 35, 60, 0.04);
    }


    .section-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 22px;
    }


    .section-eyebrow {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.3px;
        color: #0D5CC1;
        margin-bottom: 6px;
    }


    .section-heading h2,
    .table-header h2 {
        margin: 0;
        font-size: 21px;
        color: #172033;
        font-weight: 700;
    }


    .section-heading p {
        margin: 7px 0 0;
        max-width: 800px;
        font-size: 13px;
        line-height: 1.55;
        color: #667085;
    }


    .available-count {
        padding: 7px 12px;
        border-radius: 20px;
        background: #edf5ff;
        color: #0D5CC1;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }


    /* =========================================================
       FORMS
       ========================================================= */

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }


    .form-group {
        min-width: 0;
    }


    .form-group.full-width {
        grid-column: 1 / -1;
    }


    .form-group label,
    .filter-field label {
        display: block;
        margin-bottom: 7px;
        font-size: 13px;
        font-weight: 700;
        color: #344054;
    }


    .optional-label {
        margin-left: 5px;
        font-size: 11px;
        color: #98a2b3;
        font-weight: 500;
    }


    .form-control {
        width: 100%;
        min-height: 43px;
        padding: 10px 12px;
        border: 1px solid #cfd8e3;
        border-radius: 7px;
        background: #ffffff;
        color: #172033;
        font-size: 13px;
        outline: none;
        box-sizing: border-box;
        transition: border-color 0.2s ease,
                    box-shadow 0.2s ease;
    }


    .form-control:focus {
        border-color: #0D5CC1;
        box-shadow: 0 0 0 3px rgba(13, 92, 193, 0.10);
    }


    select.form-control {
        cursor: pointer;
    }


    textarea.form-control {
        min-height: 110px;
        resize: vertical;
        line-height: 1.5;
    }


    .field-help {
        margin-top: 6px;
        font-size: 11px;
        color: #7a8698;
    }


    .character-counter {
        margin-top: 5px;
        text-align: right;
        font-size: 11px;
        color: #98a2b3;
    }


    .form-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 22px;
        padding-top: 20px;
        border-top: 1px solid #edf0f4;
    }


    .primary-button,
    .secondary-button,
    .filter-button,
    .clear-filter-button,
    .empty-state-button {
        min-height: 41px;
        padding: 0 17px;
        border-radius: 7px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: 0.2s ease;
    }


    .primary-button,
    .filter-button {
        border: 1px solid #0D5CC1;
        background: #0D5CC1;
        color: #ffffff;
    }


    .primary-button:hover,
    .filter-button:hover {
        background: #094b9f;
        border-color: #094b9f;
    }


    .secondary-button,
    .clear-filter-button {
        border: 1px solid #cfd8e3;
        background: #ffffff;
        color: #475467;
    }


    .secondary-button:hover,
    .clear-filter-button:hover {
        border-color: #0D5CC1;
        color: #0D5CC1;
        text-decoration: none;
    }


    /* =========================================================
       FILTERS
       ========================================================= */

    .asset-filter-form {
        padding-top: 3px;
    }


    .filter-grid {
        display: grid;
        grid-template-columns: 2fr repeat(4, 1fr);
        gap: 14px;
    }


    .filter-field {
        min-width: 0;
    }


    .filter-actions {
        display: flex;
        gap: 9px;
        margin-top: 17px;
    }


    /* =========================================================
       TABLES
       ========================================================= */

    .table-card {
        padding: 0;
