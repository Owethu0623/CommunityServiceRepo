<!-- =============================================================
     JAVASCRIPT
     ============================================================= -->

<script>

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            /* =====================================================
               NOTES CHARACTER COUNTER
               ===================================================== */

            var notesInput =
                document.getElementById("Notes");

            var notesCounter =
                document.getElementById(
                    "notesCharacterCount");

            if (notesInput &&
                notesCounter) {

                function updateNotesCounter() {

                    notesCounter.textContent =
                        notesInput.value.length;
                }

                notesInput.addEventListener(
                    "input",
                    updateNotesCounter);

                updateNotesCounter();
            }


            /* =====================================================
               SELECT ASSET FROM TABLE
               ===================================================== */

            var selectButtons =
                document.querySelectorAll(
                    ".select-asset-button");

            var assetSelect =
                document.getElementById("AssetID");

            if (assetSelect) {

                selectButtons.forEach(
                    function (button) {

                        button.addEventListener(
                            "click",
                            function () {

                                var assetId =
                                    button.getAttribute(
                                        "data-asset-id");

                                if (!assetId)
                                    return;

                                assetSelect.value =
                                    assetId;

                                assetSelect.scrollIntoView(
                                    {
                                        behavior: "smooth",
                                        block: "center"
                                    });

                                assetSelect.focus();
                            });
                    });
            }


            /* =====================================================
               UNLINK CONFIRMATION
               ===================================================== */

            var unlinkForms =
                document.querySelectorAll(
                    ".unlink-asset-form");

            unlinkForms.forEach(
                function (form) {

                    form.addEventListener(
                        "submit",
                        function (event) {

                            var confirmed =
                                window.confirm(
                                    "Are you sure you want to unlink this asset from the project?"
                                );

                            if (!confirmed) {
                                event.preventDefault();
                            }

                        });
                });


            /* =====================================================
               AUTO HIDE ALERTS
               ===================================================== */

            var alerts =
                document.querySelectorAll(
                    ".alert-message");

            if (alerts.length) {

                setTimeout(
                    function () {

                        alerts.forEach(
                            function (alert) {

                                alert.style.transition =
                                    "opacity .3s ease";

                                alert.style.opacity =
                                    "0";

                                setTimeout(
                                    function () {

                                        if (alert.parentNode) {
                                            alert.parentNode
                                                .removeChild(alert);
                                        }

                                    },
                                    350);

                            });

                    },
                    5000);
            }

        });

</script>


