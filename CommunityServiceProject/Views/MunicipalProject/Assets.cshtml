
@model CommunityServiceProject.ViewModels.MunicipalProjectAssetsViewModel

@{
    ViewBag.Title = "Manage Municipal Assets";
}

<div class="project-assets-page">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="page-header">

        <div class="page-header-content">

            <div class="page-header-eyebrow">
                MUNICIPAL PROJECT ASSET MANAGEMENT
            </div>

            <h1>
                Manage Municipal Assets
            </h1>

            <p>
                Review, identify and link municipal assets associated
                with this project.
            </p>

        </div>

        <div class="page-header-actions">

            <a href="@Url.Action(
                "Details",
                "MunicipalProject",
                new { id = Model.ProjectID })"
               class="header-button secondary-header-button">
                ← Back to Project
            </a>

        </div>

    </div>


    <!-- =========================================================
         PROJECT CONTEXT
         ========================================================= -->

    <div class="project-context-card">

        <div class="project-context-main">

            <span class="context-label">
                PROJECT
            </span>

            <h2>
                @Model.ProjectName
            </h2>

            <div class="project-context-meta">

                <span>
                    <strong>Code:</strong>
                    @Model.ProjectCode
                </span>

                <span>
                    <strong>Type:</strong>
                    @Model.ProjectType
                </span>

                <span>
                    <strong>Ward:</strong>
                    @Model.WardName
                </span>

                @if (!string.IsNullOrWhiteSpace(
                    Model.ProjectLocation))
                {
                    <span>
                        <strong>Location:</strong>
                        @Model.ProjectLocation
                    </span>
                }

            </div>

        </div>

        <div class="linked-count-card">

            <span>
                LINKED ASSETS
            </span>

            <strong>
                @Model.LinkedAssetCount
            </strong>

        </div>

    </div>


    <!-- =========================================================
         ALERT MESSAGES
         ========================================================= -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-message success-alert">

            <div class="alert-icon">
                ✓
            </div>

            <div>
                <strong>
                    Success
                </strong>

                <span>
                    @TempData["SuccessMessage"]
                </span>
            </div>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-message error-alert">

            <div class="alert-icon">
                !
            </div>

            <div>
                <strong>
                    Unable to complete action
                </strong>

                <span>
                    @TempData["ErrorMessage"]
                </span>
            </div>

        </div>
    }


    <!-- =========================================================
         POTENTIALLY RELATED MUNICIPAL ASSETS
         ========================================================= -->

    @if (Model.SuggestedAssets != null &&
         Model.SuggestedAssets.Any())
    {
        <section class="asset-section suggested-assets-section">

            <div class="section-heading">

                <div>

                    <div class="section-eyebrow">
                        SYSTEM SUGGESTIONS
                    </div>

                    <h2>
                        Potentially Related Assets
                    </h2>

                    <p>
                        Assets identified as potentially relevant to this
                        project based on ward, service category, asset type,
                        naming, location and geographic proximity.
                    </p>

                </div>

                <div class="suggested-count">
                    @Model.SuggestedAssets.Count Suggestions
                </div>

            </div>


            <!-- =====================================================
                 SUGGESTION NOTICE
                 ===================================================== -->

            <div class="suggestion-notice">

                <div class="suggestion-notice-icon">
                    i
                </div>

                <div>

                    <strong>
                        Administrator review required
                    </strong>

                    <p>
                        These assets have not been linked automatically.
                        Review the suggested matches and link only the
                        assets confirmed to be associated with this project.
                    </p>

                </div>

            </div>


            <!-- =====================================================
                 SUGGESTED ASSETS TABLE
                 ===================================================== -->

            <div class="table-wrapper">

                <table class="asset-table suggested-assets-table">

                    <thead>

                        <tr>
                            <th>Asset</th>
                            <th>Type</th>
                            <th>Category</th>
                            <th>Ward</th>
                            <th>Condition</th>
                            <th>Status</th>
                            <th>Match</th>
                            <th>Why Suggested</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var asset in Model.SuggestedAssets)
                        {
                            <tr>

                                <td>

                                    <div class="asset-identity">

                                        <strong>
                                            @asset.AssetCode
                                        </strong>

                                        <span>
                                            @asset.AssetName
                                        </span>

                                    </div>

                                </td>

                                <td>
                                    @asset.AssetType
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(
                                        asset.AssetCategory)
                                        ? "Not specified"
                                        : asset.AssetCategory)
                                </td>

                                <td>
                                    @asset.WardName
                                </td>

                                <td>

                                    <span class="condition-pill">
                                        @asset.Condition
                                    </span>

                                </td>

                                <td>

                                    <span class="status-pill">
                                        @asset.Status
                                    </span>

                                </td>

                                <td>

                                    <span class="match-score">
                                        @asset.MatchScore%
                                    </span>

                                </td>

                                <td>

                                    <span class="match-reason">
                                        @asset.MatchReason
                                    </span>

                                </td>

                                <td>

                                    @using (Html.BeginForm(
                                        "LinkAsset",
                                        "MunicipalProject",
                                        FormMethod.Post,
                                        new
                                        {
                                            @class =
                                                "suggestion-link-form"
                                        }))
                                    {
                                        @Html.AntiForgeryToken()

                                        @Html.Hidden(
                                            "ProjectID",
                                            Model.ProjectID)

                                        @Html.Hidden(
                                            "AssetID",
                                            asset.AssetID)

                                        <button type="submit"
                                                class="table-action-button">
                                            Link Asset
                                        </button>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </section>
    }


    <!-- =========================================================
         LINK MUNICIPAL ASSET
         ========================================================= -->

    <section class="asset-section">

        <div class="section-heading">

            <div>

                <div class="section-eyebrow">
                    CONFIRMED RELATIONSHIP
                </div>

                <h2>
                    Link Municipal Asset
                </h2>

                <p>
                    Select a municipal asset and explicitly associate
                    it with this project.
                </p>

            </div>

        </div>


        @using (Html.BeginForm(
            "LinkAsset",
            "MunicipalProject",
            FormMethod.Post,
            new { @class = "link-asset-form" }))
        {
            @Html.AntiForgeryToken()

            @Html.Hidden(
                "ProjectID",
                Model.ProjectID)

            <div class="link-form-grid">

                <div class="form-field">

                    <label for="AssetID">
                        Municipal Asset
                    </label>

                    <select id="AssetID"
                            name="AssetID"
                            class="form-control">

                        <option value="">
                            Select a municipal asset
                        </option>

                        @foreach (var asset in Model.AvailableAssets)
                        {
                            <option value="@asset.AssetID">
                                @asset.AssetCode —
                                @asset.AssetName
                                (@asset.AssetType)
                            </option>
                        }

                    </select>

                    <small>
                        Only assets that are not already linked
                        to this project are displayed.
                    </small>

                </div>

                <div class="form-field">

                    <label for="Notes">
                        Link Notes
                    </label>

                    <textarea id="Notes"
                              name="Notes"
                              class="form-control notes-textarea"
                              maxlength="1000"
                              rows="3"
                              placeholder="Optional reason or notes about this asset relationship"></textarea>

                    <div class="character-counter">
                        <span id="notesCharacterCount">
                            0
                        </span>
                        / 1000
                    </div>

                </div>

                <div class="form-field form-action-field">

                    <button type="submit"
                            class="primary-button">
                        Link Asset
                    </button>

                </div>

            </div>

        }


    </section>


    <!-- =========================================================
         AVAILABLE MUNICIPAL ASSETS
         ========================================================= -->

    <section class="asset-section">

        <div class="section-heading">

            <div>

                <div class="section-eyebrow">
                    ASSET REGISTER
                </div>

                <h2>
                    Available Municipal Assets
                </h2>

                <p>
                    Search and filter assets that are not currently
                    linked to this project.
                </p>

            </div>

            <div class="asset-result-count">

                @Model.AvailableAssets.Count
                assets shown

            </div>

        </div>


        <!-- =====================================================
             SEARCH AND FILTERS
             ===================================================== -->

        @using (Html.BeginForm(
            "Assets",
            "MunicipalProject",
            FormMethod.Get,
            new { @class = "filter-form" }))
        {
            @Html.Hidden(
                "id",
                Model.ProjectID)

            <div class="filter-grid">

                <div class="filter-field search-field">

                    <label for="searchTerm">
                        Search
                    </label>

                    <input type="text"
                           id="searchTerm"
                           name="searchTerm"
                           value="@Model.SearchTerm"
                           class="form-control"
                           placeholder="Asset code, name, type, category or location" />

                </div>


                <div class="filter-field">

                    <label for="assetType">
                        Asset Type
                    </label>

                    <select id="assetType"
                            name="assetType"
                            class="form-control">

                        <option value="">
                            All asset types
                        </option>

                        @foreach (var option in
                            Model.AssetTypeOptions)
                        {
                            <option value="@option.Value"
                                    @(option.Selected ? "selected" : "")>
                                @option.Text
                            </option>
                        }

                    </select>

                </div>


                <div class="filter-field">

                    <label for="condition">
                        Condition
                    </label>

                    <select id="condition"
                            name="condition"
                            class="form-control">

                        <option value="">
                            All conditions
                        </option>

                        @foreach (var option in
                            Model.ConditionOptions)
                        {
                            <option value="@option.Value"
                                    @(option.Selected ? "selected" : "")>
                                @option.Text
                            </option>
                        }

                    </select>

                </div>


                <div class="filter-field">

                    <label for="status">
                        Status
                    </label>

                    <select id="status"
                            name="status"
                            class="form-control">

                        <option value="">
                            All statuses
                        </option>

                        @foreach (var option in
                            Model.StatusOptions)
                        {
                            <option value="@option.Value"
                                    @(option.Selected ? "selected" : "")>
                                @option.Text
                            </option>
                        }

                    </select>

                </div>


                <div class="filter-field">

                    <label for="ward">
                        Ward
                    </label>

                    <select id="ward"
                            name="ward"
                            class="form-control">

                        <option value="">
                            All wards
                        </option>

                        @foreach (var option in
                            Model.WardOptions)
                        {
                            <option value="@option.Value"
                                    @(option.Selected ? "selected" : "")>
                                @option.Text
                            </option>
                        }

                    </select>

                </div>


                <div class="filter-actions">

                    <button type="submit"
                            class="primary-button">
                        Search Assets
                    </button>

                    <a href="@Url.Action(
                        "Assets",
                        "MunicipalProject",
                        new { id = Model.ProjectID })"
                       class="secondary-button">
                        Clear
                    </a>

                </div>

            </div>

        }


        <!-- =====================================================
             AVAILABLE ASSETS TABLE
             ===================================================== -->

        @if (Model.AvailableAssets != null &&
             Model.AvailableAssets.Any())
        {
            <div class="table-wrapper">

                <table class="asset-table">

                    <thead>

                        <tr>
                            <th>Asset</th>
                            <th>Type</th>
                            <th>Category</th>
                            <th>Ward</th>
                            <th>Condition</th>
                            <th>Status</th>
                            <th>Date Registered</th>
                            <th>Last Inspection</th>
                            <th>Last Maintenance</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var asset in
                            Model.AvailableAssets)
                        {
                            <tr>

                                <td>

                                    <div class="asset-identity">

                                        <strong>
                                            @asset.AssetCode
                                        </strong>

                                        <span>
                                            @asset.AssetName
                                        </span>

                                    </div>

                                </td>

                                <td>
                                    @asset.AssetType
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(
                                        asset.AssetCategory)
                                        ? "Not specified"
                                        : asset.AssetCategory)
                                </td>

                                <td>
                                    @asset.WardName
                                </td>

                                <td>

                                    <span class="condition-pill">
                                        @asset.Condition
                                    </span>

                                </td>

                                <td>

                                    <span class="status-pill">
                                        @asset.Status
                                    </span>

                                </td>

                                <td>
                                    @asset.DateRegistered.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @(asset.LastInspectionDate.HasValue
                                        ? asset.LastInspectionDate.Value.ToString("dd MMM yyyy")
                                        : "Not recorded")
                                </td>

                                <td>
                                    @(asset.LastMaintenanceDate.HasValue
                                        ? asset.LastMaintenanceDate.Value.ToString("dd MMM yyyy")
                                        : "Not recorded")
                                </td>

                                <td>

                                    <button type="button"
                                            class="table-action-button select-asset-button"
                                            data-asset-id="@asset.AssetID">

                                        Select

                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        }
        else
        {
            <div class="empty-state">

                <div class="empty-state-icon">
                    ○
                </div>

                <strong>
                    No available municipal assets found
                </strong>

                <span>
                    No assets matched the current search and filter
                    criteria, or all matching assets are already linked
                    to this project.
                </span>

            </div>
        }

    </section>


    <!-- =========================================================
         LINKED ASSETS
         ========================================================= -->

    <section class="asset-section">

        <div class="section-heading">

            <div>

                <div class="section-eyebrow">
                    CONFIRMED RELATIONSHIPS
                </div>

                <h2>
                    Linked Municipal Assets
                </h2>

                <p>
                    Assets that have been explicitly associated with
                    this project by an administrator.
                </p>

            </div>

            <div class="asset-result-count">

                @Model.LinkedAssetCount
                linked

            </div>

        </div>


        @if (Model.LinkedAssets != null &&
             Model.LinkedAssets.Any())
        {
            <div class="table-wrapper">

                <table class="asset-table">

                    <thead>

                        <tr>
                            <th>Asset</th>
                            <th>Type</th>
                            <th>Category</th>
                            <th>Ward</th>
                            <th>Condition</th>
                            <th>Status</th>
                            <th>Linked Date</th>
                            <th>Linked By</th>
                            <th>Notes</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var asset in
                            Model.LinkedAssets)
                        {
                            <tr>

                                <td>

                                    <div class="asset-identity">

                                        <strong>
                                            @asset.AssetCode
                                        </strong>

                                        <span>
                                            @asset.AssetName
                                        </span>

                                    </div>

                                </td>

                                <td>
                                    @asset.AssetType
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(
                                        asset.AssetCategory)
                                        ? "Not specified"
                                        : asset.AssetCategory)
                                </td>

                                <td>
                                    @asset.WardName
                                </td>

                                <td>

                                    <span class="condition-pill">
                                        @asset.Condition
                                    </span>

                                </td>

                                <td>

                                    <span class="status-pill">
                                        @asset.Status
                                    </span>

                                </td>

                                <td>
                                    @asset.LinkDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @asset.LinkedByAdministratorName
                                </td>

                                <td>

                                    @(string.IsNullOrWhiteSpace(
                                        asset.Notes)
                                        ? "No notes recorded"
                                        : asset.Notes)

                                </td>

                                <td>

                                    @using (Html.BeginForm(
                                        "UnlinkAsset",
                                        "MunicipalProject",
                                        FormMethod.Post,
                                        new
                                        {
                                            @class =
                                                "unlink-asset-form"
                                        }))
                                    {
                                        @Html.AntiForgeryToken()

                                        @Html.Hidden(
                                            "id",
                                            asset.AssetProjectID)

                                        @Html.Hidden(
                                            "projectID",
                                            Model.ProjectID)

                                        <button type="submit"
                                                class="danger-action-button">
                                            Unlink
                                        </button>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        }
        else
        {
            <div class="empty-state">

                <div class="empty-state-icon">
                    ○
                </div>

                <strong>
                    No municipal assets linked
                </strong>

                <span>
                    No assets have been explicitly associated with
                    this project yet.
                </span>

            </div>
        }

    </section>


    <!-- =========================================================
         PAGE FOOTER NAVIGATION
         ========================================================= -->

    <div class="page-footer-navigation">

        <a href="@Url.Action(
            "Details",
            "MunicipalProject",
            new { id = Model.ProjectID })"
           class="secondary-button">
            ← Back to Project Details
        </a>

        <a href="@Url.Action(
            "Index",
            "MunicipalProject")"
           class="secondary-button">
            Project Register
        </a>

    </div>

</div>


<!-- =============================================================
     STYLES
     ============================================================= -->

<style>

    /* =========================================================
       PAGE
       ========================================================= */

    .project-assets-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 30px;
        color: #172033;
        font-family: Arial, sans-serif;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        padding: 28px 30px;
        margin-bottom: 20px;
        background: linear-gradient( 135deg, #0D5CC1, #094b9f );
        border-radius: 12px;
        color: white;
        box-shadow: 0 5px 16px rgba(13, 92, 193, 0.16);
    }

    .page-header-eyebrow {
        margin-bottom: 7px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .08em;
        opacity: .82;
    }

    .page-header h1 {
        margin: 0;
        font-size: 28px;
        line-height: 1.25;
    }

    .page-header p {
        margin: 8px 0 0;
        font-size: 13px;
        opacity: .9;
        line-height: 1.5;
    }

    .page-header-actions {
        flex-shrink: 0;
    }


    /* =========================================================
       BUTTONS
       ========================================================= */

    .header-button,
    .primary-button,
    .secondary-button,
    .table-action-button,
    .danger-action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 39px;
        padding: 0 14px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 650;
        text-decoration: none;
        cursor: pointer;
        box-sizing: border-box;
        transition: background .15s ease, border-color .15s ease, color .15s ease;
    }

    .secondary-header-button {
        background: rgba(255,255,255,.12);
        color: white;
        border: 1px solid rgba(255,255,255,.35);
    }

        .secondary-header-button:hover {
            background: rgba(255,255,255,.2);
            color: white;
            text-decoration: none;
        }

    .primary-button {
        background: #0D5CC1;
        border: 1px solid #0D5CC1;
        color: white;
    }

        .primary-button:hover {
            background: #094b9f;
            border-color: #094b9f;
            color: white;
        }

    .secondary-button {
        background: white;
        border: 1px solid #d0d5dd;
        color: #344054;
    }

        .secondary-button:hover {
            background: #f8fafc;
            color: #172033;
            text-decoration: none;
        }

    .table-action-button {
        min-height: 32px;
        padding: 0 10px;
        background: #eff6ff;
        border: 1px solid #c7d9f2;
        color: #0D5CC1;
        white-space: nowrap;
    }

        .table-action-button:hover {
            background: #dcecff;
            color: #094b9f;
        }

    .danger-action-button {
        min-height: 32px;
        padding: 0 10px;
        background: white;
        border: 1px solid #f0b8b4;
        color: #b42318;
        white-space: nowrap;
    }

        .danger-action-button:hover {
            background: #fff1f0;
            color: #9b1c1c;
        }


    /* =========================================================
       PROJECT CONTEXT
       ========================================================= */

    .project-context-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        padding: 22px 24px;
        margin-bottom: 20px;
        background: white;
        border: 1px solid #e4e7ec;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(15,23,42,.035);
    }

    .context-label,
    .section-eyebrow {
        display: block;
        color: #0D5CC1;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .08em;
    }

    .project-context-main h2 {
        margin: 5px 0 12px;
        color: #172033;
        font-size: 21px;
    }

    .project-context-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 20px;
        color: #667085;
        font-size: 12px;
    }

        .project-context-meta strong {
            color: #344054;
        }

    .linked-count-card {
        min-width: 125px;
        padding: 15px 18px;
        text-align: center;
        background: #eff6ff;
        border: 1px solid #c7d9f2;
        border-radius: 8px;
    }

        .linked-count-card span {
            display: block;
            color: #667085;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .06em;
        }

        .linked-count-card strong {
            display: block;
            margin-top: 4px;
            color: #0D5CC1;
            font-size: 25px;
        }


    /* =========================================================
       ALERTS
       ========================================================= */

    .alert-message {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        padding: 13px 15px;
        margin-bottom: 18px;
        border-radius: 8px;
        font-size: 12px;
    }

        .alert-message strong,
        .alert-message span {
            display: block;
        }

        .alert-message strong {
            margin-bottom: 3px;
        }

    .success-alert {
        background: #ecfdf3;
        border: 1px solid #abefc6;
        color: #027a48;
    }

    .error-alert {
        background: #fef3f2;
        border: 1px solid #fecdca;
        color: #b42318;
    }

    .alert-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 21px;
        height: 21px;
        flex-shrink: 0;
        border-radius: 50%;
        font-weight: 700;
    }

    .success-alert .alert-icon {
        background: #d1fadf;
    }

    .error-alert .alert-icon {
        background: #fee4e2;
    }


    /* =========================================================
       SECTIONS
       ========================================================= */

    .asset-section {
        background: white;
        border: 1px solid #e4e7ec;
        border-radius: 10px;
        padding: 24px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(15,23,42,.035);
    }

