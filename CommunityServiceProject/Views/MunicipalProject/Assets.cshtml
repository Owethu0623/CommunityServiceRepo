</style>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        /* =====================================================
           NOTES CHARACTER COUNTER
           ===================================================== */

        var notesInput =
            document.getElementById("Notes");

        var notesCount =
            document.getElementById("notesCount");

        if (notesInput && notesCount) {

            function updateNotesCount() {
                notesCount.textContent =
                    notesInput.value.length;
            }

            notesInput.addEventListener(
                "input",
                updateNotesCount
            );

            updateNotesCount();
        }


        /* =====================================================
           SELECT ASSET FROM TABLE
           ===================================================== */

        var selectButtons =
            document.querySelectorAll(
                ".select-asset-button"
            );

        var assetSelect =
            document.getElementById("AssetID");

        selectButtons.forEach(function (button) {

            button.addEventListener(
                "click",
                function () {

                    var assetID =
                        button.getAttribute(
                            "data-asset-id"
                        );

                    if (!assetSelect)
                        return;

                    assetSelect.value =
                        assetID;

                    assetSelect.focus();

                    var linkCard =
                        document.getElementById(
                            "assetLinkForm"
                        );

                    if (linkCard) {

                        linkCard.scrollIntoView({
                            behavior: "smooth",
                            block: "center"
                        });

                    }

                }
            );

        });


        /* =====================================================
           LINK CONFIRMATION
           ===================================================== */

        var linkForm =
            document.getElementById(
                "assetLinkForm"
            );

        if (linkForm) {

            linkForm.addEventListener(
                "submit",
                function (event) {

                    if (!assetSelect ||
                        !assetSelect.value) {

                        event.preventDefault();

                        alert(
                            "Please select a municipal asset before linking it to the project."
                        );

                        if (assetSelect)
                            assetSelect.focus();

                        return;
                    }

                    var selectedText =
                        assetSelect.options[
                            assetSelect.selectedIndex
                        ].text;

                    var confirmed =
                        confirm(
                            "Are you sure you want to link this asset to the project?\n\n" +
                            selectedText
                        );

                    if (!confirmed) {
                        event.preventDefault();
                    }

                }
            );

        }


        /* =====================================================
           UNLINK CONFIRMATION
           ===================================================== */

        var unlinkForms =
            document.querySelectorAll(
                ".unlink-form"
            );

        unlinkForms.forEach(function (form) {

            form.addEventListener(
                "submit",
                function (event) {

                    var button =
                        form.querySelector(
                            ".unlink-button"
                        );

                    var assetCode =
                        button
                            ? button.getAttribute(
                                "data-asset-code"
                            )
                            : "this asset";

                    var confirmed =
                        confirm(
                            "Are you sure you want to unlink " +
                            assetCode +
                            " from this project?\n\n" +
                            "The municipal asset itself will not be deleted."
                        );

                    if (!confirmed) {
                        event.preventDefault();
                    }

                }
            );

        });


        /* =====================================================
           AUTO-HIDE ALERTS
           ===================================================== */

        var alerts =
            document.querySelectorAll(
                ".project-alert"
            );

        alerts.forEach(function (alertBox) {

            setTimeout(function () {

                alertBox.style.transition =
                    "opacity 0.3s ease";

                alertBox.style.opacity = "0";

                setTimeout(function () {

                    if (alertBox.parentNode) {
                        alertBox.parentNode.removeChild(
                            alertBox
                        );
                    }

                }, 350);

            }, 5000);

        });

    });

</script>


