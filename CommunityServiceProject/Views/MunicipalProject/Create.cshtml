@model CommunityServiceProject.ViewModels.MunicipalProjectCreateViewModel

@{
    ViewBag.Title = "Register Municipal Project";
}

<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIhIhmNHrzRC9tD/miZyoHS5obTRR9BMY="
      crossorigin="" />

<div class="project-create-page">

    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="page-header">

        <div>
            <span class="page-eyebrow">
                MUNICIPAL PROJECT MANAGEMENT
            </span>

            <h1>Register Municipal Project</h1>

            <p>
                Create a central municipal record for an infrastructure,
                facility, development, or rehabilitation project.
            </p>
        </div>

        <div class="header-actions">

            @Html.ActionLink(
                "Back to Projects",
                "Index",
                "MunicipalProject",
                null,
                new { @class = "btn-secondary" }
            )

        </div>

    </div>


    <!-- =====================================================
         INFORMATION
         ===================================================== -->

    <div class="info-banner">

        <div class="info-icon">
            i
        </div>

        <div>

            <strong>Project registration</strong>

            <p>
                Provide accurate project information and select the
                project location before registering it.
            </p>

        </div>

    </div>


    @using (Html.BeginForm(
        "Create",
        "MunicipalProject",
        FormMethod.Post,
        new
        {
            @class = "project-form",
            id = "projectForm"
        }))
    {
        @Html.AntiForgeryToken()


        <!-- =================================================
             SERVER VALIDATION
             Only displayed when actual validation errors exist.
             ================================================= -->

        if (!ViewData.ModelState.IsValid)
        {
            <div class="validation-summary">

                <strong>
                    Please correct the highlighted information.
                </strong>

                @Html.ValidationSummary(
                    true,
                    "",
                    new { @class = "validation-summary-list" }
                )

            </div>
        }


        <!-- =====================================================
             SECTION 01 — PROJECT INFORMATION
             ===================================================== -->

        <div class="form-card">

            <div class="section-heading">

                <div class="section-number">
                    01
                </div>

                <div>
                    <h2>Project Information</h2>

                    <p>
                        Define the project's identity and purpose.
                    </p>
                </div>

            </div>


            <div class="form-grid">

                <!-- PROJECT NAME -->

                <div class="form-group full-width">

                    @Html.LabelFor(m => m.ProjectName)

                    @Html.TextBoxFor(
                        m => m.ProjectName,
                        new
                        {
                            @class = "form-control",
                            maxlength = "200",
                            placeholder = "e.g. Umlazi Road Rehabilitation Project"
                        }
                    )

                    @Html.ValidationMessageFor(
                        m => m.ProjectName,
                        "",
                        new { @class = "field-error" }
                    )

                </div>


                <!-- PROJECT TYPE -->

                <div class="form-group">

                    @Html.LabelFor(m => m.ProjectType)

                    @Html.DropDownListFor(
                        m => m.ProjectType,
                        Model.ProjectTypeOptions,
                        "Select project type",
                        new { @class = "form-control" }
                    )

                    @Html.ValidationMessageFor(
                        m => m.ProjectType,
                        "",
                        new { @class = "field-error" }
                    )

                </div>


                <!-- PRIORITY -->

                <div class="form-group">

                    @Html.LabelFor(m => m.Priority)

                    @Html.DropDownListFor(
                        m => m.Priority,
                        Model.PriorityOptions,
                        "Select priority",
                        new { @class = "form-control" }
                    )

                    @Html.ValidationMessageFor(
                        m => m.Priority,
                        "",
                        new { @class = "field-error" }
                    )

                </div>


                <!-- DESCRIPTION -->

                <div class="form-group full-width">

                    @Html.LabelFor(m => m.Description)

                    @Html.TextAreaFor(
                        m => m.Description,
                        new
                        {
                            @class = "form-control textarea",
                            rows = "5",
                            maxlength = "2000",
                            placeholder = "Describe the purpose, scope, or expected outcome of the project..."
                        }
                    )

                    <span class="field-hint">
                        Maximum 2000 characters.
                    </span>

                    @Html.ValidationMessageFor(
                        m => m.Description,
                        "",
                        new { @class = "field-error" }
                    )

                </div>

            </div>

        </div>


        <!-- =====================================================
             SECTION 02 — PROJECT LOCATION
             ===================================================== -->

        <div class="form-card">

            <div class="section-heading">

                <div class="section-number">
                    02
                </div>

                <div>

                    <h2>Project Location</h2>

                    <p>
                        Record where the municipal project is physically located.
                    </p>

                </div>

            </div>


            <!-- WARD -->

            <div class="form-group">

                @Html.LabelFor(m => m.WardID)

                @Html.DropDownListFor(
                    m => m.WardID,
                    Model.WardOptions,
                    "Select ward",
                    new { @class = "form-control" }
                )

                @Html.ValidationMessageFor(
                    m => m.WardID,
                    "",
                    new { @class = "field-error" }
                )

                <span class="field-hint">
                    Select the municipal ward in which the project is located.
                </span>

            </div>


            <div class="location-section">


                <!-- LOCATION NOTICE -->

                <div class="location-notice">

                    <div class="location-notice-icon">
                        ⌖
                    </div>

                    <div>

                        <strong>
                            Select the project location
                        </strong>

                        <p>
                            Search for an address or click directly on the map.
                            You can also drag the marker to refine the location.
                        </p>

                    </div>

                </div>


                <!-- ADDRESS SEARCH -->

                <div class="address-search-section">

                    <label class="form-label"
                           for="addressSearch">
                        Search for an Address
                    </label>

                    <div class="address-search-row">

                        <input type="text"
                               id="addressSearch"
                               class="form-control"
                               maxlength="200"
                               autocomplete="off"
                               placeholder="e.g. Main Road, Umlazi, Durban" />

                        <button type="button"
                                id="searchAddressButton"
                                class="btn-map-search">
                            Search Address
                        </button>

                    </div>

                    <div id="searchStatus"
                         class="location-status"
                         aria-live="polite">
                    </div>

                    <div id="searchResults"
                         class="location-search-results">
                    </div>

                </div>


                <!-- MAP -->

                <div class="map-container">

                    <div id="projectMap"></div>

                </div>

                <div class="map-help">
                    Click the map or drag the marker to select the project location.
                </div>


                <!-- SELECT MAP CENTRE -->

                <div class="map-centre-row">

                    <button type="button"
                            id="selectMapCentre"
                            class="btn-map-centre">
                        Select Map Centre
                    </button>

                    <span id="locationStatus"
                          class="location-status"
                          aria-live="polite">
                    </span>

                </div>


                <!-- SELECTED LOCATION -->

                <div class="selected-location-panel">

                    <div class="selected-location-header">

                        <div class="selected-location-title">

                            <span class="selected-location-icon">
                                ✓
                            </span>

                            <div>

                                <strong>
                                    Selected Location
                                </strong>

                                <small>
                                    Coordinates selected for this project
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="coordinate-grid">

                        <div class="coordinate-box">

                            <span class="coordinate-label">
                                Latitude
                            </span>

                            <strong id="latitudeDisplay">
                                Not selected
                            </strong>

                        </div>


                        <div class="coordinate-box">

                            <span class="coordinate-label">
                                Longitude
                            </span>

                            <strong id="longitudeDisplay">
                                Not selected
                            </strong>

                        </div>

                    </div>

                </div>


                <!-- PROJECT LOCATION -->

                <div class="form-group">

                    @Html.LabelFor(
                        m => m.ProjectLocation,
                        new { @class = "form-label" }
                    )

                    @Html.TextBoxFor(
                        m => m.ProjectLocation,
                        new
                        {
                            @class = "form-control",
                            id = "ProjectLocation",
                            maxlength = "500",
                            placeholder = "e.g. Umlazi Main Road corridor"
                        }
                    )

                    @Html.ValidationMessageFor(
                        m => m.ProjectLocation,
                        "",
                        new { @class = "field-error" }
                    )

                    <span class="field-hint">
                        The selected address may be populated automatically,
                        or you can edit it manually.
                    </span>

                </div>


                <!-- LOCATION DESCRIPTION -->

                <div class="form-group">

                    @Html.LabelFor(
                        m => m.LocationDescription,
                        new { @class = "form-label" }
                    )

                    @Html.TextBoxFor(
                        m => m.LocationDescription,
                        new
                        {
                            @class = "form-control",
                            id = "LocationDescription",
                            maxlength = "500",
                            placeholder = "e.g. Near the community centre"
                        }
                    )

                    @Html.ValidationMessageFor(
                        m => m.LocationDescription,
                        "",
                        new { @class = "field-error" }
                    )

                    <span class="field-hint">
                        Add a useful landmark, road section, facility,
                        or other physical location information.
                    </span>

                </div>


                <!-- HIDDEN COORDINATES -->

                @Html.Hidden(
                    "Latitude",
                    Model.Latitude,
                    new
                    {
                        id = "ProjectLatitude"
                    }
                )

                @Html.Hidden(
                    "Longitude",
                    Model.Longitude,
                    new
                    {
                        id = "ProjectLongitude"
                    }
                )


                <!-- COORDINATE ERROR -->

                <div id="coordinateError"
                     class="coordinate-error"
                     style="display:none;">
                </div>

            </div>

        </div>


        <!-- =====================================================
             SECTION 03 — PROJECT SCHEDULE
             ===================================================== -->

        <div class="form-card">

            <div class="section-heading">

                <div class="section-number">
                    03
                </div>

                <div>

                    <h2>Project Schedule</h2>

                    <p>
                        Define the planned project timeframe.
                    </p>

                </div>

            </div>


            <div class="form-grid">

                <!-- START DATE -->

                <div class="form-group">

                    @Html.LabelFor(m => m.StartDate)

                    @Html.TextBoxFor(
                        m => m.StartDate,
                        "{0:yyyy-MM-dd}",
                        new
                        {
                            @class = "form-control",
                            type = "date"
                        }
                    )

                    @Html.ValidationMessageFor(
                        m => m.StartDate,
                        "",
                        new { @class = "field-error" }
                    )

                </div>


                <!-- EXPECTED COMPLETION -->

                <div class="form-group">

                    @Html.LabelFor(m => m.ExpectedCompletionDate)

                    @Html.TextBoxFor(
                        m => m.ExpectedCompletionDate,
                        "{0:yyyy-MM-dd}",
                        new
                        {
                            @class = "form-control",
                            type = "date"
                        }
                    )

                    @Html.ValidationMessageFor(
                        m => m.ExpectedCompletionDate,
                        "",
                        new { @class = "field-error" }
                    )

                    <span class="field-hint">
                        Leave blank if the completion date has not yet been determined.
                    </span>

                </div>

            </div>

        </div>


        <!-- =====================================================
             SECTION 04 — FINANCIAL INFORMATION
             ===================================================== -->

        <div class="form-card">

            <div class="section-heading">

                <div class="section-number">
                    04
                </div>

                <div>

                    <h2>Financial Information</h2>

                    <p>
                        Record the estimated financial requirement.
                    </p>

                </div>

            </div>


            <div class="form-grid">

                <div class="form-group">

                    @Html.LabelFor(m => m.EstimatedBudget)

                    <div class="currency-input">

                        <span>R</span>

                        @Html.TextBoxFor(
                            m => m.EstimatedBudget,
                            new
                            {
                                @class = "form-control",
                                type = "number",
                                min = "0",
                                step = "0.01",
                                placeholder = "0.00"
                            }
                        )

                    </div>

                    @Html.ValidationMessageFor(
                        m => m.EstimatedBudget,
                        "",
                        new { @class = "field-error" }
                    )

                    <span class="field-hint">
                        Enter the estimated project budget in South African Rand.
                    </span>

                </div>

            </div>

        </div>


        <!-- =====================================================
             SECTION 05 — RESPONSIBILITY
             ===================================================== -->

        <div class="form-card">

            <div class="section-heading">

                <div class="section-number">
                    05
                </div>

                <div>

                    <h2>Project Responsibility</h2>

                    <p>
                        Assign an active administrator responsible for the project.
                    </p>

                </div>

            </div>


            <div class="form-group">

                @Html.LabelFor(m => m.ResponsibleAdministratorID)

                @Html.DropDownListFor(
                    m => m.ResponsibleAdministratorID,
                    Model.AdministratorOptions,
                    "Select responsible administrator",
                    new { @class = "form-control" }
                )

                @Html.ValidationMessageFor(
                    m => m.ResponsibleAdministratorID,
                    "",
                    new { @class = "field-error" }
                )

            </div>

        </div>


        <!-- =====================================================
             SECTION 06 — SYSTEM INFORMATION
             ===================================================== -->

        <div class="form-card system-information">

            <div class="section-heading">

                <div class="section-number">
                    06
                </div>

                <div>

                    <h2>System Registration</h2>

                    <p>
                        The following information is generated automatically.
                    </p>

                </div>

            </div>


            <div class="system-grid">

                <div class="system-item">

                    <span>
                        Project Code
                    </span>

                    <strong>
                        Generated after registration
                    </strong>

                </div>


                <div class="system-item">

                    <span>
                        Initial Status
                    </span>

                    <strong>
                        Planned
                    </strong>

                </div>


                <div class="system-item">

                    <span>
                        Registration Date
                    </span>

                    <strong>
                        Automatically recorded
                    </strong>

                </div>

            </div>

        </div>


        <!-- =====================================================
             ACTIONS
             ===================================================== -->

        <div class="form-actions">

            @Html.ActionLink(
                "Cancel",
                "Index",
                "MunicipalProject",
                null,
                new { @class = "btn-secondary" }
            )

            <button type="submit"
                    class="btn-primary"
                    id="registerProjectButton">

                Register Project

            </button>

        </div>

    }

</div>


<!-- =========================================================
     LEAFLET
     ========================================================= -->

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin="">
</script>


<script>

(function () {

    "use strict";


    function initialiseProjectMap() {

        var mapElement =
            document.getElementById("projectMap");


        if (!mapElement) {
            return;
        }


        if (typeof L === "undefined") {

            mapElement.innerHTML =
                "<div class='map-load-error'>" +
                "The map could not be loaded. Please refresh the page." +
                "</div>";

            return;
        }


        /* =====================================================
           ELEMENTS
           ===================================================== */

        var latitudeInput =
            document.getElementById("ProjectLatitude");

        var longitudeInput =
            document.getElementById("ProjectLongitude");

        var latitudeDisplay =
            document.getElementById("latitudeDisplay");

        var longitudeDisplay =
            document.getElementById("longitudeDisplay");

        var projectLocation =
            document.getElementById("ProjectLocation");

        var locationDescription =
            document.getElementById("LocationDescription");

        var addressSearch =
            document.getElementById("addressSearch");

        var searchButton =
            document.getElementById("searchAddressButton");

        var searchStatus =
            document.getElementById("searchStatus");

        var searchResults =
            document.getElementById("searchResults");

        var locationStatus =
            document.getElementById("locationStatus");

        var selectMapCentre =
            document.getElementById("selectMapCentre");

        var registrationForm =
            document.getElementById("projectForm");

        var registerButton =
            document.getElementById("registerProjectButton");

        var coordinateError =
            document.getElementById("coordinateError");


        /* =====================================================
           MAP
           ===================================================== */

        var defaultLatitude = -29.8587;
        var defaultLongitude = 31.0218;


        var map =
            L.map(
                "projectMap",
                {
                    zoomControl: true
                }
            );


        map.setView(
            [
                defaultLatitude,
                defaultLongitude
            ],
            12
        );


        L.tileLayer(
            "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            {
                maxZoom: 19,
                attribution:
                    "&copy; OpenStreetMap contributors"
            }
        ).addTo(map);


        var marker = null;


        /* =====================================================
           STATUS
           ===================================================== */

        function setLocationStatus(
            message,
            type
        ) {

            locationStatus.textContent =
                message;

            locationStatus.className =
                "location-status";

            if (type) {
                locationStatus.classList.add(type);
            }
        }


        function setSearchStatus(
            message,
            type
        ) {

            searchStatus.textContent =
                message;

            searchStatus.className =
                "location-status";

            if (type) {
                searchStatus.classList.add(type);
            }
        }


        /* =====================================================
           COORDINATES
           ===================================================== */

        function updateCoordinates(
            latitude,
            longitude
        ) {

            var lat =
                parseFloat(latitude);

            var lon =
                parseFloat(longitude);


            if (
                isNaN(lat) ||
                isNaN(lon)
            ) {
                return false;
            }


            latitudeInput.value =
                lat.toFixed(6);

            longitudeInput.value =
                lon.toFixed(6);


            latitudeDisplay.textContent =
                lat.toFixed(6);

            longitudeDisplay.textContent =
                lon.toFixed(6);


            return true;
        }


        /* =====================================================
           SELECT LOCATION
           ===================================================== */

        function selectLocation(
            latitude,
            longitude,
            reverseGeocode
        ) {

            var lat =
                parseFloat(latitude);

            var lon =
                parseFloat(longitude);


            if (
                isNaN(lat) ||
                isNaN(lon)
            ) {

                setLocationStatus(
                    "The selected coordinates are invalid.",
                    "error"
                );

                return;
            }


            if (
                lat < -90 ||
                lat > 90 ||
                lon < -180 ||
                lon > 180
            ) {

                setLocationStatus(
                    "The selected coordinates are outside the valid range.",
                    "error"
                );

                return;
            }


            if (
                Math.abs(lat) < 0.000001 &&
                Math.abs(lon) < 0.000001
            ) {

                setLocationStatus(
                    "Please select a valid project location.",
                    "error"
                );

                return;
            }


            updateCoordinates(
                lat,
                lon
            );


            /* CREATE OR MOVE MARKER */

            if (marker === null) {

                marker =
                    L.marker(
                        [lat, lon],
                        {
                            draggable: true
                        }
                    ).addTo(map);


                marker.on(
                    "dragend",
                    function () {

                        var position =
                            marker.getLatLng();

                        selectLocation(
                            position.lat,
                            position.lng,
                            true
                        );

                    }
                );

            }
            else {

                marker.setLatLng(
                    [lat, lon]
                );

            }


            map.setView(
                [lat, lon],
                Math.max(
                    map.getZoom(),
                    15
                )
            );


            setLocationStatus(
                "Location selected.",
                "success"
            );


            if (reverseGeocode) {

                performReverseGeocode(
                    lat,
                    lon
                );

            }

        }


        /* =====================================================
           REVERSE GEOCODING
           ===================================================== */

        function performReverseGeocode(
            latitude,
            longitude
        ) {

            var url =
                "@Url.Action("ReverseGeocode", "MunicipalProject")";


            url +=
                "?lat=" +
                encodeURIComponent(latitude) +
                "&lon=" +
                encodeURIComponent(longitude);


            fetch(url)
                .then(function (response) {

                    if (!response.ok) {
                        throw new Error(
                            "Reverse geocoding failed."
                        );
                    }

                    return response.json();

                })
                .then(function (data) {

                    if (
                        data &&
                        data.display_name
                    ) {

                        if (
                            !projectLocation.value.trim()
                        ) {

                            projectLocation.value =
                                data.display_name;

                        }


                        if (
                            !locationDescription.value.trim()
                        ) {

                            locationDescription.value =
                                data.display_name;

                        }


                        setLocationStatus(
                            "Location identified successfully.",
                            "success"
                        );

                    }

                })
                .catch(function () {

                    setLocationStatus(
                        "Coordinates selected. Location details may be entered manually.",
                        "success"
                    );

                });

        }


        /* =====================================================
           MAP CLICK
           ===================================================== */

        map.on(
            "click",
            function (event) {

                selectLocation(
                    event.latlng.lat,
                    event.latlng.lng,
                    true
                );

            }
        );


        /* =====================================================
           SELECT MAP CENTRE
           ===================================================== */

        selectMapCentre.addEventListener(
            "click",
            function () {

                var centre =
                    map.getCenter();


                selectLocation(
                    centre.lat,
                    centre.lng,
                    true
                );

            }
        );


        /* =====================================================
           ADDRESS SEARCH
           ===================================================== */

        searchButton.addEventListener(
            "click",
            function () {

                var query =
                    addressSearch.value.trim();


                if (!query) {

                    setSearchStatus(
                        "Please enter an address or location.",
                        "error"
                    );

                    addressSearch.focus();

                    return;
                }


                searchButton.disabled =
                    true;

                searchResults.innerHTML =
                    "";


                setSearchStatus(
                    "Searching for locations...",
                    "warning"
                );


                var url =
                    "@Url.Action("SearchAddress", "MunicipalProject")";


                url +=
                    "?query=" +
                    encodeURIComponent(query);


                fetch(url)
                    .then(function (response) {

                        if (!response.ok) {
                            throw new Error(
                                "Search failed."
                            );
                        }

                        return response.json();

                    })
                    .then(function (data) {

                        searchResults.innerHTML =
                            "";


                        if (
                            data &&
                            data.success === false
                        ) {

                            setSearchStatus(
                                data.message ||
                                "Unable to search for the location.",
                                "error"
                            );

                            return;
                        }


                        if (!Array.isArray(data)) {

                            setSearchStatus(
                                "The location search returned an unexpected response.",
                                "error"
                            );

                            return;
                        }


                        if (data.length === 0) {

                            setSearchStatus(
                                "No matching locations were found.",
                                "warning"
                            );

                            return;
                        }


                        setSearchStatus(
                            data.length +
                            " location(s) found. Select a result below.",
                            "success"
                        );


                        data.forEach(
                            function (result) {

                                if (
                                    !result.lat ||
                                    !result.lon
                                ) {
                                    return;
                                }


                                var button =
                                    document.createElement(
                                        "button"
                                    );


                                button.type =
                                    "button";

                                button.className =
                                    "location-search-result";

                                button.textContent =
                                    result.display_name ||
                                    "Location";


                                button.addEventListener(
                                    "click",
                                    function () {

                                        var lat =
                                            parseFloat(
                                                result.lat
                                            );

                                        var lon =
                                            parseFloat(
                                                result.lon
                                            );


                                        selectLocation(
                                            lat,
                                            lon,
                                            false
                                        );


                                        projectLocation.value =
                                            result.display_name ||
                                            "";


                                        locationDescription.value =
                                            result.display_name ||
                                            "";


                                        searchResults.innerHTML =
                                            "";


                                        setSearchStatus(
                                            "Location selected.",
                                            "success"
                                        );

                                    }
                                );


                                searchResults.appendChild(
                                    button
                                );

                            }
                        );

                    })
                    .catch(function () {

                        setSearchStatus(
                            "Unable to search for the requested location. Please try again.",
                            "error"
                        );

                    })
                    .finally(function () {

                        searchButton.disabled =
                            false;

                    });

            }
        );


        /* =====================================================
           ENTER TO SEARCH
           ===================================================== */

        addressSearch.addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Enter") {

                    event.preventDefault();

                    searchButton.click();

                }

            }
        );


        /* =====================================================
           RESTORE EXISTING COORDINATES
           ===================================================== */

        var existingLatitude =
            parseFloat(
                latitudeInput.value
            );

        var existingLongitude =
            parseFloat(
                longitudeInput.value
            );


        if (
            !isNaN(existingLatitude) &&
            !isNaN(existingLongitude)
        ) {

            selectLocation(
                existingLatitude,
                existingLongitude,
                false
            );

        }


        /* =====================================================
           FORM SUBMISSION
           ===================================================== */

        registrationForm.addEventListener(
            "submit",
            function (event) {

                var latitude =
                    parseFloat(
                        latitudeInput.value
                    );

                var longitude =
                    parseFloat(
                        longitudeInput.value
                    );


                /* CLEAR COORDINATE ERROR */

                coordinateError.style.display =
                    "none";

                coordinateError.textContent =
                    "";


                /* VALIDATE COORDINATES */

                if (
                    isNaN(latitude) ||
                    isNaN(longitude)
                ) {

                    event.preventDefault();


                    coordinateError.textContent =
                        "Please select the project location on the map.";

                    coordinateError.style.display =
                        "block";


                    setLocationStatus(
                        "Project location is required.",
                        "error"
                    );


                    document.getElementById(
                        "projectMap"
                    ).scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });


                    return;
                }


                /* NORMALISE */

                latitudeInput.value =
                    latitude.toFixed(6);

                longitudeInput.value =
                    longitude.toFixed(6);


                /* CONFIRM */

                var confirmed =
                    window.confirm(
                        "Are you sure you want to register this municipal project?"
                    );


                if (!confirmed) {

                    event.preventDefault();

                    return;
                }


                /* PREVENT DUPLICATE SUBMISSION */

                registerButton.disabled =
                    true;

                registerButton.innerText =
                    "Registering Project...";

            }
        );


        /* =====================================================
           MAP RESIZE
           ===================================================== */

        setTimeout(
            function () {

                map.invalidateSize();

            },
            300
        );


        setTimeout(
            function () {

                map.invalidateSize();

            },
            1000
        );


        window.addEventListener(
            "resize",
            function () {

                map.invalidateSize();

            }
        );

    }


    /* =========================================================
       START MAP AFTER DOM LOAD
       ========================================================= */

    if (
        document.readyState === "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initialiseProjectMap
        );

    }
    else {

        initialiseProjectMap();

    }

})();

</script>


