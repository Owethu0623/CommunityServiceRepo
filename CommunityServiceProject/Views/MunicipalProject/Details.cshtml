<script>

    document.addEventListener("DOMContentLoaded", function () {

        var mapElement =
            document.getElementById("projectLocationMap");

        if (!mapElement) {
            return;
        }


        var latitude =
            parseFloat(
                mapElement.getAttribute("data-latitude")
            );

        var longitude =
            parseFloat(
                mapElement.getAttribute("data-longitude")
            );

        var projectName =
            mapElement.getAttribute("data-project") ||
            "Municipal Project";


        if (isNaN(latitude) || isNaN(longitude)) {
            return;
        }


        var map =
            L.map("projectLocationMap", {
                center: [latitude, longitude],
                zoom: 16,
                scrollWheelZoom: true,
                zoomControl: true
            });


        L.tileLayer(
            "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            {
                maxZoom: 19,
                attribution:
                    '&copy; OpenStreetMap contributors'
            }
        ).addTo(map);


        var projectIcon =
            L.divIcon({
                className: "project-location-marker-wrapper",
                html:
                    '<div class="project-map-marker"></div>',
                iconSize: [36, 36],
                iconAnchor: [18, 36],
                popupAnchor: [0, -32]
            });


        var marker =
            L.marker(
                [latitude, longitude],
                {
                    icon: projectIcon,
                    keyboard: false
                }
            ).addTo(map);


        marker.bindPopup(
            '<div class="project-popup-title">' +
                escapeHtml(projectName) +
            '</div>' +
            '<div class="project-popup-location">' +
                'Registered project location' +
            '</div>'
        );


        marker.openPopup();


        setTimeout(function () {

            map.invalidateSize();

        }, 250);


        window.addEventListener(
            "resize",
            function () {

                map.invalidateSize();

            }
        );

    });


    function escapeHtml(value) {

        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");

    }

</script>