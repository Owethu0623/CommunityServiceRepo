@model CommunityServiceProject.ViewModels.MunicipalProjectDetailsViewModel

@{
    ViewBag.Title = "Project Details";

    double? mapLatitude = ViewBag.MapLatitude as double?;
    double? mapLongitude = ViewBag.MapLongitude as double?;
}

<div class="municipal-project-details-page">

    <!-- ============================================================
         PAGE HEADER
    ============================================================= -->

    <div class="project-details-header">

        <div class="project-details-header-left">

            <div class="project-details-eyebrow">
                MUNICIPAL PROJECT MANAGEMENT
            </div>

            <h1>@Model.ProjectName</h1>

            <div class="project-code">
                <span>@Model.ProjectCode</span>
                <span class="project-code-separator">|</span>
                <span>@Model.ProjectType</span>
            </div>

        </div>


        <div class="project-details-header-actions">

            @Html.ActionLink(
                "← Back to Projects",
                "Index",
                "MunicipalProject",
                null,
                new { @class = "btn-secondary" }
            )

            @Html.ActionLink(
                string.IsNullOrWhiteSpace(Model.ProjectScope)
                    ? "Define Project Scope"
                    : "Edit Project Scope",
                "DefineScope",
                "MunicipalProject",
                new { id = Model.ProjectID },
                new { @class = "btn-project-action" }
            )

            @Html.ActionLink(
                "Manage Objectives",
                "Objectives",
                "MunicipalProject",
                new { id = Model.ProjectID },
                new { @class = "btn-project-action" }
            )

            @Html.ActionLink(
    " Manage Service Requests",
    "Requests",
    "MunicipalProject",
    new { id = Model.ProjectID },
    new { @class = "btn-project-action" }
)

            @Html.ActionLink(
    "Manage Municipal Assets",
   "Assets",
    "MunicipalProject",
    new { id = Model.ProjectID },
    new { @class = "btn-project-action" }
)

            @Html.ActionLink(
"Milestones",
"Milestones",
"MunicipalProject",
new { id = Model.ProjectID },
new { @class = "btn-project-action" }
)

            <a href="@Url.Action(
    "Progress",
    "MunicipalProject",
    new { id = Model.ProjectID })"
               class="btn-project-action">
                Project Progress
            </a>

            @Html.ActionLink(
    "Update Project Status",
    "UpdateStatus",
    "MunicipalProject",
    new { id = Model.ProjectID },
    new { @class = "btn-project-action btn-status-action" }
)


            @Html.ActionLink(
    "Record Project Evidence",
    "RecordEvidence",
    "MunicipalProject",
    new { id = Model.ProjectID },
    new { @class = "btn-project-action btn-evidence-action" }
)

            @Html.ActionLink(
          "Monitor Project Milestones",
          "MonitorMilestones",
          "MunicipalProject",
          new { id = Model.ProjectID },
          new { @class = "btn-project-action btn-milestone-monitor-action" }
      )
        </div>

    </div>


    <!-- ============================================================
         STATUS OVERVIEW
    ============================================================= -->

    <div class="project-status-panel">

        <div class="status-main">

            <div class="status-label">
                PROJECT STATUS
            </div>

            <span class="project-status-badge status-@Model.Status.ToLower()">
                @Model.Status
            </span>

        </div>


        <div class="status-item">

            <span class="status-item-label">
                Priority
            </span>

            <span class="priority-badge priority-@Model.Priority.ToLower()">
                @Model.Priority
            </span>

        </div>


        <div class="status-item">

            <span class="status-item-label">
                Project Type
            </span>

            <strong>
                @Model.ProjectType
            </strong>

        </div>


        <div class="status-item">

            <span class="status-item-label">
                Ward
            </span>

            <strong>
                @Model.WardName
            </strong>

        </div>

    </div>


    <!-- ============================================================
         ALERTS
    ============================================================= -->

    @if (Model.IsOverdue)
    {
        <div class="project-alert project-alert-warning">

            <div class="alert-icon">
                !
            </div>

            <div>

                <strong>
                    Project schedule requires attention
                </strong>

                <p>
                    The expected completion date has passed and the project
                    has not yet been marked as completed or cancelled.
                </p>

            </div>

        </div>
    }
    else if (Model.DaysRemaining.HasValue &&
             Model.DaysRemaining.Value >= 0 &&
             Model.Status != "Completed" &&
             Model.Status != "Cancelled")
    {
        <div class="project-alert project-alert-info">

            <div class="alert-icon">
                i
            </div>

            <div>

                <strong>
                    Project schedule
                </strong>

                <p>

                    @if (Model.DaysRemaining.Value == 0)
                    {
                        @:The expected completion date is today.
                    }
                    else if (Model.DaysRemaining.Value == 1)
                    {
                        @:1 day remains until the expected completion date.
                    }
                    else
                    {
                        @:@Model.DaysRemaining.Value days remain until the expected completion date.
                    }

                </p>

            </div>

        </div>
    }


    <!-- ============================================================
         PROJECT INFORMATION
    ============================================================= -->

    <section class="details-card">

        <div class="section-header">

            <div>

                <span class="section-number">
                    01
                </span>

                <div>

                    <h2>
                        Project Information
                    </h2>

                    <p>
                        General information about the municipal project.
                    </p>

                </div>

            </div>

        </div>


        <div class="details-grid">

            <div class="detail-item detail-item-wide">

                <span class="detail-label">
                    Project Name
                </span>

                <span class="detail-value detail-value-large">
                    @Model.ProjectName
                </span>

            </div>


            <div class="detail-item">

                <span class="detail-label">
                    Project Code
                </span>

                <span class="detail-value">
                    @Model.ProjectCode
                </span>

            </div>


            <div class="detail-item">

                <span class="detail-label">
                    Project Type
                </span>

                <span class="detail-value">
                    @Model.ProjectType
                </span>

            </div>


            <div class="detail-item detail-item-wide">

                <span class="detail-label">
                    Description
                </span>

                <span class="detail-value detail-description">

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        @Model.Description
                    }
                    else
                    {
                        <span class="muted-value">
                            No project description was provided.
                        </span>
                    }

                </span>

            </div>

        </div>

    </section>


    <!-- ============================================================
         PROJECT SCOPE
    ============================================================= -->

    <section class="details-card">

        <div class="section-header">

            <div>

                <span class="section-number">
                    02
                </span>

                <div>

                    <h2>
                        Project Scope
                    </h2>

                    <p>
                        Defined work, boundaries and intended coverage of the project.
                    </p>

                </div>

            </div>

        </div>


        <div class="project-scope-content">

            @if (!string.IsNullOrWhiteSpace(Model.ProjectScope))
            {
                <div class="project-scope-display">
                    @Model.ProjectScope
                </div>
            }
            else
            {
                <div class="project-scope-empty">

                    <strong>
                        Project scope has not yet been defined.
                    </strong>

                    <p>
                        Define the work and boundaries that will be covered
                        by this municipal project.
                    </p>

                    @Html.ActionLink(
                        "Define Project Scope",
                        "DefineScope",
                        "MunicipalProject",
                        new { id = Model.ProjectID },
                        new { @class = "btn-project-action scope-action-button" }
                    )

                </div>
            }

        </div>

    </section>


    <!-- ============================================================
         PROJECT LOCATION
    ============================================================= -->

    <section class="details-card project-location-card">

        <div class="section-header">

            <div>

                <span class="section-number">
                    03
                </span>

                <div>

                    <h2>
                        Project Location
                    </h2>

                    <p>
                        Registered project location and geographical reference.
                    </p>

                </div>

            </div>

        </div>


        <div class="location-information">

            <div class="location-details">

                <div class="detail-item location-detail-item">

                    <span class="detail-label">
                        Project Location
                    </span>

                    <span class="detail-value">
                        @Model.ProjectLocation
                    </span>

                </div>


                <div class="detail-item location-detail-item">

                    <span class="detail-label">
                        Municipal Ward
                    </span>

                    <span class="detail-value">
                        @Model.WardName
                    </span>

                </div>


                <div class="location-caption">

                    <span class="location-caption-title">
                        Registered geographical position
                    </span>

                    <span class="location-caption-text">
                        The map below represents the location selected when this project was registered.
                    </span>

                </div>

            </div>


            @if (mapLatitude.HasValue && mapLongitude.HasValue)
            {
                <div class="project-map-wrapper">

                    <div id="projectLocationMap"
                         class="project-location-map"
                         data-latitude="@mapLatitude.Value.ToString(
                             System.Globalization.CultureInfo.InvariantCulture)"
                         data-longitude="@mapLongitude.Value.ToString(
                             System.Globalization.CultureInfo.InvariantCulture)"
                         data-project="@Model.ProjectName">
                    </div>

                    <div class="map-footer">

                        <span>
                            Location reference
                        </span>

                        <strong>
                            @mapLatitude.Value.ToString("0.000000",
                                System.Globalization.CultureInfo.InvariantCulture),
                            @mapLongitude.Value.ToString("0.000000",
                                System.Globalization.CultureInfo.InvariantCulture)
                        </strong>

                    </div>

                </div>
            }
            else
            {
                <div class="project-map-unavailable">

                    <div class="map-unavailable-title">
                        Location coordinates unavailable
                    </div>

                    <div class="map-unavailable-text">
                        A map position was not recorded for this project.
                    </div>

                </div>
            }

        </div>

    </section>


    <!-- ============================================================
         SCHEDULE
    ============================================================= -->

    <section class="details-card">

        <div class="section-header">

            <div>

                <span class="section-number">
                    04
                </span>

                <div>

                    <h2>
                        Project Schedule
                    </h2>

                    <p>
                        Planned project commencement and completion dates.
                    </p>

                </div>

            </div>

        </div>


        <div class="schedule-grid">

            <div class="schedule-item">

                <div class="schedule-icon">
                    01
                </div>

                <div>

                    <span class="detail-label">
                        Start Date
                    </span>

                    <strong>
                        @Model.StartDate.ToString("dd MMMM yyyy")
                    </strong>

                </div>

            </div>


            <div class="schedule-line"></div>


            <div class="schedule-item">

                <div class="schedule-icon">
                    02
                </div>

                <div>

                    <span class="detail-label">
                        Expected Completion
                    </span>

                    @if (Model.ExpectedCompletionDate.HasValue)
                    {
                        <strong>
                            @Model.ExpectedCompletionDate.Value.ToString("dd MMMM yyyy")
                        </strong>
                    }
                    else
                    {
                        <strong class="muted-value">
                            Not specified
                        </strong>
                    }

                </div>

            </div>

        </div>

    </section>


    <!-- ============================================================
         FINANCIAL INFORMATION
    ============================================================= -->

    <section class="details-card">

        <div class="section-header">

            <div>

                <span class="section-number">
                    05
                </span>

                <div>

                    <h2>
                        Financial Information
                    </h2>

                    <p>
                        Registered estimated project budget.
                    </p>

                </div>

            </div>

        </div>


        <div class="budget-display">

            <span class="detail-label">
                Estimated Project Budget
            </span>

            @if (Model.EstimatedBudget.HasValue)
            {
                <strong>
                    R @Model.EstimatedBudget.Value.ToString("N2")
                </strong>
            }
            else
            {
                <strong class="muted-value">
                    Budget not specified
                </strong>
            }

        </div>

    </section>


    <!-- ============================================================
         RESPONSIBILITY
    ============================================================= -->

    <section class="details-card">

        <div class="section-header">

            <div>

                <span class="section-number">
                    06
                </span>

                <div>

                    <h2>
                        Project Responsibility
                    </h2>

                    <p>
                        Administrator responsible for the project.
                    </p>

                </div>

            </div>

        </div>


        <div class="administrator-card">

            <div class="administrator-avatar">

                @if (!string.IsNullOrWhiteSpace(Model.ResponsibleAdministratorName))
                {
                    @Model.ResponsibleAdministratorName.Substring(0, 1).ToUpper()
                }
                else
                {
                    @:A
                }

            </div>


            <div class="administrator-information">

                <span class="detail-label">
                    Responsible Administrator
                </span>

                <strong>
                    @Model.ResponsibleAdministratorName
                </strong>

                @if (!string.IsNullOrWhiteSpace(Model.ResponsibleAdministratorEmail))
                {
                    <span class="administrator-email">
                        @Model.ResponsibleAdministratorEmail
                    </span>
                }

            </div>

        </div>

    </section>


    <!-- ============================================================
         SYSTEM INFORMATION
    ============================================================= -->

    <section class="details-card">

        <div class="section-header">

            <div>

                <span class="section-number">
                    07
                </span>

                <div>

                    <h2>
                        System Information
                    </h2>

                    <p>
                        Project registration and audit information.
                    </p>

                </div>

            </div>

        </div>


        <div class="details-grid">

            <div class="detail-item">

                <span class="detail-label">
                    Date Registered
                </span>

                <span class="detail-value">
                    @Model.DateRegistered.ToString("dd MMMM yyyy HH:mm")
                </span>

            </div>


            <div class="detail-item">

                <span class="detail-label">
                    Registered By
                </span>

                <span class="detail-value">
                    @Model.CreatedByAdministratorName
                </span>

            </div>


            <div class="detail-item">

                <span class="detail-label">
                    Last Updated
                </span>

                <span class="detail-value">

                    @if (Model.LastUpdatedDate.HasValue)
                    {
                        @Model.LastUpdatedDate.Value.ToString("dd MMMM yyyy HH:mm")
                    }
                    else
                    {
                        <span class="muted-value">
                            No updates recorded
                        </span>
                    }

                </span>

            </div>


            <div class="detail-item">

                <span class="detail-label">
                    Updated By
                </span>

                <span class="detail-value">

                    @if (!string.IsNullOrWhiteSpace(Model.LastUpdatedByAdministratorName))
                    {
                        @Model.LastUpdatedByAdministratorName
                    }
                    else
                    {
                        <span class="muted-value">
                            No updates recorded
                        </span>
                    }

                </span>

            </div>

        </div>

    </section>


    <!-- ============================================================
         NAVIGATION
    ============================================================= -->

    <div class="project-details-footer">

        <div>

            @Html.ActionLink(
                "← Back to Projects",
                "Index",
                "MunicipalProject",
                null,
                new { @class = "btn-secondary" }
            )

        </div>


        <div class="footer-note">

            Project record:
            <strong>@Model.ProjectCode</strong>

        </div>

        @if (Model.Status == "InProgress")
        {
            @Html.ActionLink(
                "Complete Project",
                "CompleteProject",
                "MunicipalProject",
                new { id = Model.ProjectID },
                new
                {
                    @class =
                        "btn-project-action btn-complete-project-action"
                }
            )
        }

        @if (Model.Status == "Completed")
        {
            @Html.ActionLink(
                "Close Project",
                "CloseProject",
                "MunicipalProject",
                new { id = Model.ProjectID },
                new
                {
                    @class =
                        "btn-project-action btn-close-project-action"
                }
            )
        }


        @if (Model.Status == "Completed" ||
     Model.Status == "Closed")
        {
            @Html.ActionLink(
                "View Project History",
                "History",
                "MunicipalProject",
                new { id = Model.ProjectID },
                new
                {
                    @class = "btn-project-action btn-history-action"
                }
            )
        }
    </div>

</div>


<!-- ================================================================
     LEAFLET
================================================================ -->

<link rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIINfQ3Z8wKk9Q0jM1G1QYq6Q6Z2sK4K6w="
      crossorigin="" />

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin=""></script>


<style>

    /* ============================================================
       PAGE
    ============================================================ */

    .municipal-project-details-page {
        max-width: 1250px;
        margin: 0 auto;
        padding: 30px 25px 60px;
        font-family: Arial, Helvetica, sans-serif;
        color: #172033;
    }


   /* =========================================================
   HEADER
========================================================= */

.project-details-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 35px;
    row-gap: 18px;
    margin-bottom: 25px;
    padding: 4px 0;
}

.project-details-header-left {
    min-width: 0;
    width: 100%;
}

.project-details-eyebrow {
    margin-bottom: 7px;
    color: #0D5CC1;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    line-height: 1.3;
}

.project-details-header h1 {
    margin: 0;
    color: #14213D;
    font-size: 32px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -.35px;
    overflow-wrap: anywhere;
}

/* Project code and type stay together horizontally */
.project-code {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 9px;
    color: #0D5CC1;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: .45px;
    line-height: 1.4;
}

.project-code-separator {
    color: #AAB3C1;
    font-weight: 500;
}


/* =========================================================
   HEADER ACTIONS
========================================================= */

.project-details-header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 9px;
    max-width: 520px;
    flex-shrink: 0;
}

/* Prevent buttons from becoming unnecessarily narrow */
.project-details-header-actions .btn-secondary,
.project-details-header-actions .btn-project-action {
    flex: 0 0 auto;
}


/* =========================================================
   BUTTONS
========================================================= */

.btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 18px;
    border-radius: 7px;
    border: 1px solid #D6DCE5;
    background: #FFFFFF;
    color: #26364F;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    transition:
        background .2s ease,
        border-color .2s ease,
        color .2s ease,
        box-shadow .2s ease;
    white-space: nowrap;
}

.btn-secondary:hover {
    background: #F5F7FA;
    border-color: #BFC8D5;
    color: #0D5CC1;
    text-decoration: none;
}


.btn-project-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 18px;
    border: 1px solid #0D5CC1;
    border-radius: 7px;
    background: #FFFFFF;
    color: #0D5CC1 !important;
    font-size: 13px;
    font-weight: 800;
    text-decoration: none !important;
    white-space: nowrap;
    transition:
        background .2s ease,
        border-color .2s ease,
        color .2s ease,
        box-shadow .2s ease;
}

.btn-project-action:hover {
    background: #0D5CC1;
    border-color: #0D5CC1;
    color: #FFFFFF !important;
    text-decoration: none !important;
    box-shadow: 0 3px 7px rgba(13, 92, 193, .18);
}


/* =========================================================
   LARGE / MEDIUM DESKTOP
========================================================= */

@@media (max-width: 1150px) {

    .project-details-header {
        grid-template-columns: minmax(0, 1fr);
        align-items: flex-start;
        row-gap: 16px;
    }

    .project-details-header-actions {
        justify-content: flex-start;
        max-width: none;
        width: 100%;
    }
}


/* =========================================================
   MOBILE
========================================================= */

@@media (max-width: 650px) {

    .municipal-project-details-page {
        padding: 20px 15px 40px;
    }

    .project-details-header {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 16px;
        margin-bottom: 22px;
    }

    .project-details-header h1 {
        font-size: 25px;
        line-height: 1.25;
    }

    .project-code {
        font-size: 13px;
    }

    .project-details-header-actions {
        width: 100%;
        max-width: none;
        flex-direction: column;
        align-items: stretch;
    }

    .project-details-header-actions .btn-secondary,
    .project-details-header-actions .btn-project-action {
        width: 100%;
    }
}


    /* ============================================================
       BUTTONS
    ============================================================ */

    .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 18px;
        border-radius: 7px;
        border: 1px solid #D6DCE5;
        background: #FFFFFF;
        color: #26364F;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        transition: all .2s ease;
        white-space: nowrap;
    }

        .btn-secondary:hover {
            background: #F5F7FA;
            border-color: #BFC8D5;
            color: #0D5CC1;
            text-decoration: none;
        }


    .btn-project-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 18px;
        border: 1px solid #0D5CC1;
        border-radius: 7px;
        background: #FFFFFF;
        color: #0D5CC1 !important;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none !important;
        white-space: nowrap;
        transition: background .2s ease, border-color .2s ease, color .2s ease, box-shadow .2s ease;
    }

        .btn-project-action:hover {
            background: #0D5CC1;
            border-color: #0D5CC1;
            color: #FFFFFF !important;
            text-decoration: none !important;
            box-shadow: 0 3px 7px rgba(13, 92, 193, .18);
        }


    /* ============================================================
       STATUS PANEL
    ============================================================ */

    .project-status-panel {
        display: grid;
        grid-template-columns: 1.2fr 1fr 1.5fr 1.5fr;
        gap: 0;
        background: #FFFFFF;
        border: 1px solid #E1E6ED;
        border-radius: 12px;
        margin-bottom: 20px;
        overflow: hidden;
        box-shadow: 0 3px 12px rgba(22, 34, 51, .04);
    }

    .status-main,
    .status-item {
        padding: 20px 22px;
        border-right: 1px solid #E6EAF0;
    }

        .status-item:last-child {
            border-right: none;
        }

    .status-label,
    .status-item-label {
        display: block;
        margin-bottom: 8px;
        color: #7A8495;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .7px;
        text-transform: uppercase;
    }

    .status-item strong {
        display: block;
        font-size: 14px;
        color: #25334A;
    }


    /* ============================================================
       STATUS BADGES
    ============================================================ */

    .project-status-badge,
    .priority-badge {
        display: inline-flex;
        align-items: center;
        min-height: 30px;
