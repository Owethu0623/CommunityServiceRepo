<script>

    (function () {

        var description =
            document.querySelector(
                'textarea[name="milestone.Description"]'
            );

        var counter =
            document.getElementById(
                'milestoneDescriptionCounter'
            );


        if (description && counter) {

            function updateCounter() {

                counter.textContent =
                    description.value.length +
                    " / 2000";

            }

            description.addEventListener(
                "input",
                updateCounter
            );

            updateCounter();

        }


        var status =
            document.getElementById(
                "milestoneStatus"
            );

        var progress =
            document.getElementById(
                "milestoneProgress"
            );


        if (status && progress) {

            status.addEventListener(
                "change",
                function () {

                    if (status.value === "NotStarted") {
                        progress.value = 0;
                    }

                    if (status.value === "Completed") {
                        progress.value = 100;
                    }

                }
            );

        }


        var deleteForms =
            document.querySelectorAll(
                ".delete-milestone-form"
            );


        deleteForms.forEach(function (form) {

            form.addEventListener(
                "submit",
                function (event) {

                    var confirmed =
                        window.confirm(
                            "Are you sure you want to remove this milestone from the project?"
                        );

                    if (!confirmed) {
                        event.preventDefault();
                    }

                }
            );

        });

    })();


    function openEditMilestone(id) {

        var panel =
            document.getElementById(
                "editMilestone-" + id
            );

        if (panel) {
            panel.classList.add("open");
            panel.scrollIntoView({
                behavior: "smooth",
                block: "nearest"
            });
        }

    }


    function closeEditMilestone(id) {

        var panel =
            document.getElementById(
                "editMilestone-" + id
            );

        if (panel) {
            panel.classList.remove("open");
        }

    }

</script>