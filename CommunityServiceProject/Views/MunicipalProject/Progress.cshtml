<script>

    document.addEventListener("DOMContentLoaded", function () {

        /* =====================================================
           PROGRESS SLIDER / NUMBER INPUT
           ===================================================== */

        var slider =
            document.getElementById("progressSlider");

        var numberInput =
            document.getElementById("progressPercentageInput");

        if (slider && numberInput) {

            slider.addEventListener("input", function () {
                numberInput.value = slider.value;
            });

            numberInput.addEventListener("input", function () {

                var value =
                    parseInt(numberInput.value);

                if (isNaN(value)) {
                    return;
                }

                if (value < 0) {
                    value = 0;
                }

                if (value > 100) {
                    value = 100;
                }

                slider.value = value;
            });
        }


        /* =====================================================
           CHARACTER COUNTERS
           ===================================================== */

        function setupCounter(
            textareaId,
            counterId,
            maximum
        ) {

            var textarea =
                document.getElementById(textareaId);

            var counter =
                document.getElementById(counterId);

            if (!textarea || !counter) {
                return;
            }

            function updateCounter() {

                var length =
                    textarea.value.length;

                counter.textContent =
                    length + " / " + maximum;
            }

            textarea.addEventListener(
                "input",
                updateCounter
            );

            updateCounter();
        }


        setupCounter(
            "progressSummary",
            "progressSummaryCounter",
            4000
        );

        setupCounter(
            "currentActivity",
            "currentActivityCounter",
            1000
        );

        setupCounter(
            "nextPlannedActivity",
            "nextPlannedActivityCounter",
            2000
        );

        setupCounter(
            "issuesEncountered",
            "issuesCounter",
            2000
        );


        /* =====================================================
           FORM CONFIRMATION
           ===================================================== */

        var form =
            document.getElementById("recordProgressForm");

        if (form) {

            form.addEventListener(
                "submit",
                function (event) {

                    var progress =
                        document.getElementById(
                            "progressPercentageInput"
                        );

                    var progressValue =
                        progress
                            ? progress.value
                            : "";

                    var confirmed =
                        window.confirm(
                            "Are you sure you want to record this project progress update at "
                            + progressValue
                            + "%?"
                        );

                    if (!confirmed) {
                        event.preventDefault();
                    }
                }
            );
        }

    });

</script>