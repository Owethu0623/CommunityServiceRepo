</style>


<script>

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            var form =
                document.getElementById(
                    "recordEvidenceForm"
                );

            var fileInput =
                document.getElementById(
                    "EvidenceFile"
                );

            var selectedFileName =
                document.getElementById(
                    "selectedFileName"
                );

            var fileValidationMessage =
                document.getElementById(
                    "fileValidationMessage"
                );

            var description =
                document.getElementById(
                    "evidenceDescription"
                );

            var descriptionCounter =
                document.getElementById(
                    "descriptionCounter"
                );

            var openButton =
                document.getElementById(
                    "openEvidenceConfirmation"
                );

            var modal =
                document.getElementById(
                    "evidenceConfirmationModal"
                );

            var closeButton =
                document.getElementById(
                    "closeEvidenceConfirmation"
                );

            var cancelButton =
                document.getElementById(
                    "cancelEvidenceConfirmation"
                );

            var overlay =
                document.getElementById(
                    "evidenceModalOverlay"
                );

            var confirmButton =
                document.getElementById(
                    "confirmEvidence"
                );

            var titleInput =
                document.getElementById(
                    "Entry_EvidenceTitle"
                );

            var typeInput =
                document.getElementById(
                    "Entry_EvidenceType"
                );


            /* ========================================================
               DESCRIPTION COUNTER
            ======================================================== */

            function updateDescriptionCounter() {

                if (!description ||
                    !descriptionCounter)
                    return;

                descriptionCounter.textContent =
                    description.value.length
                    + " / 2000";

            }


            if (description) {

                description.addEventListener(
                    "input",
                    updateDescriptionCounter
                );

                updateDescriptionCounter();

            }


            /* ========================================================
               FILE DISPLAY
            ======================================================== */

            if (fileInput) {

                fileInput.addEventListener(
                    "change",
                    function () {

                        fileValidationMessage.textContent =
                            "";

                        if (!fileInput.files ||
                            fileInput.files.length === 0)
                        {
                            selectedFileName.textContent =
                                "No file selected.";

                            return;
                        }


                        var file =
                            fileInput.files[0];


                        selectedFileName.textContent =
                            "Selected file: "
                            + file.name;


                        var maxSize =
                            10 * 1024 * 1024;


                        if (file.size > maxSize) {

                            fileValidationMessage.textContent =
                                "The selected file exceeds the 10 MB limit.";

                            return;

                        }

                    }
                );

            }


            /* ========================================================
               OPEN MODAL
            ======================================================== */

            function openModal() {

                if (!modal)
                    return;


                if (!titleInput ||
                    titleInput.value.trim().length < 3)
                {
                    alert(
                        "Please enter an evidence title of at least 3 characters."
                    );

                    if (titleInput)
                        titleInput.focus();

                    return;
                }


                if (!typeInput ||
                    !typeInput.value)
                {
                    alert(
                        "Please select an evidence type."
                    );

                    if (typeInput)
                        typeInput.focus();

                    return;
                }


                if (!fileInput ||
                    !fileInput.files ||
                    fileInput.files.length === 0)
                {
                    alert(
                        "Please select an evidence file."
                    );

                    if (fileInput)
                        fileInput.click();

                    return;
                }


                var file =
                    fileInput.files[0];


                if (file.size >
                    10 * 1024 * 1024)
                {
                    alert(
                        "The selected file exceeds the 10 MB limit."
                    );

                    return;
                }


                document.getElementById(
                    "confirmEvidenceTitle"
                ).textContent =
                    titleInput.value.trim();


                document.getElementById(
                    "confirmEvidenceType"
                ).textContent =
                    typeInput.options[
                        typeInput.selectedIndex
                    ].text;


                document.getElementById(
                    "confirmEvidenceFile"
                ).textContent =
                    file.name;


                modal.classList.add(
                    "is-open"
                );

                modal.setAttribute(
                    "aria-hidden",
                    "false"
                );

                document.body.style.overflow =
                    "hidden";

            }


            /* ========================================================
               CLOSE MODAL
            ======================================================== */

            function closeModal() {

                if (!modal)
                    return;

                modal.classList.remove(
                    "is-open"
                );

                modal.setAttribute(
                    "aria-hidden",
                    "true"
                );

                document.body.style.overflow =
                    "";

            }


            if (openButton) {

                openButton.addEventListener(
                    "click",
                    openModal
                );

            }


            if (closeButton) {

                closeButton.addEventListener(
                    "click",
                    closeModal
                );

            }


            if (cancelButton) {

                cancelButton.addEventListener(
                    "click",
                    closeModal
                );

            }


            if (overlay) {

                overlay.addEventListener(
                    "click",
                    closeModal
                );

            }


            /* ========================================================
               ESCAPE
            ======================================================== */

            document.addEventListener(
                "keydown",
                function (event) {

                    if (
                        event.key === "Escape" &&
                        modal &&
                        modal.classList.contains(
                            "is-open"
                        )
                    ) {
                        closeModal();
                    }

                }
            );


            /* ========================================================
               FINAL SUBMIT
            ======================================================== */

            if (confirmButton) {

                confirmButton.addEventListener(
                    "click",
                    function () {

                        if (!form) {

                            alert(
                                "The evidence form could not be found. Please refresh the page and try again."
                            );

                            return;

                        }


                        confirmButton.disabled =
                            true;

                        confirmButton.textContent =
                            "Recording Evidence...";


                        form.submit();

                    }
                );

            }

        }
    );

</script>