<script>

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            var notes =
                document.getElementById("Notes");

            var counter =
                document.getElementById("notesCounter");

            if (notes && counter) {

                function updateCounter() {

                    counter.textContent =
                        notes.value.length;

                }

                notes.addEventListener(
                    "input",
                    updateCounter);

                updateCounter();
            }


            var linkForm =
                document.getElementById("linkRequestForm");

            var linkButton =
                document.getElementById("linkRequestButton");

            if (linkForm && linkButton) {

                linkForm.addEventListener(
                    "submit",
                    function (event) {

                        var request =
                            document.getElementById("RequestID");

                        var relationship =
                            document.getElementById("RelationshipType");

                        if (!request.value) {

                            event.preventDefault();

                            alert(
                                "Please select a service request before continuing."
                            );

                            request.focus();

                            return;
                        }

                        if (!relationship.value) {

                            event.preventDefault();

                            alert(
                                "Please select a relationship type before continuing."
                            );

                            relationship.focus();

                            return;
                        }

                        var confirmed =
                            window.confirm(
                                "Link this service request to the selected municipal project?"
                            );

                        if (!confirmed) {

                            event.preventDefault();

                            return;
                        }

                        linkButton.disabled = true;
                        linkButton.textContent = "Linking...";
                    });
            }


            var unlinkForms =
                document.querySelectorAll(".unlink-form");

            unlinkForms.forEach(
                function (form) {

                    form.addEventListener(
                        "submit",
                        function (event) {

                            var confirmed =
                                window.confirm(
                                    "Remove this service request from the project? The service request itself will not be deleted."
                                );

                            if (!confirmed) {
                                event.preventDefault();
                            }

                        });
                });
        });


    function selectRequest(requestID) {

        var requestSelect =
            document.getElementById("RequestID");

        if (!requestSelect) {
            return;
        }

        requestSelect.value =
            requestID;

        var form =
            document.getElementById("linkRequestForm");

        if (form) {

            form.scrollIntoView({
                behavior: "smooth",
                block: "start"
            });

        }

        requestSelect.focus();

    }

</script>