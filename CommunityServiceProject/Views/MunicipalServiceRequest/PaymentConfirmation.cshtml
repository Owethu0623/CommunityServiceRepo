@model CommunityServiceProject.ViewModels.PaymentConfirmationViewModel

@{
    ViewBag.Title = "Payment Submitted";
}

<div class="payment-confirmation-page">

    <!-- =========================================================
         HEADER
    ========================================================== -->

    <div class="confirmation-header">

        <div class="confirmation-eyebrow">
            MUNICIPAL PAYMENT
        </div>

        <h1>Payment Submitted</h1>

        <p>
            Your payment has been submitted successfully and is now
            awaiting Finance Officer verification.
        </p>

    </div>


    <!-- =========================================================
         PROCESSING STATUS
    ========================================================== -->

    <div class="processing-banner">

        <div class="processing-icon">
            <span></span>
        </div>

        <div class="processing-content">

            <strong>
                Payment Awaiting Verification
            </strong>

            <p>
                Your payment and proof of payment have been received.
                The payment will remain in processing until it is
                reviewed and verified by the municipality.
            </p>

        </div>

        <div class="processing-status">
            Processing
        </div>

    </div>


    <!-- =========================================================
         SUCCESS MESSAGE
    ========================================================== -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="confirmation-alert">

            <div class="alert-icon">
                ✓
            </div>

            <div>
                <strong>
                    Submission Received
                </strong>

                <span>
                    @TempData["SuccessMessage"]
                </span>
            </div>

        </div>
    }


    <!-- =========================================================
         PAYMENT SUMMARY
    ========================================================== -->

    <div class="confirmation-card">

        <div class="confirmation-card-header">

            <div>

                <span class="section-label">
                    TRANSACTION DETAILS
                </span>

                <h2>Payment Information</h2>

            </div>

            <div class="card-reference">
                @Model.TransactionReference
            </div>

        </div>


        <div class="payment-details-grid">

            <div class="payment-detail">

                <span>
                    Transaction Reference
                </span>

                <strong>
                    @Model.TransactionReference
                </strong>

            </div>


            <div class="payment-detail">

                <span>
                    Invoice Number
                </span>

                <strong>
                    @Model.InvoiceNumber
                </strong>

            </div>


            <div class="payment-detail">

                <span>
                    Amount Submitted
                </span>

                <strong class="payment-amount">
                    R @Model.Amount.ToString("N2")
                </strong>

            </div>


            <div class="payment-detail">

                <span>
                    Payment Method
                </span>

                <strong>
                    @Model.PaymentMethod
                </strong>

            </div>


            <div class="payment-detail">

                <span>
                    Payment Date
                </span>

                <strong>
                    @Model.PaymentDate.ToString("dd MMM yyyy, HH:mm")
                </strong>

            </div>


            <div class="payment-detail">

                <span>
                    Payment Status
                </span>

                <strong>
                    <span class="processing-pill">
                        Processing
                    </span>
                </strong>

            </div>


            <div class="payment-detail">

                <span>
                    Proof of Payment
                </span>

                <strong>

                    @if (Model.HasProofOfPayment)
                    {
                        <span class="proof-submitted">
                            ✓ Submitted
                        </span>
                    }
                    else
                    {
                        <span class="proof-missing">
                            Not Submitted
                        </span>
                    }

                </strong>

            </div>

        </div>

    </div>


    <!-- =========================================================
         MUNICIPAL SERVICE INFORMATION
    ========================================================== -->

    <div class="confirmation-card">

        <div class="confirmation-card-header">

            <div>

                <span class="section-label">
                    MUNICIPAL SERVICE
                </span>

                <h2>Service Information</h2>

            </div>

        </div>


        <div class="service-details">

            <div class="service-detail">

                <span>
                    Service
                </span>

                <strong>
                    @Model.ServiceName
                </strong>

            </div>


            <div class="service-detail">

                <span>
                    Request Reference
                </span>

                <strong>
                    @Model.RequestReference
                </strong>

            </div>


            <div class="service-detail">

                <span>
                    Invoice
                </span>

                <strong>
                    @Model.InvoiceNumber
                </strong>

            </div>

        </div>

    </div>


    <!-- =========================================================
         IMPORTANT INFORMATION
    ========================================================== -->

    <div class="verification-notice">

        <div class="notice-icon">
            i
        </div>

        <div class="notice-content">

            <strong>
                What happens next?
            </strong>

            <p>
                A Finance Officer will review your payment and proof
                of payment. Your payment status will remain
                <strong>Processing</strong> until the municipality
                completes the verification.
            </p>

            <p>
                Uploading proof of payment does not mean that the
                payment has already been verified or accepted.
            </p>

        </div>

    </div>


    <!-- =========================================================
         NAVIGATION
    ========================================================== -->

    <div class="confirmation-actions">

        <a href="@Url.Action(
            "PaymentStatus",
            "MunicipalServiceRequest",
            new
            {
                id = Model.MunicipalServiceRequestID
            })"
           class="primary-action">

            View Payment Status

        </a>


        <a href="@Url.Action(
            "Details",
            "MunicipalServiceRequest",
            new
            {
                id = Model.MunicipalServiceRequestID
            })"
           class="secondary-action">

            Back to Request Details

        </a>


        <a href="@Url.Action(
            "Index",
            "MunicipalServices")"
           class="text-action">

            Back to Municipal Services

        </a>

    </div>

</div>


<style>

    /* =========================================================
       PAGE
    ========================================================== */

    .payment-confirmation-page {
        max-width: 1050px;
        margin: 0 auto;
        padding: 40px 25px 70px;
    }


    /* =========================================================
       HEADER
    ========================================================== */

    .confirmation-header {
        margin-bottom: 25px;
    }

    .confirmation-eyebrow {
        margin-bottom: 8px;
        color: #0D5CC1;
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 1.2px;
    }

    .confirmation-header h1 {
        margin: 0 0 8px;
        color: #172033;
        font-size: 32px;
        font-weight: 800;
    }

    .confirmation-header p {
        max-width: 720px;
        margin: 0;
        color: #687386;
        font-size: 15px;
        line-height: 1.6;
    }


    /* =========================================================
       PROCESSING BANNER
    ========================================================== */

    .processing-banner {
        display: flex;
        align-items: center;
        gap: 17px;
        padding: 20px 22px;
        margin-bottom: 20px;
        background: #fff9e8;
        border: 1px solid #efd88e;
        border-radius: 13px;
    }

    .processing-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #fff1bd;
    }

    .processing-icon span {
        width: 17px;
        height: 17px;
        border: 3px solid #c88a00;
        border-top-color: transparent;
        border-radius: 50%;
        animation: payment-spin 1s linear infinite;
    }

    @@keyframes payment-spin {
        to {
            transform: rotate(360deg);
        }
    }

    .processing-content {
        flex: 1;
    }

    .processing-content strong {
        display: block;
        margin-bottom: 4px;
        color: #704900;
        font-size: 15px;
        font-weight: 800;
    }

    .processing-content p {
        margin: 0;
        color: #80652f;
        font-size: 13px;
        line-height: 1.55;
    }

    .processing-status {
        padding: 7px 11px;
        border: 1px solid #e6ca73;
        border-radius: 7px;
        background: #fff4cd;
        color: #805600;
        font-size: 12px;
        font-weight: 800;
        white-space: nowrap;
    }


    /* =========================================================
       ALERT
    ========================================================== */

    .confirmation-alert {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 17px;
        margin-bottom: 20px;
        border: 1px solid #b7e1c5;
        border-radius: 9px;
        background: #eaf7ef;
    }

    .alert-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 25px;
        height: 25px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #18794e;
        color: #ffffff;
        font-size: 13px;
        font-weight: 900;
    }

    .confirmation-alert strong,
    .confirmation-alert span {
        display: block;
    }

    .confirmation-alert strong {
        margin-bottom: 2px;
        color: #176b46;
        font-size: 13px;
    }

    .confirmation-alert span {
        color: #317356;
        font-size: 13px;
    }


    /* =========================================================
       CARD
    ========================================================== */

    .confirmation-card {
        margin-bottom: 20px;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #dfe5ed;
        border-radius: 14px;
    }

    .confirmation-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        padding: 22px 24px;
        border-bottom: 1px solid #e8edf3;
    }

    .section-label {
        display: block;
        margin-bottom: 5px;
        color: #0D5CC1;
        font-size: 10px;
        font-weight: 900;
        letter-spacing: 1px;
    }

    .confirmation-card-header h2 {
        margin: 0;
        color: #172033;
        font-size: 19px;
        font-weight: 800;
    }

    .card-reference {
        padding: 7px 11px;
        border: 1px solid #d8e3f2;
        border-radius: 7px;
        background: #f5f8fc;
        color: #0D5CC1;
        font-family: monospace;
        font-size: 12px;
        font-weight: 700;
    }


    /* =========================================================
       PAYMENT DETAILS
    ========================================================== */

    .payment-details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .payment-detail {
        padding: 19px 24px;
        border-bottom: 1px solid #edf0f4;
    }

    .payment-detail:nth-child(odd) {
        border-right: 1px solid #edf0f4;
    }

    .payment-detail span:first-child {
        display: block;
        margin-bottom: 6px;
        color: #748094;
        font-size: 12px;
        font-weight: 600;
    }

    .payment-detail strong {
        display: block;
        color: #253044;
        font-size: 14px;
        font-weight: 700;
    }

    .payment-amount {
        color: #0D5CC1 !important;
        font-size: 18px !important;
    }

    .processing-pill {
        display: inline-flex !important;
        width: fit-content;
        padding: 6px 10px;
        border: 1px solid #efd88e;
        border-radius: 7px;
        background: #fff7df;
        color: #8a5a00 !important;
        font-size: 12px !important;
        font-weight: 800 !important;
    }

    .proof-submitted {
        display: inline-flex !important;
        width: fit-content;
        padding: 6px 10px;
        border: 1px solid #b7e1c5;
        border-radius: 7px;
        background: #eaf7ef;
        color: #18794e !important;
        font-size: 12px !important;
        font-weight: 800 !important;
    }

    .proof-missing {
        display: inline-flex !important;
        width: fit-content;
        padding: 6px 10px;
        border: 1px solid #f1b8b8;
        border-radius: 7px;
        background: #fef0f0;
        color: #b42318 !important;
        font-size: 12px !important;
        font-weight: 800 !important;
    }


    /* =========================================================
       SERVICE DETAILS
    ========================================================== */

    .service-details {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
    }

    .service-detail {
        padding: 20px 24px;
        border-right: 1px solid #edf0f4;
    }

    .service-detail:last-child {
        border-right: none;
    }

    .service-detail span,
    .service-detail strong {
        display: block;
    }

    .service-detail span {
        margin-bottom: 6px;
        color: #748094;
        font-size: 12px;
        font-weight: 600;
    }

    .service-detail strong {
        color: #253044;
        font-size: 14px;
    }


    /* =========================================================
       VERIFICATION NOTICE
    ========================================================== */

    .verification-notice {
        display: flex;
        gap: 14px;
        padding: 20px;
        margin-bottom: 24px;
        border: 1px solid #d5e2f3;
        border-radius: 12px;
        background: #f5f9fe;
    }

    .notice-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #dceafd;
        color: #0D5CC1;
        font-weight: 900;
    }

    .notice-content strong {
        display: block;
        margin-bottom: 6px;
        color: #1f3e68;
        font-size: 14px;
    }

    .notice-content p {
        margin: 0 0 7px;
        color: #58708e;
        font-size: 13px;
        line-height: 1.6;
    }

    .notice-content p:last-child {
        margin-bottom: 0;
    }


    /* =========================================================
       NAVIGATION
    ========================================================== */

    .confirmation-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .primary-action,
    .secondary-action,
    .text-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 17px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 800;
    }

    .primary-action {
        border: 1px solid #0D5CC1;
        background: #0D5CC1;
        color: #ffffff !important;
    }

    .primary-action:hover {
        background: #084b9f;
        text-decoration: none;
    }

    .secondary-action {
        border: 1px solid #d7dee8;
        background: #ffffff;
        color: #536074 !important;
    }

    .secondary-action:hover {
        background: #f7f9fc;
        text-decoration: none;
    }

    .text-action {
        color: #0D5CC1 !important;
    }

    .text-action:hover {
        text-decoration: underline;
    }


    /* =========================================================
       RESPONSIVE
    ========================================================== */

    @@media (max-width: 750px) {

        .payment-confirmation-page {
            padding: 28px 15px 50px;
        }

        .confirmation-header h1 {
            font-size: 27px;
        }

        .processing-banner {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .processing-content {
            min-width: 200px;
        }

        .processing-status {
            margin-left: 65px;
        }

        .payment-details-grid {
            grid-template-columns: 1fr;
        }

        .payment-detail:nth-child(odd) {
            border-right: none;
        }

        .service-details {
            grid-template-columns: 1fr;
        }

        .service-detail {
            border-right: none;
            border-bottom: 1px solid #edf0f4;
        }

        .service-detail:last-child {
            border-bottom: none;
        }

        .confirmation-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .confirmation-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .primary-action,
        .secondary-action,
        .text-action {
            width: 100%;
            box-sizing: border-box;
        }

    }

</style>