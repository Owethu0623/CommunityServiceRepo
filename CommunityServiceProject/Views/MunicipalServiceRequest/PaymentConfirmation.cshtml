@model CommunityServiceProject.ViewModels.PaymentConfirmationViewModel

@{
    ViewBag.Title = "Payment Submitted";
}

<style>
    .payment-confirmation-page {
        max-width: 1050px;
        margin: 40px auto;
        padding: 0 20px 50px;
    }

    .payment-confirmation-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .payment-submitted-icon {
        width: 82px;
        height: 82px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: #fff7e6;
        border: 1px solid #f1d48a;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #b7791f;
        font-size: 38px;
        font-weight: 700;
    }

    .payment-confirmation-header h1 {
        margin: 0 0 10px;
        font-size: 32px;
        color: #172033;
        font-weight: 700;
    }

    .payment-confirmation-header p {
        margin: 0 auto;
        max-width: 680px;
        color: #667085;
        font-size: 16px;
        line-height: 1.6;
    }

    .payment-processing-banner {
        background: #f4f8ff;
        border: 1px solid #c9dcff;
        border-radius: 12px;
        padding: 18px 22px;
        margin-bottom: 25px;
        display: flex;
        align-items: flex-start;
        gap: 14px;
    }

    .processing-icon {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #0d5cc1;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        flex-shrink: 0;
    }

    .processing-content strong {
        display: block;
        color: #17365d;
        font-size: 16px;
        margin-bottom: 4px;
    }

    .processing-content span {
        color: #5d6b82;
        font-size: 14px;
        line-height: 1.5;
    }

    .payment-confirmation-card {
        background: #ffffff;
        border: 1px solid #e4e7ec;
        border-radius: 16px;
        box-shadow: 0 8px 25px rgba(16, 24, 40, 0.07);
        overflow: hidden;
    }

    .confirmation-card-header {
        padding: 22px 28px;
        border-bottom: 1px solid #eaecf0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

        .confirmation-card-header h2 {
            margin: 0;
            color: #172033;
            font-size: 20px;
            font-weight: 700;
        }

    .processing-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 14px;
        border-radius: 20px;
        background: #fff7e6;
        color: #9a6700;
        border: 1px solid #f1d48a;
        font-size: 13px;
        font-weight: 700;
    }

    .processing-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #d99a00;
    }

    .payment-amount-section {
        padding: 30px 28px;
        background: #f8fafc;
        border-bottom: 1px solid #eaecf0;
        text-align: center;
    }

    .payment-amount-label {
        color: #667085;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .payment-amount {
        color: #172033;
        font-size: 38px;
        font-weight: 800;
        margin: 0;
    }

    .payment-details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .payment-detail {
        padding: 20px 28px;
        border-bottom: 1px solid #eaecf0;
    }

        .payment-detail:nth-child(odd) {
            border-right: 1px solid #eaecf0;
        }

    .payment-detail-label {
        color: #667085;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .payment-detail-value {
        color: #172033;
        font-size: 15px;
        font-weight: 600;
        word-break: break-word;
    }

    .payment-method-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 11px;
        background: #eef4ff;
        border: 1px solid #cbdcff;
        color: #0d5cc1;
        border-radius: 7px;
        font-size: 13px;
        font-weight: 700;
    }

    .pop-submitted {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 11px;
        background: #eaf7ef;
        border: 1px solid #b7e1c5;
        color: #18794e;
        border-radius: 7px;
        font-size: 13px;
        font-weight: 700;
    }

    .service-section {
        padding: 25px 28px;
        border-bottom: 1px solid #eaecf0;
    }

        .service-section h3 {
            margin: 0 0 18px;
            color: #172033;
            font-size: 17px;
            font-weight: 700;
        }

    .service-info {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px 30px;
    }

    .service-info-item span {
        display: block;
    }

    .service-info-label {
        color: #667085;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .service-info-value {
        color: #172033;
        font-size: 15px;
        font-weight: 600;
    }

    .confirmation-note {
        margin: 25px 28px;
        padding: 18px 20px;
        border-radius: 10px;
        background: #fafafa;
        border: 1px solid #e4e7ec;
        color: #5d6b82
    }
</style>
