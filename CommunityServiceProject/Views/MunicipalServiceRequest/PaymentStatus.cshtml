@model CommunityServiceProject.ViewModels.PaymentStatusViewModel

@{
    ViewBag.Title = "Payment Status";

    var statusClass =
        Model.PaymentStatus == "Successful"
            ? "status-successful"
            : Model.PaymentStatus == "Failed"
                ? "status-failed"
                : "status-processing";

    var statusTitle =
        Model.PaymentStatus == "Successful"
            ? "Payment Successful"
            : Model.PaymentStatus == "Failed"
                ? "Payment Failed"
                : "Payment Processing";

    var statusMessage =
        Model.PaymentStatus == "Successful"
            ? "Your payment has been successfully processed."
            : Model.PaymentStatus == "Failed"
                ? "Your payment could not be processed. You may try the payment again."
                : "Your payment has been submitted and is currently being processed.";
}

<style>
    .payment-status-page {
        max-width: 1050px;
        margin: 40px auto;
        padding: 0 20px 50px;
    }

    .payment-status-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .payment-status-icon {
        width: 82px;
        height: 82px;
        margin: 0 auto 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
        font-weight: 700;
    }

    .status-processing .payment-status-icon {
        background: #fff7e6;
        border: 1px solid #f1d48a;
        color: #b7791f;
    }

    .status-successful .payment-status-icon {
        background: #eaf7ef;
        border: 1px solid #b7e1c5;
        color: #198754;
    }

    .status-failed .payment-status-icon {
        background: #fef0f0;
        border: 1px solid #f1b8b8;
        color: #b42318;
    }

    .payment-status-header h1 {
        margin: 0 0 10px;
        color: #172033;
        font-size: 32px;
        font-weight: 700;
    }

    .payment-status-header p {
        max-width: 680px;
        margin: 0 auto;
        color: #667085;
        font-size: 16px;
        line-height: 1.6;
    }

    .payment-status-card {
        background: #ffffff;
        border: 1px solid #e4e7ec;
        border-radius: 16px;
        box-shadow: 0 8px 25px rgba(16, 24, 40, 0.07);
        overflow: hidden;
    }

    .payment-status-card-header {
        padding: 22px 28px;
        border-bottom: 1px solid #eaecf0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

        .payment-status-card-header h2 {
            margin: 0;
            color: #172033;
            font-size: 20px;
            font-weight: 700;
        }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
    }

    .status-processing .status-badge {
        background: #fff7e6;
        color: #9a6700;
        border: 1px solid #f1d48a;
    }

    .status-successful .status-badge {
        background: #eaf7ef;
        color: #18794e;
        border: 1px solid #b7e1c5;
    }

    .status-failed .status-badge {
        background: #fef0f0;
        color: #b42318;
        border: 1px solid #f1b8b8;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }

    .status-processing .status-dot {
        background: #d99a00;
    }

    .status-successful .status-dot {
        background: #198754;
    }

    .status-failed .status-dot {
        background: #b42318;
    }

    .payment-status-summary {
        padding: 30px 28px;
        background: #f8fafc;
        border-bottom: 1px solid #eaecf0;
        text-align: center;
    }

    .summary-label {
        color: #667085;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .summary-amount {
        color: #172033;
        font-size: 38px;
        font-weight: 800;
        margin: 0 0 10px;
    }

    .summary-status {
        color: #667085;
        font-size: 14px;
    }

    .payment-details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .payment-detail {
        padding: 20px 28px;
        border-bottom: 1px solid #eaecf0;
    }

        .payment-detail:nth-child(odd) {
            border-right: 1px solid #eaecf0;
        }

    .payment-detail-label {
        color: #667085;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .payment-detail-value {
        color: #172033;
        font-size: 15px;
        font-weight: 600;
        word-break: break-word;
    }

    .payment-method {
        display: inline-flex;
        padding: 6px 11px;
        border-radius: 7px;
        background: #eef4ff;
        border: 1px solid #cbdcff;
        color: #0d5cc1;
        font-size: 13px;
        font-weight: 700;
    }
    .pop-submitted {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 11px;
        background: #eaf7ef;
        border: 1px solid #b7e1c5;
        color: #18794e;
        border-radius: 7px;
        font-size: 13px;
        font-weight: 700;
    }

    .pop-not-submitted {
        display: inline-flex;
        align-items: center;
        padding: 6px 11px;
        background: #fef0f0;
        border: 1px solid #f1b8b8;
        color: #b42318;
        border-radius: 7px;
        font-size: 13px;
        font-weight: 700;
    }
    .service-section {
        padding: 25px 28px;
        border-bottom: 1px solid #eaecf0;
    }

        .service-section h3 {
            margin: 0 0 18px;
            color: #172033;
            font-size: 17px;
            font-weight: 700;
        }

    .service-info {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px 30px;
    }

    .service-label {
        color: #667085;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .service-value {
        color: #172033;
        font-size: 15px;
        font-weight: 600;
    }

    .payment-message {
        margin: 25px 28px;
        padding: 18px 20px;
        border-radius: 10px;
        background: #fafafa;
        border: 1px solid #e4e7ec;
        color: #5d6b82;
        font-size: 14px;
        line-height: 1.6;
    }

    .failure-message {
        margin: 25px 28px;
        padding: 18px 20px;
        border-radius: 10px;
        background: #fef0f0;
        border: 1px solid #f1b8b8;
        color: #8f1d1d;
        font-size: 14px;
        line-height: 1.6;
    }

    .payment-actions {
        padding: 22px 28px;
        display: flex;
        justify-content: center;
        gap: 12px;
        border-top: 1px solid #eaecf0;
    }

    .payment-action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 210px;
        padding: 12px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 700;
        transition: all 0.2s ease;
    }

        .payment-action-button.primary {
            background: #0d5cc1;
            color: #ffffff;
            border: 1px solid #0d5cc1;
        }

            .payment-action-button.primary:hover {
                background: #094a9f;
                border-color: #094a9f;
                color: #ffffff;
                text-decoration: none;
            }

        .payment-action-button.secondary {
            background: #ffffff;
            color: #344054;
            border: 1px solid #d0d5dd;
        }

            .payment-action-button.secondary:hover {
                background: #f8fafc;
                text-decoration: none;
            }

    .payment-status-footer {
        text-align: center;
        margin-top: 20px;
        color: #98a2b3;
        font-size: 12px;
        line-height: 1.5;
    }

    @@media (max-width: 700px) {

        .payment-status-page {
            margin-top: 25px;
        }

        .payment-status-header h1 {
            font-size: 26px;
        }

        .payment-status-card-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .payment-details-grid,
        .service-info {
            grid-template-columns: 1fr;
        }

        .payment-detail:nth-child(odd) {
            border-right: none;
        }

        .payment-actions {
            flex-direction: column;
        }

        .payment-action-button {
            width: 100%;
        }
    }
</style>

<div class="payment-status-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="payment-status-header @statusClass">

        <div class="payment-status-icon">

            @if (Model.PaymentStatus == "Successful")
            {
                @:✓
            }
            else if (Model.PaymentStatus == "Failed")
            {
                @:!
            }
            else
            {
                @:⏳
            }

        </div>

        <h1>
            @statusTitle
        </h1>

        <p>
            @statusMessage
        </p>

    </div>


    <!-- =========================================================
         PAYMENT CARD
         ========================================================= -->

    <div class="payment-status-card">

        <div class="payment-status-card-header">

            <h2>
                Payment Details
            </h2>

            <span class="status-badge">

                <span class="status-dot"></span>

                @Model.PaymentStatus

            </span>

        </div>


        <!-- =====================================================
             AMOUNT
             ===================================================== -->

        <div class="payment-status-summary">

            <div class="summary-label">
                Payment Amount
            </div>

            <div class="summary-amount">
                R @Model.Amount.ToString("N2")
            </div>

            <div class="summary-status">
                Transaction: @Model.TransactionReference
            </div>

        </div>


        <!-- =====================================================
             PAYMENT INFORMATION
             ===================================================== -->

        <div class="payment-details-grid">

            <div class="payment-detail">

                <div class="payment-detail-label">
                    Transaction Reference
                </div>

                <div class="payment-detail-value">
                    @Model.TransactionReference
                </div>

            </div>

            <div class="payment-detail">

                <div class="payment-detail-label">
                    Invoice Number
                </div>

                <div class="payment-detail-value">
                    @Model.InvoiceNumber
                </div>

            </div>

            <div class="payment-detail">

                <div class="payment-detail-label">
                    Payment Method
                </div>

                <div class="payment-detail-value">

                    <span class="payment-method">
                        @Model.PaymentMethod
                    </span>

                </div>

            </div>

            <div class="payment-detail">

                <div class="payment-detail-label">
                    Proof of Payment
                </div>

                <div class="payment-detail-value">

                    @if (Model.HasProofOfPayment)
                    {
                        <span class="pop-submitted">
                            ✓ Submitted
                        </span>
                    }
                    else
                    {
                        <span class="pop-not-submitted">
                            Not Submitted
                        </span>
                    }

                </div>

            </div>
            <div class="payment-detail">

                <div class="payment-detail-label">
                    Payment Date
                </div>

                <div class="payment-detail-value">
                    @Model.PaymentDate.ToString("dd MMM yyyy, HH:mm")
                </div>

            </div>

            @if (Model.ProcessedDate.HasValue)
            {
                <div class="payment-detail">

                    <div class="payment-detail-label">
                        Processed Date
                    </div>

                    <div class="payment-detail-value">
                        @Model.ProcessedDate.Value.ToString("dd MMM yyyy, HH:mm")
                    </div>

                </div>
            }

        </div>


        <!-- =====================================================
             SERVICE INFORMATION
             ===================================================== -->

        <div class="service-section">

            <h3>
                Municipal Service
            </h3>

            <div class="service-info">

                <div>

                    <div class="service-label">
                        Service
                    </div>

                    <div class="service-value">
                        @Model.ServiceName
                    </div>

                </div>

                <div>

                    <div class="service-label">
                        Request Reference
                    </div>

                    <div class="service-value">
                        @Model.RequestReference
                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             PROCESSING / FAILURE MESSAGE
             ===================================================== -->

        @if (Model.PaymentStatus == "Failed")
        {
            <div class="failure-message">

                <strong>
                    Payment could not be completed.
                </strong>

                @if (!string.IsNullOrWhiteSpace(Model.FailureReason))
                {
                    <br />
                    @Model.FailureReason
                }

                <br /><br />

                You can return to the request and try the payment again.

            </div>
        }
        else
        {
            <div class="payment-message">

                <strong>
                    Payment information:
                </strong>

                Your payment is currently recorded as
                <strong>@Model.PaymentStatus</strong>.
                Payment completion will be reflected here once the
                payment has been processed and verified.

            </div>
        }


        <!-- =====================================================
             NAVIGATION
             ===================================================== -->

        <div class="payment-actions">

            <a href="@Url.Action("Details", "MunicipalServiceRequest", new { id = Model.MunicipalServiceRequestID })"
               class="payment-action-button primary">
                ← Back to Request Details
            </a>

            @if (Model.PaymentStatus == "Failed")
            {
                <a href="@Url.Action("MakePayment", "MunicipalServiceRequest", new { id = Model.MunicipalServiceRequestID })"
                   class="payment-action-button secondary">
                    Make Payment Again
                </a>
            }

        </div>

    </div>


    <div class="payment-status-footer">

        Keep your transaction reference
        <strong>@Model.TransactionReference</strong>
        for your records.

    </div>

</div>