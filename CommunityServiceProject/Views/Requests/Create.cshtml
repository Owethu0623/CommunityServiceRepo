@model CommunityServiceProject.Models.Request

@{
    ViewBag.Title = "Submit Maintenance Request";
}

<div class="request-page">

    <div class="request-card">

        <div class="request-title">

            <span class="request-icon"></span>

            <h2>SUBMIT MAINTENANCE REQUEST</h2>

        </div>


        @using (Html.BeginForm(
            "Create",
            "Requests",
            FormMethod.Post,
            new
            {
                enctype = "multipart/form-data",
                id = "requestForm"
            }))
        {
            @Html.AntiForgeryToken()


            @Html.ValidationSummary(
                true,
                "",
                new { @class = "text-danger" }
            )


            <!-- ================================================= -->
            <!-- REQUEST TITLE -->
            <!-- ================================================= -->

            <div class="request-form-group">

                @Html.LabelFor(
                    model => model.Title,
                    "Request Title"
                )

                @Html.TextBoxFor(
                    model => model.Title,
                    new
                    {
                        @class = "request-input",
                        placeholder = "e.g. Broken streetlight"
                    }
                )

                @Html.ValidationMessageFor(
                    model => model.Title,
                    "",
                    new { @class = "text-danger" }
                )

            </div>


            <!-- ================================================= -->
            <!-- CATEGORY -->
            <!-- ================================================= -->

            <div class="request-form-group">

                @Html.LabelFor(
                    model => model.CategoryID,
                    "Category"
                )

                @Html.DropDownList(
                    "CategoryID",
                    ViewBag.CategoryID as SelectList,
                    "Select Category",
                    new
                    {
                        @class = "request-input",
                        id = "CategoryID"
                    }
                )

                <div class="category-examples">

                    <strong>Examples:</strong>

                    <ul>

                        <li>Pothole</li>

                        <li>Water Leak</li>

                        <li>Broken Streetlight</li>

                        <li>Illegal Dumping</li>

                        <li>Exposed OR Damaged Electrical Wires</li>

                        <li>Damaged Sidewalk</li>

                        <li>Sewer Overflow</li>

                        <li>Damaged Traffic Sign</li>

                        <li>Overflowing Municipal Bin</li>

                        <li>Other</li>

                    </ul>

                </div>

                @Html.ValidationMessageFor(
                    model => model.CategoryID,
                    "",
                    new { @class = "text-danger" }
                )

            </div>


            <!-- ================================================= -->
            <!-- WARD -->
            <!-- ================================================= -->

            <div class="request-form-group">

                @Html.LabelFor(
                    model => model.WardID,
                    "Ward"
                )

                @Html.DropDownList(
                    "WardID",
                    ViewBag.WardID as SelectList,
                    "Select Ward",
                    new
                    {
                        @class = "request-input",
                        id = "WardID"
                    }
                )

                @Html.ValidationMessageFor(
                    model => model.WardID,
                    "",
                    new { @class = "text-danger" }
                )

            </div>


            <!-- ================================================= -->
            <!-- DESCRIPTION -->
            <!-- ================================================= -->

            <div class="request-form-group">

                @Html.LabelFor(
                    model => model.Description
                )

                @Html.TextAreaFor(
                    model => model.Description,
                    new
                    {
                        @class = "request-textarea",
                        rows = "4",
                        placeholder = "Describe the problem"
                    }
                )

                @Html.ValidationMessageFor(
                    model => model.Description,
                    "",
                    new { @class = "text-danger" }
                )

            </div>


            <!-- ================================================= -->
            <!-- PROBLEM LOCATION -->
            <!-- ================================================= -->

    <div class="request-location-section">

        <div class="request-location-heading">

            <div class="gps-icon">
                📍
            </div>

            <div>

                <strong>
                    Problem Location
                </strong>

                <p>
                    Search for an address or select the exact
                    problem location on the map.
                </p>

            </div>

        </div>


        <!-- ADDRESS SEARCH -->

        <div class="map-search-container">

            <input type="text"
                   id="addressSearch"
                   class="request-input"
                   placeholder="Enter an address, e.g. 293 Cedar Street, Durban" />


            <button type="button"
                    id="searchAddress"
                    class="location-button">

                🔍 Search Address

            </button>

        </div>


        <!-- SEARCH STATUS -->

        <div id="addressSearchStatus"
             class="map-search-status">
        </div>


        <!-- MAP -->

        <div id="problemMap"></div>


        <!-- CURRENT LOCATION -->

        <button type="button"
                id="useCurrentLocation"
                class="location-button">

            <span>📍</span>

            <span>
                Use My Current Location
            </span>

        </button>


        <div class="request-form-group">

            @Html.LabelFor(
                model => model.ProblemLocation,
                "Describe the Problem Location"
            )

            @Html.TextAreaFor(
                model => model.ProblemLocation,
                new
                {
                    @class = "request-textarea",
                    rows = "3",
                    placeholder = "e.g. Outside the school on the right-hand side, near the main entrance."
                }
            )

            @Html.ValidationMessageFor(
                model => model.ProblemLocation,
                "",
                new { @class = "text-danger" }
            )

        </div>

        <!-- SELECTED LOCATION -->

        <div class="selected-location">

            <strong>
                Selected Location
            </strong>

            <p id="locationStatus">

                Please select the problem location
                on the map.

            </p>

            <p>

                Latitude:

                <span id="latitudeDisplay">
                    Not selected
                </span>

            </p>

            <p>

                Longitude:

                <span id="longitudeDisplay">
                    Not selected
                </span>

            </p>

        </div>


        <!-- MAP VALIDATION -->

        <div id="mapValidation"
             class="map-validation-message">

            @Html.ValidationMessageFor(
                model => model.Latitude,
                "",
                new { @class = "text-danger" }
            )

            @Html.ValidationMessageFor(
                model => model.Longitude,
                "",
                new { @class = "text-danger" }
            )

        </div>

    </div>


            <!-- ================================================= -->
            <!-- HIDDEN GPS VALUES -->
            <!-- ================================================= -->

            @Html.HiddenFor(
                model => model.Latitude
            )

            @Html.HiddenFor(
                model => model.Longitude
            )


            <!-- ================================================= -->
            <!-- PHOTO -->
            <!-- ================================================= -->

            <div class="request-form-group">

                <label for="ImageFile">
                    Upload Photo (Optional)
                </label>

                <input type="file"
                       name="ImageFile"
                       id="ImageFile"
                       class="request-file"
                       accept="image/*" />

            </div>


            <!-- ================================================= -->
            <!-- SUBMIT -->
            <!-- ================================================= -->

            <button type="submit"
                    class="request-submit-button"
                    id="submitRequestButton">

                <span>➤</span>

                <span>
                    Submit
                </span>

            </button>


            <!-- ================================================= -->
            <!-- BACK TO DASHBOARD -->
            <!-- ================================================= -->

            <div class="request-back-dashboard">

                @Html.ActionLink(
                    "Back to Dashboard",
                    "Index",
                    "CitizenDashboard"
                )

            </div>

        }

    </div>

</div>


@section Scripts {

    @Scripts.Render("~/bundles/jqueryval")


    <!-- ========================================================= -->
    <!-- LEAFLET CSS -->
    <!-- ========================================================= -->

    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />


    <!-- ========================================================= -->
    <!-- LEAFLET JAVASCRIPT -->
    <!-- ========================================================= -->

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {


                // =================================================
                // FORM ELEMENTS
                // =================================================

                var requestForm =
                    document.getElementById(
                        "requestForm"
                    );


                var latitudeInput =
                    document.getElementById(
                        "Latitude"
                    );


                var longitudeInput =
                    document.getElementById(
                        "Longitude"
                    );


                var latitudeDisplay =
                    document.getElementById(
                        "latitudeDisplay"
                    );


                var longitudeDisplay =
                    document.getElementById(
                        "longitudeDisplay"
                    );


                var locationStatus =
                    document.getElementById(
                        "locationStatus"
                    );


                var addressSearch =
                    document.getElementById(
                        "addressSearch"
                    );


                var searchAddressButton =
                    document.getElementById(
                        "searchAddress"
                    );


                var addressSearchStatus =
                    document.getElementById(
                        "addressSearchStatus"
                    );


                var mapValidation =
                    document.getElementById(
                        "mapValidation"
                    );


                // =================================================
                // CREATE MAP
                // =================================================

                var map =
                    L.map(
                        "problemMap"
                    ).setView(
                        [
                            -29.8587,
                            31.0218
                        ],
                        12
                    );


                // =================================================
                // OPENSTREETMAP
                // =================================================

                L.tileLayer(
                    "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                    {
                        maxZoom: 19,

                        attribution:
                            "&copy; OpenStreetMap contributors"
                    }
                ).addTo(map);


                // =================================================
                // MARKER
                // =================================================

                var marker = null;


                // =================================================
                // SELECT LOCATION
                // =================================================

                function selectLocation(
                    latitude,
                    longitude
                ) {

                    // ---------------------------------------------
                    // CREATE MARKER
                    // ---------------------------------------------

                    if (marker === null) {

                        marker =
                            L.marker(
                                [
                                    latitude,
                                    longitude
                                ],
                                {
                                    draggable: true
                                }
                            ).addTo(map);


                        // -----------------------------------------
                        // DRAG MARKER
                        // -----------------------------------------

                        marker.on(
                            "dragend",
                            function () {

                                var position =
                                    marker.getLatLng();


                                selectLocation(
                                    position.lat,
                                    position.lng
                                );

                            }
                        );

                    }
                    else {

                        marker.setLatLng(
                            [
                                latitude,
                                longitude
                            ]
                        );

                    }


                    // ---------------------------------------------
                    // SAVE LATITUDE
                    // ---------------------------------------------

                    latitudeInput.value =
                        latitude.toFixed(6);


                    // ---------------------------------------------
                    // SAVE LONGITUDE
                    // ---------------------------------------------

                    longitudeInput.value =
                        longitude.toFixed(6);


                    // ---------------------------------------------
                    // DISPLAY LATITUDE
                    // ---------------------------------------------

                    latitudeDisplay.textContent =
                        latitude.toFixed(6);


                    // ---------------------------------------------
                    // DISPLAY LONGITUDE
                    // ---------------------------------------------

                    longitudeDisplay.textContent =
                        longitude.toFixed(6);


                    // ---------------------------------------------
                    // LOCATION STATUS
                    // ---------------------------------------------

                    locationStatus.textContent =
                        "Problem location selected successfully.";


                    locationStatus.style.color =
                        "";


                    locationStatus.style.fontWeight =
                        "";


                    // ---------------------------------------------
                    // REMOVE VALIDATION MESSAGE
                    // ---------------------------------------------

                    mapValidation.innerHTML = "";


                    // ---------------------------------------------
                    // MOVE MAP
                    // ---------------------------------------------

                    map.setView(
                        [
                            latitude,
                            longitude
                        ],
                        16
                    );

                }


                // =================================================
                // MAP CLICK
                // =================================================

                map.on(
                    "click",
                    function (event) {

                        selectLocation(
                            event.latlng.lat,
                            event.latlng.lng
                        );

                    }
                );


                // =================================================
                // ADDRESS SEARCH
                // =================================================

                searchAddressButton.addEventListener(
                    "click",
                    function () {

                        var address =
                            addressSearch.value.trim();


                        if (address === "") {

                            addressSearchStatus.textContent =
                                "Please enter an address to search.";

                            addressSearchStatus.style.color =
                                "#dc3545";

                            return;
                        }


                        addressSearchStatus.textContent =
                            "Searching for address...";


                        addressSearchStatus.style.color =
                            "";


                        searchAddressButton.disabled =
                            true;


                        fetch(
                            "https://nominatim.openstreetmap.org/search?format=json&limit=1&q="
                            +
                            encodeURIComponent(address)
                        )
                            .then(
                                function (response) {

                                    if (!response.ok) {

                                        throw new Error(
                                            "Search request failed."
                                        );

                                    }

                                    return response.json();

                                }
                            )
                            .then(
                                function (data) {

                                    if (
                                        !data ||
                                        data.length === 0
                                    ) {

                                        addressSearchStatus.textContent =
                                            "Address could not be found. Please try a more specific address.";

                                        addressSearchStatus.style.color =
                                            "#dc3545";

                                        return;
                                    }


                                    var latitude =
                                        parseFloat(
                                            data[0].lat
                                        );


                                    var longitude =
                                        parseFloat(
                                            data[0].lon
                                        );


                                    selectLocation(
                                        latitude,
                                        longitude
                                    );


                                    addressSearchStatus.textContent =
                                        "Address found. Please confirm the pin is at the correct location.";

                                    addressSearchStatus.style.color =
                                        "";

                                }
                            )
                            .catch(
                                function () {

                                    addressSearchStatus.textContent =
                                        "Unable to search for the address. Please try again or select the location manually.";

                                    addressSearchStatus.style.color =
                                        "#dc3545";

                                }
                            )
                            .finally(
                                function () {

                                    searchAddressButton.disabled =
                                        false;

                                }
                            );

                    }
                );


                // =================================================
                // ENTER KEY ADDRESS SEARCH
                // =================================================

                addressSearch.addEventListener(
                    "keypress",
                    function (event) {

                        if (event.key === "Enter") {

                            event.preventDefault();

                            searchAddressButton.click();

                        }

                    }
                );


                // =================================================
                // USE CURRENT LOCATION
                // =================================================

                document
                    .getElementById(
                        "useCurrentLocation"
                    )
                    .addEventListener(
                        "click",
                        function () {

                            if (!navigator.geolocation) {

                                locationStatus.textContent =
                                    "Location services are not supported by this browser.";

                                locationStatus.style.color =
                                    "#dc3545";

                                return;
                            }


                            locationStatus.textContent =
                                "Detecting your current location...";


                            locationStatus.style.color =
                                "";


                            navigator.geolocation.getCurrentPosition(

                                function (position) {

                                    var latitude =
                                        position.coords.latitude;


                                    var longitude =
                                        position.coords.longitude;


                                    selectLocation(
                                        latitude,
                                        longitude
                                    );

                                },


                                function () {

                                    locationStatus.textContent =
                                        "Unable to detect your current location. Please select the problem location on the map.";

                                    locationStatus.style.color =
                                        "#dc3545";

                                },


                                {
                                    enableHighAccuracy: true,
                                    timeout: 10000,
                                    maximumAge: 0
                                }

                            );

                        }
                    );


                // =================================================
                // REQUIRE MAP LOCATION BEFORE SUBMISSION
                // =================================================

                requestForm.addEventListener(
                    "submit",
                    function (event) {

                        var latitude =
                            latitudeInput.value.trim();


                        var longitude =
                            longitudeInput.value.trim();


                        if (
                            latitude === "" ||
                            longitude === ""
                        ) {

                            event.preventDefault();


                            locationStatus.textContent =
                                "Please select the problem location on the map before submitting.";

                            locationStatus.style.color =
                                "#dc3545";

                            locationStatus.style.fontWeight =
                                "600";


                            mapValidation.innerHTML =
                                '<span class="text-danger">' +
                                'Please select the problem location on the map.' +
                                '</span>';


                            document
                                .getElementById(
                                    "problemMap"
                                )
                                .scrollIntoView(
                                    {
                                        behavior: "smooth",
                                        block: "center"
                                    }
                                );

                            return false;
                        }

                    }
                );


                // =================================================
                // FIX MAP DISPLAY
                // =================================================

                setTimeout(
                    function () {

                        map.invalidateSize();

                    },
                    300
                );

            }
        );

    </script>


    <style>

        /* =====================================================
           MAP VALIDATION
           ===================================================== */

        .map-validation-message {
            margin-top: 10px;
            margin-bottom: 15px;
            font-weight: 600;
        }


            .map-validation-message .text-danger {
                color: #dc3545;
                display: block;
            }


        /* =====================================================
           SEARCH STATUS
           ===================================================== */

        .map-search-status {
            margin-top: 8px;
            margin-bottom: 8px;
            font-weight: 600;
        }


        /* =====================================================
           BACK TO DASHBOARD
           ===================================================== */

        .request-back-dashboard {
            text-align: center;
            margin-top: 15px;
        }


            .request-back-dashboard a {
                text-decoration: none;
                font-weight: 600;
            }
    </style>

}