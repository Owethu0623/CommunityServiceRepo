@model CommunityServiceProject.Models.Request

@{
    ViewBag.Title = "Submit Maintenance Request";
}

<div class="request-page">

    <div class="request-card">

        <div class="request-title">
            <span class="request-icon"></span>
            <h2>SUBMIT MAINTENANCE REQUEST</h2>
        </div>


        @using (Html.BeginForm(
            "Create",
            "Requests",
            FormMethod.Post,
            new
            {
                enctype = "multipart/form-data",
                id = "requestForm"
            }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "text-danger" }
            )


            <!-- =====================================================
                 REQUEST TITLE
                 ===================================================== -->

            <div class="request-form-group">

                @Html.LabelFor(
                    model => model.Title,
                    "Request Title"
                )

                @Html.TextBoxFor(model => model.Title, new
                {
                    @class = "request-input",
                    placeholder = "e.g. Broken streetlight"
                })

                @Html.ValidationMessageFor(
                    model => model.Title,
                    "",
                    new { @class = "text-danger" }
                )

            </div>


            <!-- =====================================================
                 CATEGORY
                 ===================================================== -->

            <div class="request-form-group">

                @Html.LabelFor(
                    model => model.CategoryID,
                    "Category"
                )

                @Html.DropDownList(
                    "CategoryID",
                    null,
                    "Select Category",
                    new
                    {
                        @class = "request-input"
                    }
                )

                <div class="category-examples">

                    <strong>Examples:</strong>

                    <ul>
                        <li>Pothole</li>
                        <li>Water Leak</li>
                        <li>Broken Streetlight</li>
                        <li>Illegal Dumping</li>
                        <li>Other (e.g. sewage pipe problems, dirty/standing water)</li>
                    </ul>

                </div>

                @Html.ValidationMessageFor(
                    model => model.CategoryID,
                    "",
                    new { @class = "text-danger" }
                )

            </div>


            <!-- =====================================================
                 DESCRIPTION
                 ===================================================== -->

            <div class="request-form-group">

                @Html.LabelFor(model => model.Description)

                @Html.TextAreaFor(
                    model => model.Description,
                    new
                    {
                        @class = "request-textarea",
                        rows = "4",
                        placeholder = "Describe the problem"
                    }
                )

                @Html.ValidationMessageFor(
                    model => model.Description,
                    "",
                    new { @class = "text-danger" }
                )

            </div>


            <!-- =====================================================
                 LOCATION DESCRIPTION
                 ===================================================== -->

            <div class="request-form-group">

                @Html.LabelFor(
                    model => model.LocationDescription
                )

                @Html.TextBoxFor(
                    model => model.LocationDescription,
                    new
                    {
                        @class = "request-input",
                        placeholder = "Enter the location of the problem"
                    }
                )

                @Html.ValidationMessageFor(
                    model => model.LocationDescription,
                    "",
                    new { @class = "text-danger" }
                )

            </div>


            <!-- =====================================================
                 PROBLEM LOCATION MAP
                 ===================================================== -->

            <div class="request-location-section">

                <div class="request-location-heading">

                    <div class="gps-icon">
                        📍
                    </div>

                    <div>

                        <strong>
                            Problem Location
                        </strong>

                        <p>
                            Select the exact location of the problem on the map.
                        </p>

                    </div>

                </div>


                <!-- MAP -->

                <div id="problemMap"></div>


                <!-- USE CURRENT LOCATION -->

                <button type="button"
                        id="useCurrentLocation"
                        class="location-button">

                    <span>📍</span>

                    <span>
                        Use My Current Location
                    </span>

                </button>


                <!-- SELECTED LOCATION -->

                <div class="selected-location">

                    <strong>
                        Selected Location
                    </strong>

                    <p id="locationStatus">
                        Click on the map to select the problem location.
                    </p>

                    <p>
                        Latitude:
                        <span id="latitudeDisplay">
                            Not selected
                        </span>
                    </p>

                    <p>
                        Longitude:
                        <span id="longitudeDisplay">
                            Not selected
                        </span>
                    </p>

                </div>

            </div>


            <!-- =====================================================
                 HIDDEN GPS VALUES
                 ===================================================== -->

            @Html.HiddenFor(
                model => model.Latitude
            )

            @Html.HiddenFor(
                model => model.Longitude
            )


            <!-- =====================================================
                 UPLOAD PHOTO
                 ===================================================== -->

            <div class="request-form-group">

                <label for="ImageFile">
                    Upload Photo (Optional)
                </label>

                <input type="file"
                       name="ImageFile"
                       id="ImageFile"
                       class="request-file"
                       accept="image/*" />

            </div>


            <!-- =====================================================
                 SUBMIT
                 ===================================================== -->

            <button type="submit"
                    class="request-submit-button">

                <span>➤</span>

                <span>
                    Submit
                </span>

            </button>

        }

    </div>

</div>


@section Scripts {

    @Scripts.Render("~/bundles/jqueryval")


    <!-- =========================================================
         LEAFLET CSS
         ========================================================= -->

    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />


    <!-- =========================================================
         LEAFLET JAVASCRIPT
         ========================================================= -->

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {


                // =================================================
                // FORM ELEMENTS
                // =================================================

                var latitudeInput =
                    document.getElementById("Latitude");

                var longitudeInput =
                    document.getElementById("Longitude");

                var latitudeDisplay =
                    document.getElementById("latitudeDisplay");

                var longitudeDisplay =
                    document.getElementById("longitudeDisplay");

                var locationStatus =
                    document.getElementById("locationStatus");


                // =================================================
                // CREATE MAP
                // =================================================

                var map =
                    L.map("problemMap").setView(
                        [-29.8587, 31.0218],
                        12
                    );


                // =================================================
                // OPENSTREETMAP
                // =================================================

                L.tileLayer(
                    "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                    {
                        maxZoom: 19,

                        attribution:
                            "&copy; OpenStreetMap contributors"
                    }
                ).addTo(map);


                // =================================================
                // MARKER
                // =================================================

                var marker = null;


                // =================================================
                // SELECT LOCATION
                // =================================================

                function selectLocation(
                    latitude,
                    longitude
                ) {


                    // ---------------------------------------------
                    // Create marker if one doesn't exist
                    // ---------------------------------------------

                    if (marker === null) {

                        marker =
                            L.marker(
                                [
                                    latitude,
                                    longitude
                                ],
                                {
                                    draggable: true
                                }
                            ).addTo(map);


                        // -----------------------------------------
                        // Marker drag
                        // -----------------------------------------

                        marker.on(
                            "dragend",
                            function () {

                                var position =
                                    marker.getLatLng();

                                selectLocation(
                                    position.lat,
                                    position.lng
                                );

                            }
                        );

                    }
                    else {

                        marker.setLatLng(
                            [
                                latitude,
                                longitude
                            ]
                        );

                    }


                    // ---------------------------------------------
                    // Save latitude
                    // ---------------------------------------------

                    latitudeInput.value =
                        latitude.toFixed(6);


                    // ---------------------------------------------
                    // Save longitude
                    // ---------------------------------------------

                    longitudeInput.value =
                        longitude.toFixed(6);


                    // ---------------------------------------------
                    // Display latitude
                    // ---------------------------------------------

                    latitudeDisplay.textContent =
                        latitude.toFixed(6);


                    // ---------------------------------------------
                    // Display longitude
                    // ---------------------------------------------

                    longitudeDisplay.textContent =
                        longitude.toFixed(6);


                    // ---------------------------------------------
                    // Status
                    // ---------------------------------------------

                    locationStatus.textContent =
                        "Problem location selected successfully.";


                    // ---------------------------------------------
                    // Move map
                    // ---------------------------------------------

                    map.setView(
                        [
                            latitude,
                            longitude
                        ],
                        16
                    );

                }


                // =================================================
                // CLICK MAP
                // =================================================

                map.on(
                    "click",
                    function (event) {

                        selectLocation(
                            event.latlng.lat,
                            event.latlng.lng
                        );

                    }
                );


                // =================================================
                // USE CURRENT LOCATION
                // =================================================

                document
                    .getElementById("useCurrentLocation")
                    .addEventListener(
                        "click",
                        function () {


                            // -------------------------------------
                            // Browser doesn't support GPS
                            // -------------------------------------

                            if (!navigator.geolocation) {

                                locationStatus.textContent =
                                    "Location services are not supported by this browser.";

                                return;

                            }


                            // -------------------------------------
                            // Loading message
                            // -------------------------------------

                            locationStatus.textContent =
                                "Detecting your current location...";


                            // -------------------------------------
                            // Get location
                            // -------------------------------------

                            navigator.geolocation.getCurrentPosition(

                                function (position) {


                                    var latitude =
                                        position.coords.latitude;


                                    var longitude =
                                        position.coords.longitude;


                                    selectLocation(
                                        latitude,
                                        longitude
                                    );

                                },


                                function () {

                                    locationStatus.textContent =
                                        "Unable to detect your current location. Please select the problem location on the map.";

                                },


                                {
                                    enableHighAccuracy: true,

                                    timeout: 10000,

                                    maximumAge: 0
                                }

                            );

                        }
                    );


                // =================================================
                // FIX MAP DISPLAY
                // =================================================

                setTimeout(
                    function () {

                        map.invalidateSize();

                    },
                    300
                );

            }
        );

    </script>

}