@model CommunityServiceProject.Models.Request

@{
    ViewBag.Title = "Request Details";
}

<div class="request-details-page">

    <!-- =========================
         HEADER
         ========================= -->
    <div class="request-details-hero">

        <div class="request-details-hero-icon">
        </div>

        <div class="request-details-hero-text">
            <h1>REQUEST DETAILS</h1>
            <p>View information about your maintenance request</p>
        </div>

    </div>


    <!-- =========================
     SUMMARY
     ========================= -->
    <div class="request-summary">

        <div class="summary-item">
            <span class="summary-label">Request Reference</span>
            <span class="summary-value">
                @Model.ReferenceNumber
            </span>
        </div>

        <div class="summary-item">
            <span class="summary-label">Request ID</span>
            <span class="summary-value">
                #@Model.RequestID
            </span>
        </div>

        <div class="summary-item">
            <span class="summary-label">Category</span>
            <span class="summary-value">
                @(Model.Category != null
                ? Model.Category.CategoryName
                : "Unknown")
            </span>
        </div>

        <div class="summary-item">
            <span class="summary-label">Status</span>
            <span class="summary-status status-@Model.Status.ToString().ToLower()">
                @Model.Status
            </span>
        </div>

        <div class="summary-item">
            <span class="summary-label">Priority</span>
            <span class="summary-status status-@Model.Priority.ToString().ToLower()">
                @Model.Priority
            </span>
        </div>

        <div class="summary-item">
            <span class="summary-label">Date Submitted</span>
            <span class="summary-value">
                @Model.DateSubmitted.ToString("dd MMM yyyy HH:mm")
            </span>
        </div>

    </div>


    <!-- =========================
         REQUEST INFORMATION
         ========================= -->
    <div class="request-details-section">

        <div class="request-section-heading">
            <span class="section-icon"></span>
            <h2>Request Information</h2>
        </div>

        <div class="detail-field">

            <label>Request Title</label>

            <div class="detail-box">
                @Model.Title
            </div>

        </div>


        <div class="detail-field">

            <label>Description</label>

            <div class="detail-box detail-description">
                @Model.Description
            </div>

        </div>

    </div>


    <!-- =========================
         LOCATION
         ========================= -->
    <div class="request-details-section">

        <div class="request-section-heading">
            <span class="section-icon"></span>
            <h2>Location</h2>
        </div>


        <!-- WARD -->
        <div class="detail-field">

            <label>Ward</label>

            <div class="detail-box">

                @(Model.Ward != null
                    ? Model.Ward.WardName
                    : "Unknown")

            </div>

        </div>


        <!-- PROBLEM LOCATION -->
        <div class="detail-field">

            <label>Problem Location</label>

            <div class="detail-box">
                @(!string.IsNullOrWhiteSpace(Model.ProblemLocation)
                    ? Model.ProblemLocation
                    : "No problem location description provided.")
            </div>

        </div>


        <!-- GPS -->
        <div class="gps-card">

            <div class="gps-card-header">

                <span class="gps-icon"></span>

                <div>

                    <h3>GPS Location</h3>

                    <p>
                        Location captured when the request was submitted
                    </p>

                </div>

            </div>


            @if (Model.Latitude.HasValue &&
                 Model.Longitude.HasValue)
            {
                <div class="gps-coordinates">

                    <div class="gps-coordinate">

                        <span>Latitude</span>

                        <strong>
                            @Model.Latitude.Value.ToString("F6")
                        </strong>

                    </div>


                    <div class="gps-coordinate">

                        <span>Longitude</span>

                        <strong>
                            @Model.Longitude.Value.ToString("F6")
                        </strong>

                    </div>

                </div>
            }
            else
            {
                <div class="gps-unavailable">

                    <span></span>

                    <span>
                        GPS location was not available when the request was submitted.
                    </span>

                </div>
            }

        </div>

    </div>


    <!-- =========================
         PRIORITY
         ========================= -->
    <div class="request-details-section">

        <div class="request-section-heading">
            <span class="section-icon"></span>
            <h2>Priority</h2>
        </div>

        <div class="status-information">

            <div class="status-row">
                <span>Current Priority</span>

                <span class="summary-status status-@Model.Priority.ToString().ToLower()">
                    @Model.Priority
                </span>
            </div>

        </div>

    </div>


    <!-- =========================
         ASSIGNMENT
         ========================= -->
    @if (Model.Technician != null)
    {
        <div class="request-details-section">

            <div class="request-section-heading">
                <span class="section-icon"></span>
                <h2>Assigned Technician</h2>
            </div>

            <div class="status-information">

                <div class="status-row">

                    <span>Technician</span>

                    <strong>
                        @Model.Technician.FirstName
                        @Model.Technician.LastName
                    </strong>

                </div>

            </div>

        </div>
    }


    <!-- =========================
         PHOTO
         ========================= -->
    <div class="request-details-section">

        <div class="request-section-heading">
            <span class="section-icon"></span>
            <h2>Uploaded Photo</h2>
        </div>

        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <div class="request-photo-container">

                <img src="@Url.Content(Model.ImagePath)"
                     alt="Maintenance request photo"
                     class="request-photo" />

            </div>
        }
        else
        {
            <div class="no-photo">
                <span></span>
                <p>No photo was uploaded with this request.</p>
            </div>
        }

    </div>


    <!-- =========================
         REQUEST STATUS
         ========================= -->
    <div class="request-details-section">

        <div class="request-section-heading">
            <span class="section-icon"></span>
            <h2>Request Status</h2>
        </div>

        <div class="status-information">

            <div class="status-row">
                <span>Status</span>

                <span class="summary-status status-@Model.Status.ToString().ToLower()">
                    @Model.Status
                </span>
            </div>


            <div class="status-row">
                <span>Date Submitted</span>

                <strong>
                    @Model.DateSubmitted.ToString("dd MMM yyyy HH:mm")
                </strong>
            </div>

        </div>

    </div>


    <!-- =========================
         ACTIONS
         ========================= -->
    <div class="request-details-actions">

        <a href="@Url.Action("Index", "Requests")"
           class="details-back-button">
            ← Back to My Requests
        </a>

        @if (Model.CanEdit())
        {
            <a href="@Url.Action("Edit", "Requests", new { id = Model.RequestID })"
               class="details-edit-button">
                ✎ Edit Request
            </a>
        }

    </div>

</div>

