
@model CommunityServiceProject.Models.Request

@{
    ViewBag.Title = "Track Request";

    var maintenanceWork = Model.MaintenanceWorks
        .OrderByDescending(m => m.StartedDate ?? DateTime.MinValue)
        .FirstOrDefault();

    var latestCompletion = maintenanceWork != null
        ? maintenanceWork.Completions
            .OrderByDescending(c => c.SubmittedDate)
            .FirstOrDefault()
        : null;

    var latestAssignment = Model.TechnicianAssignments
        .OrderByDescending(a => a.AssignedDate)
        .FirstOrDefault();

    var progressRecords = maintenanceWork != null
        ? maintenanceWork.ProgressRecords
            .OrderBy(p => p.RecordedDate)
            .ToList()
        : new List<CommunityServiceProject.Models.MaintenanceProgress>();

    var evidenceRecords = maintenanceWork != null
        ? maintenanceWork.Evidence
            .OrderBy(e => e.UploadedDate)
            .ToList()
        : new List<CommunityServiceProject.Models.MaintenanceEvidence>();

    string currentStatus = Model.Status.ToString();

    bool isAssigned =
        Model.Status == CommunityServiceProject.Models.RequestStatus.Assigned ||
        Model.Status == CommunityServiceProject.Models.RequestStatus.InProgress ||
        Model.Status == CommunityServiceProject.Models.RequestStatus.Completed;

    bool isInProgress =
        Model.Status == CommunityServiceProject.Models.RequestStatus.InProgress;

    bool isCompleted =
        Model.Status == CommunityServiceProject.Models.RequestStatus.Completed;

    bool completionSubmitted =
        latestCompletion != null;

    bool verificationComplete =
        latestCompletion != null &&
        latestCompletion.VerificationStatus ==
            CommunityServiceProject.Models.CompletionVerificationStatus.Verified;

    int currentProgress = maintenanceWork != null
        ? maintenanceWork.ProgressPercentage
        : 0;

    string currentActivity = maintenanceWork != null
        ? maintenanceWork.CurrentActivity
        : null;

    int resolutionDays = 0;

    if (isCompleted && maintenanceWork != null && maintenanceWork.CompletedDate.HasValue)
    {
        resolutionDays =
            (maintenanceWork.CompletedDate.Value - Model.DateSubmitted).Days;
    }
}

<div class="track-page">

    <!-- =========================
         HEADER
         ========================= -->
    <div class="track-header">

        <div class="track-header-icon">
        </div>

        <div>
            <h2>TRACK REQUEST</h2>
            <p>Monitor the progress of your maintenance request</p>
        </div>

    </div>


    <!-- =========================
         REQUEST SUMMARY
         ========================= -->
    <div class="track-card">

        <div class="track-card-title">
            <span></span>
            REQUEST INFORMATION
        </div>

        <div class="track-info-grid">

            <div class="track-info-item">
                <span class="track-label">Request Reference</span>
                <span class="track-value">
                    @Model.ReferenceNumber
                </span>
            </div>

            <div class="track-info-item">
                <span class="track-label">Title</span>
                <span class="track-value">
                    @Model.Title
                </span>
            </div>

            <div class="track-info-item">
                <span class="track-label">Category</span>
                <span class="track-value">
                    @(Model.Category != null
                        ? Model.Category.CategoryName
                        : "Unknown")
                </span>
            </div>

            <div class="track-info-item">
                <span class="track-label">Ward</span>
                <span class="track-value">
                    @(Model.Ward != null
                        ? Model.Ward.WardName
                        : "Unknown")
                </span>
            </div>

            <div class="track-info-item">
                <span class="track-label">Priority</span>
                <span class="summary-status status-@Model.Priority.ToString().ToLower()">
                    @Model.Priority
                </span>
            </div>

            <div class="track-info-item">
                <span class="track-label">Date Submitted</span>
                <span class="track-value">
                    @Model.DateSubmitted.ToString("dd MMM yyyy HH:mm")
                </span>
            </div>

        </div>

    </div>


    <!-- =========================
         CURRENT STATUS
         ========================= -->
    <div class="track-card">

        <div class="track-card-title">
            <span></span>
            CURRENT STATUS
        </div>

        <div class="current-status-box">

            <span class="current-status-label">
                Current status
            </span>

            <span class="current-status status-@currentStatus.ToLower()">
                @Model.Status
            </span>

        </div>

    </div>


    <!-- =========================
         REQUEST DESCRIPTION
         ========================= -->
    <div class="track-card">

        <div class="track-card-title">
            <span></span>
            DESCRIPTION
        </div>

        <div class="track-description">
            @Model.Description
        </div>

    </div>


    <!-- =========================
         LOCATION
         ========================= -->
    <div class="track-card">

        <div class="track-card-title">
            <span></span>
            LOCATION
        </div>

        <div class="track-location-details">

            <div class="track-info-item">

                <span class="track-label">
                    Problem Location
                </span>

                <span class="track-value">
                    @(!string.IsNullOrWhiteSpace(Model.ProblemLocation)
                        ? Model.ProblemLocation
                        : "No location description provided.")
                </span>

            </div>

            @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
            {
                <div class="gps-box">

                    <div>
                        <span class="track-label">Latitude</span>
                        <strong>
                            @Model.Latitude.Value.ToString("F6")
                        </strong>
                    </div>

                    <div>
                        <span class="track-label">Longitude</span>
                        <strong>
                            @Model.Longitude.Value.ToString("F6")
                        </strong>
                    </div>

                </div>
            }

        </div>

    </div>


    <!-- =========================
         ASSIGNED TECHNICIAN
         ========================= -->
    @if (isAssigned && Model.Technician != null)
    {
        <div class="track-card">

            <div class="track-card-title">
                <span></span>
                ASSIGNED TECHNICIAN
            </div>

            <div class="technician-information">

                <div class="track-info-item">

                    <span class="track-label">
                        Technician
                    </span>

                    <span class="track-value">
                        @Model.Technician.FirstName
                        @Model.Technician.LastName
                    </span>

                </div>

                @if (latestAssignment != null)
                {
                    <div class="track-info-item">

                        <span class="track-label">
                            Assigned Date
                        </span>

                        <span class="track-value">
                            @latestAssignment.AssignedDate.ToString("dd MMM yyyy HH:mm")
                        </span>

                    </div>

                    if (latestAssignment.AcknowledgedDate.HasValue)
                    {
                        <div class="track-info-item">

                            <span class="track-label">
                                Assignment Acknowledged
                            </span>

                            <span class="track-value">
                                @latestAssignment.AcknowledgedDate.Value.ToString("dd MMM yyyy HH:mm")
                            </span>

                        </div>
                    }
                }

            </div>

        </div>
    }


    <!-- =========================
         REQUEST TIMELINE
         ========================= -->
    <div class="track-card">

        <div class="track-card-title">
            <span></span>
            REQUEST TIMELINE
        </div>

        <div class="request-timeline">

            <!-- SUBMITTED -->
            <div class="timeline-item active">

                <div class="timeline-marker">✓</div>

                <div class="timeline-content">
                    <strong>Submitted</strong>
                    <span>
                        @Model.DateSubmitted.ToString("dd MMM yyyy HH:mm")
                    </span>
                </div>

            </div>


            <!-- UNDER REVIEW -->
            <div class="timeline-item
                 @(Model.Status != CommunityServiceProject.Models.RequestStatus.Pending
                    ? "active"
                    : "")">

                <div class="timeline-marker">
                    @(Model.Status != CommunityServiceProject.Models.RequestStatus.Pending ? "✓" : "")
                </div>

                <div class="timeline-content">
                    <strong>Under Review</strong>

                    <span>
                        @(Model.Status == CommunityServiceProject.Models.RequestStatus.Pending
                            ? "Pending"
                            : "Request reviewed")
                    </span>
                </div>

            </div>


            <!-- APPROVED -->
            <div class="timeline-item
                 @((Model.Status == CommunityServiceProject.Models.RequestStatus.Approved ||
                    Model.Status == CommunityServiceProject.Models.RequestStatus.Assigned ||
                    Model.Status == CommunityServiceProject.Models.RequestStatus.InProgress ||
                    Model.Status == CommunityServiceProject.Models.RequestStatus.Completed)
                    ? "active"
                    : "")">

                <div class="timeline-marker">
                    @((Model.Status == CommunityServiceProject.Models.RequestStatus.Approved ||
                       Model.Status == CommunityServiceProject.Models.RequestStatus.Assigned ||
                       Model.Status == CommunityServiceProject.Models.RequestStatus.InProgress ||
                       Model.Status == CommunityServiceProject.Models.RequestStatus.Completed)
                       ? "✓"
                       : "")
                </div>

                <div class="timeline-content">
                    <strong>Approved</strong>

                    <span>
                        @((Model.Status == CommunityServiceProject.Models.RequestStatus.Approved ||
                           Model.Status == CommunityServiceProject.Models.RequestStatus.Assigned ||
                           Model.Status == CommunityServiceProject.Models.RequestStatus.InProgress ||
                           Model.Status == CommunityServiceProject.Models.RequestStatus.Completed)
                           ? "Request approved"
                           : "Pending")
                    </span>
                </div>

            </div>


            <!-- ASSIGNED -->
            <div class="timeline-item
                 @((Model.Status == CommunityServiceProject.Models.RequestStatus.Assigned ||
                    Model.Status == CommunityServiceProject.Models.RequestStatus.InProgress ||
                    Model.Status == CommunityServiceProject.Models.RequestStatus.Completed)
                    ? "active"
                    : "")">

                <div class="timeline-marker">
                    @((Model.Status == CommunityServiceProject.Models.RequestStatus.Assigned ||
                       Model.Status == CommunityServiceProject.Models.RequestStatus.InProgress ||
                       Model.Status == CommunityServiceProject.Models.RequestStatus.Completed)
                       ? "✓"
                       : "")
                </div>

                <div class="timeline-content">

                    <strong>Assigned</strong>

                    <span>
                        @if (latestAssignment != null)
                        {
                            @latestAssignment.AssignedDate.ToString("dd MMM yyyy HH:mm")
                        }
                        else
                        {
                            @:Pending
                        }
                    </span>

                </div>

            </div>


            <!-- IN PROGRESS -->
            <div class="timeline-item
                 @((Model.Status == CommunityServiceProject.Models.RequestStatus.InProgress ||
                    Model.Status == CommunityServiceProject.Models.RequestStatus.Completed)
                    ? "active"
                    : "")">

                <div class="timeline-marker">
                    @((Model.Status == CommunityServiceProject.Models.RequestStatus.InProgress ||
                       Model.Status == CommunityServiceProject.Models.RequestStatus.Completed)
                       ? "✓"
                       : "")
                </div>

                <div class="timeline-content">

                    <strong>In Progress</strong>

                    <span>
                        @if (maintenanceWork != null && maintenanceWork.StartedDate.HasValue)
                        {
                            @maintenanceWork.StartedDate.Value.ToString("dd MMM yyyy HH:mm")
                        }
                        else
                        {
                            @:Pending
                        }
                    </span>

                </div>

            </div>


            <!-- COMPLETION -->
            <div class="timeline-item
                 @(completionSubmitted ? "active" : "")">

                <div class="timeline-marker">
                    @(completionSubmitted ? "✓" : "")
                </div>

                <div class="timeline-content">

                    <strong>Completion</strong>

                    <span>
                        @if (latestCompletion != null)
                        {
                            @latestCompletion.SubmittedDate.ToString("dd MMM yyyy HH:mm")
                        }
                        else
                        {
                            @:Pending
                        }
                    </span>

                </div>

            </div>


            <!-- VERIFICATION -->
            <div class="timeline-item
                 @(verificationComplete ? "active" : "")">

                <div class="timeline-marker">
                    @(verificationComplete ? "✓" : "")
                </div>

                <div class="timeline-content">

                    <strong>Verification</strong>

                    <span>
                        @if (verificationComplete && latestCompletion.VerifiedDate.HasValue)
                        {
                            @latestCompletion.VerifiedDate.Value.ToString("dd MMM yyyy HH:mm")
                        }
                        else
                        {
                            @:Pending
                        }
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         MAINTENANCE PROGRESS
         ========================= -->
    @if (maintenanceWork != null)
    {
        <div class="track-card">

            <div class="track-card-title">
                <span></span>
                MAINTENANCE PROGRESS
            </div>

            <div class="progress-summary">

                <div class="progress-percentage">
                    @currentProgress%
                </div>

                <div class="progress-details">

                    <strong>
                        Current Progress
                    </strong>

                    @if (!string.IsNullOrWhiteSpace(currentActivity))
                    {
                        <span>
                            @currentActivity
                        </span>
                    }
                    else
                    {
                        <span>
                            No current activity recorded.
                        </span>
                    }

                </div>

            </div>


            @if (progressRecords.Any())
            {
                <div class="progress-history">

                    <h3>Progress Updates</h3>

                    @foreach (var progress in progressRecords)
                    {
                        <div class="progress-history-row">

                            <div>
                                <strong>
                                    @progress.ProgressPercentage%
                                </strong>

                                <span>
                                    @progress.CurrentActivity
                                </span>
                            </div>

                            <span>
                                @progress.RecordedDate.ToString("dd MMM yyyy HH:mm")
                            </span>

                        </div>
                    }

                </div>
            }

        </div>
    }


    <!-- =========================
         COMPLETION INFORMATION
         ========================= -->
    @if (latestCompletion != null)
    {
        <div class="track-card">

            <div class="track-card-title">
                <span></span>
                FINAL OUTCOME
            </div>

            @if (isCompleted && maintenanceWork != null && maintenanceWork.CompletedDate.HasValue)
            {
                <div class="completion-summary">

                    <div class="completion-status">
                        <span class="summary-status status-completed">
                            ✓ COMPLETED
                        </span>
                    </div>

                    <div class="completion-dates">

                        <div>
                            <span>Submitted</span>
                            <strong>
                                @Model.DateSubmitted.ToString("dd MMM yyyy")
                            </strong>
                        </div>

                        <div>
                            <span>Completed</span>
                            <strong>
                                @maintenanceWork.CompletedDate.Value.ToString("dd MMM yyyy")
                            </strong>
                        </div>

                        <div>
                            <span>Resolution Time</span>
                            <strong>
                                @resolutionDays day(s)
                            </strong>
                        </div>

                    </div>

                </div>
            }

            <div class="completion-field">

                <span class="track-label">
                    Maintenance Summary
                </span>

                <p>
                    @latestCompletion.MaintenanceSummary
                </p>

            </div>

            <div class="completion-field">

                <span class="track-label">
                    Resolution Action
                </span>

                <p>
                    @latestCompletion.ResolutionAction
                </p>

            </div>

            @if (Model.Technician != null)
            {
                <div class="completion-field">

                    <span class="track-label">
                        Technician
                    </span>

                    <p>
                        @Model.Technician.FirstName
                        @Model.Technician.LastName
                    </p>

                </div>
            }

        </div>
    }


    <!-- =========================
         COMPLETION EVIDENCE
         ========================= -->
    @if (evidenceRecords.Any())
    {
        <div class="track-card">

            <div class="track-card-title">
                <span></span>
                COMPLETION EVIDENCE
            </div>

            <div class="evidence-list">

                @foreach (var evidence in evidenceRecords)
                {
                    <div class="evidence-item">

                        <div class="evidence-information">

                            <strong>
                                @evidence.EvidenceType
                            </strong>

                            @if (!string.IsNullOrWhiteSpace(evidence.Description))
                            {
                                <span>
                                    @evidence.Description
                                </span>
                            }

                            <small>
                                Uploaded:
                                @evidence.UploadedDate.ToString("dd MMM yyyy HH:mm")
                            </small>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(evidence.FilePath))
                        {
                            <a href="@Url.Content(evidence.FilePath)"
                               target="_blank"
                               class="evidence-view-button">
                                VIEW
                            </a>
                        }

                    </div>
                }

            </div>

        </div>
    }


    <!-- =========================
         ADMINISTRATOR VERIFICATION
         ========================= -->
    @if (latestCompletion != null)
    {
        <div class="track-card">

            <div class="track-card-title">
                <span></span>
                ADMINISTRATOR VERIFICATION
            </div>

            <div class="verification-information">

                @if (verificationComplete)
                {
                    <div class="verification-status verified">
                        ✓ Verified
                    </div>

                    if (latestCompletion.VerifiedDate.HasValue)
                    {
                        <div class="status-row">

                            <span>Verified Date</span>

                            <strong>
                                @latestCompletion.VerifiedDate.Value.ToString("dd MMM yyyy HH:mm")
                            </strong>

                        </div>
                    }

                    if (!string.IsNullOrWhiteSpace(latestCompletion.AdministratorComments))
                    {
                        <div class="verification-comments">

                            <span class="track-label">
                                Administrator Comments
                            </span>

                            <p>
                                @latestCompletion.AdministratorComments
                            </p>

                        </div>
                    }
                }
                else if (latestCompletion.VerificationStatus ==
                    CommunityServiceProject.Models.CompletionVerificationStatus.Rejected)
                {
                    <div class="verification-status rejected">
                        Completion Requires Further Attention
                    </div>

                    if (!string.IsNullOrWhiteSpace(latestCompletion.AdministratorComments))
                    {
                        <div class="verification-comments">

                            <span class="track-label">
                                Administrator Comments
                            </span>

                            <p>
                                @latestCompletion.AdministratorComments
                            </p>

                        </div>
                    }
                }
                else
                {
                    <div class="verification-status pending">
                        Completion submitted for administrator verification.
                    </div>
                }

            </div>

        </div>
    }


    <!-- =========================
         ACTIONS
         ========================= -->
    <div class="track-actions">

        <a href="@Url.Action("Index", "Requests")"
           class="track-back-button">
            ← Back to My Requests
        </a>

        <a href="@Url.Action("Details", "Requests", new { id = Model.RequestID })"
           class="track-details-button">
            View Request Details
        </a>

    </div>


    <!-- =========================
         FUTURE CITIZEN ACTIONS
         ========================= -->
    <div class="track-secondary-actions">

        <button type="button"
                class="track-secondary-button"
                disabled>
            View Notifications
        </button>

        @if (isCompleted && verificationComplete)
        {
            <button type="button"
                    class="track-secondary-button"
                    disabled>
                Provide Feedback
            </button>
        }

    </div>

</div>

