
@model CommunityServiceProject.ViewModels.ServiceTypeManagementViewModel

@{
    ViewBag.Title = "Municipal Service Types";
}

<style>
    .service-type-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 30px 22px 50px;
        color: #1f2937;
    }


/* =========================================================
   SERVICE TYPE PAGE HEADER
   ========================================================= */

.service-page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
    padding: 24px 26px;

    background: #ffffff;
    border: 1px solid #e1e7ef;
    border-radius: 12px;

    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
}

.service-page-header > div:first-child {
    min-width: 0;
}

.service-page-header h1 {
    margin: 0 0 6px;
    color: #16324f;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.25;
}

.service-page-header p {
    margin: 0;
    color: #64748b;
    font-size: 13px;
    line-height: 1.5;
}

/* =========================================================
   HEADER ACTIONS
   ========================================================= */

.service-page-header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    flex-shrink: 0;
}

/* =========================================================
   BACK TO DASHBOARD
   ========================================================= */

.back-dashboard-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;

    min-height: 42px;
    padding: 0 16px;

    box-sizing: border-box;

    border: 1px solid #cfd7e3;
    border-radius: 8px;

    background: #ffffff;
    color: #475569;

    font-size: 13px;
    font-weight: 650;
    line-height: 1;

    text-decoration: none;

    white-space: nowrap;

    transition:
        background 0.15s ease,
        border-color 0.15s ease,
        color 0.15s ease,
        box-shadow 0.15s ease,
        transform 0.15s ease;
}

.back-dashboard-button:hover {
    background: #f8fafc;
    border-color: #aeb9c8;
    color: #1f2937;
    text-decoration: none;

    box-shadow: 0 2px 7px rgba(15, 23, 42, 0.07);

    transform: translateY(-1px);
}

.back-dashboard-button:active {
    transform: translateY(0);
    box-shadow: none;
}

.back-dashboard-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    font-size: 17px;
    line-height: 1;
    font-weight: 500;
}

/* =========================================================
   ADD SERVICE TYPE
   ========================================================= */

.add-service-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;

    min-height: 42px;
    padding: 0 17px;

    box-sizing: border-box;

    border: 1px solid #0D5CC1;
    border-radius: 8px;

    background: #0D5CC1;
    color: #ffffff;

    font-size: 13px;
    font-weight: 650;
    line-height: 1;

    cursor: pointer;

    white-space: nowrap;

    transition:
        background 0.15s ease,
        border-color 0.15s ease,
        box-shadow 0.15s ease,
        transform 0.15s ease;
}

.add-service-button:hover {
    background: #094b9f;
    border-color: #094b9f;
    color: #ffffff;

    box-shadow: 0 4px 10px rgba(13, 92, 193, 0.18);

    transform: translateY(-1px);
}

.add-service-button:active {
    transform: translateY(0);
    box-shadow: none;
}

/* =========================================================
   MOBILE
   ========================================================= */

@@media (max-width: 850px) {

    .service-page-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .service-page-header-actions {
        width: 100%;
        justify-content: flex-start;
    }
}

@@media (max-width: 600px) {

    .service-page-header {
        padding: 20px;
    }

    .service-page-header h1 {
        font-size: 21px;
    }

    .service-page-header-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .back-dashboard-button,
    .add-service-button {
        width: 100%;
    }
}



    /* =========================================================
       SUMMARY
       ========================================================= */

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .summary-card {
        background: white;
        border: 1px solid #e1e7ef;
        border-radius: 11px;
        padding: 18px 19px;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
    }

    .summary-label {
        color: #64748b;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 8px;
    }

    .summary-value {
        color: #16324f;
        font-size: 25px;
        font-weight: 750;
    }

    .summary-card.active .summary-value {
        color: #18794e;
    }

    .summary-card.inactive .summary-value {
        color: #64748b;
    }

    .summary-card.chargeable .summary-value {
        color: #0D5CC1;
    }

    /* =========================================================
       MAIN CARD
       ========================================================= */

    .service-card {
        background: white;
        border: 1px solid #e1e7ef;
        border-radius: 12px;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.05);
        overflow: hidden;
    }

    .service-card-header {
        padding: 20px 21px;
        border-bottom: 1px solid #e8edf3;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
    }

    .service-card-header h2 {
        margin: 0 0 4px;
        color: #16324f;
        font-size: 18px;
    }

    .service-card-header p {
        margin: 0;
        color: #7b8794;
        font-size: 12px;
    }

    /* =========================================================
       FILTERS
       ========================================================= */

    .filter-area {
        padding: 17px 21px;
        background: #f8fafc;
        border-bottom: 1px solid #e8edf3;
    }

    .filter-form {
        display: grid;
        grid-template-columns: minmax(240px, 1fr) 170px 170px auto;
        gap: 10px;
        align-items: end;
    }

    .filter-group label {
        display: block;
        margin-bottom: 5px;
        color: #64748b;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .filter-control {
        width: 100%;
        min-height: 39px;
        box-sizing: border-box;
        padding: 0 11px;
        border: 1px solid #cfd7e3;
        border-radius: 7px;
        background: white;
        color: #374151;
        font-size: 12px;
    }

    .filter-control:focus {
        outline: none;
        border-color: #0D5CC1;
        box-shadow: 0 0 0 3px rgba(13, 92, 193, 0.09);
    }

    .filter-button {
        min-height: 39px;
        padding: 0 15px;
        border: 1px solid #0D5CC1;
        border-radius: 7px;
        background: #0D5CC1;
        color: white;
        font-size: 12px;
        font-weight: 650;
        cursor: pointer;
    }

    .filter-button:hover {
        background: #094b9f;
        border-color: #094b9f;
    }

    .clear-filter {
        display: inline-flex;
        align-items: center;
        min-height: 39px;
        padding: 0 10px;
        color: #64748b;
        font-size: 11px;
        text-decoration: none;
    }

    .clear-filter:hover {
        color: #0D5CC1;
        text-decoration: none;
    }

    /* =========================================================
       TABLE
       ========================================================= */

    .table-wrapper {
        overflow-x: auto;
    }

    .service-table {
        width: 100%;
        border-collapse: collapse;
    }

    .service-table th {
        padding: 12px 17px;
        background: #fbfcfe;
        border-bottom: 1px solid #e8edf3;
        text-align: left;
        color: #64748b;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        white-space: nowrap;
    }

    .service-table td {
        padding: 14px 17px;
        border-bottom: 1px solid #edf0f4;
        vertical-align: middle;
        font-size: 12px;
        color: #374151;
    }

    .service-table tbody tr:hover {
        background: #fbfdff;
    }

    .service-code {
        display: inline-flex;
        padding: 5px 8px;
        border-radius: 6px;
        background: #edf5ff;
        border: 1px solid #c9ddf8;
        color: #0D5CC1;
        font-size: 10px;
        font-weight: 750;
        letter-spacing: 0.02em;
    }

    .service-name {
        color: #1f2937;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .service-description {
        color: #7b8794;
        font-size: 11px;
        line-height: 1.45;
        max-width: 370px;
    }

    .usage-count {
        color: #16324f;
        font-weight: 700;
    }

    /* =========================================================
       BADGES
       ========================================================= */

    .status-badge,
    .chargeable-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 20px;
        padding: 5px 9px;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-active {
        background: #e8f7ee;
        border: 1px solid #bfe7cf;
        color: #18794e;
    }

    .status-inactive {
        background: #f1f4f7;
        border: 1px solid #d8dee6;
        color: #64748b;
    }

    .chargeable-yes {
        background: #edf5ff;
        border: 1px solid #c9ddf8;
        color: #0D5CC1;
    }

    .chargeable-no {
        background: #f5f7fa;
        border: 1px solid #dce2e9;
        color: #64748b;
    }

    /* =========================================================
       ACTIONS
       ========================================================= */

    .row-actions {
        display: flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
    }

    .edit-button,
    .status-button {
        min-height: 31px;
        padding: 0 9px;
        border-radius: 6px;
        font-size: 10px;
        font-weight: 650;
        cursor: pointer;
    }

    .edit-button {
        background: white;
        border: 1px solid #cfd7e3;
        color: #475569;
    }

    .edit-button:hover {
        background: #f8fafc;
        color: #0D5CC1;
        border-color: #aeb9c8;
    }

    .status-button.activate {
        background: #edf8f2;
        border: 1px solid #bfe7cf;
        color: #18794e;
    }

    .status-button.deactivate {
        background: #fff8e8;
        border: 1px solid #f0dcae;
        color: #8a6413;
    }

    /* =========================================================
       EMPTY STATE
       ========================================================= */

    .empty-state {
        padding: 55px 25px;
        text-align: center;
    }

    .empty-state h3 {
        margin: 0 0 6px;
        color: #475569;
        font-size: 15px;
    }

    .empty-state p {
        margin: 0;
        color: #7b8794;
        font-size: 12px;
    }

    /* =========================================================
       MODAL
       ========================================================= */

    .service-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        background: rgba(15, 23, 42, 0.55);
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .service-modal.active {
        display: flex;
    }

    .service-modal-dialog {
        width: 100%;
        max-width: 560px;
        max-height: 90vh;
        overflow-y: auto;
        background: white;
        border-radius: 13px;
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.25);
    }

    .modal-header {
        padding: 21px 23px;
        border-bottom: 1px solid #e8edf3;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 15px;
    }

    .modal-header h2 {
        margin: 0 0 4px;
        color: #16324f;
        font-size: 19px;
    }

    .modal-header p {
        margin: 0;
        color: #7b8794;
        font-size: 11px;
        line-height: 1.5;
    }

    .modal-close {
        width: 30px;
        height: 30px;
        border: 1px solid #d7dee8;
        border-radius: 7px;
        background: white;
        color: #64748b;
        cursor: pointer;
        font-size: 17px;
        line-height: 1;
    }

    .modal-close:hover {
        background: #f8fafc;
        color: #1f2937;
    }

    .modal-body {
        padding: 22px 23px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 17px;
    }

    .form-group.full-width {
        grid-column: 1 / -1;
    }

    .form-label {
        display: block;
        margin-bottom: 6px;
        color: #374151;
        font-size: 12px;
        font-weight: 650;
    }

    .form-control {
        width: 100%;
        box-sizing: border-box;
        border: 1px solid #cfd7e3;
        border-radius: 7px;
        padding: 10px 11px;
        color: #1f2937;
        background: white;
        font-size: 13px;
    }

    .form-control:focus {
        outline: none;
        border-color: #0D5CC1;
        box-shadow: 0 0 0 3px rgba(13, 92, 193, 0.09);
    }

    textarea.form-control {
        min-height: 95px;
        resize: vertical;
    }

    .checkbox-row {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        padding: 11px 12px;
        border: 1px solid #e1e7ef;
        border-radius: 8px;
        background: #f8fafc;
    }

    .checkbox-row input {
        margin-top: 2px;
        width: 16px;
        height: 16px;
        accent-color: #0D5CC1;
    }

    .checkbox-row label {
        margin: 0;
        color: #374151;
        font-size: 12px;
        line-height: 1.45;
    }

    .field-validation {
        display: block;
        margin-top: 5px;
        color: #b42318;
        font-size: 11px;
    }

    .modal-footer {
        padding: 17px 23px;
        border-top: 1px solid #e8edf3;
        display: flex;
        justify-content: flex-end;
        gap: 9px;
    }

    .cancel-button,
    .save-button {
        min-height: 39px;
        padding: 0 15px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 650;
        cursor: pointer;
    }

    .cancel-button {
        background: white;
        border: 1px solid #cfd7e3;
        color: #475569;
    }

    .save-button {
        background: #0D5CC1;
        border: 1px solid #0D5CC1;
        color: white;
    }

    .save-button:hover {
        background: #094b9f;
        border-color: #094b9f;
    }

    /* =========================================================
       ALERTS
       ========================================================= */

    .alert-message {
        border-radius: 9px;
        padding: 13px 15px;
        margin-bottom: 19px;
        font-size: 12px;
    }

    .alert-success {
        background: #e8f7ee;
        border: 1px solid #bfe7cf;
        color: #18794e;
    }

    .alert-error {
        background: #fff1f0;
        border: 1px solid #f0b8b4;
        color: #9b1c1c;
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 1000px) {
        .summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .filter-form {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 700px) {
        .service-type-page {
            padding: 20px 12px 35px;
        }

        .service-type-header-content {
            flex-direction: column;
            align-items: flex-start;
        }

        .add-service-button {
            width: 100%;
        }

        .summary-grid,
        .form-grid,
        .filter-form {
            grid-template-columns: 1fr;
        }

        .form-group.full-width {
            grid-column: auto;
        }

        .service-type-header {
            padding: 22px;
        }

        .service-type-header h1 {
            font-size: 23px;
        }

        .modal-footer {
            flex-direction: column-reverse;
        }

        .cancel-button,
        .save-button {
            width: 100%;
        }
    }
</style>

<div class="service-type-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->
   
    <div class="service-page-header">
        <div>
            <h1>Municipal Service Types</h1>
            <p>
                Manage the municipal services available for citizen requests.
            </p>
        </div>

        <div class="service-page-header-actions">
            <a href="@Url.Action("Index", "FinanceDashboard")"
               class="back-dashboard-button">
                <span class="back-dashboard-icon">←</span>
                Back to Finance Dashboard
            </a>

            <button type="button"
                    class="add-service-button"
                    id="openCreateModal">
                + Add Service Type
            </button>
        </div>
    </div>
  


    <!-- =========================================================
         ALERTS
         ========================================================= -->

    @if (ViewBag.SuccessMessage != null)
    {
        <div class="alert-message alert-success">
            @ViewBag.SuccessMessage
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert-message alert-error">
            @ViewBag.ErrorMessage
        </div>
    }

    <!-- =========================================================
         SUMMARY
         ========================================================= -->

    <div class="summary-grid">

        <div class="summary-card">

            <div class="summary-label">
                Total Services
            </div>

            <div class="summary-value">
                @Model.TotalServices
            </div>

        </div>

        <div class="summary-card active">

            <div class="summary-label">
                Active Services
            </div>

            <div class="summary-value">
                @Model.ActiveServices
            </div>

        </div>

        <div class="summary-card inactive">

            <div class="summary-label">
                Inactive Services
            </div>

            <div class="summary-value">
                @Model.InactiveServices
            </div>

        </div>

        <div class="summary-card chargeable">

            <div class="summary-label">
                Chargeable Services
            </div>

            <div class="summary-value">
                @Model.ChargeableServices
            </div>

        </div>

    </div>

    <!-- =========================================================
         SERVICE TABLE
         ========================================================= -->

    <div class="service-card">

        <div class="service-card-header">

            <div>
                <h2>Service Catalogue</h2>

                <p>
                    Configure the services available for municipal service requests.
                </p>
            </div>

        </div>

        <!-- =====================================================
             FILTERS
             ===================================================== -->

        <div class="filter-area">

            @using (Html.BeginForm("Index", "ServiceType", FormMethod.Get, new { @class = "filter-form" }))
            {
                <div class="filter-group">

                    <label>
                        Search
                    </label>

                    <input type="text"
                           name="searchTerm"
                           value="@Model.SearchTerm"
                           class="filter-control"
                           placeholder="Search code, name or description..." />

                </div>

                <div class="filter-group">

                    <label>
                        Status
                    </label>

                    <select name="statusFilter"
                            class="filter-control">

                        <option value="">All statuses</option>

                        <option value="Active"
                                @(Model.StatusFilter == "Active" ? "selected" : "")>
                            Active
                        </option>

                        <option value="Inactive"
                                @(Model.StatusFilter == "Inactive" ? "selected" : "")>
                            Inactive
                        </option>

                    </select>

                </div>

                <div class="filter-group">

                    <label>
                        Billing
                    </label>

                    <select name="chargeableFilter"
                            class="filter-control">

                        <option value="">All services</option>

                        <option value="Chargeable"
                                @(Model.ChargeableFilter == "Chargeable" ? "selected" : "")>
                            Chargeable
                        </option>

                        <option value="NonChargeable"
                                @(Model.ChargeableFilter == "NonChargeable" ? "selected" : "")>
                            Non-chargeable
                        </option>

                    </select>

                </div>

                <div>

                    <button type="submit"
                            class="filter-button">
                        Apply Filters
                    </button>

                    <a href="@Url.Action("Index", "ServiceType")"
                       class="clear-filter">
                        Clear
                    </a>

                </div>
            }

        </div>

        @if (Model.Services.Any())
        {
            <div class="table-wrapper">

                <table class="service-table">

                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Service</th>
                            <th>Chargeable</th>
                            <th>Status</th>
                            <th>Requests</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var service in Model.Services)
                        {
                            <tr>

                                <td>
                                    <span class="service-code">
                                        @service.ServiceCode
                                    </span>
                                </td>

                                <td>

                                    <div class="service-name">
                                        @service.ServiceName
                                    </div>

                                    <div class="service-description">
                                        @(String.IsNullOrWhiteSpace(service.Description)
                                            ? "No description provided."
                                            : service.Description)
                                    </div>

                                </td>

                                <td>

                                    @if (service.IsChargeable)
                                    {
                                        <span class="chargeable-badge chargeable-yes">
                                            Chargeable
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="chargeable-badge chargeable-no">
                                            Non-chargeable
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (service.IsActive)
                                    {
                                        <span class="status-badge status-active">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td>

                                    <span class="usage-count">
                                        @service.ServiceRequestCount
                                    </span>

                                </td>

                                <td>

                                    <div class="row-actions">

                                        <button type="button"
                                                class="edit-button"
                                                data-edit-id="@service.ServiceTypeID"
                                                data-code="@service.ServiceCode"
                                                data-name="@service.ServiceName"
                                                data-description="@service.Description"
                                                data-chargeable="@service.IsChargeable.ToString().ToLower()"
                                                data-active="@service.IsActive.ToString().ToLower()">
                                            Edit
                                        </button>

                                        @using (Html.BeginForm(
                                            "ToggleStatus",
                                            "ServiceType",
                                            FormMethod.Post,
                                            new { style = "display:inline;" }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@service.ServiceTypeID" />

                                            if (service.IsActive)
                                            {
                                                <button type="submit"
                                                        class="status-button deactivate">
                                                    Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="status-button activate">
                                                    Activate
                                                </button>
                                            }
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <h3>
                    No service types found
                </h3>

                <p>
                    No services match the current filters. Create a new municipal
                    service type or adjust the filters above.
                </p>

            </div>
        }

    </div>

</div>

<!-- =============================================================
     CREATE MODAL
     ============================================================= -->

<div id="createServiceModal"
     class="service-modal">

    <div class="service-modal-dialog">

        @using (Html.BeginForm("Create", "ServiceType", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="modal-header">

                <div>
                    <h2>Add Service Type</h2>

                    <p>
                        Add a municipal service that can be offered through
                        the citizen service workflow.
                    </p>
                </div>

                <button type="button"
                        class="modal-close"
                        data-close-modal="createServiceModal">
                    ×
                </button>

            </div>

            <div class="modal-body">

                <div class="form-grid">

                    <div class="form-group">

                        <label class="form-label">
                            Service Code
                        </label>

                        <input type="text"
                               name="ServiceCode"
                               class="form-control"
                               maxlength="30"
                               placeholder="e.g. MS-HALL"
                               required />

                        <span class="field-validation">
                            Use a short unique code.
                        </span>

                    </div>

                    <div class="form-group">

                        <label class="form-label">
                            Service Name
                        </label>

                        <input type="text"
                               name="ServiceName"
                               class="form-control"
                               maxlength="150"
                               placeholder="e.g. Municipal Hall Booking"
                               required />

                    </div>

                    <div class="form-group full-width">

                        <label class="form-label">
                            Description
                        </label>

                        <textarea name="Description"
                                  class="form-control"
                                  maxlength="500"
                                  placeholder="Describe what this municipal service provides."></textarea>

                    </div>

                    <div class="form-group full-width">

                        <div class="checkbox-row">

                            <input type="checkbox"
                                   name="IsChargeable"
                                   value="true"
                                   checked />

                            <input type="hidden"
                                   name="IsChargeable"
                                   value="false" />

                            <label>
                                <strong>Chargeable service</strong><br />
                                This service will require a fee schedule before
                                citizens can be billed for it.
                            </label>

                        </div>

                    </div>

                    <div class="form-group full-width">

                        <div class="checkbox-row">

                            <input type="checkbox"
                                   name="IsActive"
                                   value="true"
                                   checked />

                            <input type="hidden"
                                   name="IsActive"
                                   value="false" />

                            <label>
                                <strong>Make service active</strong><br />
                                Active services can be made available for new
                                municipal service requests.
                            </label>

                        </div>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="cancel-button"
                        data-close-modal="createServiceModal">
                    Cancel
                </button>

                <button type="submit"
                        class="save-button">
                    Create Service Type
                </button>

            </div>
        }

    </div>

</div>

<!-- =============================================================
     EDIT MODAL
     ============================================================= -->

<div id="editServiceModal"
     class="service-modal">

    <div class="service-modal-dialog">

        @using (Html.BeginForm("Edit", "ServiceType", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="editServiceTypeID"
                   name="ServiceTypeID" />

            <div class="modal-header">

                <div>
                    <h2>Edit Service Type</h2>

                    <p>
                        Update the municipal service configuration.
                    </p>
                </div>

                <button type="button"
                        class="modal-close"
                        data-close-modal="editServiceModal">
                    ×
                </button>

            </div>

            <div class="modal-body">

                <div class="form-grid">

                    <div class="form-group">

                        <label class="form-label">
                            Service Code
                        </label>

                        <input type="text"
                               id="editServiceCode"
                               name="ServiceCode"
                               class="form-control"
                               maxlength="30"
                               required />

                    </div>

                    <div class="form-group">

                        <label class="form-label">
                            Service Name
                        </label>

                        <input type="text"
                               id="editServiceName"
                               name="ServiceName"
                               class="form-control"
                               maxlength="150"
                               required />

                    </div>

                    <div class="form-group full-width">

                        <label class="form-label">
                            Description
                        </label>

                        <textarea id="editDescription"
                                  name="Description"
                                  class="form-control"
                                  maxlength="500"></textarea>

                    </div>

                    <div class="form-group full-width">

                        <div class="checkbox-row">

                            <input type="checkbox"
                                   id="editIsChargeable"
                                   name="IsChargeable"
                                   value="true" />

                            <input type="hidden"
                                   name="IsChargeable"
                                   value="false" />

                            <label for="editIsChargeable">
                                <strong>Chargeable service</strong><br />
                                The service requires a fee schedule for billing.
                            </label>

                        </div>

                    </div>

                    <div class="form-group full-width">

                        <div class="checkbox-row">

                            <input type="checkbox"
                                   id="editIsActive"
                                   name="IsActive"
                                   value="true" />

                            <input type="hidden"
                                   name="IsActive"
                                   value="false" />

                            <label for="editIsActive">
                                <strong>Active service</strong><br />
                                Active services can be offered for new requests.
                            </label>

                        </div>

                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="cancel-button"
                        data-close-modal="editServiceModal">
                    Cancel
                </button>

                <button type="submit"
                        class="save-button">
                    Save Changes
                </button>

            </div>
        }

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        var createModal = document.getElementById("createServiceModal");
        var editModal = document.getElementById("editServiceModal");

        var openCreateButton =
            document.getElementById("openCreateModal");

        var editButtons =
            document.querySelectorAll("[data-edit-id]");

        function openModal(modal) {
            if (modal) {
                modal.classList.add("active");
            }
        }

        function closeModal(modal) {
            if (modal) {
                modal.classList.remove("active");
            }
        }

        if (openCreateButton) {

            openCreateButton.addEventListener(
                "click",
                function () {

                    openModal(createModal);
                }
            );
        }

        editButtons.forEach(function (button) {

            button.addEventListener(
                "click",
                function () {

                    document.getElementById("editServiceTypeID").value =
                        button.getAttribute("data-edit-id");

                    document.getElementById("editServiceCode").value =
                        button.getAttribute("data-code") || "";

                    document.getElementById("editServiceName").value =
                        button.getAttribute("data-name") || "";

                    document.getElementById("editDescription").value =
                        button.getAttribute("data-description") || "";

                    document.getElementById("editIsChargeable").checked =
                        button.getAttribute("data-chargeable") === "true";

                    document.getElementById("editIsActive").checked =
                        button.getAttribute("data-active") === "true";

                    openModal(editModal);
                }
            );

        });

        document
            .querySelectorAll("[data-close-modal]")
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        var modalId =
                            button.getAttribute("data-close-modal");

                        closeModal(
                            document.getElementById(modalId)
                        );
                    }
                );

            });

        [createModal, editModal].forEach(function (modal) {

            if (!modal) {
                return;
            }

            modal.addEventListener(
                "click",
                function (event) {

                    if (event.target === modal) {
                        closeModal(modal);
                    }

                }
            );

        });

    });
</script>

