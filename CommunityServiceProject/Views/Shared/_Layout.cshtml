<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewBag.Title - Community Service Request System
    </title>

    @Styles.Render("~/Content/css")
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    @Scripts.Render("~/bundles/modernizr")

</head>

<body>

    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();
        bool isHomePage = controller == "Home" && action == "Index";
        string currentController = controller ?? string.Empty;
    }

    <a class="skip-link sr-only-focusable" href="#main">Skip to main content</a>

    @if (!isHomePage)
    {
        <header role="banner">
            <nav class="navbar navbar-expand-sm navbar-dark bg-dark" role="navigation" aria-label="Main navigation">
                <div class="container">
                    <a class="navbar-brand text-truncate" href="@Url.Action("Index", "Home")" title="Community Service Request System">Community Service</a>

                    <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#citizenNavigation" aria-controls="citizenNavigation" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="citizenNavigation">
                        <ul class="navbar-nav ms-auto">
                            @if (Session["CitizenID"] != null)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Logout", "Login")">Logout</a>
                                </li>
                            }
                            else if (Session["AdministratorID"] != null)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentController=="AdministratorDashboard"?"active":"")" href="@Url.Action("Index", "AdministratorDashboard")" aria-current="@(currentController=="AdministratorDashboard"?"page":null)">Admin</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Logout", "Administrators")">Logout</a>
                                </li>
                            }
                            else if (Session["TechnicianID"] != null)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentController=="Technicians"?"active":"")" href="@Url.Action("Dashboard", "Technicians")" aria-current="@(currentController=="Technicians"?"page":null)">Technician</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Logout", "Technicians")">Logout</a>
                                </li>
                            }
                            else if (Session["FinanceOfficerID"] != null)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentController=="FinanceDashboard"?"active":"")" href="@Url.Action("Index", "FinanceDashboard")" aria-current="@(currentController=="FinanceDashboard"?"page":null)">Finance</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Logout", "FinanceOfficer")">Logout</a>
                                </li>
                            }
                            else if (Session["HROfficerID"] != null)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(currentController=="HROfficerDashboard"?"active":"")" href="@Url.Action("Index", "HROfficerDashboard")" aria-current="@(currentController=="HROfficerDashboard"?"page":null)">HR</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Logout", "HROfficer")">Logout</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "Login")">Login</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }


    <!-- =====================================================
         PAGE CONTENT
         ===================================================== -->

    <main class="container body-content">

        @RenderBody()

    </main>


    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <footer class="container">

        <hr />

        <p>
            &copy; @DateTime.Now.Year -
            Community Service Request System
        </p>

    </footer>


    <!-- =====================================================
         SCRIPTS
         ===================================================== -->

    @Scripts.Render("~/bundles/jquery")

    @Scripts.Render("~/bundles/bootstrap")
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    @RenderSection("scripts", required: false)

</body>

</html>