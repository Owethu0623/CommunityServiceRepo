@model CommunityServiceProject.ViewModels.TechnicianApplicationCreateViewModel

@{
    ViewBag.Title = "Apply for Technician Opportunity";
}

<div class="application-page">

    <div class="application-header">

        <div>
            <div class="application-eyebrow">
                MUNICIPAL TECHNICIAN RECRUITMENT
            </div>

            <h1>Apply for Technician Opportunity</h1>

            <p>
                Submit your application using your existing municipal citizen account.
            </p>
        </div>

    </div>


    @using (Html.BeginForm(
        "Create",
        "TechnicianApplication",
        FormMethod.Post,
        new
        {
            @class = "application-form",
            id = "technicianApplicationForm"
        }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(
            model => model.OpportunityID
        )


        @Html.ValidationSummary(
            true,
            "",
            new
            {
                @class = "validation-summary"
            }
        )


        <!-- ========================================================
             OPPORTUNITY INFORMATION
             ======================================================== -->

        <div class="form-card">

            <div class="section-header">
                <h2>Opportunity</h2>
                <p>
                    Review the position information before submitting your application.
                </p>
            </div>

            <div class="opportunity-summary">

                <div class="summary-main">

                    <span class="opportunity-code">
                        @Model.OpportunityCode
                    </span>

                    <h3>
                        @Model.OpportunityTitle
                    </h3>

                </div>

                <div class="summary-details">

                    <div>
                        <span>Employment Type</span>
                        <strong>
                            @Model.EmploymentType
                        </strong>
                    </div>

                    <div>
                        <span>Positions</span>
                        <strong>
                            @(Model.NumberOfPositions.HasValue
                                ? Model.NumberOfPositions.ToString()
                                : "Not specified")
                        </strong>
                    </div>

                    <div>
                        <span>Application Deadline</span>
                        <strong>
                            @Model.ApplicationDeadline
                            .ToString("dd MMM yyyy")
                        </strong>
                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================================
             APPLICATION
             ======================================================== -->

        <div class="form-card">

            <div class="section-header">
                <h2>Your Application</h2>

                <p>
                    Explain your interest in the opportunity and how your
                    experience and qualifications relate to the position.
                </p>
            </div>

            <div class="form-group">

                @Html.LabelFor(
                    model => model.CoverLetter
                )

                @Html.TextAreaFor(
                    model => model.CoverLetter,
                    new
                    {
                        @class = "form-control cover-letter",
                        rows = 14,
                        maxlength = "4000",
                        placeholder =
                            "Explain why you are interested in this opportunity, " +
                            "your relevant experience, qualifications and skills, " +
                            "and why you should be considered for the position."
                    }
                )

                @Html.ValidationMessageFor(
                    model => model.CoverLetter,
                    "",
                    new
                    {
                        @class = "field-validation"
                    }
                )

                <div class="field-help">
                    Minimum 50 characters. Maximum 4,000 characters.
                </div>

                <div class="character-counter">
                    <span id="characterCount">0</span>
                    / 4000 characters
                </div>

            </div>

        </div>


        <!-- ========================================================
             SUBMISSION NOTICE
             ======================================================== -->

        <div class="submission-notice">

            <h3>Before you submit</h3>

            <p>
                Please make sure the information in your application is
                accurate and complete. Once submitted, your application
                will be recorded against your existing citizen account.
            </p>

            <p>
                Supporting documents can be submitted after the application
                is created through the application process.
            </p>

        </div>


        <!-- ========================================================
             ACTIONS
             ======================================================== -->

        <div class="form-actions">

            @Html.ActionLink(
                "Cancel",
                "Details",
                "TechnicianOpportunity",
                new
                {
                    id = Model.OpportunityID
                },
                new
                {
                    @class = "btn-secondary"
                }
            )

            <button type="submit"
                    class="btn-primary"
                    id="submitApplicationButton">

                Submit Application

            </button>

        </div>
    }

</div>


<style>

    .application-page {
        max-width: 950px;
        margin: 30px auto 60px;
        padding: 0 20px;
        font-family: Arial, Helvetica, sans-serif;
        color: #263238;
    }

    .application-header {
        background: linear-gradient( 135deg, #0D5CC1, #094b9f );
        color: white;
        border-radius: 12px;
        padding: 30px;
        margin-bottom: 20px;
        box-shadow: 0 5px 18px rgba(0,0,0,.08);
    }

    .application-eyebrow {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.2px;
        margin-bottom: 8px;
        color: white;
    }

    .application-header h1 {
        margin: 0 0 8px;
        color: white;
        font-size: 29px;
    }

    .application-header p {
        margin: 0;
        color: white;
        font-size: 14px;
        line-height: 1.6;
    }

    .form-card {
        background: white;
        border: 1px solid #e0e6ed;
        border-radius: 10px;
        padding: 25px;
        margin-bottom: 18px;
        box-shadow: 0 3px 10px rgba(0,0,0,.04);
    }

    .section-header {
        border-bottom: 1px solid #edf0f3;
        padding-bottom: 15px;
        margin-bottom: 20px;
    }

        .section-header h2 {
            margin: 0 0 5px;
            color: #263b50;
            font-size: 20px;
        }

        .section-header p {
            margin: 0;
            color: #71808e;
            font-size: 13px;
            line-height: 1.6;
        }

    .opportunity-summary {
        border: 1px solid #dce5ef;
        border-radius: 8px;
        overflow: hidden;
    }

    .summary-main {
        padding: 20px;
        background: #f6f9fc;
        border-bottom: 1px solid #dce5ef;
    }

    .opportunity-code {
        color: #0D5CC1;
        font-size: 12px;
        font-weight: 700;
    }

    .summary-main h3 {
        margin: 6px 0 0;
        color: #263b50;
        font-size: 21px;
    }

    .summary-details {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
    }

        .summary-details > div {
            padding: 17px 20px;
            border-right: 1px solid #e4e9ee;
        }

            .summary-details > div:last-child {
                border-right: none;
            }

        .summary-details span {
            display: block;
            color: #788692;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .summary-details strong {
            color: #344454;
            font-size: 13px;
        }

    .form-group {
        position: relative;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #344454;
            font-size: 13px;
            font-weight: 700;
        }

    .form-control {
        width: 100%;
        box-sizing: border-box;
        border: 1px solid #ccd5df;
        border-radius: 7px;
        padding: 12px;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 14px;
        line-height: 1.6;
        resize: vertical;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

        .form-control:focus {
            outline: none;
            border-color: #0D5CC1;
            box-shadow: 0 0 0 3px rgba(13,92,193,.10);
        }

    .cover-letter {
        min-height: 300px;
    }

    .field-help {
        margin-top: 7px;
        color: #7b8792;
        font-size: 11px;
    }

    .character-counter {
        margin-top: 5px;
        text-align: right;
        color: #7b8792;
        font-size: 11px;
    }

    .validation-summary {
        background: #fff1f1;
        border: 1px solid #efc4c4;
        border-radius: 8px;
        color: #a32121;
        padding: 14px 18px;
        margin-bottom: 18px;
        font-size: 13px;
    }

        .validation-summary ul {
            margin: 5px 0 0;
            padding-left: 20px;
        }

    .field-validation {
        display: block;
        color: #b42318;
        margin-top: 6px;
        font-size: 12px;
    }

    .input-validation-error {
        border-color: #c93636;
        background: #fffafa;
    }

    .submission-notice {
        background: #f3f7fc;
        border: 1px solid #d5e2f1;
        border-left: 4px solid #0D5CC1;
        border-radius: 8px;
        padding: 18px 20px;
        margin-bottom: 20px;
    }

        .submission-notice h3 {
            margin: 0 0 8px;
            color: #263b50;
            font-size: 15px;
        }

        .submission-notice p {
            margin: 5px 0;
            color: #536271;
            font-size: 12px;
            line-height: 1.6;
        }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .btn-primary,
    .btn-secondary {
        min-height: 42px;
        padding: 10px 18px;
        border-radius: 7px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
    }

    .btn-primary {
        background: #0D5CC1;
        border: 1px solid #0D5CC1;
        color: white;
    }

        .btn-primary:hover {
            background: #094b9f;
            border-color: #094b9f;
            color: white;
        }

    .btn-secondary {
        background: white;
        border: 1px solid #cbd5df;
        color: #394957;
    }

        .btn-secondary:hover {
            background: #f5f7fa;
            color: #263238;
            text-decoration: none;
        }

    @@media (max-width: 700px) {

        .application-page {
            padding: 0 12px;
            margin-top: 18px;
        }

        .application-header {
            padding: 23px;
        }

            .application-header h1 {
                font-size: 24px;
            }

        .summary-details {
            grid-template-columns: 1fr;
        }

            .summary-details > div {
                border-right: none;
                border-bottom: 1px solid #e4e9ee;
            }

                .summary-details > div:last-child {
                    border-bottom: none;
                }

        .form-actions {
            flex-direction: column-reverse;
        }

            .form-actions .btn-primary,
            .form-actions .btn-secondary {
                width: 100%;
            }
    }
</style>


<script>

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            var coverLetter =
                document.getElementById(
                    "CoverLetter"
                );

            var characterCount =
                document.getElementById(
                    "characterCount"
                );

            var submitButton =
                document.getElementById(
                    "submitApplicationButton"
                );


            function updateCharacterCount() {

                if (!coverLetter)
                    return;

                characterCount.textContent =
                    coverLetter.value.length;
            }


            updateCharacterCount();


            if (coverLetter) {

                coverLetter.addEventListener(
                    "input",
                    updateCharacterCount
                );

            }


            document
                .getElementById(
                    "technicianApplicationForm"
                )
                .addEventListener(
                    "submit",
                    function () {

                        submitButton.disabled = true;

                        submitButton.textContent =
                            "Submitting...";

                    }
                );

        }
    );

</script>
