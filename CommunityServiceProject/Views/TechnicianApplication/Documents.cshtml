@model IEnumerable<CommunityServiceProject.Models.ApplicationDocument>

@using System.Linq
@using CommunityServiceProject.Models

@{
    ViewBag.Title = "Supporting Documents";

    var application =
        ViewBag.Application as TechnicianApplication;

    var canUpload =
        ViewBag.CanUpload != null &&
        (bool)ViewBag.CanUpload;

    var canUpdateDocuments =
        ViewBag.CanUpdateDocuments != null &&
        (bool)ViewBag.CanUpdateDocuments;

    var rejectedDocumentCount =
        ViewBag.RejectedDocumentCount != null
            ? (int)ViewBag.RejectedDocumentCount
            : 0;
}

<div class="documents-page">

    <div class="documents-header">

        <div>
            <span class="page-kicker">TECHNICIAN RECRUITMENT</span>

            <h1>Supporting Documents</h1>

            <p>
                View the documents submitted with your technician application.
            </p>
        </div>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-message success-message">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-message error-message">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (canUpdateDocuments && rejectedDocumentCount > 0)
    {
        <div class="documents-action-required">

            <div class="action-required-icon">
                !
            </div>

            <div class="action-required-content">

                <h2>Action Required</h2>

                <p>
                    One or more supporting documents were rejected by the
                    administrator. Please replace the rejected documents
                    below before your application can continue.
                </p>

                <strong>
                    @rejectedDocumentCount
                    @(rejectedDocumentCount == 1
                        ? "document requires"
                        : "documents require")
                    your attention.
                </strong>

            </div>

        </div>
    }

    <div class="documents-layout">

        <main class="documents-main">

            <div class="application-card">

                <div class="card-heading">

                    <div>
                        <h2>Application Information</h2>

                        <p>
                            Documents associated with this application.
                        </p>
                    </div>

                </div>

                @if (application != null)
                {
                    <div class="application-information">

                        <div class="information-item">
                            <span>Application Reference</span>
                            <strong>
                                @application.ApplicationReference
                            </strong>
                        </div>

                        <div class="information-item">
                            <span>Opportunity</span>
                            <strong>
                                @application.Opportunity.OpportunityCode
                            </strong>
                        </div>

                        <div class="information-item">
                            <span>Position</span>
                            <strong>
                                @application.Opportunity.Title
                            </strong>
                        </div>

                        <div class="information-item">
                            <span>Application Status</span>

                            <strong>
                                @if (application.Status ==
                                    TechnicianApplicationStatus.DocumentsPending)
                                {
                                    <span class="application-status-rejected">
                                        @application.Status
                                    </span>
                                }
                                else
                                {
                                    @application.Status
                                }
                            </strong>

                        </div>

                    </div>
                }

            </div>

            <div class="documents-card">

                <div class="documents-card-header">

                    <div>
                        <h2>Submitted Documents</h2>

                        <p>
                            Review the documents you have submitted for this application.
                        </p>
                    </div>

                    @if (canUpload && application != null)
                    {
                        @Html.ActionLink(
                            "Upload Supporting Document",
                            "UploadDocument",
                            "TechnicianApplication",
                            new { id = application.ApplicationID },
                            new { @class = "btn-primary" }
                        )
                    }

                </div>

                @if (canUpdateDocuments && rejectedDocumentCount > 0)
                {
                    <div class="replacement-instruction">

                        <div class="replacement-instruction-title">
                            Documents requiring replacement
                        </div>

                        <p>
                            Documents marked as <strong>Rejected</strong> must
                            be replaced. Accepted documents do not require any
                            further action.
                        </p>

                    </div>
                }

                @if (Model != null && Model.Any())
                {
                    <div class="document-list">

                        @foreach (var document in Model)
                        {
                            var isRejected =
                                document.VerificationStatus ==
                                ApplicationDocumentVerificationStatus.Rejected;

                            var isAccepted =
                                document.VerificationStatus ==
                                ApplicationDocumentVerificationStatus.Accepted;

                            var isPending =
                                document.VerificationStatus ==
                                ApplicationDocumentVerificationStatus.Pending;

                            <div class="document-entry">

                                <div class="document-row">

                                    <div class="document-information">

                                        <div class="document-title">
                                            @document.DocumentTitle
                                        </div>

                                        <div class="document-meta">

                                            <span>
                                                @document.DocumentType
                                            </span>

                                            <span>
                                                @document.FileName
                                            </span>

                                            <span>
                                                @document.DateSubmitted.ToString(
                                                    "dd MMM yyyy HH:mm")
                                            </span>

                                        </div>

                                    </div>

                                    <div class="document-status">

                                        @if (isPending)
                                        {
                                            <span class="status-badge status-pending">
                                                Pending Verification
                                            </span>
                                        }
                                        else if (isAccepted)
                                        {
                                            <span class="status-badge status-accepted">
                                                Accepted
                                            </span>
                                        }
                                        else if (isRejected)
                                        {
                                            <span class="status-badge status-rejected">
                                                Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-default">
                                                @document.VerificationStatus
                                            </span>
                                        }

                                    </div>

                                    <div class="document-actions">

                                        @Html.ActionLink(
                                            "View Document",
                                            "ViewDocument",
                                            "TechnicianApplication",
                                            new
                                            {
                                                id = document.ApplicationDocumentID
                                            },
                                            new
                                            {
                                                @class = "document-view-button",
                                                target = "_blank"
                                            }
                                        )

                                        @if (isRejected &&
                                             application != null &&
                                             application.Status ==
                                             TechnicianApplicationStatus.DocumentsPending)
                                        {
                                            @Html.ActionLink(
                                                "Replace Document",
                                                "ReplaceRejectedDocument",
                                                "TechnicianApplication",
                                                new
                                                {
                                                    id =
                                                        document.ApplicationDocumentID
                                                },
                                                new
                                                {
                                                    @class =
                                                        "document-replace-button"
                                                }
                                            )
                                        }

                                    </div>

                                </div>

                                @if (isRejected &&
                                     !string.IsNullOrWhiteSpace(
                                         document.VerificationComments))
                                {
                                    <div class="verification-comment rejected-comment">

                                        <div class="verification-comment-heading">

                                            <span class="verification-comment-icon">
                                                !
                                            </span>

                                            <strong>
                                                Administrator's comments
                                            </strong>

                                        </div>

                                        <p>
                                            @document.VerificationComments
                                        </p>

                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(
                                    document.VerificationComments))
                                {
                                    <div class="verification-comment">

                                        <strong>
                                            Verification Comment
                                        </strong>

                                        <p>
                                            @document.VerificationComments
                                        </p>

                                    </div>
                                }

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="empty-documents">

                        <h3>No Supporting Documents Submitted</h3>

                        <p>
                            You have not submitted any supporting documents
                            for this application yet.
                        </p>

                        @if (canUpload && application != null)
                        {
                            @Html.ActionLink(
                                "Upload Supporting Document",
                                "UploadDocument",
                                "TechnicianApplication",
                                new { id = application.ApplicationID },
                                new { @class = "btn-primary" }
                            )
                        }

                    </div>
                }

            </div>

        </main>

        <aside class="documents-sidebar">

            @if (canUpdateDocuments && rejectedDocumentCount > 0)
            {
                <div class="sidebar-card sidebar-action-card">

                    <div class="sidebar-action-icon">
                        !
                    </div>

                    <div class="sidebar-heading">
                        <h2>Update Required</h2>
                    </div>

                    <p class="sidebar-action-text">
                        Please replace the rejected documents shown on this page.
                    </p>

                    <p class="sidebar-action-count">
                        @rejectedDocumentCount
                        @(rejectedDocumentCount == 1
                            ? "document"
                            : "documents")
                        require attention.
                    </p>

                </div>
            }

            <div class="sidebar-card">

                <div class="sidebar-heading">
                    <h2>Document Status</h2>
                </div>

                <div class="status-explanation">

                    <div class="status-explanation-item">
                        <span class="status-dot pending-dot"></span>

                        <div>
                            <strong>Pending Verification</strong>
                            <p>
                                Your document has been submitted and is
                                waiting for administrator review.
                            </p>
                        </div>
                    </div>

                    <div class="status-explanation-item">
                        <span class="status-dot accepted-dot"></span>

                        <div>
                            <strong>Accepted</strong>
                            <p>
                                The administrator has verified the document.
                            </p>
                        </div>
                    </div>

                    <div class="status-explanation-item">
                        <span class="status-dot rejected-dot"></span>

                        <div>
                            <strong>Rejected</strong>
                            <p>
                                The administrator did not accept the document.
                                A replacement may be required.
                            </p>
                        </div>
                    </div>

                </div>

            </div>

            <div class="sidebar-card">

                <div class="sidebar-heading">
                    <h2>Navigation</h2>
                </div>

                @if (application != null)
                {
                    @Html.ActionLink(
                        "Back to Application Status",
                        "Status",
                        "TechnicianApplication",
                        new { id = application.ApplicationID },
                        new
                        {
                            @class =
                                "sidebar-link primary-navigation"
                        }
                    )
                }

                @Html.ActionLink(
                    "Back to My Applications",
                    "Index",
                    "TechnicianApplication",
                    null,
                    new
                    {
                        @class = "sidebar-link"
                    }
                )

            </div>

        </aside>

    </div>

</div>

<style>

    .documents-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 30px 20px 50px;
        color: #263238;
    }

    .documents-header {
        background: linear-gradient(135deg, #0D5CC1, #094b9f);
        color: #ffffff;
        border-radius: 14px;
        padding: 30px 34px;
        margin-bottom: 24px;
    }

    .page-kicker {
        display: block;
        color: #dceaff;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.4px;
        margin-bottom: 8px;
    }

    .documents-header h1 {
        margin: 0 0 8px;
        font-size: 30px;
    }

    .documents-header p {
        margin: 0;
        color: #e7f0ff;
        font-size: 15px;
    }

    .alert-message {
        padding: 14px 18px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .success-message {
        background: #edf9f1;
        border: 1px solid #b8dfc4;
        color: #216e39;
    }

    .error-message {
        background: #fff1f1;
        border: 1px solid #efb0b0;
        color: #a12626;
    }

    /* =========================================================
       DOCUMENTS PENDING - ACTION REQUIRED
       ========================================================= */

    .documents-action-required {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        background: #fff5f5;
        border: 1px solid #efc4c4;
        border-left: 5px solid #c33b3b;
        border-radius: 10px;
        padding: 18px 20px;
        margin-bottom: 22px;
    }

    .action-required-icon {
        width: 34px;
        height: 34px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #c33b3b;
        color: #ffffff;
        font-size: 16px;
        font-weight: 800;
    }

    .action-required-content h2 {
        margin: 0 0 5px;
        color: #922d2d;
        font-size: 17px;
    }

    .action-required-content p {
        margin: 0 0 6px;
        color: #694747;
        font-size: 13px;
        line-height: 1.6;
    }

    .action-required-content strong {
        color: #922d2d;
        font-size: 12px;
    }

    /* =========================================================
       LAYOUT
       ========================================================= */

    .documents-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 310px;
        gap: 24px;
        align-items: start;
    }

    .documents-main {
        display: flex;
        flex-direction: column;
        gap: 22px;
    }

    .application-card,
    .documents-card,
    .sidebar-card {
        background: #ffffff;
        border: 1px solid #e0e6ed;
        border-radius: 12px;
        box-shadow: 0 3px 12px rgba(20, 50, 80, 0.06);
    }

    .application-card,
    .documents-card {
        padding: 26px;
    }

    .card-heading,
    .documents-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding-bottom: 18px;
        border-bottom: 1px solid #e5e9ee;
        margin-bottom: 20px;
    }

        .card-heading h2,
        .documents-card-header h2 {
            margin: 0 0 5px;
            color: #17324d;
            font-size: 19px;
        }

        .card-heading p,
        .documents-card-header p {
            margin: 0;
            color: #697586;
            font-size: 14px;
        }

    /* =========================================================
       APPLICATION INFORMATION
       ========================================================= */

    .application-information {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    .information-item {
        background: #f7f9fb;
        border: 1px solid #e5e9ee;
        border-radius: 8px;
        padding: 14px;
    }

        .information-item span {
            display: block;
            color: #7a8795;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .6px;
            margin-bottom: 5px;
        }

        .information-item strong {
            color: #1d3852;
            font-size: 14px;
        }

    .application-status-rejected {
        color: #a12626;
    }

    /* =========================================================
       BUTTONS
       ========================================================= */

    .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 17px;
        background: #0D5CC1;
        color: #ffffff;
        border-radius: 7px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
    }

        .btn-primary:hover {
            background: #094b9f;
            color: #ffffff;
            text-decoration: none;
        }

    /* =========================================================
       REPLACEMENT INSTRUCTION
       ========================================================= */

    .replacement-instruction {
        margin-bottom: 4px;
        padding: 14px 16px;
        background: #fff8f8;
        border: 1px solid #efd1d1;
        border-radius: 8px;
    }

    .replacement-instruction-title {
        color: #922d2d;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .replacement-instruction p {
        margin: 0;
        color: #725858;
        font-size: 12px;
        line-height: 1.55;
    }

    .replacement-instruction strong {
        color: #a12626;
    }

    /* =========================================================
       DOCUMENT LIST
       ========================================================= */

    .document-list {
        display: flex;
        flex-direction: column;
    }

    .document-entry {
        border-bottom: 1px solid #e8edf2;
    }

        .document-entry:last-child {
            border-bottom: none;
        }

    .document-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto auto;
        gap: 18px;
        align-items: center;
        padding: 18px 0;
    }

    .document-title {
        color: #1d3852;
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .document-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 7px 14px;
        color: #748190;
        font-size: 12px;
    }

        .document-meta span {
            position: relative;
        }

    .document-status {
        white-space: nowrap;
    }

    .status-badge {
        display: inline-block;
        padding: 7px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .status-pending {
        background: #fff5dc;
        color: #8a6200;
    }

    .status-accepted {
        background: #eaf7ee;
        color: #21733c;
    }

    .status-rejected {
        background: #fff0f0;
        color: #a12626;
    }

    .status-default {
        background: #eef2f6;
        color: #4f6070;
    }

    .document-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .document-view-button,
    .document-replace-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 38px;
        padding: 0 14px;
        border-radius: 7px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
    }

    .document-view-button {
        border: 1px solid #0D5CC1;
        color: #0D5CC1;
        background: #ffffff;
    }

        .document-view-button:hover {
            background: #f1f6fc;
            color: #094b9f;
            text-decoration: none;
        }

    .document-replace-button {
        border: 1px solid #c33b3b;
        color: #ffffff;
        background: #c33b3b;
    }

        .document-replace-button:hover {
            background: #a12626;
            border-color: #a12626;
            color: #ffffff;
            text-decoration: none;
        }

    /* =========================================================
       VERIFICATION COMMENTS
       ========================================================= */

    .verification-comment {
        margin: 0 0 14px;
        padding: 13px 15px;
        background: #f8fafc;
        border-left: 3px solid #0D5CC1;
        color: #526273;
        font-size: 13px;
    }

        .verification-comment strong {
            color: #263b50;
        }

        .verification-comment p {
            margin: 5px 0 0;
            line-height: 1.5;
        }

    .rejected-comment {
        background: #fff7f7;
        border-left-color: #c33b3b;
        color: #694747;
    }

    .verification-comment-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #922d2d;
    }

    .verification-comment-icon {
        width: 20px;
        height: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #c33b3b;
        color: #ffffff;
        font-size: 11px;
        font-weight: 800;
    }

    /* =========================================================
       EMPTY STATE
       ========================================================= */

    .empty-documents {
        text-align: center;
        padding: 45px 20px;
    }

        .empty-documents h3 {
            margin: 0 0 8px;
            color: #29435c;
            font-size: 18px;
        }

        .empty-documents p {
            margin: 0 auto 20px;
            max-width: 500px;
            color: #758291;
            font-size: 14px;
            line-height: 1.6;
        }

    /* =========================================================
       SIDEBAR
       ========================================================= */

    .documents-sidebar {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .sidebar-card {
        padding: 20px;
    }

    .sidebar-heading {
        padding-bottom: 14px;
        border-bottom: 1px solid #e5e9ee;
        margin-bottom: 15px;
    }

        .sidebar-heading h2 {
            margin: 0;
            color: #17324d;
            font-size: 18px;
        }

    .sidebar-action-card {
        background: #fff8f8;
        border-color: #efd1d1;
        border-left: 4px solid #c33b3b;
    }

    .sidebar-action-icon {
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #c33b3b;
        color: #ffffff;
        font-size: 14px;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .sidebar-action-card .sidebar-heading {
        border-bottom-color: #efd1d1;
    }

        .sidebar-action-card .sidebar-heading h2 {
            color: #922d2d;
        }

    .sidebar-action-text {
        margin: 0 0 7px;
        color: #694747;
        font-size: 12px;
        line-height: 1.55;
    }

    .sidebar-action-count {
        margin: 0;
        color: #922d2d;
        font-size: 12px;
        font-weight: 700;
    }

    .status-explanation {
        display: flex;
        flex-direction: column;
        gap: 17px;
    }

    .status-explanation-item {
        display: flex;
        gap: 11px;
        align-items: flex-start;
    }

    .status-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        margin-top: 5px;
        flex-shrink: 0;
    }

    .pending-dot {
        background: #d49a00;
    }

    .accepted-dot {
        background: #2d8a4e;
    }

    .rejected-dot {
        background: #c33b3b;
    }

    .status-explanation-item strong {
        display: block;
        color: #334b62;
        font-size: 13px;
        margin-bottom: 3px;
    }

    .status-explanation-item p {
        margin: 0;
        color: #758291;
        font-size: 12px;
        line-height: 1.5;
    }

    .sidebar-link {
        display: block;
        padding: 11px 13px;
        border: 1px solid #d8e0e8;
        border-radius: 7px;
        color: #0D5CC1;
        background: #ffffff;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 9px;
    }

        .sidebar-link:last-child {
            margin-bottom: 0;
        }

        .sidebar-link:hover {
            background: #f3f7fc;
            color: #094b9f;
            text-decoration: none;
        }

    .primary-navigation {
        background: #f3f7fc;
        border-color: #bfd2e8;
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 900px) {

        .documents-layout {
            grid-template-columns: 1fr;
        }

        .documents-sidebar {
            order: 2;
        }
    }

    @@media (max-width: 700px) {

        .application-information {
            grid-template-columns: 1fr;
        }

        .documents-card-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .document-row {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .document-status,
        .document-actions {
            justify-self: start;
        }

        .document-actions {
            justify-content: flex-start;
        }
    }

    @@media (max-width: 550px) {

        .documents-page {
            padding: 20px 12px 35px;
        }

        .documents-header {
            padding: 24px 20px;
        }

            .documents-header h1 {
                font-size: 25px;
            }

        .application-card,
        .documents-card {
            padding: 20px;
        }

        .btn-primary {
            width: 100%;
        }

        .documents-action-required {
            padding: 15px;
        }

        .action-required-icon {
            width: 30px;
            height: 30px;
        }

        .document-actions {
            width: 100%;
            flex-direction: column;
            align-items: stretch;
        }

