     ============================================================= -->

<script>
    document.addEventListener("DOMContentLoaded", function () {

        var checkbox =
            document.getElementById("confirmVerification");

        var button =
            document.getElementById("completeVerificationButton");

        var form =
            document.getElementById("finalVerificationForm");

        var result =
            document.getElementById("verificationResult");


        if (!checkbox || !button || !form) {
            return;
        }


        /* =========================================================
           BUTTON STATE
           ========================================================= */

        function updateButtonState() {

            button.disabled =
                !checkbox.checked || !result || !result.value;
        }


        /* =========================================================
           CHECKBOX
           ========================================================= */

        checkbox.addEventListener(
            "change",
            updateButtonState
        );


        /* =========================================================
           FORM SUBMISSION
           ========================================================= */

        form.addEventListener(
            "submit",
            function (event) {

                /*
                 * Confirmation is mandatory.
                 */

                if (!checkbox.checked) {

                    event.preventDefault();

                    alert(
                        "Please confirm that you have completed the final verification."
                    );

                    return;
                }


                /*
                 * Verification result is mandatory.
                 */

                if (!result || !result.value) {

                    event.preventDefault();

                    alert(
                        "Please select the final verification result."
                    );

                    if (result) {
                        result.focus();
                    }

                    return;
                }


                /*
                 * Final confirmation.
                 */

                var confirmed =
                    window.confirm(
                        "Are you sure you want to complete final verification for this applicant?"
                    );


                if (!confirmed) {

                    event.preventDefault();

                    return;
                }


                /*
                 * Prevent duplicate submission.
                 */

                button.disabled = true;

                button.innerText =
                    "Saving...";

            }
        );


        /*
         * Initial state.
         */

        updateButtonState();

    });
</script>


