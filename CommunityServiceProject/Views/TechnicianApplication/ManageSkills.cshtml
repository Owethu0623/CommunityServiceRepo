@model CommunityServiceProject.ViewModels.TechnicianSkillManagementViewModel

@{
    ViewBag.Title = "Manage Technician Skill";
}

<div class="technician-skill-page">

    <div class="skill-page-header">

        <div>
            <div class="breadcrumb-text">
                Technician Management
                <span>/</span>
                Manage Skill
            </div>

            <h1>Manage Technician Skill</h1>

            <p>
                Assign or update the primary skill associated with this technician.
            </p>
        </div>

        <div class="header-actions">
            <a href="@Url.Action("Details", "TechnicianManagement", new { id = Model.TechnicianID })"
               class="btn btn-outline">
                Technician Details
            </a>

            <a href="@Url.Action("Index", "TechnicianManagement")"
               class="btn btn-light">
                Technician Management
            </a>
        </div>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="message message-success">
            <div>
                <strong>Update successful</strong>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="message message-info">
            <div>
                <strong>No change required</strong>
                <span>@TempData["InfoMessage"]</span>
            </div>
        </div>
    }


    <div class="skill-layout">

        <!-- Technician Information -->

        <section class="technician-card">

            <div class="section-heading">
                <div>
                    <span class="section-label">TECHNICIAN PROFILE</span>
                    <h2>@Model.TechnicianName</h2>
                </div>

                <span class="account-status">
                    @Model.AccountStatus
                </span>
            </div>

            <div class="profile-details">

                <div class="detail-item">
                    <span class="detail-label">Technician ID</span>
                    <span class="detail-value">
                        TECH-@Model.TechnicianID.ToString("D6")
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Municipal Email</span>
                    <span class="detail-value">
                        @Model.MunicipalEmail
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Phone Number</span>
                    <span class="detail-value">
                        @Model.PhoneNumber
                    </span>
                </div>

                <div class="detail-item">
                    <span class="detail-label">Current Primary Skill</span>

                    <span class="current-skill">
                        @(string.IsNullOrWhiteSpace(Model.CurrentSkillName)
                            ? "No primary skill assigned"
                            : Model.CurrentSkillName)
                    </span>
                </div>

            </div>

        </section>


        <!-- Skill Management -->

        <section class="management-card">

            <div class="management-header">

                <div>
                    <span class="section-label">SKILL MANAGEMENT</span>

                    <h2>Primary Skill Assignment</h2>

                    <p>
                        Select the skill that best represents this technician's
                        current area of responsibility.
                    </p>
                </div>

            </div>


            @using (Html.BeginForm(
                "ManageSkills",
                "TechnicianManagement",
                FormMethod.Post,
                new { id = "skillForm" }))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.TechnicianID)

                <div class="form-group">

                    @Html.LabelFor(
                        m => m.SelectedSkillID,
                        new { @class = "form-label" })

                    @Html.DropDownListFor(
                        m => m.SelectedSkillID,
                        new SelectList(
                            Model.AvailableSkills,
                            "SkillID",
                            "SkillName",
                            Model.SelectedSkillID),
                        "-- Select primary skill --",
                        new
                        {
                            @class = "form-control skill-select",
                            id = "SelectedSkillID"
                        })

                    @Html.ValidationMessageFor(
                        m => m.SelectedSkillID,
                        "",
                        new { @class = "validation-message" })

                </div>


                <div class="skill-description-box" id="skillDescriptionBox">

                    <span class="description-label">
                        Skill Description
                    </span>

                    <p id="skillDescription">
                        Select a skill to view its description.
                    </p>

                </div>


                <div class="change-notice">

                    <strong>Before updating</strong>

                    <span>
                        Changing the primary skill affects the technician's
                        skill profile and may influence future maintenance
                        assignment decisions.
                    </span>

                </div>


                <div class="form-actions">

                    <a href="@Url.Action(
                        "Details",
                        "TechnicianManagement",
                        new { id = Model.TechnicianID })"
                       class="btn btn-cancel">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary"
                            id="saveSkillButton">
                        Update Primary Skill
                    </button>

                </div>
            }

        </section>

    </div>


    <!-- Navigation -->

    <div class="bottom-navigation">

        <a href="@Url.Action(
            "Details",
            "TechnicianManagement",
            new { id = Model.TechnicianID })"
           class="navigation-link">
            Back to Technician Details
        </a>

        <a href="@Url.Action(
            "Index",
            "TechnicianManagement")"
           class="navigation-link">
            Back to Technician Management
        </a>

    </div>

</div>


@section Styles {

    <style>

        .technician-skill-page {
            max-width: 1250px;
            margin: 0 auto;
            padding: 30px 24px 50px;
            color: #1f2937;
        }

        .skill-page-header {
            background: #0D5CC1;
            color: white;
            border-radius: 12px;
            padding: 28px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 25px;
            margin-bottom: 24px;
            box-shadow: 0 6px 18px rgba(13, 92, 193, 0.16);
        }

        .breadcrumb-text {
            font-size: 13px;
            opacity: 0.85;
            margin-bottom: 8px;
        }

            .breadcrumb-text span {
                margin: 0 7px;
            }

        .skill-page-header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
        }

        .skill-page-header p {
            margin: 8px 0 0;
            font-size: 14px;
            opacity: 0.92;
        }

        .header-actions {
            display: flex;
            gap: 10px;
            flex-shrink: 0;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 42px;
            padding: 0 18px;
            border-radius: 7px;
            border: 1px solid transparent;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.18s ease;
        }

        .btn-light {
            background: white;
            color: #0D5CC1;
        }

            .btn-light:hover {
                background: #f1f5f9;
                text-decoration: none;
            }

        .btn-outline {
            background: transparent;
            color: white;
            border-color: rgba(255,255,255,0.65);
        }

            .btn-outline:hover {
                background: rgba(255,255,255,0.12);
                color: white;
                text-decoration: none;
            }

        .btn-primary {
            background: #0D5CC1;
            color: white;
            border-color: #0D5CC1;
        }

            .btn-primary:hover {
                background: #094b9f;
                border-color: #094b9f;
            }

        .btn-cancel {
            background: white;
            color: #374151;
            border-color: #d1d5db;
        }

            .btn-cancel:hover {
                background: #f8fafc;
                text-decoration: none;
            }

        .message {
            padding: 15px 18px;
            border-radius: 8px;
            margin-bottom: 20px;
            border: 1px solid;
        }

            .message > div {
                display: flex;
                flex-direction: column;
                gap: 3px;
            }

        .message-success {
            background: #f0fdf4;
            border-color: #bbf7d0;
            color: #166534;
        }

        .message-info {
            background: #eff6ff;
            border-color: #bfdbfe;
            color: #1e40af;
        }

        .message strong {
            font-size: 14px;
        }

        .message span {
            font-size: 13px;
        }

        .skill-layout {
            display: grid;
            grid-template-columns: 0.9fr 1.1fr;
            gap: 22px;
            align-items: start;
        }

        .technician-card,
        .management-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(15, 23, 42, 0.05);
        }

        .technician-card {
            padding: 25px;
        }

        .management-card {
            padding: 28px;
        }

        .section-heading,
        .management-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 15px;
            padding-bottom: 20px;
            border-bottom: 1px solid #eef0f3;
        }

        .section-label {
            display: block;
            color: #0D5CC1;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.08em;
            margin-bottom: 6px;
        }

        .section-heading h2,
        .management-header h2 {
            margin: 0;
            font-size: 21px;
            color: #111827;
        }

        .management-header p {
            margin: 8px 0 0;
            color: #6b7280;
            font-size: 13px;
            line-height: 1.6;
            max-width: 600px;
        }

        .account-status {
            background: #ecfdf5;
            color: #047857;
            border: 1px solid #a7f3d0;
            padding: 6px 11px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .profile-details {
            padding-top: 6px;
        }

        .detail-item {
            display: flex;
            flex-direction: column;
            gap: 5px;
            padding: 15px 0;
            border-bottom: 1px solid #f0f2f5;
        }

            .detail-item:last-child {
                border-bottom: none;
            }

        .detail-label {
            font-size: 12px;
            color: #6b7280;
            font-weight: 600;
        }

        .detail-value {
            font-size: 14px;
            color: #111827;
            font-weight: 500;
            word-break: break-word;
        }

        .current-skill {
            display: inline-block;
            width: fit-content;
            background: #eff6ff;
            color: #0D5CC1;
            border: 1px solid #bfdbfe;
            border-radius: 6px;
            padding: 7px 11px;
            font-size: 13px;
            font-weight: 700;
        }

        .form-group {
            margin-top: 25px;
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 700;
            color: #374151;
        }

        .form-control {
            width: 100%;
            box-sizing: border-box;
            min-height: 46px;
            padding: 10px 13px;
            border: 1px solid #d1d5db;
            border-radius: 7px;
            background: white;
            color: #111827;
            font-size: 14px;
            outline: none;
            transition: border-color 0.18s ease, box-shadow 0.18s ease;
        }

            .form-control:focus {
                border-color: #0D5CC1;
                box-shadow: 0 0 0 3px rgba(13, 92, 193, 0.10);
            }

        .validation-message {
            display: block;
            margin-top: 6px;
            color: #dc2626;
            font-size: 12px;
        }

        .skill-description-box {
            margin-top: 18px;
            padding: 16px;
            background: #f8fafc;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
        }

        .description-label {
            display: block;
            color: #374151;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .skill-description-box p {
            margin: 0;
            color: #6b7280;
            font-size: 13px;
            line-height: 1.55;
        }

        .change-notice {
            margin-top: 18px;
            padding: 15px;
            background: #fffbeb;
            border: 1px solid #fde68a;
            border-radius: 8px;
            color: #78350f;
        }

            .change-notice strong,
            .change-notice span {
                display: block;
            }

            .change-notice strong {
                font-size: 13px;
                margin-bottom: 4px;
            }

            .change-notice span {
                font-size: 12px;
                line-height: 1.5;
            }

        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 25px;
            padding-top: 20px;
            border-top: 1px solid #eef0f3;
        }

        .bottom-navigation {
            display: flex;
            gap: 20px;
            margin-top: 22px;
        }

        .navigation-link {
            color: #0D5CC1;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
        }

            .navigation-link:hover {
                color: #094b9f;
                text-decoration: underline;
            }

        @@media (max-width: 850px) {

            .skill-page-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .header-actions {
                width: 100%;
            }

                .header-actions .btn {
                    flex: 1;
                }

            .skill-layout {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 550px) {

            .technician-skill-page {
                padding: 20px 15px 40px;
            }

            .skill-page-header {
                padding: 22px;
            }

                .skill-page-header h1 {
                    font-size: 23px;
                }

            .header-actions,
            .form-actions,
            .bottom-navigation {
                flex-direction: column;
            }

                .header-actions .btn,
                .form-actions .btn {
                    width: 100%;
                }
        }
    </style>
}


@section Scripts {

    <script>

    (function () {

        var skillDescriptions = {};

        @foreach (var skill in Model.AvailableSkills)
        {
            <text>
                skillDescriptions["@skill.SkillID"] =
                    "@Html.Raw(HttpUtility.JavaScriptStringEncode(skill.Description ?? "No description available."))";
            </text>
        }

        var skillSelect = document.getElementById("SelectedSkillID");
        var description = document.getElementById("skillDescription");

        function updateDescription() {

            if (!skillSelect || !description) {
                return;
            }

            var selectedValue = skillSelect.value;

            if (selectedValue && skillDescriptions[selectedValue]) {
                description.textContent =
                    skillDescriptions[selectedValue];
            }
            else {
                description.textContent =
                    "Select a skill to view its description.";
            }
        }

        if (skillSelect) {
            skillSelect.addEventListener(
                "change",
                updateDescription
            );

            updateDescription();
        }

        var form = document.getElementById("skillForm");

        if (form) {

            form.addEventListener("submit", function (event) {

                var selectedOption =
                    skillSelect.options[
                        skillSelect.selectedIndex
                    ];

                if (!skillSelect.value) {
                    event.preventDefault();
                    return;
                }

                var currentSkill =
                    "@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.CurrentSkillName ?? ""))";

                var selectedSkill =
                    selectedOption.text;

                if (currentSkill === selectedSkill) {
                    return;
                }

                var confirmed = window.confirm(
                    "Update this technician's primary skill to \"" +
                    selectedSkill +
                    "\"?"
                );

                if (!confirmed) {
                    event.preventDefault();
                }
            });
        }

    })();

    </script>

}