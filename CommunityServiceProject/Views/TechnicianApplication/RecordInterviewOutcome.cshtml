@model CommunityServiceProject.ViewModels.TechnicianApplicationInterviewOutcomeViewModel

@{
    ViewBag.Title = "Record Interview Outcome";
}

<div class="record-interview-outcome-page">

    <!-- ============================================================
         PAGE HEADER
         ============================================================ -->

    <div class="record-interview-outcome-header">

        <div>
            <h1>Record Interview Outcome</h1>

            <p>
                Record the outcome of the applicant interview
                and update the applicant's recruitment stage.
            </p>

            <div class="application-reference">
                @Model.ApplicationReference
            </div>
        </div>

    </div>


    <!-- ============================================================
         MAIN LAYOUT
         ============================================================ -->

    <div class="record-interview-outcome-layout">

        <!-- ========================================================
             MAIN CONTENT
             ======================================================== -->

        <div class="record-interview-outcome-main">

            <div class="record-interview-outcome-card">

                <div class="record-interview-outcome-card-header">

                    <h2>Interview Outcome</h2>

                    <p>
                        Review the interview information below and record
                        the final outcome and any relevant comments.
                    </p>

                </div>


                <div class="record-interview-outcome-card-body">

                    @using (Html.BeginForm(
                        "RecordInterviewOutcome",
                        "TechnicianApplication",
                        FormMethod.Post,
                        new
                        {
                            id = "recordInterviewOutcomeForm"
                        }))
                    {
                        @Html.AntiForgeryToken()

                        @Html.HiddenFor(
                            model => model.InterviewID)

                        @Html.HiddenFor(
                            model => model.ApplicationID)


                        @Html.ValidationSummary(
                            true,
                            "",
                            new
                            {
                                @class = "validation-summary-errors"
                            })


                        <!-- ====================================================
                             APPLICANT INFORMATION
                             ==================================================== -->

                        <div class="information-section">

                            <h3 class="section-title">
                                Applicant Information
                            </h3>

                            <div class="information-grid">

                                <div class="information-row">
                                    <div class="information-label">
                                        Application Reference
                                    </div>

                                    <div class="information-value">
                                        @Model.ApplicationReference
                                    </div>
                                </div>


                                <div class="information-row">
                                    <div class="information-label">
                                        Applicant Name
                                    </div>

                                    <div class="information-value">
                                        @Model.ApplicantName
                                    </div>
                                </div>


                                <div class="information-row">
                                    <div class="information-label">
                                        Email Address
                                    </div>

                                    <div class="information-value">
                                        @Model.ApplicantEmail
                                    </div>
                                </div>


                                <div class="information-row">
                                    <div class="information-label">
                                        Application Date
                                    </div>

                                    <div class="information-value">
                                        @Model.ApplicationDate.ToString("dd MMM yyyy")
                                    </div>
                                </div>

                            </div>

                        </div>


                        <!-- ====================================================
                             OPPORTUNITY INFORMATION
                             ==================================================== -->

                        <div class="information-section">

                            <h3 class="section-title">
                                Opportunity Information
                            </h3>

                            <div class="information-grid">

                                <div class="information-row">
                                    <div class="information-label">
                                        Opportunity Code
                                    </div>

                                    <div class="information-value">
                                        @Model.OpportunityCode
                                    </div>
                                </div>


                                <div class="information-row">
                                    <div class="information-label">
                                        Opportunity Title
                                    </div>

                                    <div class="information-value">
                                        @Model.OpportunityTitle
                                    </div>
                                </div>

                            </div>

                        </div>


                        <!-- ====================================================
                             INTERVIEW INFORMATION
                             ==================================================== -->

                        <div class="information-section">

                            <h3 class="section-title">
                                Interview Information
                            </h3>

                            <div class="information-grid">

                                <div class="information-row">
                                    <div class="information-label">
                                        Interview Method
                                    </div>

                                    <div class="information-value">
                                        @Model.InterviewMethod
                                    </div>
                                </div>


                                <div class="information-row">
                                    <div class="information-label">
                                        Interview Date
                                    </div>

                                    <div class="information-value">
                                        @Model.InterviewDate.ToString("dd MMM yyyy")
                                    </div>
                                </div>


                                <div class="information-row">
                                    <div class="information-label">
                                        Interview Time
                                    </div>

                                    <div class="information-value">
                                        @Model.InterviewDate.ToString("HH:mm")
                                    </div>
                                </div>


                                <div class="information-row">
                                    <div class="information-label">
                                        Location
                                    </div>

                                    <div class="information-value">
                                        @Model.Location
                                    </div>
                                </div>


                                <div class="information-row">
                                    <div class="information-label">
                                        Current Status
                                    </div>

                                    <div class="information-value">

                                        <span class="status-badge">
                                            @Model.InterviewStatus
                                        </span>

                                    </div>
                                </div>

                            </div>

                        </div>


                        <!-- ====================================================
                             OUTCOME FORM
                             ==================================================== -->

                        <div class="outcome-section">

                            <div class="outcome-section-header">

                                <h3 class="section-title">
                                    Record Interview Outcome
                                </h3>

                                <p>
                                    Record the result of the interview accurately.
                                    This information becomes part of the applicant's
                                    recruitment history.
                                </p>

                            </div>


                            <!-- Outcome -->

                            <div class="form-group">

                                @Html.LabelFor(
                                    model => model.Outcome,
                                    new
                                    {
                                        @class = "form-label"
                                    })

                                <span class="required-indicator">
                                    *
                                </span>

                                @Html.TextAreaFor(
                                    model => model.Outcome,
                                    new
                                    {
                                        @class = "form-control outcome-textarea",
                                        placeholder =
                                            "Enter the interview outcome..."
                                    })

                                @Html.ValidationMessageFor(
                                    model => model.Outcome,
                                    "",
                                    new
                                    {
                                        @class = "field-validation-error"
                                    })

                                <span class="form-help">
                                    Provide a clear summary of the interview outcome.
                                </span>

                            </div>


                            <!-- Comments -->

                            <div class="form-group">

                                @Html.LabelFor(
                                    model => model.Comments,
                                    new
                                    {
                                        @class = "form-label"
                                    })

                                <span class="optional-label">
                                    Optional
                                </span>

                                @Html.TextAreaFor(
                                    model => model.Comments,
                                    new
                                    {
                                        @class = "form-control comments-textarea",
                                        placeholder =
                                            "Enter any additional interview comments..."
                                    })

                                @Html.ValidationMessageFor(
                                    model => model.Comments,
                                    "",
                                    new
                                    {
                                        @class = "field-validation-error"
                                    })

                                <span class="form-help">
                                    Add relevant observations or supporting comments
                                    where necessary.
                                </span>

                            </div>

                        </div>


                        <!-- ====================================================
                             CONFIRMATION
                             ==================================================== -->

                        <div class="confirmation-section">

                            <label class="confirmation-label">

                                <input type="checkbox"
                                       id="confirmInterviewOutcome" />

                                <span>
                                    I confirm that the interview outcome and
                                    comments entered above are accurate and
                                    ready to be recorded.
                                </span>

                            </label>

                        </div>


                        <!-- ====================================================
                             ACTIONS
                             ==================================================== -->

                        <div class="form-actions">

                            <a href="@Url.Action(
                                "Review",
                                "TechnicianApplication",
                                new
                                {
                                    id = Model.ApplicationID
                                })"
                               class="secondary-button">
                                Back to Application
                            </a>

                            <button type="submit"
                                    id="recordOutcomeButton"
                                    class="primary-button"
                                    disabled>
                                Record Interview Outcome
                            </button>

                        </div>

                    }

                </div>

            </div>


            <!-- ========================================================
                 NAVIGATION
                 ======================================================== -->

            <div class="page-navigation">

                <a href="@Url.Action(
                    "ReviewApplications",
                    "TechnicianApplication")"
                   class="navigation-button">
                    Back to Applications
                </a>

                <a href="@Url.Action(
                    "Manage",
                    "TechnicianOpportunity")"
                   class="navigation-button">
                    Opportunity Management
                </a>

            </div>

        </div>


        <!-- ========================================================
             SIDEBAR
             ======================================================== -->

        <aside class="record-interview-outcome-sidebar">


            <!-- ====================================================
                 RECRUITMENT PROGRESS
                 ==================================================== -->

            <div class="sidebar-card">

                <div class="sidebar-card-header">
                    <h3>Recruitment Progress</h3>
                </div>

                <div class="sidebar-card-body">

                    <div class="progress-list">

                        <div class="progress-step completed">

                            <div class="progress-marker"></div>

                            <div class="progress-content">
                                <strong>Application Submitted</strong>
                                <span>Application received.</span>
                            </div>

                        </div>


                        <div class="progress-step completed">

                            <div class="progress-marker"></div>

                            <div class="progress-content">
                                <strong>Application Screening</strong>
                                <span>Application requirements reviewed.</span>
                            </div>

                        </div>


                        <div class="progress-step completed">

                            <div class="progress-marker"></div>

                            <div class="progress-content">
                                <strong>Assessment</strong>
                                <span>Assessment completed.</span>
                            </div>

                        </div>


                        <div class="progress-step current">

                            <div class="progress-marker"></div>

                            <div class="progress-content">
                                <strong>Interview</strong>
                                <span>Record the interview outcome.</span>
                            </div>

                        </div>


                        <div class="progress-step">

                            <div class="progress-marker"></div>

                            <div class="progress-content">
                                <strong>Selection</strong>
                                <span> HR records selection decision.</span>
                            </div>

                        </div>


                        <div class="progress-step">

                            <div class="progress-marker"></div>

                            <div class="progress-content">
                                <strong>Final Verification</strong>
                                <span>Final applicant verification.</span>
                            </div>

                        </div>


                        <div class="progress-step">

                            <div class="progress-marker"></div>

                            <div class="progress-content">
                                <strong>Onboarding</strong>
                                <span>Successful applicant is onboarded.</span>
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ====================================================
                 GUIDANCE
                 ==================================================== -->

            <div class="sidebar-card">

                <div class="sidebar-card-header">
                    <h3>Recording Guidance</h3>
                </div>

                <div class="sidebar-card-body">

                    <ul class="guidance-list">

                        <li>
                            Record the actual outcome of the interview.
                        </li>

                        <li>
                            Include relevant observations where appropriate.
                        </li>

                        <li>
                            Ensure the recorded information is accurate
                            before confirming.
                        </li>

                        <li>
                            Recording the outcome moves the application
                            to the interviewed stage.
                        </li>

                    </ul>

                </div>

            </div>


            <!-- ====================================================
                 CURRENT STAGE
                 ==================================================== -->

            <div class="sidebar-card current-stage-card">

                <div class="sidebar-card-header">
                    <h3>Current Stage</h3>
                </div>

                <div class="sidebar-card-body">

                    <div class="current-stage-status">
                        Interview Scheduled
                    </div>

                    <p>
                        Once the outcome is recorded, the application will
                        move to the <strong>Interviewed</strong> stage.
                    </p>

                </div>

            </div>

        </aside>

    </div>

</div>


<style>

    /* ============================================================
       PAGE
       ============================================================ */

    .record-interview-outcome-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 32px 24px 50px;
        color: #1f2937;
        font-family: Arial, Helvetica, sans-serif;
    }


    /* ============================================================
       HEADER
       ============================================================ */

    .record-interview-outcome-header {
        background: #0D5CC1;
        border-radius: 10px;
        padding: 24px 28px;
        margin-bottom: 24px;
        color: #ffffff;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
    }

    .record-interview-outcome-header h1 {
        margin: 0 0 7px;
        color: #ffffff;
        font-size: 28px;
        font-weight: 700;
        line-height: 1.25;
    }

    .record-interview-outcome-header p {
        margin: 0;
        color: #ffffff;
        font-size: 14px;
        line-height: 1.6;
        opacity: 0.95;
    }

    .application-reference {
        display: inline-block;
        margin-top: 14px;
        padding: 7px 12px;
        border: 1px solid rgba(255, 255, 255, 0.35);
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.12);
        color: #ffffff;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0.3px;
    }


    /* ============================================================
       MAIN LAYOUT
       ============================================================ */

    .record-interview-outcome-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 310px;
        gap: 24px;
        align-items: start;
    }


    /* ============================================================
       MAIN CARD
       ============================================================ */

    .record-interview-outcome-card {
        background: #ffffff;
        border: 1px solid #e1e7ef;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
        overflow: hidden;
    }

    .record-interview-outcome-card-header {
        padding: 20px 24px;
        border-bottom: 1px solid #e5e7eb;
        background: #f8fafc;
    }

    .record-interview-outcome-card-header h2 {
        margin: 0;
        color: #17324d;
        font-size: 20px;
        font-weight: 700;
    }

    .record-interview-outcome-card-header p {
        margin: 6px 0 0;
        color: #64748b;
        font-size: 13px;
        line-height: 1.5;
    }

    .record-interview-outcome-card-body {
        padding: 26px 28px 30px;
    }


    /* ============================================================
       INFORMATION SECTIONS
       ============================================================ */

    .information-section {
        margin-bottom: 30px;
    }

    .information-section:last-of-type {
        margin-bottom: 28px;
    }

    .section-title {
        margin: 0 0 16px;
        padding-bottom: 10px;
        border-bottom: 2px solid #0D5CC1;
        color: #17324d;
        font-size: 16px;
        font-weight: 700;
    }

    .information-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 34px;
    }

    .information-row {
        display: grid;
        grid-template-columns: 145px minmax(0, 1fr);
        align-items: start;
        min-height: 46px;
        padding: 11px 0;
        border-bottom: 1px solid #edf0f4;
    }

    .information-label {
        padding-right: 14px;
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
        line-height: 1.5;
    }

    .information-value {
        min-width: 0;
        color: #1f2937;
        font-size: 14px;
        font-weight: 600;
        line-height: 1.5;
        overflow-wrap: anywhere;
        word-break: break-word;
    }


    /* ============================================================
       STATUS
       ============================================================ */

    .status-badge {
        display: inline-flex;
        align-items: center;
        min-height: 27px;
        padding: 4px 10px;
        border-radius: 5px;
        background: #e8f1ff;
        border: 1px solid #c8dcfa;
        color: #0D5CC1;
        font-size: 12px;
        font-weight: 700;
    }


    /* ============================================================
       OUTCOME SECTION
       ============================================================ */

    .outcome-section {
        margin-top: 6px;
        padding-top: 4px;
    }

    .outcome-section-header p {
        margin: -7px 0 22px;
        color: #64748b;
        font-size: 13px;
        line-height: 1.6;
    }

    .form-group {
        margin-bottom: 22px;
    }

    .form-label {
        display: inline-block;
        margin-bottom: 7px;
        color: #334155;
        font-size: 13px;
        font-weight: 700;
    }

    .required-indicator {
        margin-left: 3px;
        color: #c62828;
        font-size: 13px;
        font-weight: 700;
    }

    .optional-label {
        display: inline-block;
        margin-left: 7px;
        color: #94a3b8;
        font-size: 11px;
        font-weight: 600;
    }

    .form-control {
        width: 100%;
        box-sizing: border-box;
        padding: 11px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        background: #ffffff;
        color: #1f2937;
        font-family: inherit;
        font-size: 14px;
        line-height: 1.5;
        transition:
            border-color 0.15s ease,
            box-shadow 0.15s ease;
    }

    .form-control:focus {
        outline: none;
        border-color: #0D5CC1;
        box-shadow: 0 0 0 3px rgba(13, 92, 193, 0.10);
    }

    .form-control::placeholder {
        color: #94a3b8;
    }

    .outcome-textarea {
        min-height: 135px;
        resize: vertical;
    }

    .comments-textarea {
        min-height: 115px;
        resize: vertical;
    }

    .form-help {
        display: block;
        margin-top: 6px;
        color: #64748b;
        font-size: 12px;
        line-height: 1.5;
    }


    /* ============================================================
       VALIDATION
       ============================================================ */

    .field-validation-error {
        display: block;
        margin-top: 6px;
        color: #b42318;
        font-size: 12px;
        line-height: 1.4;
    }

    .input-validation-error {
        border-color: #d92d20 !important;
        background: #fffafa;
    }

    .validation-summary-errors {
        margin-bottom: 22px;
        padding: 13px 15px;
        border: 1px solid #f0b8b8;
        border-radius: 6px;
        background: #fff5f5;
        color: #a61b1b;
        font-size: 13px;
        line-height: 1.6;
    }

    .validation-summary-errors ul {
        margin: 0;
        padding-left: 20px;
    }


    /* ============================================================
       CONFIRMATION
       ============================================================ */

    .confirmation-section {
        margin-top: 28px;
        padding: 16px 18px;
        border: 1px solid #dbe4ee;
        border-radius: 7px;
        background: #f8fafc;
    }

    .confirmation-label {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        cursor: pointer;
        color: #334155;
        font-size: 13px;
        font-weight: 600;
        line-height: 1.6;
    }

    .confirmation-label input[type="checkbox"] {
        width: 17px;
        height: 17px;
        margin: 2px 0 0;
        flex: 0 0 auto;
        accent-color: #0D5CC1;
        cursor: pointer;
    }


    /* ============================================================
       FORM ACTIONS
       ============================================================ */

    .form-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid #e5e7eb;
    }

    .primary-button,
    .secondary-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 18px;
        border-radius: 6px;
        font-family: inherit;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        box-sizing: border-box;
        cursor: pointer;
        transition:
            background-color 0.15s ease,
            border-color 0.15s ease,
            box-shadow 0.15s ease;
    }

    .primary-button {
        border: 1px solid #0D5CC1;
        background: #0D5CC1;
        color: #ffffff;
    }

    .primary-button:hover:not(:disabled) {
        background: #094b9f;
        border-color: #094b9f;
        color: #ffffff;
    }

    .primary-button:focus {
        outline: none;
        box-shadow: 0 0 0 3px rgba(13, 92, 193, 0.15);
    }

    .primary-button:disabled {
        background: #cbd5e1;
        border-color: #cbd5e1;
        color: #64748b;
        cursor: not-allowed;
    }

    .secondary-button {
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #334155;
    }

    .secondary-button:hover {
        background: #f8fafc;
        border-color: #94a3b8;
        color: #1f2937;
    }


    /* ============================================================
       SIDEBAR
       ============================================================ */

    .record-interview-outcome-sidebar {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .sidebar-card {
        background: #ffffff;
        border: 1px solid #e1e7ef;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.05);
        overflow: hidden;
    }

    .sidebar-card-header {
        padding: 16px 18px;
        border-bottom: 1px solid #e5e7eb;
        background: #f8fafc;
    }

    .sidebar-card-header h3 {
        margin: 0;
        color: #17324d;
        font-size: 15px;
        font-weight: 700;
    }

    .sidebar-card-body {
        padding: 17px 18px;
    }


    /* ============================================================
       PROGRESS
       ============================================================ */

    .progress-list {
        display: flex;
        flex-direction: column;
    }

    .progress-step {
        position: relative;
        display: grid;
        grid-template-columns: 30px minmax(0, 1fr);
        column-gap: 10px;
        min-height: 54px;
    }

    .progress-step:last-child {
        min-height: auto;
    }

    .progress-marker {
        position: relative;
        display: flex;
        justify-content: center;
    }

    .progress-marker::before {
        content: "";
        width: 10px;
        height: 10px;
        margin-top: 4px;
        border-radius: 50%;
        background: #cbd5e1;
        border: 2px solid #ffffff;
        box-shadow: 0 0 0 1px #cbd5e1;
        z-index: 2;
    }

    .progress-step:not(:last-child) .progress-marker::after {
        content: "";
        position: absolute;
        top: 16px;
        bottom: 0;
        width: 1px;
        background: #dbe2ea;
    }

    .progress-step.completed .progress-marker::before {
        background: #2e7d32;
        box-shadow: 0 0 0 1px #2e7d32;
    }

    .progress-step.current .progress-marker::before {
        background: #0D5CC1;
        box-shadow: 0 0 0 1px #0D5CC1;
    }

    .progress-content {
        padding-bottom: 14px;
    }

    .progress-content strong {
        display: block;
        color: #334155;
        font-size: 12px;
        line-height: 1.4;
    }

    .progress-step.current .progress-content strong {
        color: #0D5CC1;
    }

    .progress-content span {
        display: block;
        margin-top: 3px;
        color: #64748b;
        font-size: 11px;
        line-height: 1.45;
    }


    /* ============================================================
       GUIDANCE
       ============================================================ */

    .guidance-list {
        margin: 0;
        padding-left: 17px;
    }

    .guidance-list li {
        margin-bottom: 9px;
        color: #64748b;
        font-size: 12px;
        line-height: 1.55;
    }

    .guidance-list li:last-child {
        margin-bottom: 0;
    }


    /* ============================================================
       CURRENT STAGE
       ============================================================ */

    .current-stage-status {
        display: inline-block;
        margin-bottom: 12px;
        padding: 6px 10px;
        border: 1px solid #c8dcfa;
        border-radius: 5px;
        background: #e8f1ff;
        color: #0D5CC1;
        font-size: 12px;
        font-weight: 700;
    }

    .current-stage-card p {
        margin: 0;
        color: #64748b;
        font-size: 12px;
        line-height: 1.6;
    }

    .current-stage-card strong {
