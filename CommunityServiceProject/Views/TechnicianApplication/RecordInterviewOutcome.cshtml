<script>

    document.addEventListener("DOMContentLoaded", function () {

        var confirmationCheckbox =
            document.getElementById(
                "confirmInterviewOutcome"
            );

        var recordButton =
            document.getElementById(
                "recordOutcomeButton"
            );

        var form =
            document.getElementById(
                "recordInterviewOutcomeForm"
            );


        if (!confirmationCheckbox ||
            !recordButton ||
            !form) {
            return;
        }


        function updateButtonState() {

            recordButton.disabled =
                !confirmationCheckbox.checked;

        }


        confirmationCheckbox.addEventListener(
            "change",
            updateButtonState
        );


        form.addEventListener(
            "submit",
            function (event) {

                if (!confirmationCheckbox.checked) {

                    event.preventDefault();

                    alert(
                        "Please confirm the interview outcome before recording it."
                    );

                    return;
                }


                var confirmed =
                    window.confirm(
                        "Are you sure you want to record this interview outcome? The application status will change to Interviewed."
                    );


                if (!confirmed) {

                    event.preventDefault();

                    return;
                }


                recordButton.disabled = true;

                recordButton.innerText =
                    "Recording...";

            }
        );


        updateButtonState();

    });

</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        var checkbox =
            document.getElementById("confirmInterviewOutcome");

        var button =
            document.getElementById("recordOutcomeButton");

        if (!checkbox || !button) {
            return;
        }

        function updateButtonState() {
            button.disabled = !checkbox.checked;
        }

        checkbox.addEventListener(
            "change",
            updateButtonState
        );

        updateButtonState();
    });
</script>