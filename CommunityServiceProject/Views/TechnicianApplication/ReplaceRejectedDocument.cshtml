
@model CommunityServiceProject.ViewModels.ApplicationDocumentCreateViewModel

@using CommunityServiceProject.Models

@{
    ViewBag.Title = "Replace Rejected Document";

    var rejectionReason =
        ViewBag.RejectionReason as string;

    var existingFileName =
        ViewBag.ExistingFileName as string;

    var documentTitle =
        ViewBag.DocumentTitle as string;

    var documentType =
        ViewBag.DocumentType as string;

    var rejectedDocumentID =
        ViewBag.RejectedDocumentID;

    var hasRejectionReason =
        !string.IsNullOrWhiteSpace(rejectionReason);
}

<div class="replace-rejected-page">

    <!-- =======================================================
         PAGE HEADER
    ======================================================== -->

    <div class="replace-rejected-header">

        <div>

            <div class="replace-rejected-eyebrow">
                TECHNICIAN RECRUITMENT
            </div>

            <h1>
                Replace Rejected Document
            </h1>

            <p>
                Replace the document rejected by the administrator
                and submit it for another review.
            </p>

        </div>

        <div class="replace-rejected-reference">

            <span>
                APPLICATION
            </span>

            <strong>
                @Model.ApplicationReference
            </strong>

        </div>

    </div>


    <!-- =======================================================
         ALERTS
    ======================================================== -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="replace-alert replace-alert-success">

            <span class="replace-alert-icon">
                ✓
            </span>

            <div>
                @TempData["SuccessMessage"]
            </div>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="replace-alert replace-alert-error">

            <span class="replace-alert-icon">
                !
            </span>

            <div>
                @TempData["ErrorMessage"]
            </div>

        </div>
    }


    <!-- =======================================================
         VALIDATION SUMMARY
    ======================================================== -->

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="replace-alert replace-alert-error">

            <span class="replace-alert-icon">
                !
            </span>

            <div>

                @Html.ValidationSummary(
                    true,
                    "Please correct the following before continuing.")

            </div>

        </div>
    }


    <!-- =======================================================
         DOCUMENT REQUIRES ATTENTION
    ======================================================== -->

    <div class="replace-action-required">

        <div class="replace-action-icon">
            !
        </div>

        <div>

            <h2>
                Document Requires Attention
            </h2>

            <p>
                The administrator rejected this document.
                Review the feedback below, select a corrected
                file, and submit the replacement for review.
            </p>

        </div>

    </div>


    <!-- =======================================================
         MAIN CONTENT
    ======================================================== -->

    <div class="replace-rejected-layout">

        <!-- ===================================================
             MAIN CARD
        ==================================================== -->

        <div class="replace-main-card">

            <div class="replace-card-header">

                <div>

                    <span class="replace-section-label">
                        DOCUMENT CORRECTION
                    </span>

                    <h2>
                        @documentTitle
                    </h2>

                </div>

                <span class="replace-rejected-badge">
                    Rejected
                </span>

            </div>


            <!-- ===============================================
                 DOCUMENT INFORMATION
            ================================================ -->

            <div class="replace-document-information">

                <div class="replace-information-item">

                    <span>
                        Document Type
                    </span>

                    <strong>
                        @documentType
                    </strong>

                </div>

                <div class="replace-information-item">

                    <span>
                        Current File
                    </span>

                    <strong>
                        @existingFileName
                    </strong>

                </div>

            </div>


            <!-- ===============================================
                 ADMINISTRATOR FEEDBACK
            ================================================ -->

            <div class="replace-feedback-box">

                <div class="replace-feedback-heading">

                    <span class="replace-feedback-icon">
                        !
                    </span>

                    <h3>
                        Administrator Feedback
                    </h3>

                </div>

                @if (hasRejectionReason)
                {
                    <p>
                        @rejectionReason
                    </p>
                }
                else
                {
                    <p>
                        The administrator rejected this document
                        and requested that it be replaced.
                    </p>
                }

            </div>


            <!-- ===============================================
                 REPLACEMENT FORM
            ================================================ -->

            @using (Html.BeginForm(
                "ReplaceRejectedDocument",
                "TechnicianApplication",
                new
                {
                    rejectedDocumentID =
                        rejectedDocumentID
                },
                FormMethod.Post,
                new
                {
                    enctype =
                        "multipart/form-data",
                    @class =
                        "replace-document-form"
                }))
            {
                @Html.AntiForgeryToken()

                <!-- ===========================================
                     EXISTING APPLICATION INFORMATION
                ============================================ -->

                @Html.HiddenFor(
                    m => m.ApplicationID)

                @Html.HiddenFor(
                    m => m.ApplicationReference)

                @Html.HiddenFor(
                    m => m.OpportunityCode)

                @Html.HiddenFor(
                    m => m.OpportunityTitle)


                <!-- ===========================================
                     EXISTING DOCUMENT METADATA

                     These values identify the document
                     requirement being replaced.

                     Example:
                     DocumentTitle = CV
                     DocumentType  = CV

                     The citizen only replaces the actual
                     file. These values must remain unchanged.
                ============================================ -->

                @Html.HiddenFor(
                    m => m.DocumentTitle)

                @Html.HiddenFor(
                    m => m.DocumentType)


                <div class="replace-upload-section">

                    <div class="replace-upload-heading">

                        <div>

                            <span class="replace-section-label">
                                REPLACEMENT FILE
                            </span>

                            <h3>
                                Upload Corrected Document
                            </h3>

                        </div>

                    </div>


                    <label for="DocumentFile"
                           class="replace-file-label">

                        Select Replacement Document
                    </label>

                    <div class="replace-file-wrapper">

                        @Html.TextBoxFor(
                            m => m.DocumentFile,
                            new
                            {
                                type = "file",
                                id = "DocumentFile",
                                @class =
                                    "replace-file-input",
                                accept =
                                    ".pdf,.doc,.docx,.jpg,.jpeg,.png"
                            })

                    </div>

                    @Html.ValidationMessageFor(
                        m => m.DocumentFile,
                        "",
                        new
                        {
                            @class =
                                "replace-validation-message"
                        })


                    <div class="replace-upload-help">

                        <strong>
                            Accepted formats:
                        </strong>

                        PDF, DOC, DOCX, JPG, JPEG and PNG.

                        <span>
                            Maximum file size: 10 MB.
                        </span>

                    </div>

                </div>


                <!-- ===========================================
                     CONFIRMATION
                ============================================ -->

                <div class="replace-confirmation">

                    <div class="replace-confirmation-icon">
                        ✓
                    </div>

                    <div>

                        <strong>
                            Before submitting
                        </strong>

                        <p>
                            Make sure the replacement document
                            addresses the administrator's feedback
                            and contains the correct information.
                        </p>

                    </div>

                </div>


                <!-- ===========================================
                     FORM ACTIONS
                ============================================ -->

                <div class="replace-form-actions">

                    @Html.ActionLink(
                        "Cancel",
                        "Documents",
                        "TechnicianApplication",
                        new
                        {
                            id =
                                Model.ApplicationID
                        },
                        new
                        {
                            @class =
                                "replace-cancel-button"
                        })

                    <button type="submit"
                            class="replace-submit-button">

                        Replace Document

                    </button>

                </div>

            }

        </div>


        <!-- ===================================================
             SIDEBAR
        ==================================================== -->

        <aside class="replace-sidebar">


            <!-- ===============================================
                 APPLICATION
            ================================================ -->

            <div class="replace-sidebar-card">

                <span class="replace-sidebar-label">
                    APPLICATION
                </span>

                <h3>
                    @Model.ApplicationReference
                </h3>

                <div class="replace-sidebar-detail">

                    <span>
                        Opportunity
                    </span>

                    <strong>
                        @Model.OpportunityCode
                    </strong>

                </div>

                <div class="replace-sidebar-detail">

                    <span>
                        Position
                    </span>

                    <strong>
                        @Model.OpportunityTitle
                    </strong>

                </div>

            </div>


            <!-- ===============================================
                 UPDATE PROCESS
            ================================================ -->

            <div class="replace-sidebar-card">

                <span class="replace-sidebar-label">
                    WHAT HAPPENS NEXT
                </span>

                <div class="replace-process">

                    <div class="replace-process-item">

                        <span class="replace-process-number">
                            1
                        </span>

                        <div>

                            <strong>
                                Replace the document
                            </strong>

                            <p>
                                Upload a corrected version.
                            </p>

                        </div>

                    </div>


                    <div class="replace-process-item">

                        <span class="replace-process-number">
                            2
                        </span>

                        <div>

                            <strong>
                                Submit the replacement
                            </strong>

                            <p>
                                Your document returns to pending review.
                            </p>

                        </div>

                    </div>


                    <div class="replace-process-item">

                        <span class="replace-process-number">
                            3
                        </span>

                        <div>

                            <strong>
                                Administrator reviews
                            </strong>

                            <p>
                                The administrator verifies the replacement.
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ===============================================
                 STATUS
            ================================================ -->

            <div class="replace-sidebar-card">

                <span class="replace-sidebar-label">
                    CURRENT STATUS
                </span>

                <div class="replace-status-badge">
                    Documents Pending
                </div>

                <p class="replace-status-text">
                    Your application requires a corrected
                    supporting document before recruitment
                    processing can continue.
                </p>

            </div>


            <!-- ===============================================
                 NAVIGATION
            ================================================ -->

            <div class="replace-sidebar-card">

                <span class="replace-sidebar-label">
                    NAVIGATION
                </span>

                <div class="replace-navigation">

                    @Html.ActionLink(
                        "Application Status",
                        "Status",
                        "TechnicianApplication",
                        new
                        {
                            id =
                                Model.ApplicationID
                        },
                        null)

                    @Html.ActionLink(
                        "Supporting Documents",
                        "Documents",
                        "TechnicianApplication",
                        new
                        {
                            id =
                                Model.ApplicationID
                        },
                        null)

                </div>

            </div>

        </aside>

    </div>

</div>


<style>

    /* =========================================================
       PAGE
    ========================================================= */

    .replace-rejected-page {
        max-width: 1180px;
        margin: 30px auto 60px;
        padding: 0 20px;
        color: #172033;
        font-family: Arial, Helvetica, sans-serif;
    }


    /* =========================================================
       HEADER
    ========================================================= */

    .replace-rejected-header {
        background: linear-gradient(135deg, #0D5CC1, #094b9f);
        color: #ffffff;
        border-radius: 16px;
        padding: 32px 36px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 22px;
        box-shadow: 0 10px 30px rgba(13, 92, 193, 0.16);
    }

    .replace-rejected-eyebrow {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.5px;
        opacity: 0.82;
        margin-bottom: 7px;
    }

    .replace-rejected-header h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 800;
        line-height: 1.2;
    }

    .replace-rejected-header p {
        margin: 9px 0 0;
        font-size: 14px;
        line-height: 1.6;
        opacity: 0.92;
        max-width: 680px;
    }

    .replace-rejected-reference {
        min-width: 180px;
        text-align: right;
    }

        .replace-rejected-reference span {
            display: block;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.3px;
            opacity: 0.72;
            margin-bottom: 5px;
        }

        .replace-rejected-reference strong {
            font-size: 17px;
        }


    /* =========================================================
       ALERTS
    ========================================================= */

    .replace-alert {
        border-radius: 10px;
        padding: 14px 16px;
        margin-bottom: 18px;
        display: flex;
        align-items: flex-start;
        gap: 11px;
        font-size: 13px;
        line-height: 1.55;
    }

    .replace-alert-icon {
        width: 22px;
        height: 22px;
        min-width: 22px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 800;
    }

    .replace-alert-success {
        background: #ecfdf3;
        border: 1px solid #abefc6;
        color: #067647;
    }

        .replace-alert-success .replace-alert-icon {
            background: #12b76a;
            color: #ffffff;
        }

    .replace-alert-error {
        background: #fff5f5;
        border: 1px solid #fecdca;
        color: #b42318;
    }

        .replace-alert-error .replace-alert-icon {
            background: #b42318;
            color: #ffffff;
        }


    /* =========================================================
       ACTION REQUIRED
    ========================================================= */

    .replace-action-required {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        background: #fff5f5;
        border: 1px solid #fecdca;
        border-left: 5px solid #b42318;
        border-radius: 12px;
        padding: 19px 20px;
        margin-bottom: 24px;
    }

    .replace-action-icon {
        width: 30px;
        height: 30px;
        min-width: 30px;
        background: #b42318;
        color: #ffffff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
    }

    .replace-action-required h2 {
        margin: 0 0 5px;
        font-size: 16px;
        color: #8e1b12;
    }

    .replace-action-required p {
        margin: 0;
        color: #7a271a;
        font-size: 13px;
        line-height: 1.55;
    }


    /* =========================================================
       LAYOUT
    ========================================================= */

    .replace-rejected-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 320px;
        gap: 24px;
        align-items: start;
    }


    /* =========================================================
       MAIN CARD
    ========================================================= */

    .replace-main-card {
        background: #ffffff;
        border: 1px solid #e3e8ef;
        border-radius: 14px;
        box-shadow: 0 7px 24px rgba(16, 24, 40, 0.06);
        overflow: hidden;
    }

    .replace-card-header {
        padding: 24px 26px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        border-bottom: 1px solid #e9edf3;
    }

    .replace-section-label {
        display: block;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.2px;
        color: #667085;
        margin-bottom: 6px;
    }

    .replace-card-header h2 {
        margin: 0;
        font-size: 21px;
        color: #172033;
    }

    .replace-rejected-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 11px;
        border-radius: 999px;
        background: #fef3f2;
        border: 1px solid #fecdca;
        color: #b42318;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }


    /* =========================================================
       DOCUMENT INFORMATION
    ========================================================= */

    .replace-document-information {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
        padding: 22px 26px;
        background: #f8fafc;
        border-bottom: 1px solid #e9edf3;
    }

    .replace-information-item {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .replace-information-item span {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.9px;
            color: #667085;
            font-weight: 800;
        }

        .replace-information-item strong {
            font-size: 13px;
            color: #344054;
            word-break: break-word;
        }


    /* =========================================================
       FEEDBACK
    ========================================================= */

    .replace-feedback-box {
        margin: 22px 26px;
        padding: 18px;
        background: #fff5f5;
        border: 1px solid #fecdca;
        border-radius: 10px;
    }

    .replace-feedback-heading {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 9px;
    }

        .replace-feedback-heading h3 {
            margin: 0;
            font-size: 14px;
            color: #8e1b12;
        }

    .replace-feedback-icon {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #b42318;
        color: #ffffff;
        font-size: 11px;
        font-weight: 800;
    }

    .replace-feedback-box p {
        margin: 0;
        color: #7a271a;
        font-size: 13px;
        line-height: 1.6;
    }


    /* =========================================================
       UPLOAD SECTION
    ========================================================= */

    .replace-upload-section {
        padding: 0 26px 25px;
    }

    .replace-upload-heading {
        padding-top: 3px;
        margin-bottom: 16px;
    }

        .replace-upload-heading h3 {
            margin: 0;
            font-size: 17px;
            color: #172033;
        }

    .replace-file-label {
        display: block;
        margin-bottom: 8px;
        font-size: 12px;
        font-weight: 700;
        color: #344054;
    }

    .replace-file-wrapper {
        border: 1px dashed #b8c2d1;
        background: #f8fafc;
        border-radius: 10px;
        padding: 15px;
        transition: border-color 0.2s ease, background 0.2s ease;
    }

        .replace-file-wrapper:hover {
            border-color: #0D5CC1;
            background: #f5f9ff;
        }

    .replace-file-input {
        width: 100%;
        font-size: 13px;
        color: #344054;
    }

        .replace-file-input::file-selector-button {
            border: none;
            background: #0D5CC1;
            color: #ffffff;
            border-radius: 7px;
            padding: 9px 13px;
            margin-right: 10px;
            font-weight: 700;
            cursor: pointer;
        }

    .replace-validation-message {
        display: block;
        margin-top: 7px;
        color: #b42318;
        font-size: 12px;
        font-weight: 600;
    }

    .replace-upload-help {
        margin-top: 10px;
        color: #667085;
        font-size: 11px;
        line-height: 1.5;
    }

        .replace-upload-help strong {
            color: #475467;
        }

        .replace-upload-help span {
            margin-left: 5px;
        }


    /* =========================================================
       CONFIRMATION
    ========================================================= */

    .replace-confirmation {
        margin: 0 26px 24px;
        padding: 15px 16px;
        background: #f8fafc;
        border: 1px solid #e4e7ec;
        border-radius: 10px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .replace-confirmation-icon {
        width: 25px;
        height: 25px;
        min-width: 25px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e0edff;
        color: #0D5CC1;
        font-size: 12px;
        font-weight: 800;
    }

    .replace-confirmation strong {
        display: block;
        margin-bottom: 4px;
        font-size: 12px;
        color: #344054;
    }

    .replace-confirmation p {
        margin: 0;
        color: #667085;
        font-size: 12px;
        line-height: 1.5;
    }


    /* =========================================================
       FORM ACTIONS
    ========================================================= */

    .replace-form-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        padding: 18px 26px;
        background: #f8fafc;
        border-top: 1px solid #e9edf3;
    }

    .replace-cancel-button,
    .replace-submit-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 0 17px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.2s ease;
    }

    .replace-cancel-button {
        background: #ffffff;
        color: #344054;
        border: 1px solid #d0d5dd;
    }

        .replace-cancel-button:hover {
            background: #f2f4f7;
            color: #172033;
            text-decoration: none;
        }

    .replace-submit-button {
        border: none;
        background: #0D5CC1;
        color: #ffffff;
        box-shadow: 0 4px 10px rgba(13, 92, 193, 0.18);
    }

        .replace-submit-button:hover {
            background: #094b9f;
            transform: translateY(-1px);
        }


    /* =========================================================
       SIDEBAR
    ========================================================= */

    .replace-sidebar {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .replace-sidebar-card {
        background: #ffffff;
        border: 1px solid #e3e8ef;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 5px 18px rgba(16, 24, 40, 0.04);
    }

    .replace-sidebar-label {
        display: block;
        margin-bottom: 9px;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.1px;
        color: #667085;
    }

    .replace-sidebar-card h3 {
        margin: 0 0 16px;
        color: #172033;
        font-size: 18px;
    }

    .replace-sidebar-detail {
        padding: 11px 0;
        border-top: 1px solid #edf0f4;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .replace-sidebar-detail span {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 0.7px;
            color: #98a2b3;
            font-weight: 800;
        }

        .replace-sidebar-detail strong {
            font-size: 12px;
            color: #344054;
            line-height: 1.45;
        }


    /* =========================================================
       PROCESS
    ========================================================= */

    .replace-process {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .replace-process-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }

    .replace-process-number {
        width: 24px;
        height: 24px;
        min-width: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e8f1ff;
        color: #0D5CC1;
        font-size: 11px;
        font-weight: 800;
    }

    .replace-process-item strong {
        display: block;
        color: #344054;
        font-size: 12px;
        margin-bottom: 2px;
    }

    .replace-process-item p {
        margin: 0;
        color: #667085;
        font-size: 11px;
        line-height: 1.45;
    }


    /* =========================================================
       STATUS
    ========================================================= */

    .replace-status-badge {
        display: inline-flex;
        padding: 6px 10px;
        border-radius: 999px;
        background: #fff4e5;
        border: 1px solid #f5c77a;
        color: #9a6700;
        font-size: 11px;
        font-weight: 800;
    }

    .replace-status-text {
        margin: 11px 0 0;
        color: #667085;
        font-size: 12px;
        line-height: 1.55;
    }


    /* =========================================================
       NAVIGATION
    ========================================================= */

    .replace-navigation {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

        .replace-navigation a {
            display: block;
            padding: 9px 10px;
            border-radius: 7px;
            color: #0D5CC1;
            background: #f5f9ff;
            font-size: 12px;
            font-weight: 700;
            text-decoration: none;
        }

            .replace-navigation a:hover {
                background: #e8f1ff;
