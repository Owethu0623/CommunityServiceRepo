@model CommunityServiceProject.Models.TechnicianApplication

@using System.Linq
@using CommunityServiceProject.Models

@{
    ViewBag.Title = "Review Application";

    var applicantName =
        Model.Citizen.FirstName + " " + Model.Citizen.LastName;
}

<div class="application-review-page">

    <!-- ============================================================
         PAGE HEADER
         ============================================================ -->

    <div class="review-header">

        <div class="review-header-content">

            <div class="page-eyebrow">
                TECHNICIAN RECRUITMENT
            </div>

            <div class="header-title-row">

                <h1>@Model.ApplicationReference</h1>

                <span class="status-badge status-@Model.Status">
                    @Model.Status
                </span>

            </div>

            <p>
                Review the submitted application and supporting information
                before applicant screening.
            </p>

        </div>

    </div>


    <!-- ============================================================
         APPLICATION SUMMARY
         ============================================================ -->

    <div class="summary-grid">

        <div class="summary-card">

            <div class="summary-label">
                Application Date
            </div>

            <div class="summary-value">
                @Model.ApplicationDate.ToString("dd MMM yyyy HH:mm")
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-label">
                Application Status
            </div>

            <div class="summary-value">
                <span class="status-badge status-@Model.Status">
                    @Model.Status
                </span>
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-label">
                Supporting Documents
            </div>

            <div class="summary-value">
                @Model.ApplicationDocuments.Count
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-label">
                Last Updated
            </div>

            <div class="summary-value">
                @(Model.LastUpdatedDate.HasValue ? Model.LastUpdatedDate.Value.ToString("dd MMM yyyy HH:mm") : "Not updated")
            </div>

        </div>

    </div>


    <!-- ============================================================
         MAIN CONTENT
         ============================================================ -->

    <div class="review-content">


        <!-- ========================================================
             LEFT COLUMN
             ======================================================== -->

        <div class="review-main-column">


            <!-- ====================================================
                 APPLICANT INFORMATION
                 ==================================================== -->

            <section class="section-card">

                <div class="section-header">

                    <div>
                        <div class="section-kicker">
                            APPLICANT
                        </div>

                        <h2>Applicant Information</h2>

                        <p>
                            Personal information associated with the citizen account.
                        </p>
                    </div>

                </div>


                <div class="applicant-identity">

                    <div class="applicant-name">
                        @applicantName
                    </div>

                    <div class="applicant-reference">
                        Citizen ID: @Model.CitizenID
                    </div>

                </div>


                <div class="details-table">

                    <div class="detail-row">

                        <div class="detail-label">
                            Email Address
                        </div>

                        <div class="detail-value">
                            @Model.Citizen.EmailAddress
                        </div>

                    </div>


                    <div class="detail-row">

                        <div class="detail-label">
                            Phone Number
                        </div>

                        <div class="detail-value">
                            @Model.Citizen.PhoneNumber
                        </div>

                    </div>


                    <div class="detail-row">

                        <div class="detail-label">
                            Residential Address
                        </div>

                        <div class="detail-value">
                            @Model.Citizen.ResidentialAddress
                        </div>

                    </div>

                </div>

            </section>


            <!-- ====================================================
                 COVER LETTER
                 ==================================================== -->

            <section class="section-card">

                <div class="section-header">

                    <div>
                        <div class="section-kicker">
                            APPLICATION STATEMENT
                        </div>

                        <h2>Cover Letter</h2>

                        <p>
                            Statement submitted by the applicant with the application.
                        </p>
                    </div>

                </div>


                <div class="cover-letter">

                    @if (!string.IsNullOrWhiteSpace(Model.CoverLetter))
                    {
                        @Model.CoverLetter
                    }
                    else
                    {
                        <span class="empty-information">
                            No cover letter was submitted.
                        </span>
                    }

                </div>

            </section>


            <!-- ====================================================
                 SUPPORTING DOCUMENTS
                 ==================================================== -->

            <section class="section-card">

                <div class="section-header">

                    <div>
                        <div class="section-kicker">
                            DOCUMENTATION
                        </div>

                        <h2>Supporting Documents</h2>

                        <p>
                            Documents submitted by the applicant for this application.
                        </p>
                    </div>

                    <div class="section-count">
                        @Model.ApplicationDocuments.Count document(s)
                    </div>

                </div>


                @if (Model.ApplicationDocuments.Any())
                {
                    <div class="documents-container">

                        @foreach (var document in Model.ApplicationDocuments.OrderByDescending(d => d.DateSubmitted))
                        {
                            <div class="document-row">

                                <div class="document-content">

                                    <div class="document-title">
                                        @document.DocumentTitle
                                    </div>

                                    <div class="document-type">
                                        @document.DocumentType
                                    </div>

                                    <div class="document-file">
                                        @document.FileName
                                    </div>

                                    <div class="document-date">
                                        Submitted @document.DateSubmitted.ToString("dd MMM yyyy HH:mm")
                                    </div>

                                </div>


                                <div class="document-status">

                                    <span class="verification-badge verification-@document.VerificationStatus">
                                        @document.VerificationStatus
                                    </span>

                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="empty-documents">

                        <div class="empty-documents-title">
                            No supporting documents
                        </div>

                        <p>
                            The applicant has not submitted supporting documents
                            for this application.
                        </p>

                    </div>
                }

            </section>


        </div>


        <!-- ========================================================
             RIGHT COLUMN
             ======================================================== -->

        <aside class="review-sidebar">


            <!-- ====================================================
                 APPLICATION INFORMATION
                 ==================================================== -->

            <section class="sidebar-card">

                <div class="sidebar-header">

                    <div class="section-kicker">
                        APPLICATION
                    </div>

                    <h2>Application Details</h2>

                </div>


                <div class="sidebar-details">

                    <div class="sidebar-detail">

                        <span class="sidebar-label">
                            Reference
                        </span>

                        <span class="sidebar-value strong">
                            @Model.ApplicationReference
                        </span>

                    </div>


                    <div class="sidebar-detail">

                        <span class="sidebar-label">
                            Status
                        </span>

                        <span class="sidebar-value">
                            <span class="status-badge status-@Model.Status">
                                @Model.Status
                            </span>
                        </span>

                    </div>


                    <div class="sidebar-detail">

                        <span class="sidebar-label">
                            Submitted
                        </span>

                        <span class="sidebar-value">
                            @Model.ApplicationDate.ToString("dd MMM yyyy HH:mm")
                        </span>

                    </div>


                    <div class="sidebar-detail">

                        <span class="sidebar-label">
                            Last Updated
                        </span>

                        <span class="sidebar-value">
                            @(Model.LastUpdatedDate.HasValue ? Model.LastUpdatedDate.Value.ToString("dd MMM yyyy HH:mm") : "Not updated")
                        </span>

                    </div>

                </div>

            </section>


            <!-- ====================================================
                 OPPORTUNITY INFORMATION
                 ==================================================== -->

            <section class="sidebar-card opportunity-card">

                <div class="sidebar-header">

                    <div class="section-kicker">
                        OPPORTUNITY
                    </div>

                    <h2>Technician Opportunity</h2>

                </div>


                <div class="opportunity-code">
                    @Model.Opportunity.OpportunityCode
                </div>

                <h3>
                    @Model.Opportunity.Title
                </h3>


                <div class="opportunity-details">

                    <div class="sidebar-detail">

                        <span class="sidebar-label">
                            Employment Type
                        </span>

                        <span class="sidebar-value">
                            @(string.IsNullOrWhiteSpace(Model.Opportunity.EmploymentType)
                                ? "Not specified"
                                : Model.Opportunity.EmploymentType)
                        </span>

                    </div>


                    <div class="sidebar-detail">

                        <span class="sidebar-label">
                            Positions Available
                        </span>

                        <span class="sidebar-value">
                            @(Model.Opportunity.NumberOfPositions.HasValue
                                ? Model.Opportunity.NumberOfPositions.Value.ToString()
                                : "Not specified")
                        </span>

                    </div>


                    <div class="sidebar-detail">

                        <span class="sidebar-label">
                            Application Start
                        </span>

                        <span class="sidebar-value">
                            @Model.Opportunity.ApplicationStartDate.ToString("dd MMM yyyy")
                        </span>

                    </div>


                    <div class="sidebar-detail">

                        <span class="sidebar-label">
                            Application Deadline
                        </span>

                        <span class="sidebar-value">
                            @Model.Opportunity.ApplicationDeadline.ToString("dd MMM yyyy")
                        </span>

                    </div>

                </div>

            </section>


            <!-- ====================================================
                 OPPORTUNITY DESCRIPTION
                 ==================================================== -->

            <section class="sidebar-card">

                <div class="sidebar-header">

                    <div class="section-kicker">
                        POSITION
                    </div>

                    <h2>Opportunity Description</h2>

                </div>

                <div class="opportunity-description">

                    @Model.Opportunity.Description

                </div>

            </section>


            <!-- ====================================================
                 REVIEW WORKFLOW
                 ==================================================== -->

            <section class="workflow-card">

                <div class="workflow-title">
                    Application Review
                </div>

                <p>
                    This page provides the administrator with the information
                    required before proceeding to applicant screening,
                    document verification, shortlisting and later recruitment
                    decisions.
                </p>

            </section>


        </aside>

    </div>


    <div class="bottom-navigation">

        <!-- Always available -->
        <a href="@Url.Action("ReviewApplications", "TechnicianApplication")"
           class="primary-button">
            Back to Applications
        </a>


        <!-- ==========================================================
         DOCUMENT VERIFICATION
         Documents must be verified BEFORE screening.
         ========================================================== -->

        @if (Model.Status == TechnicianApplicationStatus.Submitted ||
             Model.Status == TechnicianApplicationStatus.UnderReview ||
             Model.Status == TechnicianApplicationStatus.DocumentsPending)
        {
            <a href="@Url.Action("VerifyDocuments", "TechnicianApplication",
                    new { id = Model.ApplicationID })"
               class="secondary-button">
                Verify Applicant Documents
            </a>
        }


        <!-- ==========================================================
         SCREENING
         Screening is only available once all documents
         have been accepted.
         ========================================================== -->

        @if (Model.Status == TechnicianApplicationStatus.DocumentsVerified ||
             Model.Status == TechnicianApplicationStatus.Screening)
        {
            <a href="@Url.Action("Screen", "TechnicianApplication",
                    new { id = Model.ApplicationID })"
               class="primary-button">
                Screen Applicant
            </a>
        }


        <div>

          <!-- ==========================================================
         SHORTLISTED
         Shortlisted applicants proceed to assessment scheduling.
         ========================================================== -->

        @if (Model.Status == TechnicianApplicationStatus.Shortlisted)
        {
            <a href="@Url.Action("ScheduleAssessment", "TechnicianApplication",
                    new { id = Model.ApplicationID })"
               class="primary-button">
                Schedule Assessment
            </a>
        }


        <!-- ==========================================================
         ASSESSMENT SCHEDULED
         Only show the result action when an actual scheduled
         assessment exists.
         ========================================================== -->

        @if (Model.Status == TechnicianApplicationStatus.AssessmentScheduled &&
             ViewBag.ScheduledAssessmentID != null)
        {
            <a href="@Url.Action("RecordAssessmentResult", "TechnicianApplication",
                    new { id = ViewBag.ScheduledAssessmentID })"
               class="primary-button">
                Record Assessment Result
            </a>
        }


        <!-- ==========================================================
         ASSESSED
         Applicant can proceed to interview scheduling.
         ========================================================== -->

        @if (Model.Status == TechnicianApplicationStatus.Assessed)
        {
            <a href="@Url.Action("ScheduleInterview", "TechnicianApplication",
                    new { id = Model.ApplicationID })"
               class="primary-button">
                Schedule Interview
            </a>
        }


        <!-- ==========================================================
         INTERVIEW SCHEDULED
         Only show outcome action when a scheduled interview exists.
         ========================================================== -->

        @if (Model.Status == TechnicianApplicationStatus.InterviewScheduled &&
             ViewBag.ScheduledInterviewID != null)
        {
            <a href="@Url.Action("RecordInterviewOutcome", "TechnicianApplication",
                    new { id = ViewBag.ScheduledInterviewID })"
               class="primary-button">
                Record Interview Outcome
            </a>
        }


        <!-- ==========================================================
         INTERVIEWED
         Applicant can now be selected.
         ========================================================== -->

        @if (Model.Status == TechnicianApplicationStatus.Interviewed)
        {
            <a href="@Url.Action("SelectApplicant", "TechnicianApplication",
                    new { id = Model.ApplicationID })"
               class="primary-button">
                Select Applicant
            </a>
        }


        <!-- ==========================================================
         SELECTED
         Final verification is required before onboarding.
         ========================================================== -->

        @if (Model.Status == TechnicianApplicationStatus.Selected)
        {
            <a href="@Url.Action("FinalApplicantVerification",
                    "TechnicianApplication",
                    new { id = Model.ApplicationID })"
               class="primary-button">
                Final Applicant Verification
            </a>
        }


        <!-- ==========================================================
         APPROVED FOR ONBOARDING
         Administrator can create the technician record.
         ========================================================== -->

        @if (Model.Status == TechnicianApplicationStatus.ApprovedForOnboarding)
        {
            <a href="@Url.Action("OnboardTechnician",
                    "TechnicianApplication",
                    new { id = Model.ApplicationID })"
               class="primary-button">
                Onboard Selected Technician
            </a>
        }

    </div>

    </div>

</div>


<style>

    /* ================================================================
       PAGE
       ================================================================ */

    .application-review-page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 32px 28px 60px;
        font-family: Arial, Helvetica, sans-serif;
        color: #1e293b;
    }


    /* ================================================================
       HEADER
       ================================================================ */

    .review-header {
        background: linear-gradient(135deg, #0D5CC1, #094b9f);
        border-radius: 14px;
        padding: 30px 34px;
        margin-bottom: 20px;
        color: white;
        box-shadow: 0 5px 18px rgba(15, 23, 42, 0.10);
    }

    .review-header-content {
        max-width: 900px;
    }

    .page-eyebrow,
    .section-kicker {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.2px;
    }

    .page-eyebrow {
        color: rgba(255, 255, 255, 0.82);
        margin-bottom: 9px;
    }

    .header-title-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
    }

    .review-header h1 {
        margin: 0;
        color: white;
        font-size: 30px;
        font-weight: 700;
    }

    .review-header p {
        margin: 11px 0 0;
        color: rgba(255, 255, 255, 0.92);
        font-size: 14px;
        line-height: 1.6;
    }


    /* ================================================================
       SUMMARY
       ================================================================ */

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 22px;
    }

    .summary-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 17px 19px;
        min-width: 0;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.035);
    }

    .summary-label {
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
    }

    .summary-value {
        color: #1e293b;
        font-size: 14px;
        font-weight: 600;
        min-height: 22px;
        word-break: break-word;
    }


    /* ================================================================
       MAIN LAYOUT
       ================================================================ */

    .review-content {
        display: grid;
        grid-template-columns: minmax(0, 1.65fr) minmax(300px, 0.9fr);
        gap: 22px;
        align-items: start;
    }

    .review-main-column,
    .review-sidebar {
        min-width: 0;
    }


    /* ================================================================
       SECTION CARDS
       ================================================================ */

    .section-card,
    .sidebar-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        margin-bottom: 22px;
        box-shadow: 0 3px 12px rgba(15, 23, 42, 0.045);
        overflow: hidden;
    }

    .section-header,
    .sidebar-header {
        padding: 21px 23px;
        border-bottom: 1px solid #e8edf3;
    }

    .section-kicker {
        color: #0D5CC1;
        margin-bottom: 6px;
    }

    .section-header h2,
    .sidebar-header h2 {
        margin: 0;
        color: #172033;
        font-size: 19px;
        font-weight: 700;
    }

    .section-header p {
        margin: 6px 0 0;
        color: #64748b;
        font-size: 13px;
        line-height: 1.5;
    }


    /* ================================================================
       APPLICANT
       ================================================================ */

    .applicant-identity {
        padding: 21px 23px 17px;
        background: #f8fafc;
        border-bottom: 1px solid #e8edf3;
    }

    .applicant-name {
        color: #0D5CC1;
        font-size: 23px;
        font-weight: 700;
        line-height: 1.3;
    }

    .applicant-reference {
        margin-top: 5px;
        color: #64748b;
        font-size: 13px;
    }


    /* ================================================================
       DETAIL ROWS
       ================================================================ */

    .details-table {
        padding: 4px 23px;
    }

    .detail-row {
        display: grid;
        grid-template-columns: 180px minmax(0, 1fr);
        gap: 22px;
        padding: 16px 0;
        border-bottom: 1px solid #eef2f7;
        align-items: start;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.35px;
    }

    .detail-value {
        color: #1e293b;
        font-size: 14px;
        font-weight: 500;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }


    /* ================================================================
       COVER LETTER
       ================================================================ */

    .cover-letter {
        margin: 22px 23px;
        padding: 20px 21px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        color: #334155;
        font-size: 14px;
        line-height: 1.8;
        white-space: pre-line;
        overflow-wrap: anywhere;
    }

    .empty-information {
        color: #64748b;
        font-style: italic;
    }


    /* ================================================================
       DOCUMENTS
       ================================================================ */

    .section-count {
        margin-top: 2px;
        color: #64748b;
        font-size: 12px;
        font-weight: 600;
    }

    .documents-container {
        padding: 4px 23px;
    }

    .document-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 17px 0;
        border-bottom: 1px solid #eef2f7;
    }

        .document-row:last-child {
            border-bottom: none;
        }

    .document-content {
        min-width: 0;
    }

    .document-title {
        color: #1e293b;
        font-size: 14px;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .document-type {
        margin-top: 4px;
        color: #0D5CC1;
        font-size: 12px;
        font-weight: 600;
    }

    .document-file {
        margin-top: 3px;
        color: #475569;
        font-size: 12px;
        overflow-wrap: anywhere;
    }

    .document-date {
        margin-top: 5px;
        color: #94a3b8;
        font-size: 11px;
    }

    .document-status {
        flex-shrink: 0;
    }

    .empty-documents {
        padding: 30px 23px;
        text-align: center;
    }

    .empty-documents-title {
        color: #475569;
        font-size: 14px;
        font-weight: 700;
    }

    .empty-documents p {
        margin: 6px 0 0;
        color: #94a3b8;
        font-size: 13px;
    }


    /* ================================================================
       SIDEBAR
       ================================================================ */

    .sidebar-card {
        margin-bottom: 18px;
    }

    .sidebar-details,
    .opportunity-details {
        padding: 7px 21px;
    }

    .sidebar-detail {
        display: grid;
        grid-template-columns: 115px minmax(0, 1fr);
        gap: 15px;
        align-items: start;
        padding: 14px 0;
        border-bottom: 1px solid #eef2f7;
    }

        .sidebar-detail:last-child {
            border-bottom: none;
        }

    .sidebar-label {
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }

    .sidebar-value {
        color: #1e293b;
        font-size: 13px;
        font-weight: 500;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

        .sidebar-value.strong {
            color: #0D5CC1;
            font-weight: 700;
        }


    /* ================================================================
       OPPORTUNITY
       ================================================================ */

    .opportunity-card {
        border-top: 3px solid #0D5CC1;
    }

    .opportunity-code {
        padding: 20px 21px 0;
        color: #0D5CC1;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.4px;
    }

    .opportunity-card h3 {
        margin: 5px 21px 3px;
        color: #172033;
        font-size: 20px;
        line-height: 1.35;
    }

    .opportunity-description {
        padding: 18px 21px 21px;
        color: #475569;
        font-size: 13px;
        line-height: 1.7;
        white-space: pre-line;
        overflow-wrap: anywhere;
    }


    /* ================================================================
       WORKFLOW INFORMATION
       ================================================================ */

    .workflow-card {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 10px;
        padding: 19px 20px;
        margin-bottom: 18px;
    }

    .workflow-title {
        color: #1e40af;
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .workflow-card p {
        margin: 0;
        color: #475569;
        font-size: 12px;
        line-height: 1.65;
    }


    /* ================================================================
       STATUS BADGES
       ================================================================ */

    .status-badge,
    .verification-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 25px;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-badge {
        background: #e2e8f0;
        color: #334155;
    }

    .status-Submitted {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .status-UnderReview {
        background: #fef3c7;
        color: #92400e;
    }

    .status-DocumentsPending {
        background: #ffedd5;
        color: #c2410c;
    }

    .status-DocumentsVerified {
        background: #dcfce7;
        color: #166534;
    }

    .status-Shortlisted {
        background: #e0e7ff;
        color: #4338ca;
    }

    .status-Selected {
        background: #dcfce7;
        color: #166534;
    }

    .status-NotSelected {
        background: #fee2e2;
        color: #b91c1c;
    }

    .status-Withdrawn {
        background: #f1f5f9;
        color: #475569;
    }

    .verification-badge {
        background: #e2e8f0;
        color: #334155;
    }

    .verification-Pending {
        background: #fef3c7;
        color: #92400e;
    }

    .verification-Accepted {
        background: #dcfce7;
        color: #166534;
    }

    .verification-Rejected {
        background: #fee2e2;
        color: #b91c1c;
    }


    /* ================================================================
       NAVIGATION
       ================================================================ */

    .bottom-navigation {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 4px;
    }

    .primary-button,
    .secondary-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
