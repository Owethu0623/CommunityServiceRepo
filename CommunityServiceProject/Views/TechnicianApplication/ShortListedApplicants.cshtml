@model CommunityServiceProject.ViewModels.TechnicianApplicationShortlistedViewModel

@{
    ViewBag.Title = "Shortlisted Applicants";
}

<div class="admin-shortlisted-page">

    <div class="admin-shortlisted-header">

        <div>
            <div class="page-kicker">
                RECRUITMENT
            </div>

            <h1>Shortlisted Applicants</h1>

            <p>
                Review applicants who have successfully progressed through
                screening and document verification.
            </p>
        </div>

        <div class="shortlisted-count-header">
            <span>Shortlisted</span>
            <strong>@Model.TotalShortlisted</strong>
        </div>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-message alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-message alert-error">
            @TempData["ErrorMessage"]
        </div>
    }


    <div class="summary-card">

        <div>
            <span class="summary-label">
                Shortlisted Applicants
            </span>

            <strong>
                @Model.TotalShortlisted
            </strong>
        </div>

        <p>
            These applicants have progressed to the next stage
            of the recruitment process.
        </p>

    </div>


    <div class="filter-card">

        @using (Html.BeginForm(
            "ShortlistedApplicants",
            "TechnicianApplication",
            FormMethod.Get,
            new
            {
                @class = "filter-form"
            }))
        {
            <div class="filter-field">

                <label for="searchTerm">
                    Search Applicants
                </label>

                <input type="text"
                       id="searchTerm"
                       name="searchTerm"
                       value="@Model.SearchTerm"
                       placeholder="Reference, name, email or opportunity" />

            </div>


            <div class="filter-field">

                <label for="opportunityFilter">
                    Opportunity
                </label>

                <select id="opportunityFilter"
                        name="opportunityFilter">

                    <option value="">
                        All Opportunities
                    </option>

                    @foreach (var opportunity in Model.Opportunities)
                    {
                        <option value="@opportunity.OpportunityID"
                                @(Model.OpportunityFilter == opportunity.OpportunityID ? "selected" : "")>

                            @opportunity.OpportunityCode -
                            @opportunity.Title

                        </option>
                    }

                </select>

            </div>


            <div class="filter-actions">

                <button type="submit"
                        class="primary-button">
                    Search
                </button>

                <a href="@Url.Action(
                    "ShortlistedApplicants",
                    "TechnicianApplication")"
                   class="secondary-button">
                    Clear
                </a>

            </div>
        }

    </div>


    <div class="results-card">

        <div class="results-header">

            <div>
                <h2>Shortlisted Applicants</h2>

                <p>
                    Applicants currently progressing through recruitment.
                </p>
            </div>

            <span class="result-count">
                @Model.Applicants.Count applicant(s)
            </span>

        </div>


        @if (Model.Applicants.Any())
        {
            <div class="table-wrapper">

                <table class="applicants-table">

                    <thead>

                        <tr>
                            <th>Application</th>
                            <th>Applicant</th>
                            <th>Opportunity</th>
                            <th>Application Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var applicant in Model.Applicants)
                        {
                            <tr>

                                <td>

                                    <div class="reference-cell">
                                        <strong>
                                            @applicant.ApplicationReference
                                        </strong>

                                        <span>
                                            @applicant.ApplicantEmail
                                        </span>
                                    </div>

                                </td>


                                <td>

                                    <strong>
                                        @applicant.ApplicantName
                                    </strong>

                                </td>


                                <td>

                                    <div class="opportunity-cell">

                                        <strong>
                                            @applicant.OpportunityCode
                                        </strong>

                                        <span>
                                            @applicant.OpportunityTitle
                                        </span>

                                    </div>

                                </td>


                                <td>
                                    @applicant.ApplicationDate.ToString("dd MMM yyyy")
                                </td>


                                <td>

                                    <span class="status-badge">
                                        @applicant.Status
                                    </span>

                                </td>


                                <td>

                                    <div class="action-buttons">

                                        <a href="@Url.Action(
                                            "Review",
                                            "TechnicianApplication",
                                            new
                                            {
                                                id = applicant.ApplicationID
                                            })"
                                           class="table-button secondary-table-button">
                                            View Application
                                        </a>


                                        @if (applicant.CanScheduleAssessment)
                                        {
                                            <a href="@Url.Action(
                                                "ScheduleAssessment",
                                                "TechnicianApplication",
                                                new
                                                {
                                                    id = applicant.ApplicationID
                                                })"
                                               class="table-button primary-table-button">
                                                Schedule Assessment
                                            </a>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <h3>No Shortlisted Applicants</h3>

                <p>
                    There are currently no applicants who have been
                    shortlisted using the selected criteria.
                </p>

                <a href="@Url.Action(
                    "ReviewApplications",
                    "TechnicianApplication")"
                   class="primary-button">
                    Review Applications
                </a>

            </div>
        }

    </div>


    <div class="navigation-card">

        <a href="@Url.Action(
            "Manage",
            "TechnicianOpportunity")"
           class="navigation-button">
            Opportunity Management
        </a>

        <a href="@Url.Action(
            "ReviewApplications",
            "TechnicianApplication")"
           class="navigation-button">
            Review Applications
        </a>

        <a href="@Url.Action(
            "Index",
            "AdministratorDashboard")"
           class="navigation-button">
            Administrator Dashboard
        </a>

    </div>

</div>


<style>

    .admin-shortlisted-page {
        max-width: 1450px;
        margin: 0 auto;
        padding: 30px;
        color: #1f2937;
    }

    .admin-shortlisted-header {
        background: linear-gradient(135deg, #0D5CC1, #094b9f);
        color: #ffffff;
        border-radius: 14px;
        padding: 30px 34px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
        margin-bottom: 24px;
        box-shadow: 0 8px 24px rgba(13, 92, 193, 0.15);
    }

    .page-kicker {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.5px;
        margin-bottom: 8px;
        opacity: 0.85;
    }

    .admin-shortlisted-header h1 {
        margin: 0 0 8px;
        font-size: 30px;
        font-weight: 700;
    }

    .admin-shortlisted-header p {
        margin: 0;
        max-width: 760px;
        font-size: 15px;
        line-height: 1.6;
        opacity: 0.92;
    }

    .shortlisted-count-header {
        min-width: 120px;
        padding: 17px 20px;
        background: rgba(255,255,255,0.13);
        border: 1px solid rgba(255,255,255,0.25);
        border-radius: 10px;
        text-align: center;
    }

    .shortlisted-count-header span {
        display: block;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.7px;
        opacity: 0.85;
        margin-bottom: 5px;
    }

    .shortlisted-count-header strong {
        font-size: 28px;
    }

    .alert-message {
        border-radius: 8px;
        padding: 14px 18px;
        margin-bottom: 20px;
        font-size: 14px;
        font-weight: 600;
    }

    .alert-success {
        background: #edf9f1;
        color: #176b36;
        border: 1px solid #b8e0c4;
    }

    .alert-error {
        background: #fff1f1;
        color: #a61b1b;
        border: 1px solid #f2b8b8;
    }

    .summary-card {
        background: #ffffff;
        border: 1px solid #e4e9f0;
        border-left: 4px solid #0D5CC1;
        border-radius: 12px;
        padding: 20px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 22px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    .summary-label {
        display: block;
        color: #6b7280;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.7px;
        margin-bottom: 5px;
    }

    .summary-card strong {
        font-size: 26px;
        color: #172033;
    }

    .summary-card p {
        max-width: 620px;
        margin: 0;
        color: #6b7280;
        font-size: 14px;
        line-height: 1.5;
    }

    .filter-card,
    .results-card,
    .navigation-card {
        background: #ffffff;
        border: 1px solid #e4e9f0;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 22px;
        box-shadow: 0 4px 14px rgba(0,0,0,0.04);
    }

    .filter-form {
        display: grid;
        grid-template-columns: minmax(260px, 1.5fr) minmax(230px, 1fr) auto;
        gap: 16px;
        align-items: end;
    }

    .filter-field label {
        display: block;
        margin-bottom: 7px;
        color: #374151;
        font-size: 13px;
        font-weight: 700;
    }

    .filter-field input,
    .filter-field select {
        width: 100%;
        min-height: 43px;
        padding: 9px 12px;
        box-sizing: border-box;
        border: 1px solid #d8dee7;
        border-radius: 7px;
        background: #ffffff;
        color: #263244;
        font-size: 14px;
    }

    .filter-field input:focus,
    .filter-field select:focus {
        outline: none;
        border-color: #0D5CC1;
        box-shadow: 0 0 0 3px rgba(13,92,193,0.1);
    }

    .filter-actions {
        display: flex;
        gap: 9px;
    }

    .primary-button,
    .secondary-button,
    .table-button,
    .navigation-button {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        min-height: 41px;
        padding: 9px 15px;
        border-radius: 7px;
        text-decoration: none !important;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

    .primary-button {
        background: #0D5CC1;
        color: #ffffff !important;
        border: 1px solid #0D5CC1;
    }

    .primary-button:hover {
        background: #094b9f;
        border-color: #094b9f;
    }

    .secondary-button {
        background: #eef2f7;
        color: #263244 !important;
        border: 1px solid #d8dee7;
    }

    .secondary-button:hover {
        background: #e3e8ef;
    }

    .results-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 20px;
    }

    .results-header h2 {
        margin: 0 0 5px;
        color: #172033;
        font-size: 20px;
    }

    .results-header p {
        margin: 0;
        color: #6b7280;
        font-size: 13px;
    }

    .result-count {
        padding: 7px 12px;
        background: #eef5ff;
        color: #0D5CC1;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    .applicants-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 950px;
    }

    .applicants-table th {
        padding: 13px 14px;
        background: #f7f9fc;
        border-bottom: 1px solid #dfe5ec;
        color: #566173;
        text-align: left;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.6px;
    }

    .applicants-table td {
        padding: 16px 14px;
        border-bottom: 1px solid #edf0f4;
        color: #394457;
        font-size: 13px;
        vertical-align: middle;
    }

    .applicants-table tbody tr:hover {
        background: #fbfcfe;
    }

    .reference-cell,
    .opportunity-cell {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .reference-cell strong,
    .opportunity-cell strong,
    .applicants-table td > strong {
        color: #172033;
    }

    .reference-cell span,
    .opportunity-cell span {
        color: #718096;
        font-size: 12px;
        line-height: 1.4;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 20px;
        background: #edf9f1;
        border: 1px solid #b8e0c4;
        color: #176b36;
        font-size: 12px;
        font-weight: 700;
    }

    .action-buttons {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
    }

    .table-button {
        min-height: 36px;
        padding: 7px 11px;
        font-size: 12px;
    }

    .primary-table-button {
        background: #0D5CC1;
        color: #ffffff !important;
        border: 1px solid #0D5CC1;
    }

    .primary-table-button:hover {
        background: #094b9f;
    }

    .secondary-table-button {
        background: #f1f4f8;
        color: #263244 !important;
        border: 1px solid #dce2e9;
    }

    .secondary-table-button:hover {
        background: #e7ebf0;
    }

    .empty-state {
        text-align: center;
        padding: 55px 25px;
        border: 1px dashed #ccd5e1;
        border-radius: 10px;
        background: #fafbfd;
    }

    .empty-state h3 {
        margin: 0 0 8px;
        color: #263244;
        font-size: 19px;
    }

    .empty-state p {
        max-width: 540px;
        margin: 0 auto 20px;
        color: #6b7280;
        font-size: 14px;
        line-height: 1.6;
    }

    .navigation-card {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .navigation-button {
        background: #f4f6f9;
        color: #263244 !important;
        border: 1px solid #dfe5ec;
    }

    .navigation-button:hover {
        background: #e9edf3;
    }

    @@media (max-width: 900px) {

        .filter-form {
            grid-template-columns: 1fr;
        }

        .filter-actions {
            justify-content: flex-start;
        }

        .summary-card {
            align-items: flex-start;
            flex-direction: column;
        }

    }

    @@media (max-width: 650px) {

        .admin-shortlisted-page {
            padding: 18px;
        }

        .admin-shortlisted-header {
            padding: 24px;
            flex-direction: column;
            align-items: flex-start;
        }

        .shortlisted-count-header {
            width: 100%;
            box-sizing: border-box;
        }

        .results-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .navigation-card {
            flex-direction: column;
        }

        .navigation-button {
            width: 100%;
        }

    }

</style>