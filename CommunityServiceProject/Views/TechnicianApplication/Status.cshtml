
@model CommunityServiceProject.ViewModels.TechnicianApplicationDetailsViewModel

@{
    ViewBag.Title = "Application Status";
}

<div class="application-details-page">

    <div class="details-header">

        <div>

            <div class="details-eyebrow">
                TECHNICIAN APPLICATION
            </div>

            <h1>
                @Model.OpportunityTitle
            </h1>

            <p>
                Application reference:
                <strong>
                    @Model.ApplicationReference
                </strong>
            </p>

        </div>

        <div>

            <span class="status-badge status-@Model.Status.ToString().ToLower()">
                @Model.Status
            </span>

        </div>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-error">
            @TempData["ErrorMessage"]
        </div>
    }


    @* =========================================================
         DRAFT APPLICATION MESSAGE
        ========================================================= *@

    @if (Model.Status ==
        CommunityServiceProject.Models.TechnicianApplicationStatus.Draft)
    {
        <div class="draft-message">

            <div class="draft-message-content">

                <h2>
                    Application Not Yet Submitted
                </h2>

                <p>
                    Your application has been saved as a draft.
                    You can still edit your application and upload
                    supporting documents before submitting it.
                </p>

            </div>

        </div>
    }


    @* =========================================================
         DOCUMENTS PENDING MESSAGE
        ========================================================= *@

    @if (Model.Status ==
        CommunityServiceProject.Models.TechnicianApplicationStatus.DocumentsPending)
    {
        <div class="documents-pending-message">

            <div class="documents-pending-icon">
                !
            </div>

            <div class="documents-pending-content">

                <h2>
                    Supporting Documents Require Attention
                </h2>

                <p>
                    One or more supporting documents submitted with your
                    application were rejected by HR.
                    Please review the HR's comments and replace
                    the rejected documents before your application can continue.
                </p>

                <div class="documents-pending-action">

                    @Html.ActionLink(
                        "Update Documents",
                        "Documents",
                        "TechnicianApplication",
                        new
                        {
                            id = Model.ApplicationID
                        },
                        new
                        {
                            @class = "update-documents-button"
                        }
                    )

                </div>

            </div>

        </div>
    }


    @* =========================================================
         REPLACEMENT DOCUMENT SUBMITTED / UNDER REVIEW
        ========================================================= *@

    @if (Model.Status ==
        CommunityServiceProject.Models.TechnicianApplicationStatus.UnderReview)
    {
        <div class="replacement-review-message">

            <div class="replacement-review-icon">
                ✓
            </div>

            <div class="replacement-review-content">

                <h2>
                    Replacement Document Submitted
                </h2>

                <p>
                    Your replacement supporting document has been
                    submitted successfully and is now awaiting
                    HR's' review.
                </p>

                <p>
                    You do not need to submit a new application.
                    The administrator will review the replacement
                    document as part of your existing application.
                </p>

                <div class="replacement-review-action">

                    @Html.ActionLink(
                        "View Supporting Documents",
                        "Documents",
                        "TechnicianApplication",
                        new
                        {
                            id = Model.ApplicationID
                        },
                        new
                        {
                            @class = "replacement-documents-button"
                        }
                    )

                </div>

            </div>

        </div>
    }


    @* =========================================================
         TECHNICIAN ONBOARDING / ACCOUNT CREATED
        ========================================================= *@

    @if (Model.Status ==
        CommunityServiceProject.Models.TechnicianApplicationStatus.Onboarded)
    {
        <div class="technician-onboarded-message">

            <div class="technician-onboarded-icon">
                ✓
            </div>

            <div class="technician-onboarded-content">

                <div class="technician-onboarded-eyebrow">
                    ONBOARDING COMPLETE
                </div>

                <h2>
                    Your Technician Account Has Been Created
                </h2>

                <p>
                    Your application has successfully completed the
                    technician onboarding process. Your municipal
                    Technician account has been created.
                </p>

                <p>
                    Select a Technician account below to view its
                    municipal login details.
                </p>


                @if (Model.TechnicianOnboardings != null &&
                     Model.TechnicianOnboardings.Count > 0)
                {
                    <div class="technician-onboarding-list">

                        @foreach (var onboarding in Model.TechnicianOnboardings)
                        {
                            <div class="technician-onboarding-item">

                                <div class="technician-onboarding-info">

                                    <div class="technician-onboarding-name">
                                        @onboarding.TechnicianName
                                    </div>

                                    <div class="technician-onboarding-email">
                                        @onboarding.MunicipalEmail
                                    </div>

                                    <div class="technician-onboarding-meta">
                                        Onboarded
                                        @onboarding.OnboardingDate.ToString(
                                            "dd MMM yyyy HH:mm")
                                    </div>

                                </div>

                                <div class="technician-onboarding-action">

                                    @Html.ActionLink(
                                        "View Account Details",
                                        "TechnicianAccountDetails",
                                        "TechnicianApplication",
                                        new
                                        {
                                            onboardingId =
                                                onboarding.OnboardingID
                                        },
                                        new
                                        {
                                            @class =
                                                "technician-details-button"
                                        }
                                    )

                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="technician-account-pending">

                        Technician account details are currently being
                        prepared. Please refresh this page shortly.

                    </div>
                }


                <div class="technician-onboarded-note">

                    <strong>Important:</strong>

                    Each Technician account uses a temporary password.
                    The temporary password must be changed during the
                    first Technician login.

                </div>

            </div>

        </div>
    }


    @if (Model.IsSuccessful)
    {
        <div class="decision-message success">

            <h2>
                Application Progressed
            </h2>

            <p>
                Your application has progressed in the recruitment process.
                Please continue to monitor your application status for
                further onboarding information.
            </p>

        </div>
    }
    else if (Model.IsUnsuccessful)
    {
        <div class="decision-message unsuccessful">

            <h2>
                Application Not Selected
            </h2>

            <p>
                Your application was not selected for this opportunity.
                Thank you for your interest in working with the municipality.
            </p>

        </div>
    }


    <div class="details-grid">

        <div class="details-main">

            <div class="content-card">

                <div class="card-header">

                    <h2>
                        Application Information
                    </h2>

                </div>

                <div class="information-grid">

                    <div>
                        <span>
                            Application Reference
                        </span>

                        <strong>
                            @Model.ApplicationReference
                        </strong>
                    </div>


                    <div>
                        <span>
                            Opportunity Code
                        </span>

                        <strong>
                            @Model.OpportunityCode
                        </strong>
                    </div>


                    <div>
                        <span>
                            Employment Type
                        </span>

                        <strong>
                            @Model.EmploymentType
                        </strong>
                    </div>


                    <div>
                        <span>
                            Positions
                        </span>

                        <strong>
                            @(Model.NumberOfPositions.HasValue
                                ? Model.NumberOfPositions.ToString()
                                : "Not specified")
                        </strong>
                    </div>


                    <div>
                        <span>
                            Application Date
                        </span>

                        <strong>
                            @Model.ApplicationDate.ToString(
                                "dd MMM yyyy HH:mm")
                        </strong>
                    </div>


                    <div>
                        <span>
                            Application Deadline
                        </span>

                        <strong>
                            @Model.ApplicationDeadline.ToString(
                                "dd MMM yyyy")
                        </strong>
                    </div>


                    <div>
                        <span>
                            Last Updated
                        </span>

                        <strong>
                            @(Model.LastUpdatedDate.HasValue
                                ? Model.LastUpdatedDate.Value.ToString(
                                    "dd MMM yyyy HH:mm")
                                : "Not updated")
                        </strong>
                    </div>


                    <div>
                        <span>
                            Supporting Documents
                        </span>

                        <strong>
                            @Model.DocumentCount
                            @(Model.DocumentCount == 1
                                ? "document"
                                : "documents")
                        </strong>
                    </div>

                </div>

            </div>


            @* =================================================
                 COVER LETTER
                ================================================= *@

            <div class="content-card">

                <div class="card-header">

                    <h2>
                        Application Cover Letter
                    </h2>

                </div>

                <div class="cover-letter-content">

                    @Html.Raw(
                        HttpUtility.HtmlEncode(Model.CoverLetter)
                            .Replace("\r\n", "<br />")
                            .Replace("\n", "<br />")
                    )

                </div>

            </div>


            @* =================================================
                 SUPPORTING DOCUMENTS / SUBMISSION READINESS
                ================================================= *@

            @if (Model.Status ==
                CommunityServiceProject.Models.TechnicianApplicationStatus.Draft)
            {
                <div class="content-card">

                    <div class="card-header">

                        <h2>
                            Application Completion
                        </h2>

                    </div>

                    <div class="completion-content">

                        <div class="completion-item completed">

                            <div class="completion-icon">
                                ✓
                            </div>

                            <div>

                                <strong>
                                    Application details saved
                                </strong>

                                <p>
                                    Your cover letter has been saved successfully.
                                </p>

                            </div>

                        </div>


                        <div class="completion-item @(Model.HasDocuments ? "completed" : "incomplete")">

                            <div class="completion-icon">
                                @(Model.HasDocuments ? "✓" : "!")
                            </div>

                            <div>

                                <strong>
                                    Supporting documents
                                </strong>

                                @if (Model.HasDocuments)
                                {
                                    <p>
                                        @Model.DocumentCount
                                        @(Model.DocumentCount == 1
                                            ? "supporting document has"
                                            : "supporting documents have")
                                        been uploaded.
                                    </p>
                                }
                                else
                                {
                                    <p>
                                        At least one supporting document
                                        is required before you can submit
                                        your application.
                                    </p>
                                }

                            </div>

                        </div>


                        <div class="completion-item @(Model.CanSubmit ? "completed" : "incomplete")">

                            <div class="completion-icon">
                                @(Model.CanSubmit ? "✓" : "!")
                            </div>

                            <div>

                                <strong>
                                    Final submission
                                </strong>

                                @if (Model.CanSubmit)
                                {
                                    <p>
                                        Your application is ready for final submission.
                                    </p>
                                }
                                else
                                {
                                    <p>
                                        Complete the required supporting documents
                                        before submitting your application.
                                    </p>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>


        <aside class="details-sidebar">

            <div class="sidebar-card">

                <h2>
                    Application Status
                </h2>

                <div class="current-status">

                    <span class="status-badge status-@Model.Status.ToString().ToLower()">
                        @Model.Status
                    </span>

                </div>


                @if (Model.Status ==
                    CommunityServiceProject.Models.TechnicianApplicationStatus.Draft)
                {
                    <p>
                        Your application is currently saved as a draft.
                        Complete your supporting documents and submit the
                        application before the deadline.
                    </p>
                }
                else if (Model.Status ==
                    CommunityServiceProject.Models.TechnicianApplicationStatus.DocumentsPending)
                {
                    <p>
                        One or more supporting documents require replacement.
                        Review the rejected documents and submit updated
                        copies for administrator verification.
                    </p>
                }
                else if (Model.Status ==
                    CommunityServiceProject.Models.TechnicianApplicationStatus.UnderReview)
                {
                    <p>
                        Your application is currently under administrator
                        review. If you recently replaced a rejected document,
                        the replacement is awaiting verification.
                    </p>
                }
                else if (Model.Status ==
                    CommunityServiceProject.Models.TechnicianApplicationStatus.Onboarded)
                {
                    <p>
                        Your application has completed the onboarding process.
                        Your municipal Technician account has been created.
                        View the Technician account details below to access
                        your login information.
                    </p>
                }
                else
                {
                    <p>
                        Your application status will change as the
                        recruitment process progresses.
                    </p>
                }

            </div>


            @* =================================================
                 ONBOARDED TECHNICIAN ACCOUNT ACTION
                ================================================= *@

            @if (Model.Status ==
                CommunityServiceProject.Models.TechnicianApplicationStatus.Onboarded &&
                Model.TechnicianOnboardings != null &&
                Model.TechnicianOnboardings.Count > 0)
            {
                <div class="sidebar-card technician-account-card">

                    <div class="technician-account-icon">
                        ✓
                    </div>

                    <h2>
                        Technician Accounts
                    </h2>

                    <p>
                        Your municipal Technician account has been created.
                        Select an account below to view its login details.
                    </p>


                    @foreach (var onboarding in Model.TechnicianOnboardings)
                    {
                        <div class="technician-sidebar-account">

                            <strong>
                                @onboarding.TechnicianName
                            </strong>

                            <span>
                                @onboarding.MunicipalEmail
                            </span>

                            @Html.ActionLink(
                                "View Account Details",
                                "TechnicianAccountDetails",
                                "TechnicianApplication",
                                new
                                {
                                    onboardingId =
                                        onboarding.OnboardingID
                                },
                                new
                                {
                                    @class =
                                        "action-button technician-details-action"
                                }
                            )

                        </div>
                    }

                </div>
            }


            @* =================================================
                 DOCUMENTS PENDING ACTIONS
                ================================================= *@

            @if (Model.Status ==
                CommunityServiceProject.Models.TechnicianApplicationStatus.DocumentsPending)
            {
                <div class="sidebar-card documents-update-card">

                    <div class="documents-update-icon">
                        !
                    </div>

                    <h2>
                        Action Required
                    </h2>

                    <p>
                        Your application cannot continue until the rejected
                        supporting documents have been replaced.
                    </p>

                    @Html.ActionLink(
                        "Update Documents",
                        "Documents",
                        "TechnicianApplication",
                        new
                        {
                            id = Model.ApplicationID
                        },
                        new
                        {
                            @class =
                                "action-button update-documents-action"
                        }
                    )

                </div>
            }


            @* =================================================
                 UNDER REVIEW ACTIONS
                ================================================= *@

            @if (Model.Status ==
                CommunityServiceProject.Models.TechnicianApplicationStatus.UnderReview)
            {
                <div class="sidebar-card replacement-review-card">

                    <div class="replacement-review-sidebar-icon">
                        ✓
                    </div>

                    <h2>
                        Awaiting Review
                    </h2>

                    <p>
                        Your application is being reviewed by the
                        administrator. You can view your submitted
                        supporting documents below.
                    </p>

                    @Html.ActionLink(
                        "Supporting Documents",
                        "Documents",
                        "TechnicianApplication",
                        new
                        {
                            id = Model.ApplicationID
                        },
                        new
                        {
                            @class =
                                "action-button replacement-documents-action"
                        }
                    )

                </div>
            }


            @* =================================================
                 DRAFT ACTIONS
                ================================================= *@

            @if (Model.Status ==
                CommunityServiceProject.Models.TechnicianApplicationStatus.Draft)
            {
                <div class="sidebar-card">

                    <h2>
                        Application Actions
                    </h2>

                    <p>
                        You can update your application and manage
                        supporting documents while it remains a draft.
                    </p>

                    @if (Model.IsEditable)
                    {
                        @Html.ActionLink(
                            "Edit Application",
                            "Edit",
                            "TechnicianApplication",
                            new
                            {
                                id = Model.ApplicationID
                            },
                            new
                            {
                                @class =
                                    "action-button secondary-action"
                            }
                        )
                    }


                    @Html.ActionLink(
                        "Supporting Documents",
                        "Documents",
                        "TechnicianApplication",
                        new
                        {
                            id = Model.ApplicationID
                        },
                        new
                        {
                            @class =
                                "action-button secondary-action"
                        }
                    )


                    @if (Model.CanSubmit)
                    {
                        using (Html.BeginForm(
                            "Submit",
                            "TechnicianApplication",
                            new
                            {
                                id = Model.ApplicationID
                            },
                            FormMethod.Post,
                            new
                            {
                                @class =
                                    "submit-application-form"
                            }))
                        {
                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="action-button primary-action"
                                    onclick="return confirm('Are you sure you want to submit this application? You will not be able to edit it after submission.');">
                                Submit Application
                            </button>
                        }
                    }
                    else
                    {
                        <div class="submission-requirement">

                            <strong>
                                Final submission unavailable
                            </strong>

                            <p>
                                Upload at least one supporting document
                                before submitting your application.
                            </p>

                        </div>
                    }

                </div>
            }


            @* =================================================
                 OPPORTUNITY
                ================================================= *@

            <div class="sidebar-card">

                <h2>
                    Opportunity
                </h2>

                <p class="sidebar-opportunity-title">
                    @Model.OpportunityTitle
                </p>

                @Html.ActionLink(
                    "View Opportunity",
                    "Details",
                    "TechnicianOpportunity",
                    new
                    {
                        id = Model.OpportunityID
                    },
                    new
                    {
                        @class =
                            "sidebar-link"
                    }
                )

            </div>

        </aside>

    </div>


    @* =========================================================
         APPLICATION LOCKED MESSAGE
        ========================================================= *@

    @if (!Model.IsEditable &&
        Model.Status !=
            CommunityServiceProject.Models.TechnicianApplicationStatus.Draft &&
        Model.Status !=
            CommunityServiceProject.Models.TechnicianApplicationStatus.DocumentsPending &&
        Model.Status !=
            CommunityServiceProject.Models.TechnicianApplicationStatus.NotSelected &&
        Model.Status !=
            CommunityServiceProject.Models.TechnicianApplicationStatus.Withdrawn)
    {
        <div class="edit-status-note">

            This application has been submitted and can no longer
            be edited while it is being processed.

        </div>
    }


    @* =========================================================
         PAGE NAVIGATION
        ========================================================= *@

    <div class="page-navigation">

        @Html.ActionLink(
            "Back to My Applications",
            "Index",
            "TechnicianApplication",
            null,
            new
            {
                @class = "btn-secondary"
            }
        )

        @Html.ActionLink(
            "View Opportunities",
            "Index",
            "TechnicianOpportunity",
            null,
            new
            {
                @class = "btn-primary"
            }
        )

    </div>

</div>


<style>

    .application-details-page {
        max-width: 1100px;
        margin: 30px auto 60px;
        padding: 0 20px;
        font-family: Arial, Helvetica, sans-serif;
        color: #263238;
    }

    .details-header {
        background: linear-gradient(135deg, #0D5CC1, #094b9f);
        color: white;
        border-radius: 12px;
        padding: 30px;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
    }

    .details-eyebrow {
        color: white;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.2px;
        margin-bottom: 8px;
    }

    .details-header h1 {
        color: white;
        margin: 0 0 8px;
        font-size: 27px;
    }

    .details-header p {
        color: white;
        margin: 0;
        font-size: 13px;
    }

    .details-header strong {
        color: white;
    }

    .status-badge {
        display: inline-block;
        border-radius: 5px;
        padding: 7px 10px;
        font-size: 11px;
        font-weight: 700;
        border: 1px solid transparent;
        white-space: nowrap;
    }

    .status-draft {
        background: #fff7e6;
        color: #9a6700;
        border-color: #f1d59b;
    }

    .status-submitted,
    .status-underreview,
    .status-screening,
    .status-documentspending,
    .status-documentsverified,
    .status-assessmentscheduled,
    .status-assessed,
    .status-interviewscheduled,
    .status-interviewed,
    .status-finalverification {
        background: #edf4ff;
        color: #0D5CC1;
        border-color: #cbdcf4;
    }

    .status-shortlisted,
    .status-selected,
    .status-approvedforonboarding {
        background: #eaf7ef;
        color: #187a43;
        border-color: #bfe2ca;
    }

    .status-onboarded {
        background: #e5f4ec;
        color: #126334;
        border-color: #b7ddc4;
    }

    .status-notselected {
        background: #fff0f0;
        color: #b42318;
        border-color: #efc4c4;
    }

    .status-withdrawn {
        background: #f1f3f5;
        color: #596773;
        border-color: #d8dee3;
    }

    .alert {
        padding: 13px 16px;
        border-radius: 8px;
        margin-bottom: 18px;
        font-size: 13px;
        font-weight: 600;
    }

    .alert-success {
        background: #edf9f1;
        border: 1px solid #c4e6cf;
        color: #25643c;
    }

    .alert-error {
        background: #fff5f5;
        border: 1px solid #efc4c4;
        color: #8e2424;
    }

    /* =========================================================
       TECHNICIAN ONBOARDING
       ========================================================= */

    .technician-onboarded-message {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        background: #f1faf5;
        border: 1px solid #c5e5d1;
        border-left: 5px solid #198754;
        border-radius: 10px;
        padding: 22px;
        margin-bottom: 20px;
    }

    .technician-onboarded-icon {
        width: 40px;
        height: 40px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #198754;
        color: #ffffff;
        font-size: 18px;
        font-weight: 800;
    }

    .technician-onboarded-content {
        min-width: 0;
        width: 100%;
    }

    .technician-onboarded-eyebrow {
        color: #198754;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
        margin-bottom: 5px;
    }

    .technician-onboarded-content h2 {
        margin: 0 0 7px;
        color: #176b42;
        font-size: 19px;
    }

    .technician-onboarded-content p {
        margin: 0 0 7px;
        color: #456557;
        font-size: 13px;
        line-height: 1.65;
        max-width: 780px;
    }

    .technician-onboarded-note {
        margin-top: 15px;
        padding: 11px 13px;
        background: #ffffff;
        border: 1px solid #cfe4d6;
        border-radius: 7px;
        color: #4b6657;
        font-size: 11px;
        line-height: 1.55;
        max-width: 780px;
    }

        .technician-onboarded-note strong {
            color: #176b42;
        }

    .technician-onboarding-list {
        margin-top: 17px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        max-width: 780px;
    }

    .technician-onboarding-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 14px 15px;
        background: #ffffff;
        border: 1px solid #cfe4d6;
        border-radius: 8px;
    }

    .technician-onboarding-info {
        min-width: 0;
    }

    .technician-onboarding-name {
        color: #176b42;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .technician-onboarding-email {
        color: #456557;
        font-size: 12px;
        word-break: break-word;
    }

    .technician-onboarding-meta {
        margin-top: 4px;
        color: #71808e;
        font-size: 11px;
    }

    .technician-onboarding-action {
        flex-shrink: 0;
    }

    .technician-account-pending {
        margin-top: 17px;
        max-width: 780px;
        padding: 12px 14px;
        background: #ffffff;
        border: 1px solid #cfe4d6;
        border-radius: 7px;
        color: #5b7165;
        font-size: 12px;
        line-height: 1.5;
