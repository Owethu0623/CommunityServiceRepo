@model CommunityServiceProject.Models.Technician

@{
    ViewBag.Title = "Add Technician";
}

<div class="admin-technician-create-page">

    <div class="admin-technician-create-card">

        <!-- =======================================================
             HEADER
             ======================================================= -->

        <div class="admin-technician-create-header">

            <h2>
                Add Technician
            </h2>

            <p>
                Create a new technician account.
            </p>

        </div>


        <!-- =======================================================
             FORM
             ======================================================= -->

        @using (Html.BeginForm(
            "Create",
            "TechnicianManagement",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="admin-technician-create-content">

                <!-- =================================================
                     VALIDATION SUMMARY
                     ================================================= -->

                @Html.ValidationSummary(
                    true,
                    "",
                    new
                    {
                        @class = "admin-validation-summary"
                    }
                )


                <!-- =================================================
                     FIRST NAME
                     ================================================= -->

                <div class="admin-technician-form-group">

                    @Html.LabelFor(
                        model => model.FirstName,
                        "First Name"
                    )

                    @Html.TextBoxFor(
                        model => model.FirstName,
                        new
                        {
                            @class = "admin-technician-input",
                            autocomplete = "off"
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.FirstName,
                        "",
                        new
                        {
                            @class = "admin-validation-message"
                        }
                    )

                </div>


                <!-- =================================================
                     LAST NAME
                     ================================================= -->

                <div class="admin-technician-form-group">

                    @Html.LabelFor(
                        model => model.LastName,
                        "Last Name"
                    )

                    @Html.TextBoxFor(
                        model => model.LastName,
                        new
                        {
                            @class = "admin-technician-input",
                            autocomplete = "off"
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.LastName,
                        "",
                        new
                        {
                            @class = "admin-validation-message"
                        }
                    )

                </div>


                <!-- =================================================
                     EMAIL ADDRESS
                     ================================================= -->

                <div class="admin-technician-form-group">

                    @Html.LabelFor(
                        model => model.EmailAddress,
                        "Email Address"
                    )

                    @Html.TextBoxFor(
                        model => model.EmailAddress,
                        new
                        {
                            @class = "admin-technician-input",
                            type = "email",
                            autocomplete = "off"
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.EmailAddress,
                        "",
                        new
                        {
                            @class = "admin-validation-message"
                        }
                    )

                </div>


                <!-- =================================================
                     PHONE NUMBER
                     ================================================= -->

                <div class="admin-technician-form-group">

                    @Html.LabelFor(
                        model => model.PhoneNumber,
                        "Phone Number"
                    )

                    @Html.TextBoxFor(
                        model => model.PhoneNumber,
                        new
                        {
                            @class = "admin-technician-input",
                            type = "tel",
                            autocomplete = "off"
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.PhoneNumber,
                        "",
                        new
                        {
                            @class = "admin-validation-message"
                        }
                    )

                </div>


                <!-- =================================================
                     PASSWORD
                     ================================================= -->

                <div class="admin-technician-form-group">

                    @Html.LabelFor(
                        model => model.Password,
                        "Password"
                    )

                    @Html.PasswordFor(
                        model => model.Password,
                        new
                        {
                            @class = "admin-technician-input",
                            id = "technicianPassword",
                            autocomplete = "new-password"
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.Password,
                        "",
                        new
                        {
                            @class = "admin-validation-message"
                        }
                    )

                    <small class="admin-technician-password-help">
                        Password must be at least 8 characters and contain
                        an uppercase letter, a lowercase letter, and a number.
                    </small>

                </div>


                <!-- =================================================
                     CONFIRM PASSWORD
                     ================================================= -->

                <div class="admin-technician-form-group">

                    @Html.LabelFor(
                        model => model.ConfirmPassword,
                        "Confirm Password"
                    )

                    @Html.PasswordFor(
                        model => model.ConfirmPassword,
                        new
                        {
                            @class = "admin-technician-input",
                            id = "technicianConfirmPassword",
                            autocomplete = "new-password"
                        }
                    )

                    @Html.ValidationMessageFor(
                        model => model.ConfirmPassword,
                        "",
                        new
                        {
                            @class = "admin-validation-message"
                        }
                    )

                </div>


                <!-- =================================================
                     SHOW PASSWORD
                     ================================================= -->

                <div class="admin-technician-password-toggle">

                    <label>
                        <input type="checkbox"
                               id="showTechnicianPassword"
                               onclick="toggleTechnicianPassword()" />

                        Show Password
                    </label>

                </div>


                <!-- =================================================
                     ACTION BUTTONS
                     ================================================= -->

                <div class="admin-technician-create-actions">

                    <button type="submit"
                            class="admin-technician-save-button">

                        Add Technician

                    </button>


                    <a href="@Url.Action(
                        "Index",
                        "TechnicianManagement"
                    )"
                       class="admin-technician-cancel-button">

                        Cancel

                    </a>

                </div>

            </div>
        }

    </div>

</div>


<!-- ===============================================================
     SHOW / HIDE PASSWORD
     =============================================================== -->

<script>

    function toggleTechnicianPassword() {

        var passwordField =
            document.getElementById("technicianPassword");

        var confirmPasswordField =
            document.getElementById("technicianConfirmPassword");

        var checkbox =
            document.getElementById("showTechnicianPassword");


        if (checkbox.checked) {

            passwordField.type = "text";

            confirmPasswordField.type = "text";

        }
        else {

            passwordField.type = "password";

            confirmPasswordField.type = "password";

        }
    }

</script>