@model CommunityServiceProject.ViewModels.TechnicianOpportunityListViewModel

@{
    ViewBag.Title = "Technician Opportunities";
}

<div class="technician-opportunity-page">

    <!-- ============================================================
         PAGE HEADER
         ============================================================ -->

    <div class="technician-opportunity-header">

        <div class="page-header">

            <div>
                <div class="page-eyebrow">
                    TECHNICIAN RECRUITMENT
                </div>

                <h1>
                    Technician Opportunities
                </h1>

                <p>
                    Create, publish and manage municipal technician recruitment opportunities.
                </p>
            </div>

            <div class="page-header-actions">

                @Html.ActionLink(
                    "Create New Opportunity",
                    "Create",
                    "TechnicianOpportunity",
                    null,
                    new
                    {
                        @class = "btn-primary"
                    }
                )

            </div>

        </div>

        <div class="header-actions">

            @Html.ActionLink(
                "Back",
                "Index",
                "AdministratorDashboard",
                null,
                new { @class = "btn-secondary" }
            )

        </div>

    </div>


    <!-- ============================================================
         SEARCH / FILTER CARD
         ============================================================ -->

    <div class="opportunity-filter-card">

        @using (Html.BeginForm(
            "Index",
            "TechnicianOpportunity",
            FormMethod.Get))
        {
            <div class="filter-grid">

                <div class="filter-field filter-search">

                    <label for="searchTerm">
                        Search Opportunities
                    </label>

                    @Html.TextBox(
                        "searchTerm",
                        Model.SearchTerm,
                        new
                        {
                            @class = "form-control",
                            id = "searchTerm",
                            placeholder =
                                "Search by title, code or requirements..."
                        }
                    )

                </div>


                <div class="filter-field">

                    <label for="employmentType">
                        Employment Type
                    </label>

                    @Html.DropDownList(
                        "employmentType",
                        (SelectList)ViewBag.EmploymentTypes,
                        "All employment types",
                        new
                        {
                            @class = "form-control",
                            id = "employmentType"
                        }
                    )

                </div>


                <div class="filter-field">

                    <label for="closingFilter">
                        Closing Soon
                    </label>

                    <select id="closingFilter"
                            name="closingFilter"
                            class="form-control">

                        <option value="">
                            All available opportunities
                        </option>

                        <option value="7"
                                @(Model.ClosingFilter == "7" ? "selected" : "")>
                            Closing within 7 days
                        </option>

                        <option value="14"
                                @(Model.ClosingFilter == "14" ? "selected" : "")>
                            Closing within 14 days
                        </option>

                        <option value="30"
                                @(Model.ClosingFilter == "30" ? "selected" : "")>
                            Closing within 30 days
                        </option>

                    </select>

                </div>


                <div class="filter-actions">

                    <button type="submit"
                            class="btn-primary">
                        Search
                    </button>

                    @Html.ActionLink(
                        "Clear",
                        "Index",
                        "TechnicianOpportunity",
                        null,
                        new { @class = "btn-secondary" }
                    )

                </div>

            </div>
        }

    </div>


    <!-- ============================================================
         RESULTS SUMMARY
         ============================================================ -->

    <div class="opportunity-results-header">

        <div>

            <h2>
                Available Opportunities
            </h2>

            <p>
                @Model.TotalOpportunities
                opportunity@(Model.TotalOpportunities == 1 ? "" : "ies")
                currently available.
            </p>

        </div>

    </div>


    <!-- ============================================================
         OPPORTUNITY LIST
         ============================================================ -->

    @if (Model.Opportunities != null &&
         Model.Opportunities.Any())
    {
        <div class="opportunity-list">

            @foreach (var opportunity in Model.Opportunities)
            {
                <div class="opportunity-card">

                    <div class="opportunity-card-main">

                        <div class="opportunity-code">
                            @opportunity.OpportunityCode
                        </div>

                        <h3>
                            @opportunity.Title
                        </h3>

                        <div class="opportunity-meta">

                            <span>
                                @(string.IsNullOrWhiteSpace(
                                    opportunity.EmploymentType)
                                    ? "Employment type not specified"
                                    : opportunity.EmploymentType)
                            </span>

                            @if (opportunity.NumberOfPositions.HasValue)
                            {
                                <span>
                                    @opportunity.NumberOfPositions
                                    position@(opportunity.NumberOfPositions == 1
                                        ? ""
                                        : "s")
                                </span>
                            }

                            <span>
                                Applications close
                                @opportunity.ApplicationDeadline
                                .ToString("dd MMM yyyy")
                            </span>

                        </div>


                        <div class="opportunity-requirements">

                            <strong>
                                Key Requirements
                            </strong>

                            <p>
                                @opportunity.Requirements
                            </p>

                        </div>

                    </div>


                    <div class="opportunity-card-side">

                        @if (opportunity.DaysRemaining == 0)
                        {
                            <div class="deadline-badge deadline-today">
                                Closing today
                            </div>
                        }
                        else if (opportunity.DaysRemaining <= 7)
                        {
                            <div class="deadline-badge deadline-soon">
                                @opportunity.DaysRemaining
                                day@(opportunity.DaysRemaining == 1
                                    ? ""
                                    : "s")
                                remaining
                            </div>
                        }
                        else
                        {
                            <div class="deadline-badge deadline-normal">
                                @opportunity.DaysRemaining
                                days remaining
                            </div>
                        }


                        @Html.ActionLink(
                            "View Opportunity",
                            "Details",
                            "TechnicianOpportunity",
                            new
                            {
                                id = opportunity.OpportunityID
                            },
                            new
                            {
                                @class =
                                    "btn-primary opportunity-view-button"
                            }
                        )

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="opportunity-empty-state">

            <div class="empty-state-title">
                No opportunities found
            </div>

            <p>
                There are currently no available technician
                opportunities matching your search criteria.
            </p>

            @Html.ActionLink(
                "View All Opportunities",
                "Index",
                "TechnicianOpportunity",
                null,
                new { @class = "btn-secondary" }
            )

        </div>
    }

</div>


<style>

    .technician-opportunity-page {
        max-width: 1250px;
        margin: 30px auto 60px;
        padding: 0 20px;
        font-family: Arial, Helvetica, sans-serif;
        color: #263238;
    }

    /* ============================================================
       HEADER
       ============================================================ */

    .technician-opportunity-header {
        background: linear-gradient( 135deg, #0D5CC1, #094b9f );
        color: white;
        border-radius: 12px;
        padding: 30px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 25px;
        margin-bottom: 24px;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.08);
    }

    .technician-opportunity-eyebrow {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.3px;
        margin-bottom: 8px;
        opacity: 0.9;
    }

    .technician-opportunity-header h1 {
        margin: 0 0 8px;
        font-size: 30px;
        font-weight: 700;
    }

    .technician-opportunity-header p {
        margin: 0;
        max-width: 700px;
        font-size: 15px;
        line-height: 1.6;
        color: white;
    }

    .header-actions {
        flex-shrink: 0;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 25px;
    }

    .page-header-actions {
        flex-shrink: 0;
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 18px;
        border-radius: 7px;
        background: #0D5CC1;
        border: 1px solid #0D5CC1;
        color: white;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }

        .btn-primary:hover {
            background: #094b9f;
            border-color: #094b9f;
            color: white;
            text-decoration: none;
        }

    .page-eyebrow {
        color: #0D5CC1;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.2px;
        margin-bottom: 7px;
    }
    /* ============================================================
       FILTER CARD
       ============================================================ */

    .opportunity-filter-card {
        background: white;
        border: 1px solid #e1e7ef;
        border-radius: 12px;
        padding: 22px;
        margin-bottom: 30px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.05);
    }

    .filter-grid {
        display: grid;
        grid-template-columns: minmax(260px, 2fr) minmax(190px, 1fr) minmax(190px, 1fr) auto;
        gap: 16px;
        align-items: end;
    }

    .filter-field label {
        display: block;
        margin-bottom: 7px;
        font-size: 13px;
        font-weight: 700;
        color: #37474f;
    }

    .form-control {
        width: 100%;
        min-height: 42px;
        padding: 9px 12px;
        border: 1px solid #ccd5df;
        border-radius: 7px;
        background: white;
        font-size: 14px;
        box-sizing: border-box;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .form-control:focus {
            border-color: #0D5CC1;
            box-shadow: 0 0 0 3px rgba(13, 92, 193, 0.10);
        }

    .filter-actions {
        display: flex;
        gap: 8px;
    }


    /* ============================================================
       RESULTS HEADER
       ============================================================ */

    .opportunity-results-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

        .opportunity-results-header h2 {
            margin: 0 0 4px;
            font-size: 21px;
            color: #263238;
        }

        .opportunity-results-header p {
            margin: 0;
            font-size: 14px;
            color: #6b7785;
        }


    /* ============================================================
       OPPORTUNITY CARD
       ============================================================ */

    .opportunity-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .opportunity-card {
        background: white;
        border: 1px solid #e0e6ed;
        border-radius: 11px;
        padding: 23px;
        display: flex;
        justify-content: space-between;
        gap: 25px;
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }

        .opportunity-card:hover {
            transform: translateY(-2px);
            border-color: #b8cae2;
            box-shadow: 0 7px 20px rgba(0, 0, 0, 0.07);
        }

    .opportunity-card-main {
        min-width: 0;
        flex: 1;
    }

    .opportunity-code {
        color: #0D5CC1;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.6px;
        margin-bottom: 6px;
    }

    .opportunity-card h3 {
        margin: 0 0 10px;
        font-size: 21px;
        color: #1f2d3d;
    }

    .opportunity-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 17px;
    }

        .opportunity-meta span {
            background: #f3f6fa;
            border: 1px solid #e1e7ee;
            color: #526170;
            border-radius: 5px;
            padding: 5px 9px;
            font-size: 12px;
        }

    .opportunity-requirements strong {
        display: block;
        margin-bottom: 5px;
        font-size: 13px;
        color: #37474f;
    }

    .opportunity-requirements p {
        margin: 0;
        font-size: 14px;
        line-height: 1.55;
        color: #657381;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .opportunity-card-side {
        width: 180px;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        justify-content: center;
        gap: 12px;
    }


    /* ============================================================
       DEADLINE BADGES
       ============================================================ */

    .deadline-badge {
        border-radius: 6px;
        padding: 8px 10px;
        text-align: center;
        font-size: 12px;
        font-weight: 700;
    }

    .deadline-normal {
        background: #eef5ff;
        color: #0D5CC1;
        border: 1px solid #c9ddf7;
    }

    .deadline-soon {
        background: #fff7e8;
        color: #a76400;
        border: 1px solid #f0d49e;
    }

    .deadline-today {
        background: #fff0f0;
        color: #b42318;
        border: 1px solid #efc0c0;
    }


    /* ============================================================
       BUTTONS
       ============================================================ */

    .btn-primary,
    .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 9px 16px;
        border-radius: 7px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        border: 1px solid transparent;
        cursor: pointer;
        box-sizing: border-box;
        transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
        white-space: nowrap;
    }

    .btn-primary {
        background: #0D5CC1;
        color: white;
        border-color: #0D5CC1;
    }

        .btn-primary:hover {
            background: #094b9f;
            border-color: #094b9f;
            color: white;
            text-decoration: none;
        }

    .btn-secondary {
        background: white;
        color: #394957;
        border-color: #cbd5df;
    }

        .btn-secondary:hover {
            background: #f5f7fa;
            color: #263238;
            text-decoration: none;
        }

    .opportunity-view-button {
        width: 100%;
    }


    /* ============================================================
       EMPTY STATE
       ============================================================ */

    .opportunity-empty-state {
        background: white;
        border: 1px solid #e0e6ed;
        border-radius: 11px;
        padding: 50px 25px;
        text-align: center;
    }

    .empty-state-title {
        font-size: 20px;
        font-weight: 700;
        color: #344454;
        margin-bottom: 8px;
    }

    .opportunity-empty-state p {
        max-width: 600px;
        margin: 0 auto 20px;
        color: #71808e;
        font-size: 14px;
        line-height: 1.6;
    }


    /* ============================================================
       RESPONSIVE
       ============================================================ */

    @@media (max-width: 950px) {

        .filter-grid {
            grid-template-columns: 1fr 1fr;
        }

        .filter-search {
            grid-column: 1 / -1;
        }

        .filter-actions {
            grid-column: 1 / -1;
        }

            .filter-actions .btn-primary,
            .filter-actions .btn-secondary {
                flex: 1;
            }
    }

    @@media (max-width: 700px) {

        .technician-opportunity-page {
            padding: 0 12px;
            margin-top: 18px;
        }

        .technician-opportunity-header {
            flex-direction: column;
            padding: 22px;
        }

            .technician-opportunity-header h1 {
                font-size: 24px;
            }

        .filter-grid {
            grid-template-columns: 1fr;
        }

        .filter-search,
        .filter-actions {
            grid-column: auto;
        }

        .opportunity-card {
            flex-direction: column;
        }

        .opportunity-card-side {
            width: 100%;
        }

        .opportunity-view-button {
            width: 100%;
        }
    }
</style>