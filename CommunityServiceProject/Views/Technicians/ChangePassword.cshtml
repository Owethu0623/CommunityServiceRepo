
@model CommunityServiceProject.ViewModels.TechnicianChangePasswordViewModel

@{
    ViewBag.Title = "Change Password";
}

<style>
    .change-password-page {
        max-width: 620px;
        margin: 50px auto;
        padding: 0 20px 50px;
    }

    .change-password-card {
        background: #ffffff;
        border: 1px solid #e1e7ef;
        border-radius: 14px;
        padding: 32px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.07);
    }

    .change-password-header {
        margin-bottom: 25px;
    }

        .change-password-header h1 {
            margin: 0 0 8px;
            color: #16324f;
            font-size: 25px;
            font-weight: 700;
        }

        .change-password-header p {
            margin: 0;
            color: #6b7280;
            font-size: 14px;
            line-height: 1.6;
        }

    .password-notice {
        background: #f0f6ff;
        border: 1px solid #c9ddf8;
        border-radius: 9px;
        padding: 15px 16px;
        margin-bottom: 24px;
        color: #24415f;
        font-size: 13px;
        line-height: 1.55;
    }

    .form-group {
        margin-bottom: 19px;
    }

    .form-label {
        display: block;
        margin-bottom: 7px;
        color: #374151;
        font-size: 13px;
        font-weight: 650;
    }

    .form-control {
        width: 100%;
        box-sizing: border-box;
        border: 1px solid #cfd7e3;
        border-radius: 8px;
        padding: 11px 12px;
        font-size: 14px;
        color: #1f2937;
        background: #ffffff;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

        .form-control:focus {
            outline: none;
            border-color: #0D5CC1;
            box-shadow: 0 0 0 3px rgba(13, 92, 193, 0.10);
        }

    .field-help {
        margin-top: 6px;
        color: #6b7280;
        font-size: 11px;
        line-height: 1.45;
    }

    .field-validation {
        display: block;
        margin-top: 5px;
        color: #b42318;
        font-size: 12px;
    }

    .validation-summary {
        background: #fff1f0;
        border: 1px solid #f0b8b4;
        color: #9b1c1c;
        border-radius: 9px;
        padding: 13px 15px;
        margin-bottom: 20px;
        font-size: 13px;
    }

        .validation-summary ul {
            margin: 7px 0 0 18px;
            padding: 0;
        }

    .password-requirements {
        background: #f8fafc;
        border: 1px solid #e1e7ef;
        border-radius: 9px;
        padding: 14px 16px;
        margin-top: 6px;
        margin-bottom: 22px;
    }

    .password-requirements-title {
        margin: 0 0 8px;
        color: #374151;
        font-size: 12px;
        font-weight: 700;
    }

    .password-requirements ul {
        margin: 0;
        padding-left: 18px;
        color: #64748b;
        font-size: 11px;
        line-height: 1.7;
    }

    .action-area {
        display: flex;
        justify-content: flex-end;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #e8edf3;
    }

    .primary-button {
        min-height: 42px;
        padding: 0 20px;
        border: 1px solid #0D5CC1;
        border-radius: 8px;
        background: #0D5CC1;
        color: #ffffff;
        font-size: 13px;
        font-weight: 650;
        cursor: pointer;
        transition: all 0.15s ease;
    }

        .primary-button:hover {
            background: #094b9f;
            border-color: #094b9f;
        }

        .primary-button:disabled {
            background: #aeb8c5;
            border-color: #aeb8c5;
            cursor: not-allowed;
        }

    .security-note {
        margin-top: 20px;
        padding-top: 18px;
        border-top: 1px solid #e8edf3;
        color: #6b7280;
        font-size: 11px;
        line-height: 1.55;
    }

    @@media (max-width: 600px) {

        .change-password-page {
            margin: 25px auto;
            padding: 0 12px 35px;
        }

        .change-password-card {
            padding: 22px;
        }

        .action-area {
            display: block;
        }

        .primary-button {
            width: 100%;
        }
    }
</style>

<div class="change-password-page">

    <div class="change-password-card">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="change-password-header">

            <h1>Change Your Password</h1>

            <p>
                For security, you must change the temporary password
                provided during technician onboarding before accessing
                the Technician Dashboard.
            </p>

        </div>

        <!-- =====================================================
             NOTICE
             ===================================================== -->

        <div class="password-notice">

            <strong>First-time login:</strong>

            Enter your current temporary password, then create a new
            password that you will use for future Technician Login.

        </div>

        <!-- =====================================================
             VALIDATION SUMMARY
             ===================================================== -->

        @Html.ValidationSummary(
            true,
            "",
            new { @class = "validation-summary" }
        )

        <!-- =====================================================
             CHANGE PASSWORD FORM
             ===================================================== -->

        @using (Html.BeginForm(
            "ChangePassword",
            "Technicians",
            FormMethod.Post
        ))
        {
            @Html.AntiForgeryToken()

            <!-- CURRENT PASSWORD -->

            <div class="form-group">

                <label class="form-label">
                    @Html.DisplayNameFor(
                        m => m.CurrentPassword
                    )
                </label>

                @Html.PasswordFor(
                    m => m.CurrentPassword,
                    new
                    {
                        @class = "form-control",
                        autocomplete = "current-password"
                    }
                )

                @Html.ValidationMessageFor(
                    m => m.CurrentPassword,
                    "",
                    new
                    {
                        @class = "field-validation"
                    }
                )

            </div>

            <!-- NEW PASSWORD -->

            <div class="form-group">

                <label class="form-label">
                    @Html.DisplayNameFor(
                        m => m.NewPassword
                    )
                </label>

                @Html.PasswordFor(
                    m => m.NewPassword,
                    new
                    {
                        @class = "form-control",
                        autocomplete = "new-password"
                    }
                )

                @Html.ValidationMessageFor(
                    m => m.NewPassword,
                    "",
                    new
                    {
                        @class = "field-validation"
                    }
                )

            </div>

            <!-- PASSWORD REQUIREMENTS -->

            <div class="password-requirements">

                <div class="password-requirements-title">
                    Password Requirements
                </div>

                <ul>
                    <li>At least 8 characters</li>
                    <li>At least one uppercase letter</li>
                    <li>At least one lowercase letter</li>
                    <li>At least one number</li>
                    <li>Must be different from your temporary password</li>
                </ul>

            </div>

            <!-- CONFIRM NEW PASSWORD -->

            <div class="form-group">

                <label class="form-label">
                    @Html.DisplayNameFor(
                        m => m.ConfirmNewPassword
                    )
                </label>

                @Html.PasswordFor(
                    m => m.ConfirmNewPassword,
                    new
                    {
                        @class = "form-control",
                        autocomplete = "new-password"
                    }
                )

                @Html.ValidationMessageFor(
                    m => m.ConfirmNewPassword,
                    "",
                    new
                    {
                        @class = "field-validation"
                    }
                )

            </div>

            <!-- ACTION -->

            <div class="action-area">

                <button type="submit"
                        class="primary-button"
                        id="changePasswordButton">

                    Change Password

                </button>

            </div>
        }

        <!-- =====================================================
             SECURITY NOTE
             ===================================================== -->

        <div class="security-note">

            Your new password will be used for future Technician Login.
            Keep your password confidential and do not share it with
            other users.

        </div>

    </div>

</div>

<script>

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            var form =
                document.querySelector(
                    "form"
                );

            var button =
                document.getElementById(
                    "changePasswordButton"
                );

            if (!form || !button) {
                return;
            }

            form.addEventListener(
                "submit",
                function () {

                    button.disabled = true;

                    button.textContent =
                        "Changing Password...";

                }
            );

        }
    );

</script>

