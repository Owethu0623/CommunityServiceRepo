@model IEnumerable<CommunityServiceProject.Models.MaintenanceWork>

@{
    ViewBag.Title = "Completed Work History";
}

<div class="completed-work-page">

    <div class="completed-work-card">

        <div class="completed-work-header">
            <div>
                <h2>Completed Work History</h2>
                <p>View maintenance work you have successfully completed.</p>
            </div>

            <a href="@Url.Action("Dashboard", "Technicians")"
               class="back-button">
                ← Back to Dashboard
            </a>
        </div>

        <div class="completed-work-content">

            <!-- FILTERS -->
            <div class="completed-work-filters">

                @using (Html.BeginForm("CompletedWork", "Technicians", FormMethod.Get))
                {
                    <div class="filter-group search-group">
                        <label for="search">Search</label>
                        <input type="text"
                               id="search"
                               name="search"
                               value="@ViewBag.Search"
                               placeholder="Search completed work..." />
                    </div>

                    <div class="filter-group">
                        <label for="categoryId">Category</label>

                        <select id="categoryId" name="categoryId">
                            <option value="">All Categories</option>

                            @foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.CategoryID"
                                        @(ViewBag.CategoryID != null && (int)ViewBag.CategoryID == category.CategoryID ? "selected" : "")>
                                    @category.CategoryName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="filter-group">
                        <label for="wardId">Ward</label>

                        <select id="wardId" name="wardId">
                            <option value="">All Wards</option>

                            @foreach (var ward in ViewBag.Wards)
                            {
                                <option value="@ward.WardID"
                                        @(ViewBag.WardID != null && (int)ViewBag.WardID == ward.WardID ? "selected" : "")>
                                    Ward @ward.WardNumber
                                </option>
                            }
                        </select>
                    </div>

                    <div class="filter-buttons">
                        <button type="submit" class="apply-button">
                            Apply Filters
                        </button>

                        <a href="@Url.Action("CompletedWork", "Technicians")"
                           class="clear-button">
                            Clear
                        </a>
                    </div>
                }

            </div>

            <!-- COMPLETED WORK TABLE -->
            <div class="completed-work-section">

                <div class="section-header">
                    <div>
                        <h3>My Completed Work</h3>
                        <p>Verified maintenance work completed by you.</p>
                    </div>

                    <span class="work-count">
                        @Model.Count() completed
                    </span>
                </div>

                @if (Model.Any())
                {
                    <div class="table-wrapper">

                        <table class="completed-work-table">

                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th>Category</th>
                                    <th>Ward</th>
                                    <th>Completed</th>
                                    <th>Resolution</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var work in Model)
                                {
                                    var completion = work.Completions
                                        .Where(c =>
                                            c.VerificationStatus ==
                                            CommunityServiceProject.Models.CompletionVerificationStatus.Verified)
                                        .OrderByDescending(c => c.SubmittedDate)
                                        .FirstOrDefault();

                                    <tr>

                                        <td class="reference-cell">
                                            #REQ-@work.RequestID
                                        </td>

                                        <td>
                                            @work.Request.Category.CategoryName
                                        </td>

                                        <td>
                                            Ward @work.Request.Ward.WardNumber
                                        </td>

                                        <td>
                                            @(work.CompletedDate.HasValue
                                                ? work.CompletedDate.Value.ToString("dd/MM/yyyy")
                                                : "—")
                                        </td>

                                        <td class="resolution-cell">
                                            @if (completion != null)
                                            {
                                                @completion.ResolutionAction
                                            }
                                            else
                                            {
                                                <span class="no-resolution">
                                                    Resolution unavailable
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            <a href="@Url.Action("Details", "Technicians", new { id = work.RequestID })"
                                               class="view-button">
                                                View Details
                                            </a>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="empty-state">

                        <div class="empty-icon">
                            ✓
                        </div>

                        <h3>No Completed Work Found</h3>

                        <p>
                            You do not have any verified completed maintenance
                            work matching the selected filters.
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>

</div>

<style>

    .completed-work-page {
        background: #f4f7fb;
        min-height: 100vh;
        padding: 35px 20px;
    }

    .completed-work-card {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    }

    .completed-work-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 30px 35px;
        background: #ffffff;
        border-bottom: 1px solid #e5e7eb;
    }

        .completed-work-header h2 {
            margin: 0 0 6px 0;
            font-size: 28px;
            font-weight: 700;
            color: #0D5CC1;
        }

        .completed-work-header p {
            margin: 0;
            color: #6b7280;
            font-size: 14px;
        }

    .back-button {
        display: inline-block;
        padding: 10px 16px;
        border-radius: 8px;
        background: #f3f4f6;
        color: #374151;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
    }

        .back-button:hover {
            background: #e5e7eb;
            text-decoration: none;
            color: #111827;
        }

    .completed-work-content {
        padding: 35px;
    }

    .completed-work-filters {
        padding: 22px;
        margin-bottom: 30px;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
    }

        .completed-work-filters form {
            display: flex;
            align-items: flex-end;
            gap: 18px;
            flex-wrap: wrap;
        }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
        min-width: 190px;
    }

    .search-group {
        flex: 1;
        min-width: 260px;
    }

    .filter-group label {
        font-size: 13px;
        font-weight: 600;
        color: #374151;
    }

    .filter-group input,
    .filter-group select {
        height: 42px;
        padding: 0 12px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        background: #ffffff;
        color: #374151;
        outline: none;
    }

        .filter-group input:focus,
        .filter-group select:focus {
            border-color: #6b7280;
        }

    .filter-buttons {
        display: flex;
        gap: 10px;
    }

    .apply-button,
    .clear-button {
        height: 42px;
        padding: 0 18px;
        border-radius: 8px;
        border: none;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .apply-button {
        background: #2563eb;
        color: white;
    }

        .apply-button:hover {
            background: #1d4ed8;
        }

    .clear-button {
        background: #e5e7eb;
        color: #374151;
    }

        .clear-button:hover {
            background: #d1d5db;
            text-decoration: none;
            color: #111827;
        }

    .completed-work-section {
        width: 100%;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

        .section-header h3 {
            margin: 0 0 5px 0;
            font-size: 21px;
            color: #1f2937;
        }

        .section-header p {
            margin: 0;
            color: #6b7280;
            font-size: 14px;
        }

    .work-count {
        padding: 7px 12px;
        background: #eef2ff;
        color: #3730a3;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
    }

    .completed-work-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 900px;
    }

        .completed-work-table th {
            padding: 15px 16px;
            background: #f8fafc;
            border-bottom: 1px solid #e5e7eb;
            text-align: left;
            font-size: 13px;
            font-weight: 700;
            color: #374151;
            white-space: nowrap;
        }

        .completed-work-table td {
            padding: 16px;
            border-bottom: 1px solid #f0f0f0;
            font-size: 14px;
            color: #4b5563;
            vertical-align: middle;
        }

        .completed-work-table tbody tr:last-child td {
            border-bottom: none;
        }

        .completed-work-table tbody tr:hover {
            background: #fafafa;
        }

    .reference-cell {
        font-weight: 700;
        color: #1f2937 !important;
        white-space: nowrap;
    }

    .resolution-cell {
        max-width: 350px;
        line-height: 1.5;
    }

    .no-resolution {
        color: #9ca3af;
        font-style: italic;
    }

    .view-button {
        display: inline-block;
        padding: 8px 13px;
        border-radius: 7px;
        background: #eff6ff;
        color: #1d4ed8;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

        .view-button:hover {
            background: #dbeafe;
            color: #1e40af;
            text-decoration: none;
        }

    .empty-state {
        text-align: center;
        padding: 70px 20px;
        border: 1px dashed #d1d5db;
        border-radius: 12px;
        background: #fafafa;
    }

    .empty-icon {
        width: 52px;
        height: 52px;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e5e7eb;
        color: #6b7280;
        font-size: 24px;
        font-weight: 700;
    }

    .empty-state h3 {
        margin: 0 0 8px;
        color: #374151;
    }

    .empty-state p {
        margin: 0;
        color: #6b7280;
        font-size: 14px;
    }

    @@media (max-width: 900px) {

        .completed-work-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .completed-work-content {
            padding: 20px;
        }

        .completed-work-filters form {
            align-items: stretch;
            flex-direction: column;
        }

        .filter-group,
        .search-group {
            width: 100%;
            min-width: 0;
        }

        .filter-buttons {
            width: 100%;
        }

        .apply-button,
        .clear-button {
            flex: 1;
        }
    }

    @@media (max-width: 600px) {

        .completed-work-page {
            padding: 15px 10px;
        }

        .completed-work-header {
            padding: 22px 20px;
        }

            .completed-work-header h2 {
                font-size: 23px;
            }

        .section-header {
            align-items: flex-start;
            gap: 12px;
            flex-direction: column;
        }
    }
</style>