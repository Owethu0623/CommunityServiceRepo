@model CommunityServiceProject.Models.Request

    @{
        ViewBag.Title = "Request Details";
    }

    @{
        var technicianID = (int)Session["TechnicianID"];

        var maintenanceWork = Model.MaintenanceWorks
            .OrderByDescending(m => m.StartedDate)
            .FirstOrDefault(m =>
                m.TechnicianID == technicianID &&
                (m.Status == CommunityServiceProject.Models.MaintenanceWorkStatus.InProgress ||
                 m.Status == CommunityServiceProject.Models.MaintenanceWorkStatus.SubmittedForVerification ||
                 m.Status == CommunityServiceProject.Models.MaintenanceWorkStatus.Verified ||
                 m.Status == CommunityServiceProject.Models.MaintenanceWorkStatus.Rejected));

        var assignment = Model.TechnicianAssignments
            .OrderByDescending(a => a.AssignedDate)
            .FirstOrDefault(a =>
                a.TechnicianID == technicianID);

        // ===========================================================
        // ASSIGNMENT STATES
        // ===========================================================

        var assignmentPending =
            assignment != null &&
            assignment.Status ==
            CommunityServiceProject.Models.AssignmentStatus.PendingAcknowledgement;

        var assignmentAcknowledged =
            assignment != null &&
            assignment.Status ==
            CommunityServiceProject.Models.AssignmentStatus.Acknowledged;

        var issueReported =
    assignment != null &&
    assignment.Status == CommunityServiceProject.Models.AssignmentStatus.IssueReported;

        var reassignmentRequested =
        assignment != null &&
        assignment.Status ==
        CommunityServiceProject.Models.AssignmentStatus.ReassignmentRequested;

        // ===========================================================
        // MAINTENANCE STATES
        // ===========================================================

        var hasMaintenanceWork =
            maintenanceWork != null;

        var maintenanceInProgress =
            maintenanceWork != null &&
            maintenanceWork.Status ==
            CommunityServiceProject.Models.MaintenanceWorkStatus.InProgress;

        var completionSubmitted =
            maintenanceWork != null &&
            maintenanceWork.Status ==
            CommunityServiceProject.Models.MaintenanceWorkStatus.SubmittedForVerification;

        var maintenanceVerified =
            maintenanceWork != null &&
            maintenanceWork.Status ==
            CommunityServiceProject.Models.MaintenanceWorkStatus.Verified;

        var maintenanceRejected =
            maintenanceWork != null &&
            maintenanceWork.Status ==
            CommunityServiceProject.Models.MaintenanceWorkStatus.Rejected;

        var hasBeforeEvidence =
    maintenanceWork != null &&
    maintenanceWork.Evidence != null &&
    maintenanceWork.Evidence.Any(e =>
        e.EvidenceType == CommunityServiceProject.Models.EvidenceType.BeforeMaintenance);

        var hasProgressEvidence =
            maintenanceWork != null &&
            maintenanceWork.Evidence != null &&
            maintenanceWork.Evidence.Any(e =>
                e.EvidenceType == CommunityServiceProject.Models.EvidenceType.Progress);

        var hasCompletionEvidence =
            maintenanceWork != null &&
            maintenanceWork.Evidence != null &&
            maintenanceWork.Evidence.Any(e =>
                e.EvidenceType == CommunityServiceProject.Models.EvidenceType.Completion);

        var progressStarted =
            maintenanceWork != null &&
            maintenanceWork.ProgressPercentage > 0;

        var maintenanceComplete =
            maintenanceWork != null &&
            maintenanceWork.ProgressPercentage >= 100;
    }
<div>
    <div class="admin-review-page">

        <div class="admin-review-card">

            <!-- HEADER -->
            <div class="admin-review-header">

                <h2>Request Details</h2>

                <p>
                    Reference Number @Model.ReferenceNumber
                </p>

            </div>


            <div class="admin-review-content">

                <!-- REQUEST INFORMATION -->
                <div class="admin-review-section">

                    <h3>Request Information</h3>

                    <div class="admin-review-row">

                        <span class="admin-review-label">
                            Request Title
                        </span>

                        <span>
                            @Model.Title
                        </span>

                    </div>


                    <div class="admin-review-row">

                        <span class="admin-review-label">
                            Description
                        </span>

                        <span>
                            @Model.Description
                        </span>

                    </div>


                    <div class="admin-review-row">

                        <span class="admin-review-label">
                            Category
                        </span>

                        <span>
                            @(Model.Category != null
                            ? Model.Category.CategoryName
                            : "Unknown")
                        </span>

                    </div>


                    <div class="admin-review-row">

                        <span class="admin-review-label">
                            Status
                        </span>

                        <span>
                            @Model.Status
                        </span>

                    </div>


                    <div class="admin-review-row">

                        <span class="admin-review-label">
                            Priority
                        </span>

                        <span>
                            @Model.Priority
                        </span>

                    </div>


                    @if (!string.IsNullOrWhiteSpace(Model.PriorityReason))
                    {
                        <div class="admin-review-row">

                            <span class="admin-review-label">
                                Priority Reason
                            </span>

                            <span>
                                @Model.PriorityReason
                            </span>

                        </div>
                    }

                </div>
            </div>

            <!-- LOCATION -->
            <div class="admin-review-section">

                <h3>Location</h3>

                <div class="admin-review-row">

                    <span class="admin-review-label">
                        Problem Location
                    </span>

                    <span>
                        @(!string.IsNullOrWhiteSpace(Model.ProblemLocation)
                ? Model.ProblemLocation
                : "No problem location description provided.")
                    </span>

                </div>


                <div class="admin-review-row">

                    <span class="admin-review-label">
                        Latitude
                    </span>

                    <span>
                        @Model.Latitude
                    </span>

                </div>


                <div class="admin-review-row">

                    <span class="admin-review-label">
                        Longitude
                    </span>

                    <span>
                        @Model.Longitude
                    </span>

                </div>


                @if (Model.Latitude != null &&
                     Model.Longitude != null)
                {
                    <div style="
            width: 100%;
            margin-top: 20px;
        ">

                        <div id="map"
                             data-latitude="@(Model.Latitude.Value.ToString(
                     System.Globalization.CultureInfo.InvariantCulture))"
                             data-longitude="@(Model.Longitude.Value.ToString(
                     System.Globalization.CultureInfo.InvariantCulture))"
                             style="
                     width: 100%;
                     height: 450px;
                     border-radius: 10px;
                     overflow: hidden;
                 ">
                        </div>

                    </div>


                    <div class="admin-review-actions">

                        <a href="@Url.Action(
                        "Directions",
                        "Technicians",
                        new
                        {
                            id = Model.RequestID
                        })"
                           class="admin-approve-button"
                           target="_blank">

                            Get Directions

                        </a>

                    </div>
                }
                else
                {
                    <div class="admin-review-row">

                        <span>
                            GPS location was not available.
                        </span>

                    </div>
                }

            </div>


            <!-- CITIZEN INFORMATION -->
            <div class="admin-review-section">

                <h3>Citizen Information</h3>

                @if (Model.Citizen != null)
                {
                    <div class="admin-review-row">

                        <span class="admin-review-label">
                            First Name
                        </span>

                        <span>
                            @Model.Citizen.FirstName
                        </span>

                    </div>


                    <div class="admin-review-row">

                        <span class="admin-review-label">
                            Last Name
                        </span>

                        <span>
                            @Model.Citizen.LastName
                        </span>

                    </div>


                    <div class="admin-review-row">

                        <span class="admin-review-label">
                            Email Address
                        </span>

                        <span>
                            @Model.Citizen.EmailAddress
                        </span>

                    </div>


                    <div class="admin-review-row">

                        <span class="admin-review-label">
                            Phone Number
                        </span>

                        <span>
                            @Model.Citizen.PhoneNumber
                        </span>

                    </div>
                }
                else
                {
                    <div class="admin-review-row">

                        <span>
                            Citizen information unavailable.
                        </span>

                    </div>
                }

            </div>


            <!-- SUPPORTING PHOTOGRAPH -->
            <div class="admin-review-section">

                <h3>Supporting Photograph</h3>

                @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
                {
                    <div style="
                        margin-top: 15px;
                        width: 100%;
                        display: flex;
                        justify-content: center;
                    ">

                        <img src="@Url.Content(Model.ImagePath)"
                             alt="Supporting Photograph"
                             style="
                                 max-width: 100%;
                                 max-height: 400px;
                                 border-radius: 8px;
                             " />

                    </div>
                }
                else
                {
                    <div class="admin-review-row">

                        <span>
                            No supporting photograph was provided.
                        </span>

                    </div>
                }

            </div>


            <!-- ASSIGNMENT -->
            <div class="admin-review-section">

                <h3>Assignment</h3>

                <div class="admin-review-row">

                    <span class="admin-review-label">
                        Assigned Technician
                    </span>

                    <span>
                        @Session["TechnicianName"]
                    </span>

                </div>


                <div class="admin-review-row">

                    <span class="admin-review-label">
                        Assignment Status
                    </span>

                    <span>
                        @(assignment != null
                            ? assignment.Status.ToString()
                            : "No assignment found.")
                    </span>

                </div>


                @if (assignment != null)
                {
                    <div class="admin-review-row">

                        <span class="admin-review-label">
                            Assigned Date
                        </span>

                        <span>
                            @assignment.AssignedDate.ToString(
                                "dd MMM yyyy HH:mm")
                        </span>

                    </div>


                    <div class="admin-review-row">

                        <span class="admin-review-label">
                            Acknowledged Date
                        </span>

                        <span>
                            @(assignment.AcknowledgedDate.HasValue
            ? assignment.AcknowledgedDate.Value.ToString("dd MMM yyyy HH:mm")
            : "Not acknowledged yet")
                        </span>

                    </div>
                }

                <!-- REQUIRED SKILLS -->
                <div class="admin-review-section">

                    <h3>Required Skills</h3>

                    @if (Model.RequiredSkills != null &&
                         Model.RequiredSkills.Any())
                    {
                        foreach (var requiredSkill in Model.RequiredSkills)
                        {
                            <div class="admin-review-row">

                                <span class="admin-review-label">
                                    Skill
                                </span>

                                <span>
                                    @(requiredSkill.Skill != null
                        ? requiredSkill.Skill.SkillName
                        : "Skill unavailable")
                                </span>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="admin-review-row">
                            <span>
                                No specific skills have been identified for this request.
                            </span>
                        </div>
                    }

                </div>

                <!-- PENDING ASSIGNMENT ACTIONS -->
                <div class="admin-review-actions"
                     style="@(assignmentPending ? "" : "display:none;")">

                    @using (Html.BeginForm(
                        "Acknowledge",
                        "Technicians",
                        new
                        {
                            id = assignment != null
                                ? assignment.AssignmentID
                                : 0
                        },
                        FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="admin-approve-button">

                            Acknowledge Assignment

                        </button>
                    }


                    <a href="@Url.Action(
                                "ReportIssue",
                                "Technicians",
                                new
                                {
                                    id = assignment != null
                                        ? assignment.AssignmentID
                                        : 0
                                })"
                       class="admin-back-button">

                        Report Assignment Issue

                    </a>

                </div>


                @if (assignmentAcknowledged && !hasMaintenanceWork)
                {
                    using (Html.BeginForm(
                        "StartMaintenance",
                        "Technicians",
                        FormMethod.Post,
                        new { style = "display:inline;" }))
                    {
                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@assignment.AssignmentID" />

                        <button type="submit" class="btn btn-primary">
                            Start Maintenance
                        </button>
                    }
                }

                @if (issueReported)
                {
                    <div class="admin-review-actions">
                        <span>
                            An assignment issue has been reported. You can now request reassignment if you are unable to complete this request.
                        </span>

                        <a href="@Url.Action(
            "RequestReassignment",
            "Technicians",
            new { id = assignment.AssignmentID })"
                           class="admin-approve-button">
                            Request Reassignment
                        </a>
                    </div>
                }

                <!-- MAINTENANCE HAS STARTED -->
                <div class="admin-review-actions"
                     style="@(assignmentAcknowledged && hasMaintenanceWork
                ? ""
                : "display:none;")">

                    <span>
                        Assignment acknowledged and maintenance is currently in progress.
                    </span>

                </div>


                <!-- REASSIGNMENT REQUESTED -->
                <div class="admin-review-actions"
                     style="@(reassignmentRequested
                                ? ""
                                : "display:none;")">

                    <span>
                        Reassignment request submitted and awaiting administrator review.
                    </span>

                </div>

            </div>
        </div>

        <!-- MAINTENANCE -->
        @if (maintenanceWork != null)
        {
            <div class="admin-review-section">

                <h3>Maintenance</h3>


                <div class="admin-review-row">

                    <span class="admin-review-label">
                        Maintenance Status
                    </span>

                    <span>
                        @maintenanceWork.Status
                    </span>

                </div>


                <div class="admin-review-row">

                    <span class="admin-review-label">
                        Progress
                    </span>

                    <span>
                        @maintenanceWork.ProgressPercentage%
                    </span>

                </div>


                <div class="admin-review-row">

                    <span class="admin-review-label">
                        Current Activity
                    </span>

                    <span>
                        @(string.IsNullOrWhiteSpace(
                                maintenanceWork.CurrentActivity)
                                ? "No activity recorded."
                                : maintenanceWork.CurrentActivity)
                    </span>

                </div>


                <div class="admin-review-row">

                    <span class="admin-review-label">
                        Started Date
                    </span>

                    <span>
                        @(maintenanceWork.StartedDate.HasValue
                                ? maintenanceWork.StartedDate.Value.ToString(
                                    "dd MMM yyyy HH:mm")
                                : "Not available")
                    </span>

                </div>


                @if (maintenanceInProgress)
                {
                    <div style="margin-top: 20px;">

                        <!-- ===================================================
                    STAGE 1 - MAINTENANCE STARTED
                    =================================================== -->

                        @if (!progressStarted)
                        {
                            <div class="admin-review-actions">

                                @if (!hasBeforeEvidence)
                                {
                                    <a href="@Url.Action(
                        "UploadEvidence",
                        "Technicians",
                        new
                        {
                            id = maintenanceWork.MaintenanceWorkID
                        })"
                                       class="btn btn-primary">

                                        Upload Before-Maintenance Evidence

                                    </a>
                                }
                                else
                                {
                                    <a href="@Url.Action(
                        "UpdateProgress",
                        "Technicians",
                        new
                        {
                            id = maintenanceWork.MaintenanceWorkID
                        })"
                                       class="admin-approve-button">

                                        Update Maintenance Progress

                                    </a>
                                }

                            </div>

                            <div style="margin-top: 15px;">

                                @if (!hasBeforeEvidence)
                                {
                                    <p class="text-muted">
                                        Maintenance has started. Upload before-maintenance evidence
                                        before recording maintenance progress.
                                    </p>
                                }
                                else
                                {
                                    <p class="text-muted">
                                        Before-maintenance evidence has been uploaded.
                                        You can now record the maintenance progress.
                                    </p>
                                }

                            </div>
                        }


                        <!-- ===================================================
                    STAGE 2 - PROGRESS HAS BEEN RECORDED
                    =================================================== -->

                        @if (progressStarted && !maintenanceComplete)
                        {
                            <div class="admin-review-actions">

                                @if (hasProgressEvidence)
                                {
                                    <a href="@Url.Action(
                        "UpdateProgress",
                        "Technicians",
                        new
                        {
                            id = maintenanceWork.MaintenanceWorkID
                        })"
                                       class="admin-approve-button">

                                        Update Maintenance Progress

                                    </a>
                                }

                                <a href="@Url.Action(
                    "AddWorkNote",
                    "Technicians",
                    new
                    {
                        id = maintenanceWork.MaintenanceWorkID
                    })"
                                   class="btn btn-primary">

                                    Add Work Note

                                </a>


                                <a href="@Url.Action(
                    "AddMaterial",
                    "Technicians",
                    new
                    {
                        id = maintenanceWork.MaintenanceWorkID
                    })"
                                   class="btn btn-primary">

                                    Record Materials Used

                                </a>


                                @if (!hasProgressEvidence)
                                {
                                    <a href="@Url.Action(
                        "UploadProgressEvidence",
                        "Technicians",
                        new
                        {
                            id = maintenanceWork.MaintenanceWorkID
                        })"
                                       class="btn btn-primary">

                                        Upload Progress Evidence

                                    </a>
                                }

                            </div>


                            <div style="margin-top: 15px;">

                                @if (!hasProgressEvidence)
                                {
                                    <p class="text-muted">
                                        Upload progress evidence before recording another
                                        maintenance progress update.
                                    </p>
                                }
                                else
                                {
                                    <p class="text-muted">
                                        Progress evidence has been uploaded.
                                        You can continue updating the maintenance progress.
                                    </p>
                                }

                            </div>
                        }


                        <!-- ===================================================
                    STAGE 3 - READY FOR COMPLETION
                    =================================================== -->

                        @if (maintenanceComplete)
                        {
                            <div class="admin-review-actions"
                                 style="margin-top: 15px;">

                                @if (!hasCompletionEvidence)
                                {
                                    <a href="@Url.Action(
                        "UploadCompletionEvidence",
                        "Technicians",
                        new
                        {
                            id = maintenanceWork.MaintenanceWorkID
                        })"
                                       class="btn btn-primary">

                                        Upload Completion Evidence

                                    </a>
                                }
                                else
                                {
                                    <a href="@Url.Action(
                        "SubmitCompletion",
                        "Technicians",
                        new
                        {
                            id = maintenanceWork.MaintenanceWorkID
                        })"
                                       class="btn btn-primary">

                                        Submit for Completion Verification

                                    </a>
                                }

                            </div>


                            <div style="margin-top: 15px;">

                                @if (!hasCompletionEvidence)
                                {
                                    <p class="text-muted">
                                        Maintenance progress has reached 100%.
                                        Upload completion evidence before submitting the
                                        maintenance for administrator verification.
                                    </p>
                                }
                                else
                                {
                                    <p class="text-muted">
                                        Completion evidence has been uploaded.
                                        You can now submit the maintenance for administrator verification.
                                    </p>
                                }

                            </div>
                        }

                    </div>
                }

                <!-- SUBMITTED FOR VERIFICATION -->
                <div class="admin-review-actions"
                     style="@(completionSubmitted ? "" : "display:none;")">

                    <span>
                        Maintenance completion has been submitted and is awaiting administrator verification.
                    </span>

                </div>


                <!-- VERIFIED -->
                <div class="admin-review-actions"
                     style="@(maintenanceVerified ? "" : "display:none;")">

                    <span>
                        Maintenance has been verified by the administrator.
                    </span>

                </div>


                <!-- REJECTED -->
                <div class="admin-review-actions"
                     style="@(maintenanceRejected ? "" : "display:none;")">

                    <span>
                        Maintenance completion was rejected by the administrator.
                    </span>

                </div>


                <!-- WORK NOTES -->
                <div style="margin-top: 25px;">

                    <h4>Work Notes</h4>

                    @if (maintenanceWork.WorkNotes != null &&
                         maintenanceWork.WorkNotes.Any())
                    {
                        foreach (var note in maintenanceWork.WorkNotes
                            .OrderByDescending(n => n.CreatedDate))
                        {
                            <div class="card mb-2">

                                <div class="card-body">

                                    <p class="mb-1">
                                        @note.NoteText
                                    </p>

                                    <small class="text-muted">
                                        Added:
                                        @note.CreatedDate.ToString(
                                            "dd MMM yyyy HH:mm")
                                    </small>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">
                            No work notes have been added yet.
                        </p>
                    }

                </div>


                <!-- MATERIALS AND RESOURCES -->
                <div style="margin-top: 25px;">

                    <h4>Materials & Resources</h4>

                    @if (maintenanceWork.Materials != null &&
                         maintenanceWork.Materials.Any())
                    {
                        foreach (var material in maintenanceWork.Materials
                            .OrderByDescending(m => m.RecordedDate))
                        {
                            <div class="card mb-2">

                                <div class="card-body">

                                    <p class="mb-1">

                                        <strong>
                                            @material.MaterialName
                                        </strong>

                                    </p>


                                    <p class="mb-1">

                                        Quantity:
                                        @material.Quantity
                                        @material.Unit

                                    </p>


                                    <small class="text-muted">

                                        Recorded:
                                        @material.RecordedDate.ToString(
                                            "dd MMM yyyy HH:mm")

                                    </small>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">
                            No materials or resources have been recorded yet.
                        </p>
                    }

                </div>


                <!-- BEFORE-MAINTENANCE EVIDENCE -->
                <div style="margin-top: 25px;">

                    <h4>Before-Maintenance Evidence</h4>

                    @if (maintenanceWork.Evidence != null)
                    {
                        var beforeEvidence = maintenanceWork.Evidence
                            .Where(e =>
                                e.EvidenceType ==
                                CommunityServiceProject.Models.EvidenceType.BeforeMaintenance)
                            .OrderByDescending(e => e.UploadedDate)
                            .ToList();

                        if (beforeEvidence.Any())
                        {
                            foreach (var evidence in beforeEvidence)
                            {
                                <div class="card mb-3">

                                    <div class="card-body">

                                        <p class="mb-2">
                                            <strong>
                                                Evidence
                                            </strong>
                                        </p>


                                        <div style="text-align: center;">

                                            <img src="@Url.Content(
                                                            evidence.FilePath)"
                                                 alt="Before-maintenance evidence"
                                                 style="
                                                         max-width: 500px;
                                                         max-height: 300px;
                                                         object-fit: contain;
                                                         border-radius: 8px;
                                                         display: inline-block;
                                                     " />

                                        </div>


                                        @if (!string.IsNullOrWhiteSpace(
                                            evidence.Description))
                                        {
                                            <p class="mt-3 mb-1">

                                                <strong>
                                                    Description:
                                                </strong>

                                                @evidence.Description

                                            </p>
                                        }


                                        <small class="text-muted">

                                            Uploaded:
                                            @evidence.UploadedDate.ToString(
                                                "dd MMM yyyy HH:mm")

                                        </small>

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">
                                No before-maintenance evidence has been uploaded yet.
                            </p>
                        }
                    }
                    else
                    {
                        <p class="text-muted">
                            No before-maintenance evidence has been uploaded yet.
                        </p>
                    }

                </div>


                <!-- PROGRESS EVIDENCE -->
                <div style="margin-top: 25px;">

                    <h4>Progress Evidence</h4>

                    @if (maintenanceWork.Evidence != null)
                    {
                        var progressEvidence = maintenanceWork.Evidence
                            .Where(e =>
                                e.EvidenceType ==
                                CommunityServiceProject.Models.EvidenceType.Progress)
                            .OrderByDescending(e => e.UploadedDate)
                            .ToList();

                        if (progressEvidence.Any())
                        {
                            foreach (var evidence in progressEvidence)
                            {
                                <div class="card mb-3">

                                    <div class="card-body">

                                        <p class="mb-2">
                                            <strong>
                                                Progress Evidence
                                            </strong>
                                        </p>


                                        <div style="text-align: center;">

                                            <img src="@Url.Content(
                                                            evidence.FilePath)"
                                                 alt="Progress evidence"
                                                 style="
                                                         max-width: 500px;
                                                         max-height: 300px;
                                                         object-fit: contain;
                                                         border-radius: 8px;
                                                         display: inline-block;
                                                     " />

                                        </div>


                                        @if (!string.IsNullOrWhiteSpace(
                                            evidence.Description))
                                        {
                                            <p class="mt-3 mb-1">

                                                <strong>
                                                    Description:
                                                </strong>

                                                @evidence.Description

                                            </p>
                                        }


                                        <small class="text-muted">

                                            Uploaded:
                                            @evidence.UploadedDate.ToString(
                                                "dd MMM yyyy HH:mm")

                                        </small>

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">
                                No progress evidence has been uploaded yet.
                            </p>
                        }
                    }
                    else
                    {
                        <p class="text-muted">
                            No progress evidence has been uploaded yet.
                        </p>
                    }

                </div>


                <!-- COMPLETION EVIDENCE -->
                <div style="margin-top: 25px;">

                    <h4>Completion Evidence</h4>

                    @if (maintenanceWork.Evidence != null)
                    {
                        var completionEvidence = maintenanceWork.Evidence
                            .Where(e =>
                                e.EvidenceType ==
                                CommunityServiceProject.Models.EvidenceType.Completion)
                            .OrderByDescending(e => e.UploadedDate)
                            .ToList();

                        if (completionEvidence.Any())
                        {
                            foreach (var evidence in completionEvidence)
                            {
                                <div class="card mb-3">

                                    <div class="card-body">

