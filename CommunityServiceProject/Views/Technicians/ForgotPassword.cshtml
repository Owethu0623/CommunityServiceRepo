@{
    ViewBag.Title = "Forgot Password";
}

<div class="technician-login-container">

    <div class="technician-login-card">

        <div class="technician-login-header">

            <h2>
                Forgot Password
            </h2>

            <p>
                Verify your technician account to reset your password.
            </p>

        </div>


        @using (Html.BeginForm(
            "ForgotPassword",
            "Technicians",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="technician-login-content">

                @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
                {
                    <div class="technician-login-error">
                        @ViewBag.ErrorMessage
                    </div>
                }


                <div class="technician-login-form-group">

                    <label for="emailAddress">
                        Email Address
                    </label>

                    <input type="email"
                           id="emailAddress"
                           name="emailAddress"
                           class="technician-login-input"
                           required />

                </div>


                <div class="technician-login-form-group">

                    <label for="phoneNumber">
                        Phone Number
                    </label>

                    <input type="tel"
                           id="phoneNumber"
                           name="phoneNumber"
                           class="technician-login-input"
                           required />

                </div>


                <div class="technician-login-form-group">

                    <label for="lastName">
                        Last Name
                    </label>

                    <input type="text"
                           id="lastName"
                           name="lastName"
                           class="technician-login-input"
                           required />

                </div>


                <div class="technician-login-actions">

                    <button type="submit"
                            class="technician-login-button">

                        Verify Account

                    </button>

                </div>


                <div class="technician-login-forgot">

                    <a href="@Url.Action("Login", "Technicians")">
                        Back to Login
                    </a>

                </div>

            </div>
        }

    </div>

</div>
