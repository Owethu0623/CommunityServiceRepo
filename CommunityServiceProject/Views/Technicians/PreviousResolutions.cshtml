@model IEnumerable<CommunityServiceProject.Models.MaintenanceCompletion>

@{
    ViewBag.Title = "Previous Resolutions";
}

<div class="previous-resolutions-page">

    <div class="previous-resolutions-card">

        <!-- PAGE HEADER -->
        <div class="previous-resolutions-header">
            <div>
                <h2>Previous Resolutions</h2>
                <p>View verified maintenance resolutions completed by technicians.</p>
            </div>

            <a href="@Url.Action("Dashboard", "Technicians")"
               class="back-button">
                ← Back to Dashboard
            </a>
        </div>

        <div class="previous-resolutions-content">

            <!-- FILTERS -->
            <div class="resolution-filters">

                @using (Html.BeginForm(
                    "PreviousResolutions",
                    "Technicians",
                    FormMethod.Get))
                {
                    <div class="filter-group search-group">
                        <label for="search">
                            Search previous resolutions
                        </label>

                        <input type="text"
                               id="search"
                               name="search"
                               value="@ViewBag.Search"
                               placeholder="Search problem, resolution..." />
                    </div>

                    <div class="filter-group">
                        <label for="categoryId">
                            Category
                        </label>

                        <select id="categoryId" name="categoryId">

                            <option value="">
                                All Categories
                            </option>

                            @foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.CategoryID"
                                        @(ViewBag.CategoryID != null && (int)ViewBag.CategoryID == category.CategoryID ? "selected" : "")>
                                    @category.CategoryName
                                </option>
                            }

                        </select>
                    </div>

                    <div class="filter-group">
                        <label for="wardId">
                            Ward
                        </label>

                        <select id="wardId" name="wardId">

                            <option value="">
                                All Wards
                            </option>

                            @foreach (var ward in ViewBag.Wards)
                            {
                                <option value="@ward.WardID"
                                        @(ViewBag.WardID != null && (int)ViewBag.WardID == ward.WardID ? "selected" : "")>
                                    Ward @ward.WardNumber
                                </option>
                            }

                        </select>
                    </div>

                    <div class="filter-buttons">

                        <button type="submit"
                                class="search-button">
                            SEARCH
                        </button>

                        <a href="@Url.Action(
                            "PreviousResolutions",
                            "Technicians")"
                           class="clear-button">
                            CLEAR
                        </a>

                    </div>
                }

            </div>


            <!-- RESOLUTION RECORDS -->
            <div class="resolution-section">

                <div class="section-header">

                    <div>
                        <h3>Previous Resolution Records</h3>

                        <p>
                            Verified maintenance cases from across the system.
                        </p>
                    </div>

                    <span class="resolution-count">
                        @Model.Count() records
                    </span>

                </div>


                @if (Model.Any())
                {
                    foreach (var completion in Model)
                    {
                        var work = completion.MaintenanceWork;
                        var request = work.Request;

                        <div class="resolution-record">

                            <div class="record-header">

                                <div>
                                    <h4>
                                        @request.Category.CategoryName
                                    </h4>

                                    <span class="record-reference">
                                        #REQ-@request.RequestID
                                    </span>
                                </div>

                                <span class="verified-badge">
                                    ✓ Successfully Verified
                                </span>

                            </div>


                            <div class="record-grid">

                                <div class="record-item">

                                    <span class="record-label">
                                        Problem
                                    </span>

                                    <p>
                                        @request.Description
                                    </p>

                                </div>


                                <div class="record-item">

                                    <span class="record-label">
                                        Resolution
                                    </span>

                                    <p>
                                        @completion.ResolutionAction
                                    </p>

                                </div>


                                <div class="record-item">

                                    <span class="record-label">
                                        Materials
                                    </span>

                                    <p>
                                        @if (work.Materials != null && work.Materials.Any())
                                        {
                                            string materials = string.Join(
                                                ", ",
                                                work.Materials.Select(m => m.MaterialName)
                                            );

                                            @materials
                                        }
                                        else
                                        {
                                            <span class="not-available">
                                                No materials recorded
                                            </span>
                                        }
                                    </p>

                                </div>


                                <div class="record-item">

                                    <span class="record-label">
                                        Technician
                                    </span>

                                    <p>
                                        @work.Technician.FirstName
                                        @work.Technician.LastName
                                    </p>

                                </div>


                                <div class="record-item">

                                    <span class="record-label">
                                        Ward
                                    </span>

                                    <p>
                                        Ward @request.Ward.WardNumber
                                    </p>

                                </div>


                                <div class="record-item">

                                    <span class="record-label">
                                        Verified
                                    </span>

                                    <p>
                                        @(completion.VerifiedDate.HasValue
                                            ? completion.VerifiedDate.Value.ToString("dd/MM/yyyy")
                                            : "Verified")
                                    </p>

                                </div>

                            </div>


                            @Html.ActionLink(
     "VIEW FULL RESOLUTION",
     "Details",
     "Technicians",
     new
     {
         id = work.RequestID,
         returnTo = "PreviousResolutions"
     },
     new
     {
         @class = "view-resolution-button"
     }
 )

                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">

                        <div class="empty-icon">
                            ✓
                        </div>

                        <h3>No Previous Resolutions Found</h3>

                        <p>
                            There are no verified maintenance resolutions
                            matching your search or filters.
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>

</div>


<style>

    .previous-resolutions-page {
        background: #F5F8FC;
        min-height: 100vh;
        padding: 35px 20px;
    }


    .previous-resolutions-card {
        width: 100%;
        max-width: 1400px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0px 4px 15px rgba(0,0,0,0.15);
    }


    /* PAGE HEADER */

    .previous-resolutions-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 30px 35px;
        border-bottom: 1px solid #e5e7eb;
    }


        .previous-resolutions-header h2 {
            margin: 0 0 6px 0;
            color: #0D5CC1;
            font-size: 28px;
            font-weight: 700;
        }


        .previous-resolutions-header p {
            margin: 0;
            color: #666;
            font-size: 14px;
        }


    .back-button {
        padding: 10px 16px;
        border-radius: 8px;
        background: #f3f4f6;
        color: #374151;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
    }


        .back-button:hover {
            background: #e5e7eb;
            color: #111827;
            text-decoration: none;
        }


    .previous-resolutions-content {
        padding: 35px;
    }


    /* FILTERS */

    .resolution-filters {
        padding: 22px;
        margin-bottom: 30px;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
    }


        .resolution-filters form {
            display: flex;
            align-items: flex-end;
            gap: 18px;
            flex-wrap: wrap;
        }


    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
        min-width: 190px;
    }


    .search-group {
        flex: 1;
        min-width: 280px;
    }


    .filter-group label {
        font-size: 13px;
        font-weight: 600;
        color: #374151;
    }


    .filter-group input,
    .filter-group select {
        height: 42px;
        padding: 0 12px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        background: #ffffff;
        color: #374151;
        outline: none;
    }


        .filter-group input:focus,
        .filter-group select:focus {
            border-color: #0D5CC1;
        }


    .filter-buttons {
        display: flex;
        gap: 10px;
    }


    .search-button,
    .clear-button {
        height: 42px;
        padding: 0 18px;
        border-radius: 8px;
        border: none;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }


    .search-button {
        background: #0D5CC1;
        color: white;
    }


        .search-button:hover {
            background: #0a4fa8;
        }


    .clear-button {
        background: #e5e7eb;
        color: #374151;
    }


        .clear-button:hover {
            background: #d1d5db;
            color: #111827;
            text-decoration: none;
        }


    /* SECTION */

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }


        .section-header h3 {
            margin: 0 0 5px 0;
            color: #0D5CC1;
            font-size: 22px;
            font-weight: 600;
            text-transform: uppercase;
        }


        .section-header p {
            margin: 0;
            color: #6b7280;
            font-size: 14px;
        }


    .resolution-count {
        padding: 7px 12px;
        background: #eef5ff;
        color: #0D5CC1;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }


    /* RESOLUTION RECORD */

    .resolution-record {
        margin-bottom: 20px;
        padding: 25px;
        border: 1px solid #e1e7ef;
        border-radius: 12px;
        background: #ffffff;
    }


        .resolution-record:last-child {
            margin-bottom: 0;
        }


    .record-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 22px;
        padding-bottom: 15px;
        border-bottom: 1px solid #edf0f4;
    }


        .record-header h4 {
            margin: 0 0 5px 0;
            color: #0D5CC1;
            font-size: 20px;
            font-weight: 700;
        }


    .record-reference {
        color: #6b7280;
        font-size: 13px;
        font-weight: 600;
    }


    .verified-badge {
        padding: 7px 12px;
        border-radius: 20px;
        background: #eef5ff;
        color: #0D5CC1;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }


    .record-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px 35px;
    }


    .record-item {
        min-width: 0;
    }


    .record-label {
        display: block;
        margin-bottom: 5px;
        color: #6b7280;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }


    .record-item p {
        margin: 0;
        color: #374151;
        font-size: 14px;
        line-height: 1.55;
    }


    .not-available {
        color: #9ca3af;
        font-style: italic;
    }


    .record-footer {
        display: flex;
        justify-content: flex-end;
        margin-top: 22px;
        padding-top: 18px;
        border-top: 1px solid #edf0f4;
    }


    .view-resolution-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 16px;
        border-radius: 8px;
        background: #0D5CC1;
        color: #ffffff;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
    }


        .view-resolution-button:hover {
            background: #0a4fa8;
            color: #ffffff;
            text-decoration: none;
        }


    /* EMPTY STATE */

    .empty-state {
        text-align: center;
        padding: 70px 20px;
        border: 1px dashed #d1d5db;
        border-radius: 12px;
        background: #fafafa;
    }


    .empty-icon {
        width: 52px;
        height: 52px;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #eef5ff;
        color: #0D5CC1;
        font-size: 24px;
        font-weight: 700;
    }


    .empty-state h3 {
        margin: 0 0 8px;
        color: #374151;
    }


    .empty-state p {
        margin: 0;
        color: #6b7280;
        font-size: 14px;
    }


    @@media (max-width: 900px) {

        .previous-resolutions-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .previous-resolutions-content {
            padding: 20px;
        }

        .resolution-filters form {
            flex-direction: column;
            align-items: stretch;
        }

        .filter-group,
        .search-group {
            width: 100%;
            min-width: 0;
        }

        .filter-buttons {
            width: 100%;
        }

        .search-button,
        .clear-button {
            flex: 1;
        }

        .record-grid {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 600px) {

        .previous-resolutions-page {
            padding: 15px 10px;
        }

        .previous-resolutions-header {
            padding: 22px 20px;
        }

            .previous-resolutions-header h2 {
                font-size: 23px;
            }

        .record-header {
            flex-direction: column;
        }

        .verified-badge {
            align-self: flex-start;
        }
    }
</style>
