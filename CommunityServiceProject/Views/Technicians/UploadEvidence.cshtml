@model CommunityServiceProject.Models.MaintenanceWork

@{
    ViewBag.Title = "Upload Before-Maintenance Evidence";
}

<div class="admin-review-page">

    <div class="admin-review-card">

        <div class="admin-review-header">
            <h2>Upload Before-Maintenance Evidence</h2>
            <p>Request #@Model.RequestID</p>
        </div>

        <div class="admin-review-content">

            @if (Model.Request != null)
            {
                <div class="admin-review-section">
                    <h3>Request Information</h3>

                    <div class="admin-review-row">
                        <span class="admin-review-label">
                            Request Title
                        </span>

                        <span>
                            @Model.Request.Title
                        </span>
                    </div>
                </div>
            }

            <div class="admin-review-section">

                <h3>Evidence</h3>

                @using (Html.BeginForm(
                    "UploadEvidence",
                    "Technicians",
                    FormMethod.Post,
                    new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()

                    @Html.Hidden(
                        "id",
                        Model.MaintenanceWorkID)

                    <div class="mb-3">

                        <label for="evidenceFile"
                               class="form-label">
                            Before-Maintenance Evidence
                        </label>

                        <input type="file"
                               id="evidenceFile"
                               name="evidenceFile"
                               class="form-control"
                               accept="image/*"
                               required />

                        @Html.ValidationMessage(
                            "evidenceFile",
                            "",
                            new { @class = "text-danger" })

                        <small class="text-muted">
                            Upload a photograph showing the condition
                            before maintenance begins.
                        </small>

                    </div>

                    <div class="mb-3">

                        <label for="description"
                               class="form-label">
                            Description
                        </label>

                        <textarea id="description"
                                  name="description"
                                  class="form-control"
                                  maxlength="500"
                                  rows="4"
                                  placeholder="Describe what the evidence shows..."></textarea>

                        @Html.ValidationMessage(
                            "description",
                            "",
                            new { @class = "text-danger" })

                    </div>

                    <div class="admin-review-actions">

                        <button type="submit"
                                class="admin-approve-button">
                            Upload Evidence
                        </button>

                        <a href="@Url.Action(
                            "Details",
                            "Technicians",
                            new
                            {
                                id = Model.RequestID
                            })"
                           class="admin-back-button">
                            Cancel
                        </a>

                    </div>
                }

            </div>

        </div>

    </div>

</div>
