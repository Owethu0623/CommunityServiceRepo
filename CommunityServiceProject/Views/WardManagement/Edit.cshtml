@model CommunityServiceProject.Models.Ward

@{
ViewBag.Title = "Edit Ward";
}

<style>

    /* =========================================================
       EDIT WARD
       ========================================================= */

    .ward-form-page {
        max-width: 650px;
        margin: 35px auto 40px;
        padding: 0 20px;
    }

    .ward-form-header {
        text-align: center;
        margin-bottom: 25px;
    }

    .ward-form-header h1 {
        margin: 0 0 7px;
        color: #0D5CC1;
        font-size: 28px;
        font-weight: 700;
    }

    .ward-form-header p {
        margin: 0;
        color: #666;
        font-size: 14px;
    }

    .ward-form-line {
        width: 65px;
        margin: 14px auto 0;
        border-top: 3px solid #0D5CC1;
    }


    /* =========================================================
       CARD
       ========================================================= */

    .ward-form-card {
        background: white;
        border-radius: 12px;
        padding: 28px;
        box-shadow: 0px 4px 15px rgba(0,0,0,0.10);
        border: 1px solid #e7edf5;
    }


    /* =========================================================
       FORM
       ========================================================= */

    .ward-form-group {
        margin-bottom: 20px;
    }

    .ward-form-group label {
        display: block;
        margin-bottom: 7px;
        color: #333;
        font-size: 14px;
        font-weight: 600;
    }

    .ward-form-group .form-control {
        height: 42px;
        border: 1px solid #d7e0eb;
        border-radius: 7px;
        box-shadow: none;
    }

    .ward-form-group .form-control:focus {
        border-color: #0D5CC1;
        box-shadow: none;
    }

    .ward-validation {
        display: block;
        margin-top: 5px;
        color: #b42318;
        font-size: 12px;
    }


    /* =========================================================
       ACTIONS
       ========================================================= */

    .ward-form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 25px;
    }

    .ward-form-button {
        border-radius: 7px;
        padding: 10px 18px;
        min-height: 40px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none !important;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .ward-save-button {
        background: #0D5CC1;
        color: white !important;
        border: 1px solid #0D5CC1;
    }

    .ward-save-button:hover {
        background: #08479A;
        border-color: #08479A;
        color: white !important;
    }

    .ward-back-button {
        background: white;
        color: #0D5CC1 !important;
        border: 1px solid #0D5CC1;
    }

    .ward-back-button:hover {
        background: #0D5CC1;
        color: white !important;
    }


    @@media (max-width: 600px) {

        .ward-form-page {
            margin-top: 25px;
            padding: 0 14px;
        }

        .ward-form-card {
            padding: 20px;
        }

        .ward-form-actions {
            flex-direction: column;
        }

        .ward-form-button {
            width: 100%;
            text-align: center;
        }
    }

</style>

<div class="ward-form-page">

```
<div class="ward-form-header">

    <h1>
        EDIT WARD
    </h1>

    <p>
        Update the ward number and area name.
    </p>

    <div class="ward-form-line"></div>

</div>


<div class="ward-form-card">

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(model => model.WardID)


        @Html.ValidationSummary(
            true,
            "",
            new { @class = "ward-validation" }
        )


        <!-- Ward Number -->

        <div class="ward-form-group">

            @Html.LabelFor(
                model => model.WardNumber,
                "Ward Number"
            )

            @Html.TextBoxFor(
                model => model.WardNumber,
                new
                {
                    @class = "form-control",
                    placeholder = "Enter ward number"
                }
            )

            @Html.ValidationMessageFor(
                model => model.WardNumber,
                "",
                new { @class = "ward-validation" }
            )

        </div>


        <!-- Ward Name / Area -->

        <div class="ward-form-group">

            @Html.LabelFor(
                model => model.WardName,
                "Ward Name / Area"
            )

            @Html.TextBoxFor(
                model => model.WardName,
                new
                {
                    @class = "form-control",
                    placeholder = "Enter ward name or area"
                }
            )

            @Html.ValidationMessageFor(
                model => model.WardName,
                "",
                new { @class = "ward-validation" }
            )

        </div>


        <!-- Actions -->

        <div class="ward-form-actions">

            <a href="@Url.Action("Index", "WardManagement")"
               class="ward-form-button ward-back-button">

                <span class="glyphicon glyphicon-arrow-left"></span>

                Back to Wards

            </a>


            <button type="submit"
                    class="ward-form-button ward-save-button">

                <span class="glyphicon glyphicon-save"></span>

                Save Changes

            </button>

        </div>

    }

</div>


</div>

